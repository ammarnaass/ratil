#!/usr/bin/env node

/**
 * رتل - Ratil
 * سكربت التحقق الصارم من سلامة النص القرآني والخطوط المعتمدة
 * scripts/verify-text
 *
 * المبدأ الحاكم الأول: النص القرآني لا يُكتب ولا يُعدل يدوياً؛
 * يُستورد من مصدر معتمد ويُتحقق من بصمته (SHA-256).
 * أي اختلاف، ولو في حركة أو مسافة واحدة، يُفشل العملية فوراً بكود خطأ (Exit Code 1).
 */

import { createHash } from 'node:crypto';
import { readFileSync, existsSync } from 'node:fs';
import { resolve, dirname } from 'node:path';
import { fileURLToPath } from 'node:url';

const __filename = fileURLToPath(import.meta.url);
const __dirname = dirname(__filename);
const ROOT_DIR = resolve(__dirname, '..');
const CHECKSUMS_PATH = resolve(ROOT_DIR, 'data/checksums.json');

// ألوان مخرجات الطرفية
const C = {
  reset: '\x1b[0m',
  bold: '\x1b[1m',
  dim: '\x1b[2m',
  green: '\x1b[32m',
  red: '\x1b[31m',
  yellow: '\x1b[33m',
  cyan: '\x1b[36m',
};

function log(msg) {
  console.log(msg);
}

function success(msg) {
  console.log(` ${C.green}✓${C.reset} ${msg}`);
}

function fail(msg) {
  console.error(` ${C.red}✗${C.reset} ${C.bold}${msg}${C.reset}`);
}

function computeSha256(filePath) {
  const fileBuffer = readFileSync(filePath);
  return createHash('sha256').update(fileBuffer).digest('hex');
}

function verifyHafsStructuralIntegrity(filePath) {
  const content = readFileSync(filePath, 'utf-8');
  const lines = content.split('\n');

  let ayaCount = 0;
  const surahs = new Set();

  for (const line of lines) {
    const trimmed = line.trim();
    if (!trimmed || trimmed.startsWith('#')) continue;

    const parts = trimmed.split('|');
    if (parts.length >= 3) {
      const suraNo = parseInt(parts[0], 10);
      const ayaNo = parseInt(parts[1], 10);
      const text = parts.slice(2).join('|');

      if (isNaN(suraNo) || isNaN(ayaNo) || !text) {
        throw new Error(`سطر غير سليم في نص حفص: "${trimmed.substring(0, 40)}..."`);
      }

      surahs.add(suraNo);
      ayaCount++;
    }
  }

  if (surahs.size !== 114) {
    throw new Error(`عدد سور نص حفص غير مطابق: المتوقع 114، وُجد ${surahs.size}`);
  }

  if (ayaCount !== 6236) {
    throw new Error(`عدد آيات نص حفص غير مطابق: المتوقع 6236 (العد الكوفي)، وُجد ${ayaCount}`);
  }

  return { surahs: surahs.size, ayahs: ayaCount };
}

function verifyWarshStructuralIntegrity(filePath) {
  const content = readFileSync(filePath, 'utf-8');
  const data = JSON.parse(content);

  if (!Array.isArray(data)) {
    throw new Error('ملف ورش يجب أن يكون مصفوفة JSON صالحة');
  }

  const surahs = new Set();
  let ayaCount = 0;

  for (const item of data) {
    if (!item.sura_no || !item.aya_no || !item.aya_text) {
      throw new Error(`عنصر ناقص في مصفوفة ورش: معرف ${item.id || 'مجهول'}`);
    }
    surahs.add(item.sura_no);
    ayaCount++;
  }

  if (surahs.size !== 114) {
    throw new Error(`عدد سور نص ورش غير مطابق: المتوقع 114، وُجد ${surahs.size}`);
  }

  if (ayaCount !== 6214) {
    throw new Error(`عدد آيات نص ورش غير مطابق: المتوقع 6214 (العد المدني الأخير)، وُجد ${ayaCount}`);
  }

  return { surahs: surahs.size, ayahs: ayaCount };
}

async function runVerification() {
  const startTime = Date.now();
  log(`\n${C.bold}${C.cyan}╔════════════════════════════════════════════════════════════╗${C.reset}`);
  log(`${C.bold}${C.cyan}║   رتل - التحقق من البصمات الرقمية وسلامة النصوص القرآنية  ║${C.reset}`);
  log(`${C.bold}${C.cyan}╚════════════════════════════════════════════════════════════╝${C.reset}\n`);

  if (!existsSync(CHECKSUMS_PATH)) {
    fail(`ملف البصمات المرجعية مفقود: ${CHECKSUMS_PATH}`);
    process.exit(1);
  }

  const checksumsData = JSON.parse(readFileSync(CHECKSUMS_PATH, 'utf-8'));
  let totalErrors = 0;
  let verifiedCount = 0;

  // 1. فحص مصادر النصوص القرآنية
  log(`${C.bold}1. فحص مصادر النصوص القرآنية المعتمدة:${C.reset}`);

  for (const [key, info] of Object.entries(checksumsData.sources)) {
    const fullPath = resolve(ROOT_DIR, info.file);
    log(`\n ${C.bold}▸ الرواية: ${info.narration}${C.reset}`);
    log(`   المصدر: ${info.authority}`);
    log(`   الملف: ${info.file}`);

    if (!existsSync(fullPath)) {
      fail(`الملف غير موجود في المسار: ${fullPath}`);
      totalErrors++;
      continue;
    }

    const computedHash = computeSha256(fullPath);
    if (computedHash.toLowerCase() !== info.sha256.toLowerCase()) {
      fail(`تطابق البصمة فشل! تم اكتشاف تغيير في النص القرآني!`);
      log(`   البصمة المتوقعة: ${C.green}${info.sha256}${C.reset}`);
      log(`   البصمة الفعلية:  ${C.red}${computedHash}${C.reset}`);
      totalErrors++;
      continue;
    } else {
      success(`بصمة SHA-256 متطابقة بدقة 100%: ${C.dim}${computedHash}${C.reset}`);
      verifiedCount++;
    }

    // التحقق الهيكلي والعلمي للرواية
    try {
      if (key === 'hafs') {
        const stats = verifyHafsStructuralIntegrity(fullPath);
        success(`التحقق الهيكلي: ${stats.surahs} سورة، ${stats.ayahs} آية (مطابق لمصحف المدينة بالعد الكوفي)`);
      } else if (key === 'warsh') {
        const stats = verifyWarshStructuralIntegrity(fullPath);
        success(`التحقق الهيكلي: ${stats.surahs} سورة، ${stats.ayahs} آية (مطابق لمصحف المدينة بالعد المدني الأخير)`);
      }
    } catch (err) {
      fail(`خطأ في التحقق الهيكلي: ${err.message}`);
      totalErrors++;
    }
  }

  // 2. فحص ملفات الخطوط العثمانية
  log(`\n${C.bold}2. فحص ملفات الخطوط العثمانية المعتمدة (KFGQPC):${C.reset}`);

  for (const [key, info] of Object.entries(checksumsData.fonts)) {
    const fullPath = resolve(ROOT_DIR, info.file);
    log(`\n ${C.bold}▸ الخط: ${key} (${info.authority})${C.reset}`);
    log(`   الملف: ${info.file}`);

    if (!existsSync(fullPath)) {
      fail(`ملف الخط غير موجود: ${fullPath}`);
      totalErrors++;
      continue;
    }

    const computedHash = computeSha256(fullPath);
    if (computedHash.toLowerCase() !== info.sha256.toLowerCase()) {
      fail(`بصمة ملف الخط غير مطابقة!`);
      log(`   المتوقع: ${info.sha256}`);
      log(`   الفعلي:  ${computedHash}`);
      totalErrors++;
    } else {
      success(`بصمة الخط متطابقة: ${C.dim}${computedHash}${C.reset}`);
      verifiedCount++;
    }
  }

  const duration = (Date.now() - startTime) / 1000;
  log(`\n${C.dim}────────────────────────────────────────────────────────────${C.reset}`);

  if (totalErrors > 0) {
    log(`\n${C.red}${C.bold}❌ فشل التحقق! تم العثور على ${totalErrors} خطأ.${C.reset}`);
    log(`${C.red}تنبيه أمني: وفقاً للمبادئ الحاكمة لمشروع «رتل»، تم إيقاف عملية البناء فوراً.${C.reset}\n`);
    process.exit(1);
  }

  log(`\n${C.green}${C.bold}✓ اكتمل التحقق بنجاح (${verifiedCount} عناصر تم فحصها في ${duration} ثانية).${C.reset}`);
  log(`${C.green}النص القرآني سليم وموثوق ومطابق للمصادر المعتمدة 100%.${C.reset}\n`);
  process.exit(0);
}

runVerification().catch((err) => {
  console.error('حدث خطأ غير متوقع أثناء فحص البصمات:', err);
  process.exit(1);
});
