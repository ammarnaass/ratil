{
  "id": 104,
  "name_ar": "الهمزة",
  "name_en": "Al-Humazah",
  "type": "مكية",
  "ayahs_hafs": 9,
  "ayahs_warsh": 9,
  "page": 601,
  "narration": "hafs",
  "narration_ar": "حفص عن عاصم",
  "ayahs": [
    {
      "sura": 104,
      "aya": 1,
      "text_uthmani": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَيْلٌ لِّكُلِّ هُمَزَةٍ لُّمَزَةٍ",
      "text_normalized": "بسم الله الرحمن الرحيم ويل لكل همزه لمزه",
      "aya_indic": "١"
    },
    {
      "sura": 104,
      "aya": 2,
      "text_uthmani": "ٱلَّذِى جَمَعَ مَالًا وَعَدَّدَهُۥ",
      "text_normalized": "الذي جمع مالا وعدده",
      "aya_indic": "٢"
    },
    {
      "sura": 104,
      "aya": 3,
      "text_uthmani": "يَحْسَبُ أَنَّ مَالَهُۥٓ أَخْلَدَهُۥ",
      "text_normalized": "يحسب ان ماله اخلده",
      "aya_indic": "٣"
    },
    {
      "sura": 104,
      "aya": 4,
      "text_uthmani": "كَلَّا ۖ لَيُنۢبَذَنَّ فِى ٱلْحُطَمَةِ",
      "text_normalized": "كلا لينبذن في الحطمه",
      "aya_indic": "٤"
    },
    {
      "sura": 104,
      "aya": 5,
      "text_uthmani": "وَمَآ أَدْرَىٰكَ مَا ٱلْحُطَمَةُ",
      "text_normalized": "وما ادرياك ما الحطمه",
      "aya_indic": "٥"
    },
    {
      "sura": 104,
      "aya": 6,
      "text_uthmani": "نَارُ ٱللَّهِ ٱلْمُوقَدَةُ",
      "text_normalized": "نار الله الموقده",
      "aya_indic": "٦"
    },
    {
      "sura": 104,
      "aya": 7,
      "text_uthmani": "ٱلَّتِى تَطَّلِعُ عَلَى ٱلْأَفْـِٔدَةِ",
      "text_normalized": "التي تطلع علي الافده",
      "aya_indic": "٧"
    },
    {
      "sura": 104,
      "aya": 8,
      "text_uthmani": "إِنَّهَا عَلَيْهِم مُّؤْصَدَةٌ",
      "text_normalized": "انها عليهم موصده",
      "aya_indic": "٨"
    },
    {
      "sura": 104,
      "aya": 9,
      "text_uthmani": "فِى عَمَدٍ مُّمَدَّدَةٍۭ",
      "text_normalized": "في عمد ممدده",
      "aya_indic": "٩"
    }
  ]
}