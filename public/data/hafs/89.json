{
  "id": 89,
  "name_ar": "الفجر",
  "name_en": "Al-Fajr",
  "type": "مكية",
  "ayahs_hafs": 30,
  "ayahs_warsh": 32,
  "page": 593,
  "narration": "hafs",
  "narration_ar": "حفص عن عاصم",
  "ayahs": [
    {
      "sura": 89,
      "aya": 1,
      "text_uthmani": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلْفَجْرِ",
      "text_normalized": "بسم الله الرحمن الرحيم والفجر",
      "aya_indic": "١"
    },
    {
      "sura": 89,
      "aya": 2,
      "text_uthmani": "وَلَيَالٍ عَشْرٍ",
      "text_normalized": "وليال عشر",
      "aya_indic": "٢"
    },
    {
      "sura": 89,
      "aya": 3,
      "text_uthmani": "وَٱلشَّفْعِ وَٱلْوَتْرِ",
      "text_normalized": "والشفع والوتر",
      "aya_indic": "٣"
    },
    {
      "sura": 89,
      "aya": 4,
      "text_uthmani": "وَٱلَّيْلِ إِذَا يَسْرِ",
      "text_normalized": "واليل اذا يسر",
      "aya_indic": "٤"
    },
    {
      "sura": 89,
      "aya": 5,
      "text_uthmani": "هَلْ فِى ذَٰلِكَ قَسَمٌ لِّذِى حِجْرٍ",
      "text_normalized": "هل في ذلك قسم لذي حجر",
      "aya_indic": "٥"
    },
    {
      "sura": 89,
      "aya": 6,
      "text_uthmani": "أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِعَادٍ",
      "text_normalized": "الم تر كيف فعل ربك بعاد",
      "aya_indic": "٦"
    },
    {
      "sura": 89,
      "aya": 7,
      "text_uthmani": "إِرَمَ ذَاتِ ٱلْعِمَادِ",
      "text_normalized": "ارم ذات العماد",
      "aya_indic": "٧"
    },
    {
      "sura": 89,
      "aya": 8,
      "text_uthmani": "ٱلَّتِى لَمْ يُخْلَقْ مِثْلُهَا فِى ٱلْبِلَٰدِ",
      "text_normalized": "التي لم يخلق مثلها في البلاد",
      "aya_indic": "٨"
    },
    {
      "sura": 89,
      "aya": 9,
      "text_uthmani": "وَثَمُودَ ٱلَّذِينَ جَابُوا۟ ٱلصَّخْرَ بِٱلْوَادِ",
      "text_normalized": "وثمود الذين جابوا الصخر بالواد",
      "aya_indic": "٩"
    },
    {
      "sura": 89,
      "aya": 10,
      "text_uthmani": "وَفِرْعَوْنَ ذِى ٱلْأَوْتَادِ",
      "text_normalized": "وفرعون ذي الاوتاد",
      "aya_indic": "١٠"
    },
    {
      "sura": 89,
      "aya": 11,
      "text_uthmani": "ٱلَّذِينَ طَغَوْا۟ فِى ٱلْبِلَٰدِ",
      "text_normalized": "الذين طغوا في البلاد",
      "aya_indic": "١١"
    },
    {
      "sura": 89,
      "aya": 12,
      "text_uthmani": "فَأَكْثَرُوا۟ فِيهَا ٱلْفَسَادَ",
      "text_normalized": "فاكثروا فيها الفساد",
      "aya_indic": "١٢"
    },
    {
      "sura": 89,
      "aya": 13,
      "text_uthmani": "فَصَبَّ عَلَيْهِمْ رَبُّكَ سَوْطَ عَذَابٍ",
      "text_normalized": "فصب عليهم ربك سوط عذاب",
      "aya_indic": "١٣"
    },
    {
      "sura": 89,
      "aya": 14,
      "text_uthmani": "إِنَّ رَبَّكَ لَبِٱلْمِرْصَادِ",
      "text_normalized": "ان ربك لبالمرصاد",
      "aya_indic": "١٤"
    },
    {
      "sura": 89,
      "aya": 15,
      "text_uthmani": "فَأَمَّا ٱلْإِنسَٰنُ إِذَا مَا ٱبْتَلَىٰهُ رَبُّهُۥ فَأَكْرَمَهُۥ وَنَعَّمَهُۥ فَيَقُولُ رَبِّىٓ أَكْرَمَنِ",
      "text_normalized": "فاما الانسان اذا ما ابتلياه ربه فاكرمه ونعمه فيقول ربي اكرمن",
      "aya_indic": "١٥"
    },
    {
      "sura": 89,
      "aya": 16,
      "text_uthmani": "وَأَمَّآ إِذَا مَا ٱبْتَلَىٰهُ فَقَدَرَ عَلَيْهِ رِزْقَهُۥ فَيَقُولُ رَبِّىٓ أَهَٰنَنِ",
      "text_normalized": "واما اذا ما ابتلياه فقدر عليه رزقه فيقول ربي اهانن",
      "aya_indic": "١٦"
    },
    {
      "sura": 89,
      "aya": 17,
      "text_uthmani": "كَلَّا ۖ بَل لَّا تُكْرِمُونَ ٱلْيَتِيمَ",
      "text_normalized": "كلا بل لا تكرمون اليتيم",
      "aya_indic": "١٧"
    },
    {
      "sura": 89,
      "aya": 18,
      "text_uthmani": "وَلَا تَحَٰٓضُّونَ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ",
      "text_normalized": "ولا تحاضون عليا طعام المسكين",
      "aya_indic": "١٨"
    },
    {
      "sura": 89,
      "aya": 19,
      "text_uthmani": "وَتَأْكُلُونَ ٱلتُّرَاثَ أَكْلًا لَّمًّا",
      "text_normalized": "وتاكلون التراث اكلا لما",
      "aya_indic": "١٩"
    },
    {
      "sura": 89,
      "aya": 20,
      "text_uthmani": "وَتُحِبُّونَ ٱلْمَالَ حُبًّا جَمًّا",
      "text_normalized": "وتحبون المال حبا جما",
      "aya_indic": "٢٠"
    },
    {
      "sura": 89,
      "aya": 21,
      "text_uthmani": "كَلَّآ إِذَا دُكَّتِ ٱلْأَرْضُ دَكًّا دَكًّا",
      "text_normalized": "كلا اذا دكت الارض دكا دكا",
      "aya_indic": "٢١"
    },
    {
      "sura": 89,
      "aya": 22,
      "text_uthmani": "وَجَآءَ رَبُّكَ وَٱلْمَلَكُ صَفًّا صَفًّا",
      "text_normalized": "وجاء ربك والملك صفا صفا",
      "aya_indic": "٢٢"
    },
    {
      "sura": 89,
      "aya": 23,
      "text_uthmani": "وَجِا۟ىٓءَ يَوْمَئِذٍۭ بِجَهَنَّمَ ۚ يَوْمَئِذٍ يَتَذَكَّرُ ٱلْإِنسَٰنُ وَأَنَّىٰ لَهُ ٱلذِّكْرَىٰ",
      "text_normalized": "وجايء يوميذ بجهنم يوميذ يتذكر الانسان وانيا له الذكريا",
      "aya_indic": "٢٣"
    },
    {
      "sura": 89,
      "aya": 24,
      "text_uthmani": "يَقُولُ يَٰلَيْتَنِى قَدَّمْتُ لِحَيَاتِى",
      "text_normalized": "يقول ياليتني قدمت لحياتي",
      "aya_indic": "٢٤"
    },
    {
      "sura": 89,
      "aya": 25,
      "text_uthmani": "فَيَوْمَئِذٍ لَّا يُعَذِّبُ عَذَابَهُۥٓ أَحَدٌ",
      "text_normalized": "فيوميذ لا يعذب عذابه احد",
      "aya_indic": "٢٥"
    },
    {
      "sura": 89,
      "aya": 26,
      "text_uthmani": "وَلَا يُوثِقُ وَثَاقَهُۥٓ أَحَدٌ",
      "text_normalized": "ولا يوثق وثاقه احد",
      "aya_indic": "٢٦"
    },
    {
      "sura": 89,
      "aya": 27,
      "text_uthmani": "يَٰٓأَيَّتُهَا ٱلنَّفْسُ ٱلْمُطْمَئِنَّةُ",
      "text_normalized": "ياايتها النفس المطمينه",
      "aya_indic": "٢٧"
    },
    {
      "sura": 89,
      "aya": 28,
      "text_uthmani": "ٱرْجِعِىٓ إِلَىٰ رَبِّكِ رَاضِيَةً مَّرْضِيَّةً",
      "text_normalized": "ارجعي اليا ربك راضيه مرضيه",
      "aya_indic": "٢٨"
    },
    {
      "sura": 89,
      "aya": 29,
      "text_uthmani": "فَٱدْخُلِى فِى عِبَٰدِى",
      "text_normalized": "فادخلي في عبادي",
      "aya_indic": "٢٩"
    },
    {
      "sura": 89,
      "aya": 30,
      "text_uthmani": "وَٱدْخُلِى جَنَّتِى",
      "text_normalized": "وادخلي جنتي",
      "aya_indic": "٣٠"
    }
  ]
}