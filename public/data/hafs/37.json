      "aya_indic": "١٤٦"
    },
    {
      "sura": 37,
      "aya": 147,
      "text_uthmani": "وَأَرْسَلْنَٰهُ إِلَىٰ مِا۟ئَةِ أَلْفٍ أَوْ يَزِيدُونَ",
      "text_normalized": "وارسلناه اليا مايه الف او يزيدون",
      "aya_indic": "١٤٧"
    },
    {
      "sura": 37,
      "aya": 148,
      "text_uthmani": "فَـَٔامَنُوا۟ فَمَتَّعْنَٰهُمْ إِلَىٰ حِينٍ",
      "text_normalized": "فامنوا فمتعناهم اليا حين",
      "aya_indic": "١٤٨"
    },
    {
      "sura": 37,
      "aya": 149,
      "text_uthmani": "فَٱسْتَفْتِهِمْ أَلِرَبِّكَ ٱلْبَنَاتُ وَلَهُمُ ٱلْبَنُونَ",
      "text_normalized": "فاستفتهم الربك البنات ولهم البنون",
      "aya_indic": "١٤٩"
    },
    {
      "sura": 37,
      "aya": 150,
      "text_uthmani": "أَمْ خَلَقْنَا ٱلْمَلَٰٓئِكَةَ إِنَٰثًا وَهُمْ شَٰهِدُونَ",
      "text_normalized": "ام خلقنا الملايكه اناثا وهم شاهدون",
      "aya_indic": "١٥٠"
    },
    {
      "sura": 37,
      "aya": 151,
      "text_uthmani": "أَلَآ إِنَّهُم مِّنْ إِفْكِهِمْ لَيَقُولُونَ",
      "text_normalized": "الا انهم من افكهم ليقولون",
      "aya_indic": "١٥١"
    },
    {
      "sura": 37,
      "aya": 152,
      "text_uthmani": "وَلَدَ ٱللَّهُ وَإِنَّهُمْ لَكَٰذِبُونَ",
      "text_normalized": "ولد الله وانهم لكاذبون",
      "aya_indic": "١٥٢"
    },
    {
      "sura": 37,
      "aya": 153,
      "text_uthmani": "أَصْطَفَى ٱلْبَنَاتِ عَلَى ٱلْبَنِينَ",
