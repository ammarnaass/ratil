      "aya_indic": "١٢٣"
    },
    {
      "sura": 37,
      "aya": 124,
      "text_uthmani": "إِذْ قَالَ لِقَوْمِهِۦٓ أَلَا تَتَّقُونَ",
      "text_normalized": "اذ قال لقومه الا تتقون",
      "aya_indic": "١٢٤"
    },
    {
      "sura": 37,
      "aya": 125,
      "text_uthmani": "أَتَدْعُونَ بَعْلًا وَتَذَرُونَ أَحْسَنَ ٱلْخَٰلِقِينَ",
      "text_normalized": "اتدعون بعلا وتذرون احسن الخالقين",
      "aya_indic": "١٢٥"
    },
    {
      "sura": 37,
      "aya": 126,
      "text_uthmani": "ٱللَّهَ رَبَّكُمْ وَرَبَّ ءَابَآئِكُمُ ٱلْأَوَّلِينَ",
      "text_normalized": "الله ربكم ورب ءابايكم الاولين",
