      "aya_indic": "١٧٥"
    },
    {
      "sura": 37,
      "aya": 176,
      "text_uthmani": "أَفَبِعَذَابِنَا يَسْتَعْجِلُونَ",
      "text_normalized": "افبعذابنا يستعجلون",
      "aya_indic": "١٧٦"
    },
    {
      "sura": 37,
      "aya": 177,
      "text_uthmani": "فَإِذَا نَزَلَ بِسَاحَتِهِمْ فَسَآءَ صَبَاحُ ٱلْمُنذَرِينَ",
      "text_normalized": "فاذا نزل بساحتهم فساء صباح المنذرين",
      "aya_indic": "١٧٧"
    },
    {
      "sura": 37,
      "aya": 178,
      "text_uthmani": "وَتَوَلَّ عَنْهُمْ حَتَّىٰ حِينٍ",
      "text_normalized": "وتول عنهم حتيا حين",
      "aya_indic": "١٧٨"
    },
    {
      "sura": 37,
      "aya": 179,
      "text_uthmani": "وَأَبْصِرْ فَسَوْفَ يُبْصِرُونَ",
      "text_normalized": "وابصر فسوف يبصرون",
      "aya_indic": "١٧٩"
    },
    {
      "sura": 37,
      "aya": 180,
      "text_uthmani": "سُبْحَٰنَ رَبِّكَ رَبِّ ٱلْعِزَّةِ عَمَّا يَصِفُونَ",
      "text_normalized": "سبحان ربك رب العزه عما يصفون",
      "aya_indic": "١٨٠"
    },
    {
      "sura": 37,
