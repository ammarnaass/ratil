      "aya_indic": "١٣٤"
    },
    {
      "sura": 37,
      "aya": 135,
      "text_uthmani": "إِلَّا عَجُوزًا فِى ٱلْغَٰبِرِينَ",
      "text_normalized": "الا عجوزا في الغابرين",
      "aya_indic": "١٣٥"
    },
    {
      "sura": 37,
      "aya": 136,
      "text_uthmani": "ثُمَّ دَمَّرْنَا ٱلْـَٔاخَرِينَ",
      "text_normalized": "ثم دمرنا الاخرين",
      "aya_indic": "١٣٦"
    },
    {
      "sura": 37,
      "aya": 137,
      "text_uthmani": "وَإِنَّكُمْ لَتَمُرُّونَ عَلَيْهِم مُّصْبِحِينَ",
      "text_normalized": "وانكم لتمرون عليهم مصبحين",
      "aya_indic": "١٣٧"
    },
    {
      "sura": 37,
      "aya": 138,
      "text_uthmani": "وَبِٱلَّيْلِ ۗ أَفَلَا تَعْقِلُونَ",
