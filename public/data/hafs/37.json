      "aya_indic": "١٧٠"
    },
    {
      "sura": 37,
      "aya": 171,
      "text_uthmani": "وَلَقَدْ سَبَقَتْ كَلِمَتُنَا لِعِبَادِنَا ٱلْمُرْسَلِينَ",
      "text_normalized": "ولقد سبقت كلمتنا لعبادنا المرسلين",
      "aya_indic": "١٧١"
    },
    {
      "sura": 37,
      "aya": 172,
      "text_uthmani": "إِنَّهُمْ لَهُمُ ٱلْمَنصُورُونَ",
      "text_normalized": "انهم لهم المنصورون",
      "aya_indic": "١٧٢"
    },
    {
      "sura": 37,
      "aya": 173,
      "text_uthmani": "وَإِنَّ جُندَنَا لَهُمُ ٱلْغَٰلِبُونَ",
      "text_normalized": "وان جندنا لهم الغالبون",
      "aya_indic": "١٧٣"
    },
    {
      "sura": 37,
      "aya": 174,
      "text_uthmani": "فَتَوَلَّ عَنْهُمْ حَتَّىٰ حِينٍ",
