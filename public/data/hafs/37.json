{
  "id": 37,
  "name_ar": "الصافات",
  "name_en": "As-Saffat",
  "type": "مكية",
  "ayahs_hafs": 182,
  "ayahs_warsh": 182,
  "page": 446,
  "narration": "hafs",
  "narration_ar": "حفص عن عاصم",
  "ayahs": [
    {
      "sura": 37,
      "aya": 1,
      "text_uthmani": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلصَّٰٓفَّٰتِ صَفًّا",
      "text_normalized": "بسم الله الرحمن الرحيم والصافات صفا",
      "aya_indic": "١"
    },
    {
      "sura": 37,
      "aya": 2,
      "text_uthmani": "فَٱلزَّٰجِرَٰتِ زَجْرًا",
      "text_normalized": "فالزاجرات زجرا",
      "aya_indic": "٢"
    },
    {
      "sura": 37,
      "aya": 3,
      "text_uthmani": "فَٱلتَّٰلِيَٰتِ ذِكْرًا",
      "text_normalized": "فالتاليات ذكرا",
      "aya_indic": "٣"
    },
    {
      "sura": 37,
      "aya": 4,
      "text_uthmani": "إِنَّ إِلَٰهَكُمْ لَوَٰحِدٌ",
      "text_normalized": "ان الاهكم لواحد",
      "aya_indic": "٤"
    },
    {
      "sura": 37,
      "aya": 5,
      "text_uthmani": "رَّبُّ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ وَمَا بَيْنَهُمَا وَرَبُّ ٱلْمَشَٰرِقِ",
      "text_normalized": "رب السماوات والارض وما بينهما ورب المشارق",
      "aya_indic": "٥"
    },
    {
      "sura": 37,
      "aya": 6,
      "text_uthmani": "إِنَّا زَيَّنَّا ٱلسَّمَآءَ ٱلدُّنْيَا بِزِينَةٍ ٱلْكَوَاكِبِ",
      "text_normalized": "انا زينا السماء الدنيا بزينه الكواكب",
      "aya_indic": "٦"
    },
    {
      "sura": 37,
      "aya": 7,
      "text_uthmani": "وَحِفْظًا مِّن كُلِّ شَيْطَٰنٍ مَّارِدٍ",
      "text_normalized": "وحفظا من كل شيطان مارد",
      "aya_indic": "٧"
    },
    {
      "sura": 37,
      "aya": 8,
      "text_uthmani": "لَّا يَسَّمَّعُونَ إِلَى ٱلْمَلَإِ ٱلْأَعْلَىٰ وَيُقْذَفُونَ مِن كُلِّ جَانِبٍ",
      "text_normalized": "لا يسمعون الي الملا الاعليا ويقذفون من كل جانب",
      "aya_indic": "٨"
    },
    {
      "sura": 37,
      "aya": 9,
      "text_uthmani": "دُحُورًا ۖ وَلَهُمْ عَذَابٌ وَاصِبٌ",
      "text_normalized": "دحورا ولهم عذاب واصب",
      "aya_indic": "٩"
    },
    {
      "sura": 37,
      "aya": 10,
      "text_uthmani": "إِلَّا مَنْ خَطِفَ ٱلْخَطْفَةَ فَأَتْبَعَهُۥ شِهَابٌ ثَاقِبٌ",
      "text_normalized": "الا من خطف الخطفه فاتبعه شهاب ثاقب",
      "aya_indic": "١٠"
    },
    {
      "sura": 37,
      "aya": 11,
      "text_uthmani": "فَٱسْتَفْتِهِمْ أَهُمْ أَشَدُّ خَلْقًا أَم مَّنْ خَلَقْنَآ ۚ إِنَّا خَلَقْنَٰهُم مِّن طِينٍ لَّازِبٍۭ",
      "text_normalized": "فاستفتهم اهم اشد خلقا ام من خلقنا انا خلقناهم من طين لازب",
      "aya_indic": "١١"
    },
    {
      "sura": 37,
      "aya": 12,
      "text_uthmani": "بَلْ عَجِبْتَ وَيَسْخَرُونَ",
      "text_normalized": "بل عجبت ويسخرون",
      "aya_indic": "١٢"
    },
    {
      "sura": 37,
      "aya": 13,
      "text_uthmani": "وَإِذَا ذُكِّرُوا۟ لَا يَذْكُرُونَ",
      "text_normalized": "واذا ذكروا لا يذكرون",
      "aya_indic": "١٣"
    },
    {
      "sura": 37,
      "aya": 14,
      "text_uthmani": "وَإِذَا رَأَوْا۟ ءَايَةً يَسْتَسْخِرُونَ",
      "text_normalized": "واذا راوا ءايه يستسخرون",
      "aya_indic": "١٤"
    },
    {
      "sura": 37,
      "aya": 15,
      "text_uthmani": "وَقَالُوٓا۟ إِنْ هَٰذَآ إِلَّا سِحْرٌ مُّبِينٌ",
      "text_normalized": "وقالوا ان هذا الا سحر مبين",
      "aya_indic": "١٥"
    },
    {
      "sura": 37,
      "aya": 16,
      "text_uthmani": "أَءِذَا مِتْنَا وَكُنَّا تُرَابًا وَعِظَٰمًا أَءِنَّا لَمَبْعُوثُونَ",
      "text_normalized": "اءذا متنا وكنا ترابا وعظاما اءنا لمبعوثون",
      "aya_indic": "١٦"
    },
    {
      "sura": 37,
      "aya": 17,
      "text_uthmani": "أَوَءَابَآؤُنَا ٱلْأَوَّلُونَ",
      "text_normalized": "اوءاباونا الاولون",
      "aya_indic": "١٧"
    },
    {
      "sura": 37,
      "aya": 18,
      "text_uthmani": "قُلْ نَعَمْ وَأَنتُمْ دَٰخِرُونَ",
      "text_normalized": "قل نعم وانتم داخرون",
      "aya_indic": "١٨"
    },
    {
      "sura": 37,
      "aya": 19,
      "text_uthmani": "فَإِنَّمَا هِىَ زَجْرَةٌ وَٰحِدَةٌ فَإِذَا هُمْ يَنظُرُونَ",
      "text_normalized": "فانما هي زجره واحده فاذا هم ينظرون",
      "aya_indic": "١٩"
    },
    {
      "sura": 37,
      "aya": 20,
      "text_uthmani": "وَقَالُوا۟ يَٰوَيْلَنَا هَٰذَا يَوْمُ ٱلدِّينِ",
      "text_normalized": "وقالوا ياويلنا هذا يوم الدين",
      "aya_indic": "٢٠"
    },
    {
      "sura": 37,
      "aya": 21,
      "text_uthmani": "هَٰذَا يَوْمُ ٱلْفَصْلِ ٱلَّذِى كُنتُم بِهِۦ تُكَذِّبُونَ",
      "text_normalized": "هذا يوم الفصل الذي كنتم به تكذبون",
      "aya_indic": "٢١"
    },
    {
      "sura": 37,
      "aya": 22,
      "text_uthmani": "ٱحْشُرُوا۟ ٱلَّذِينَ ظَلَمُوا۟ وَأَزْوَٰجَهُمْ وَمَا كَانُوا۟ يَعْبُدُونَ",
      "text_normalized": "احشروا الذين ظلموا وازواجهم وما كانوا يعبدون",
      "aya_indic": "٢٢"
    },
    {
      "sura": 37,
      "aya": 23,
      "text_uthmani": "مِن دُونِ ٱللَّهِ فَٱهْدُوهُمْ إِلَىٰ صِرَٰطِ ٱلْجَحِيمِ",
      "text_normalized": "من دون الله فاهدوهم اليا صراط الجحيم",
      "aya_indic": "٢٣"
    },
    {
      "sura": 37,
      "aya": 24,
      "text_uthmani": "وَقِفُوهُمْ ۖ إِنَّهُم مَّسْـُٔولُونَ",
      "text_normalized": "وقفوهم انهم مسولون",
      "aya_indic": "٢٤"
    },
    {
      "sura": 37,
      "aya": 25,
      "text_uthmani": "مَا لَكُمْ لَا تَنَاصَرُونَ",
      "text_normalized": "ما لكم لا تناصرون",
      "aya_indic": "٢٥"
    },
    {
      "sura": 37,
      "aya": 26,
      "text_uthmani": "بَلْ هُمُ ٱلْيَوْمَ مُسْتَسْلِمُونَ",
      "text_normalized": "بل هم اليوم مستسلمون",
      "aya_indic": "٢٦"
    },
    {
      "sura": 37,
      "aya": 27,
      "text_uthmani": "وَأَقْبَلَ بَعْضُهُمْ عَلَىٰ بَعْضٍ يَتَسَآءَلُونَ",
      "text_normalized": "واقبل بعضهم عليا بعض يتساءلون",
      "aya_indic": "٢٧"
    },
    {
      "sura": 37,
      "aya": 28,
      "text_uthmani": "قَالُوٓا۟ إِنَّكُمْ كُنتُمْ تَأْتُونَنَا عَنِ ٱلْيَمِينِ",
      "text_normalized": "قالوا انكم كنتم تاتوننا عن اليمين",
      "aya_indic": "٢٨"
    },
    {
      "sura": 37,
      "aya": 29,
      "text_uthmani": "قَالُوا۟ بَل لَّمْ تَكُونُوا۟ مُؤْمِنِينَ",
      "text_normalized": "قالوا بل لم تكونوا مومنين",
      "aya_indic": "٢٩"
    },
    {
      "sura": 37,
      "aya": 30,
      "text_uthmani": "وَمَا كَانَ لَنَا عَلَيْكُم مِّن سُلْطَٰنٍۭ ۖ بَلْ كُنتُمْ قَوْمًا طَٰغِينَ",
      "text_normalized": "وما كان لنا عليكم من سلطان بل كنتم قوما طاغين",
      "aya_indic": "٣٠"
    },
    {
      "sura": 37,
      "aya": 31,
      "text_uthmani": "فَحَقَّ عَلَيْنَا قَوْلُ رَبِّنَآ ۖ إِنَّا لَذَآئِقُونَ",
      "text_normalized": "فحق علينا قول ربنا انا لذايقون",
      "aya_indic": "٣١"
    },
    {
      "sura": 37,
      "aya": 32,
      "text_uthmani": "فَأَغْوَيْنَٰكُمْ إِنَّا كُنَّا غَٰوِينَ",
      "text_normalized": "فاغويناكم انا كنا غاوين",
      "aya_indic": "٣٢"
    },
    {
      "sura": 37,
      "aya": 33,
      "text_uthmani": "فَإِنَّهُمْ يَوْمَئِذٍ فِى ٱلْعَذَابِ مُشْتَرِكُونَ",
      "text_normalized": "فانهم يوميذ في العذاب مشتركون",
      "aya_indic": "٣٣"
    },
    {
      "sura": 37,
      "aya": 34,
      "text_uthmani": "إِنَّا كَذَٰلِكَ نَفْعَلُ بِٱلْمُجْرِمِينَ",
      "text_normalized": "انا كذالك نفعل بالمجرمين",
      "aya_indic": "٣٤"
    },
    {
      "sura": 37,
      "aya": 35,
      "text_uthmani": "إِنَّهُمْ كَانُوٓا۟ إِذَا قِيلَ لَهُمْ لَآ إِلَٰهَ إِلَّا ٱللَّهُ يَسْتَكْبِرُونَ",
      "text_normalized": "انهم كانوا اذا قيل لهم لا اله الا الله يستكبرون",
      "aya_indic": "٣٥"
    },
    {
      "sura": 37,
      "aya": 36,
      "text_uthmani": "وَيَقُولُونَ أَئِنَّا لَتَارِكُوٓا۟ ءَالِهَتِنَا لِشَاعِرٍ مَّجْنُونٍۭ",
      "text_normalized": "ويقولون اينا لتاركوا ءالهتنا لشاعر مجنون",
      "aya_indic": "٣٦"
    },
    {
      "sura": 37,
      "aya": 37,
      "text_uthmani": "بَلْ جَآءَ بِٱلْحَقِّ وَصَدَّقَ ٱلْمُرْسَلِينَ",
      "text_normalized": "بل جاء بالحق وصدق المرسلين",
      "aya_indic": "٣٧"
    },
    {
      "sura": 37,
      "aya": 38,
      "text_uthmani": "إِنَّكُمْ لَذَآئِقُوا۟ ٱلْعَذَابِ ٱلْأَلِيمِ",
      "text_normalized": "انكم لذايقوا العذاب الاليم",
      "aya_indic": "٣٨"
    },
    {
      "sura": 37,
      "aya": 39,
      "text_uthmani": "وَمَا تُجْزَوْنَ إِلَّا مَا كُنتُمْ تَعْمَلُونَ",
      "text_normalized": "وما تجزون الا ما كنتم تعملون",
      "aya_indic": "٣٩"
    },
    {
      "sura": 37,
      "aya": 40,
      "text_uthmani": "إِلَّا عِبَادَ ٱللَّهِ ٱلْمُخْلَصِينَ",
      "text_normalized": "الا عباد الله المخلصين",
      "aya_indic": "٤٠"
    },
    {
      "sura": 37,
      "aya": 41,
      "text_uthmani": "أُو۟لَٰٓئِكَ لَهُمْ رِزْقٌ مَّعْلُومٌ",
      "text_normalized": "اولايك لهم رزق معلوم",
      "aya_indic": "٤١"
    },
    {
      "sura": 37,
      "aya": 42,
      "text_uthmani": "فَوَٰكِهُ ۖ وَهُم مُّكْرَمُونَ",
      "text_normalized": "فواكه وهم مكرمون",
      "aya_indic": "٤٢"
    },
    {
      "sura": 37,
      "aya": 43,
      "text_uthmani": "فِى جَنَّٰتِ ٱلنَّعِيمِ",
      "text_normalized": "في جنات النعيم",
      "aya_indic": "٤٣"
    },
    {
      "sura": 37,
      "aya": 44,
      "text_uthmani": "عَلَىٰ سُرُرٍ مُّتَقَٰبِلِينَ",
      "text_normalized": "عليا سرر متقابلين",
      "aya_indic": "٤٤"
    },
    {
      "sura": 37,
      "aya": 45,
      "text_uthmani": "يُطَافُ عَلَيْهِم بِكَأْسٍ مِّن مَّعِينٍۭ",
      "text_normalized": "يطاف عليهم بكاس من معين",
      "aya_indic": "٤٥"
    },
    {
      "sura": 37,
      "aya": 46,
      "text_uthmani": "بَيْضَآءَ لَذَّةٍ لِّلشَّٰرِبِينَ",
      "text_normalized": "بيضاء لذه للشاربين",
      "aya_indic": "٤٦"
    },
    {
      "sura": 37,
      "aya": 47,
      "text_uthmani": "لَا فِيهَا غَوْلٌ وَلَا هُمْ عَنْهَا يُنزَفُونَ",
      "text_normalized": "لا فيها غول ولا هم عنها ينزفون",
      "aya_indic": "٤٧"
    },
    {
      "sura": 37,
      "aya": 48,
      "text_uthmani": "وَعِندَهُمْ قَٰصِرَٰتُ ٱلطَّرْفِ عِينٌ",
      "text_normalized": "وعندهم قاصرات الطرف عين",
      "aya_indic": "٤٨"
    },
    {
      "sura": 37,
      "aya": 49,
      "text_uthmani": "كَأَنَّهُنَّ بَيْضٌ مَّكْنُونٌ",
      "text_normalized": "كانهن بيض مكنون",
      "aya_indic": "٤٩"
    },
    {
      "sura": 37,
      "aya": 50,
      "text_uthmani": "فَأَقْبَلَ بَعْضُهُمْ عَلَىٰ بَعْضٍ يَتَسَآءَلُونَ",
      "text_normalized": "فاقبل بعضهم عليا بعض يتساءلون",
      "aya_indic": "٥٠"
    },
    {
      "sura": 37,
      "aya": 51,
      "text_uthmani": "قَالَ قَآئِلٌ مِّنْهُمْ إِنِّى كَانَ لِى قَرِينٌ",
      "text_normalized": "قال قايل منهم اني كان لي قرين",
      "aya_indic": "٥١"
    },
    {
      "sura": 37,
      "aya": 52,
      "text_uthmani": "يَقُولُ أَءِنَّكَ لَمِنَ ٱلْمُصَدِّقِينَ",
      "text_normalized": "يقول اءنك لمن المصدقين",
      "aya_indic": "٥٢"
    },
    {
      "sura": 37,
      "aya": 53,
      "text_uthmani": "أَءِذَا مِتْنَا وَكُنَّا تُرَابًا وَعِظَٰمًا أَءِنَّا لَمَدِينُونَ",
      "text_normalized": "اءذا متنا وكنا ترابا وعظاما اءنا لمدينون",
      "aya_indic": "٥٣"
    },
    {
      "sura": 37,
      "aya": 54,
      "text_uthmani": "قَالَ هَلْ أَنتُم مُّطَّلِعُونَ",
      "text_normalized": "قال هل انتم مطلعون",
      "aya_indic": "٥٤"
    },
    {
      "sura": 37,
      "aya": 55,
      "text_uthmani": "فَٱطَّلَعَ فَرَءَاهُ فِى سَوَآءِ ٱلْجَحِيمِ",
      "text_normalized": "فاطلع فرءاه في سواء الجحيم",
      "aya_indic": "٥٥"
    },
    {
      "sura": 37,
      "aya": 56,
      "text_uthmani": "قَالَ تَٱللَّهِ إِن كِدتَّ لَتُرْدِينِ",
      "text_normalized": "قال تالله ان كدت لتردين",
      "aya_indic": "٥٦"
    },
    {
      "sura": 37,
      "aya": 57,
      "text_uthmani": "وَلَوْلَا نِعْمَةُ رَبِّى لَكُنتُ مِنَ ٱلْمُحْضَرِينَ",
      "text_normalized": "ولولا نعمه ربي لكنت من المحضرين",
      "aya_indic": "٥٧"
    },
    {
      "sura": 37,
      "aya": 58,
      "text_uthmani": "أَفَمَا نَحْنُ بِمَيِّتِينَ",
      "text_normalized": "افما نحن بميتين",
      "aya_indic": "٥٨"
    },
    {
      "sura": 37,
      "aya": 59,
      "text_uthmani": "إِلَّا مَوْتَتَنَا ٱلْأُولَىٰ وَمَا نَحْنُ بِمُعَذَّبِينَ",
