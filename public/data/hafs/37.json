      "text_uthmani": "وَهَدَيْنَٰهُمَا ٱلصِّرَٰطَ ٱلْمُسْتَقِيمَ",
      "text_normalized": "وهديناهما الصراط المستقيم",
      "aya_indic": "١١٨"
    },
    {
      "sura": 37,
      "aya": 119,
      "text_uthmani": "وَتَرَكْنَا عَلَيْهِمَا فِى ٱلْـَٔاخِرِينَ",
      "text_normalized": "وتركنا عليهما في الاخرين",
      "aya_indic": "١١٩"
    },
    {
      "sura": 37,
      "aya": 120,
      "text_uthmani": "سَلَٰمٌ عَلَىٰ مُوسَىٰ وَهَٰرُونَ",
