      "aya_indic": "١٤١"
    },
    {
      "sura": 37,
      "aya": 142,
      "text_uthmani": "فَٱلْتَقَمَهُ ٱلْحُوتُ وَهُوَ مُلِيمٌ",
      "text_normalized": "فالتقمه الحوت وهو مليم",
      "aya_indic": "١٤٢"
    },
    {
      "sura": 37,
      "aya": 143,
      "text_uthmani": "فَلَوْلَآ أَنَّهُۥ كَانَ مِنَ ٱلْمُسَبِّحِينَ",
      "text_normalized": "فلولا انه كان من المسبحين",
      "aya_indic": "١٤٣"
    },
    {
      "sura": 37,
      "aya": 144,
      "text_uthmani": "لَلَبِثَ فِى بَطْنِهِۦٓ إِلَىٰ يَوْمِ يُبْعَثُونَ",
      "text_normalized": "للبث في بطنه اليا يوم يبعثون",
      "aya_indic": "١٤٤"
    },
    {
      "sura": 37,
      "aya": 145,
      "text_uthmani": "فَنَبَذْنَٰهُ بِٱلْعَرَآءِ وَهُوَ سَقِيمٌ",
