      "aya_indic": "١٢٧"
    },
    {
      "sura": 37,
      "aya": 128,
      "text_uthmani": "إِلَّا عِبَادَ ٱللَّهِ ٱلْمُخْلَصِينَ",
      "text_normalized": "الا عباد الله المخلصين",
      "aya_indic": "١٢٨"
    },
    {
      "sura": 37,
      "aya": 129,
      "text_uthmani": "وَتَرَكْنَا عَلَيْهِ فِى ٱلْـَٔاخِرِينَ",
      "text_normalized": "وتركنا عليه في الاخرين",
      "aya_indic": "١٢٩"
    },
    {
      "sura": 37,
      "aya": 130,
      "text_uthmani": "سَلَٰمٌ عَلَىٰٓ إِلْ يَاسِينَ",
      "text_normalized": "سلام عليا ال ياسين",
      "aya_indic": "١٣٠"
    },
    {
      "sura": 37,
      "aya": 131,
      "text_uthmani": "إِنَّا كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ",
      "text_normalized": "انا كذالك نجزي المحسنين",
      "aya_indic": "١٣١"
    },
    {
      "sura": 37,
      "aya": 132,
      "text_uthmani": "إِنَّهُۥ مِنْ عِبَادِنَا ٱلْمُؤْمِنِينَ",
