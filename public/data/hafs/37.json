      "aya_indic": "١٦٥"
    },
    {
      "sura": 37,
      "aya": 166,
      "text_uthmani": "وَإِنَّا لَنَحْنُ ٱلْمُسَبِّحُونَ",
      "text_normalized": "وانا لنحن المسبحون",
      "aya_indic": "١٦٦"
    },
    {
      "sura": 37,
      "aya": 167,
      "text_uthmani": "وَإِن كَانُوا۟ لَيَقُولُونَ",
