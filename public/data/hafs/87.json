{
  "id": 87,
  "name_ar": "الأعلى",
  "name_en": "Al-A'la",
  "type": "مكية",
  "ayahs_hafs": 19,
  "ayahs_warsh": 19,
  "page": 591,
  "narration": "hafs",
  "narration_ar": "حفص عن عاصم",
  "ayahs": [
    {
      "sura": 87,
      "aya": 1,
      "text_uthmani": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ سَبِّحِ ٱسْمَ رَبِّكَ ٱلْأَعْلَى",
      "text_normalized": "بسم الله الرحمن الرحيم سبح اسم ربك الاعلي",
      "aya_indic": "١"
    },
    {
      "sura": 87,
      "aya": 2,
      "text_uthmani": "ٱلَّذِى خَلَقَ فَسَوَّىٰ",
      "text_normalized": "الذي خلق فسويا",
      "aya_indic": "٢"
    },
    {
      "sura": 87,
      "aya": 3,
      "text_uthmani": "وَٱلَّذِى قَدَّرَ فَهَدَىٰ",
      "text_normalized": "والذي قدر فهديا",
      "aya_indic": "٣"
    },
    {
      "sura": 87,
      "aya": 4,
      "text_uthmani": "وَٱلَّذِىٓ أَخْرَجَ ٱلْمَرْعَىٰ",
      "text_normalized": "والذي اخرج المرعيا",
      "aya_indic": "٤"
    },
    {
      "sura": 87,
      "aya": 5,
      "text_uthmani": "فَجَعَلَهُۥ غُثَآءً أَحْوَىٰ",
      "text_normalized": "فجعله غثاء احويا",
      "aya_indic": "٥"
    },
    {
      "sura": 87,
      "aya": 6,
      "text_uthmani": "سَنُقْرِئُكَ فَلَا تَنسَىٰٓ",
      "text_normalized": "سنقريك فلا تنسيا",
      "aya_indic": "٦"
    },
    {
      "sura": 87,
      "aya": 7,
      "text_uthmani": "إِلَّا مَا شَآءَ ٱللَّهُ ۚ إِنَّهُۥ يَعْلَمُ ٱلْجَهْرَ وَمَا يَخْفَىٰ",
      "text_normalized": "الا ما شاء الله انه يعلم الجهر وما يخفيا",
      "aya_indic": "٧"
    },
    {
      "sura": 87,
      "aya": 8,
      "text_uthmani": "وَنُيَسِّرُكَ لِلْيُسْرَىٰ",
      "text_normalized": "ونيسرك لليسريا",
      "aya_indic": "٨"
    },
    {
      "sura": 87,
      "aya": 9,
      "text_uthmani": "فَذَكِّرْ إِن نَّفَعَتِ ٱلذِّكْرَىٰ",
      "text_normalized": "فذكر ان نفعت الذكريا",
      "aya_indic": "٩"
    },
    {
      "sura": 87,
      "aya": 10,
      "text_uthmani": "سَيَذَّكَّرُ مَن يَخْشَىٰ",
      "text_normalized": "سيذكر من يخشيا",
      "aya_indic": "١٠"
    },
    {
      "sura": 87,
      "aya": 11,
      "text_uthmani": "وَيَتَجَنَّبُهَا ٱلْأَشْقَى",
      "text_normalized": "ويتجنبها الاشقي",
      "aya_indic": "١١"
    },
    {
      "sura": 87,
      "aya": 12,
      "text_uthmani": "ٱلَّذِى يَصْلَى ٱلنَّارَ ٱلْكُبْرَىٰ",
      "text_normalized": "الذي يصلي النار الكبريا",
      "aya_indic": "١٢"
    },
    {
      "sura": 87,
      "aya": 13,
      "text_uthmani": "ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحْيَىٰ",
      "text_normalized": "ثم لا يموت فيها ولا يحييا",
      "aya_indic": "١٣"
    },
    {
      "sura": 87,
      "aya": 14,
      "text_uthmani": "قَدْ أَفْلَحَ مَن تَزَكَّىٰ",
      "text_normalized": "قد افلح من تزكيا",
      "aya_indic": "١٤"
    },
    {
      "sura": 87,
      "aya": 15,
      "text_uthmani": "وَذَكَرَ ٱسْمَ رَبِّهِۦ فَصَلَّىٰ",
      "text_normalized": "وذكر اسم ربه فصليا",
      "aya_indic": "١٥"
    },
    {
      "sura": 87,
      "aya": 16,
      "text_uthmani": "بَلْ تُؤْثِرُونَ ٱلْحَيَوٰةَ ٱلدُّنْيَا",
      "text_normalized": "بل توثرون الحياه الدنيا",
      "aya_indic": "١٦"
    },
    {
      "sura": 87,
      "aya": 17,
      "text_uthmani": "وَٱلْـَٔاخِرَةُ خَيْرٌ وَأَبْقَىٰٓ",
      "text_normalized": "والاخره خير وابقيا",
      "aya_indic": "١٧"
    },
    {
      "sura": 87,
      "aya": 18,
      "text_uthmani": "إِنَّ هَٰذَا لَفِى ٱلصُّحُفِ ٱلْأُولَىٰ",
      "text_normalized": "ان هذا لفي الصحف الاوليا",
      "aya_indic": "١٨"
    },
    {
      "sura": 87,
      "aya": 19,
      "text_uthmani": "صُحُفِ إِبْرَٰهِيمَ وَمُوسَىٰ",
      "text_normalized": "صحف ابراهيم وموسيا",
      "aya_indic": "١٩"
    }
  ]
}