{
  "id": 78,
  "name_ar": "النبأ",
  "name_en": "An-Naba'",
  "type": "مكية",
  "ayahs_hafs": 40,
  "ayahs_warsh": 41,
  "page": 582,
  "narration": "hafs",
  "narration_ar": "حفص عن عاصم",
  "ayahs": [
    {
      "sura": 78,
      "aya": 1,
      "text_uthmani": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ عَمَّ يَتَسَآءَلُونَ",
      "text_normalized": "بسم الله الرحمن الرحيم عم يتساءلون",
      "aya_indic": "١"
    },
    {
      "sura": 78,
      "aya": 2,
      "text_uthmani": "عَنِ ٱلنَّبَإِ ٱلْعَظِيمِ",
      "text_normalized": "عن النبا العظيم",
      "aya_indic": "٢"
    },
    {
      "sura": 78,
      "aya": 3,
      "text_uthmani": "ٱلَّذِى هُمْ فِيهِ مُخْتَلِفُونَ",
      "text_normalized": "الذي هم فيه مختلفون",
      "aya_indic": "٣"
    },
    {
      "sura": 78,
      "aya": 4,
      "text_uthmani": "كَلَّا سَيَعْلَمُونَ",
      "text_normalized": "كلا سيعلمون",
      "aya_indic": "٤"
    },
    {
      "sura": 78,
      "aya": 5,
      "text_uthmani": "ثُمَّ كَلَّا سَيَعْلَمُونَ",
      "text_normalized": "ثم كلا سيعلمون",
      "aya_indic": "٥"
    },
    {
      "sura": 78,
      "aya": 6,
      "text_uthmani": "أَلَمْ نَجْعَلِ ٱلْأَرْضَ مِهَٰدًا",
      "text_normalized": "الم نجعل الارض مهادا",
      "aya_indic": "٦"
    },
    {
      "sura": 78,
      "aya": 7,
      "text_uthmani": "وَٱلْجِبَالَ أَوْتَادًا",
      "text_normalized": "والجبال اوتادا",
      "aya_indic": "٧"
    },
    {
      "sura": 78,
      "aya": 8,
      "text_uthmani": "وَخَلَقْنَٰكُمْ أَزْوَٰجًا",
      "text_normalized": "وخلقناكم ازواجا",
      "aya_indic": "٨"
    },
    {
      "sura": 78,
      "aya": 9,
      "text_uthmani": "وَجَعَلْنَا نَوْمَكُمْ سُبَاتًا",
      "text_normalized": "وجعلنا نومكم سباتا",
      "aya_indic": "٩"
    },
    {
      "sura": 78,
      "aya": 10,
      "text_uthmani": "وَجَعَلْنَا ٱلَّيْلَ لِبَاسًا",
      "text_normalized": "وجعلنا اليل لباسا",
      "aya_indic": "١٠"
    },
    {
      "sura": 78,
      "aya": 11,
      "text_uthmani": "وَجَعَلْنَا ٱلنَّهَارَ مَعَاشًا",
      "text_normalized": "وجعلنا النهار معاشا",
      "aya_indic": "١١"
    },
    {
      "sura": 78,
      "aya": 12,
      "text_uthmani": "وَبَنَيْنَا فَوْقَكُمْ سَبْعًا شِدَادًا",
      "text_normalized": "وبنينا فوقكم سبعا شدادا",
      "aya_indic": "١٢"
    },
    {
      "sura": 78,
      "aya": 13,
      "text_uthmani": "وَجَعَلْنَا سِرَاجًا وَهَّاجًا",
      "text_normalized": "وجعلنا سراجا وهاجا",
      "aya_indic": "١٣"
    },
    {
      "sura": 78,
      "aya": 14,
      "text_uthmani": "وَأَنزَلْنَا مِنَ ٱلْمُعْصِرَٰتِ مَآءً ثَجَّاجًا",
      "text_normalized": "وانزلنا من المعصرات ماء ثجاجا",
      "aya_indic": "١٤"
    },
    {
      "sura": 78,
      "aya": 15,
      "text_uthmani": "لِّنُخْرِجَ بِهِۦ حَبًّا وَنَبَاتًا",
      "text_normalized": "لنخرج به حبا ونباتا",
      "aya_indic": "١٥"
    },
    {
      "sura": 78,
      "aya": 16,
      "text_uthmani": "وَجَنَّٰتٍ أَلْفَافًا",
      "text_normalized": "وجنات الفافا",
      "aya_indic": "١٦"
    },
    {
      "sura": 78,
      "aya": 17,
      "text_uthmani": "إِنَّ يَوْمَ ٱلْفَصْلِ كَانَ مِيقَٰتًا",
      "text_normalized": "ان يوم الفصل كان ميقاتا",
      "aya_indic": "١٧"
    },
    {
      "sura": 78,
      "aya": 18,
      "text_uthmani": "يَوْمَ يُنفَخُ فِى ٱلصُّورِ فَتَأْتُونَ أَفْوَاجًا",
      "text_normalized": "يوم ينفخ في الصور فتاتون افواجا",
      "aya_indic": "١٨"
    },
    {
      "sura": 78,
      "aya": 19,
      "text_uthmani": "وَفُتِحَتِ ٱلسَّمَآءُ فَكَانَتْ أَبْوَٰبًا",
      "text_normalized": "وفتحت السماء فكانت ابوابا",
      "aya_indic": "١٩"
    },
    {
      "sura": 78,
      "aya": 20,
      "text_uthmani": "وَسُيِّرَتِ ٱلْجِبَالُ فَكَانَتْ سَرَابًا",
      "text_normalized": "وسيرت الجبال فكانت سرابا",
      "aya_indic": "٢٠"
    },
    {
      "sura": 78,
      "aya": 21,
      "text_uthmani": "إِنَّ جَهَنَّمَ كَانَتْ مِرْصَادًا",
      "text_normalized": "ان جهنم كانت مرصادا",
      "aya_indic": "٢١"
    },
    {
      "sura": 78,
      "aya": 22,
      "text_uthmani": "لِّلطَّٰغِينَ مَـَٔابًا",
      "text_normalized": "للطاغين مابا",
      "aya_indic": "٢٢"
    },
    {
      "sura": 78,
      "aya": 23,
      "text_uthmani": "لَّٰبِثِينَ فِيهَآ أَحْقَابًا",
      "text_normalized": "لابثين فيها احقابا",
      "aya_indic": "٢٣"
    },
    {
      "sura": 78,
      "aya": 24,
      "text_uthmani": "لَّا يَذُوقُونَ فِيهَا بَرْدًا وَلَا شَرَابًا",
      "text_normalized": "لا يذوقون فيها بردا ولا شرابا",
      "aya_indic": "٢٤"
    },
    {
      "sura": 78,
      "aya": 25,
      "text_uthmani": "إِلَّا حَمِيمًا وَغَسَّاقًا",
      "text_normalized": "الا حميما وغساقا",
      "aya_indic": "٢٥"
    },
    {
      "sura": 78,
      "aya": 26,
      "text_uthmani": "جَزَآءً وِفَاقًا",
      "text_normalized": "جزاء وفاقا",
      "aya_indic": "٢٦"
    },
    {
      "sura": 78,
      "aya": 27,
      "text_uthmani": "إِنَّهُمْ كَانُوا۟ لَا يَرْجُونَ حِسَابًا",
      "text_normalized": "انهم كانوا لا يرجون حسابا",
      "aya_indic": "٢٧"
    },
    {
      "sura": 78,
      "aya": 28,
      "text_uthmani": "وَكَذَّبُوا۟ بِـَٔايَٰتِنَا كِذَّابًا",
      "text_normalized": "وكذبوا باياتنا كذابا",
      "aya_indic": "٢٨"
    },
    {
      "sura": 78,
      "aya": 29,
      "text_uthmani": "وَكُلَّ شَىْءٍ أَحْصَيْنَٰهُ كِتَٰبًا",
      "text_normalized": "وكل شيء احصيناه كتابا",
      "aya_indic": "٢٩"
    },
    {
      "sura": 78,
      "aya": 30,
      "text_uthmani": "فَذُوقُوا۟ فَلَن نَّزِيدَكُمْ إِلَّا عَذَابًا",
      "text_normalized": "فذوقوا فلن نزيدكم الا عذابا",
      "aya_indic": "٣٠"
    },
    {
      "sura": 78,
      "aya": 31,
      "text_uthmani": "إِنَّ لِلْمُتَّقِينَ مَفَازًا",
      "text_normalized": "ان للمتقين مفازا",
      "aya_indic": "٣١"
    },
    {
      "sura": 78,
      "aya": 32,
      "text_uthmani": "حَدَآئِقَ وَأَعْنَٰبًا",
      "text_normalized": "حدايق واعنابا",
      "aya_indic": "٣٢"
    },
    {
      "sura": 78,
      "aya": 33,
      "text_uthmani": "وَكَوَاعِبَ أَتْرَابًا",
      "text_normalized": "وكواعب اترابا",
      "aya_indic": "٣٣"
    },
    {
      "sura": 78,
      "aya": 34,
      "text_uthmani": "وَكَأْسًا دِهَاقًا",
      "text_normalized": "وكاسا دهاقا",
      "aya_indic": "٣٤"
    },
    {
      "sura": 78,
      "aya": 35,
      "text_uthmani": "لَّا يَسْمَعُونَ فِيهَا لَغْوًا وَلَا كِذَّٰبًا",
      "text_normalized": "لا يسمعون فيها لغوا ولا كذابا",
      "aya_indic": "٣٥"
    },
    {
      "sura": 78,
      "aya": 36,
      "text_uthmani": "جَزَآءً مِّن رَّبِّكَ عَطَآءً حِسَابًا",
      "text_normalized": "جزاء من ربك عطاء حسابا",
      "aya_indic": "٣٦"
    },
    {
      "sura": 78,
      "aya": 37,
      "text_uthmani": "رَّبِّ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ وَمَا بَيْنَهُمَا ٱلرَّحْمَٰنِ ۖ لَا يَمْلِكُونَ مِنْهُ خِطَابًا",
      "text_normalized": "رب السماوات والارض وما بينهما الرحمن لا يملكون منه خطابا",
      "aya_indic": "٣٧"
    },
    {
      "sura": 78,
      "aya": 38,
      "text_uthmani": "يَوْمَ يَقُومُ ٱلرُّوحُ وَٱلْمَلَٰٓئِكَةُ صَفًّا ۖ لَّا يَتَكَلَّمُونَ إِلَّا مَنْ أَذِنَ لَهُ ٱلرَّحْمَٰنُ وَقَالَ صَوَابًا",
      "text_normalized": "يوم يقوم الروح والملايكه صفا لا يتكلمون الا من اذن له الرحمن وقال صوابا",
      "aya_indic": "٣٨"
    },
    {
      "sura": 78,
      "aya": 39,
      "text_uthmani": "ذَٰلِكَ ٱلْيَوْمُ ٱلْحَقُّ ۖ فَمَن شَآءَ ٱتَّخَذَ إِلَىٰ رَبِّهِۦ مَـَٔابًا",
      "text_normalized": "ذلك اليوم الحق فمن شاء اتخذ اليا ربه مابا",
      "aya_indic": "٣٩"
    },
    {
      "sura": 78,
      "aya": 40,
      "text_uthmani": "إِنَّآ أَنذَرْنَٰكُمْ عَذَابًا قَرِيبًا يَوْمَ يَنظُرُ ٱلْمَرْءُ مَا قَدَّمَتْ يَدَاهُ وَيَقُولُ ٱلْكَافِرُ يَٰلَيْتَنِى كُنتُ تُرَٰبًۢا",
      "text_normalized": "انا انذرناكم عذابا قريبا يوم ينظر المرء ما قدمت يداه ويقول الكافر ياليتني كنت ترابا",
      "aya_indic": "٤٠"
    }
  ]
}