{
  "id": 88,
  "name_ar": "الغاشية",
  "name_en": "Al-Ghashiyah",
  "type": "مكية",
  "ayahs_hafs": 26,
  "ayahs_warsh": 26,
  "page": 592,
  "narration": "hafs",
  "narration_ar": "حفص عن عاصم",
  "ayahs": [
    {
      "sura": 88,
      "aya": 1,
      "text_uthmani": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ هَلْ أَتَىٰكَ حَدِيثُ ٱلْغَٰشِيَةِ",
      "text_normalized": "بسم الله الرحمن الرحيم هل اتياك حديث الغاشيه",
      "aya_indic": "١"
    },
    {
      "sura": 88,
      "aya": 2,
      "text_uthmani": "وُجُوهٌ يَوْمَئِذٍ خَٰشِعَةٌ",
      "text_normalized": "وجوه يوميذ خاشعه",
      "aya_indic": "٢"
    },
    {
      "sura": 88,
      "aya": 3,
      "text_uthmani": "عَامِلَةٌ نَّاصِبَةٌ",
      "text_normalized": "عامله ناصبه",
      "aya_indic": "٣"
    },
    {
      "sura": 88,
      "aya": 4,
      "text_uthmani": "تَصْلَىٰ نَارًا حَامِيَةً",
      "text_normalized": "تصليا نارا حاميه",
      "aya_indic": "٤"
    },
    {
      "sura": 88,
      "aya": 5,
      "text_uthmani": "تُسْقَىٰ مِنْ عَيْنٍ ءَانِيَةٍ",
      "text_normalized": "تسقيا من عين ءانيه",
      "aya_indic": "٥"
    },
    {
      "sura": 88,
      "aya": 6,
      "text_uthmani": "لَّيْسَ لَهُمْ طَعَامٌ إِلَّا مِن ضَرِيعٍ",
      "text_normalized": "ليس لهم طعام الا من ضريع",
      "aya_indic": "٦"
    },
    {
      "sura": 88,
      "aya": 7,
      "text_uthmani": "لَّا يُسْمِنُ وَلَا يُغْنِى مِن جُوعٍ",
      "text_normalized": "لا يسمن ولا يغني من جوع",
      "aya_indic": "٧"
    },
    {
      "sura": 88,
      "aya": 8,
      "text_uthmani": "وُجُوهٌ يَوْمَئِذٍ نَّاعِمَةٌ",
      "text_normalized": "وجوه يوميذ ناعمه",
      "aya_indic": "٨"
    },
    {
      "sura": 88,
      "aya": 9,
      "text_uthmani": "لِّسَعْيِهَا رَاضِيَةٌ",
      "text_normalized": "لسعيها راضيه",
      "aya_indic": "٩"
    },
    {
      "sura": 88,
      "aya": 10,
      "text_uthmani": "فِى جَنَّةٍ عَالِيَةٍ",
      "text_normalized": "في جنه عاليه",
      "aya_indic": "١٠"
    },
    {
      "sura": 88,
      "aya": 11,
      "text_uthmani": "لَّا تَسْمَعُ فِيهَا لَٰغِيَةً",
      "text_normalized": "لا تسمع فيها لاغيه",
      "aya_indic": "١١"
    },
    {
      "sura": 88,
      "aya": 12,
      "text_uthmani": "فِيهَا عَيْنٌ جَارِيَةٌ",
      "text_normalized": "فيها عين جاريه",
      "aya_indic": "١٢"
    },
    {
      "sura": 88,
      "aya": 13,
      "text_uthmani": "فِيهَا سُرُرٌ مَّرْفُوعَةٌ",
      "text_normalized": "فيها سرر مرفوعه",
      "aya_indic": "١٣"
    },
    {
      "sura": 88,
      "aya": 14,
      "text_uthmani": "وَأَكْوَابٌ مَّوْضُوعَةٌ",
      "text_normalized": "واكواب موضوعه",
      "aya_indic": "١٤"
    },
    {
      "sura": 88,
      "aya": 15,
      "text_uthmani": "وَنَمَارِقُ مَصْفُوفَةٌ",
      "text_normalized": "ونمارق مصفوفه",
      "aya_indic": "١٥"
    },
    {
      "sura": 88,
      "aya": 16,
      "text_uthmani": "وَزَرَابِىُّ مَبْثُوثَةٌ",
      "text_normalized": "وزرابي مبثوثه",
      "aya_indic": "١٦"
    },
    {
      "sura": 88,
      "aya": 17,
      "text_uthmani": "أَفَلَا يَنظُرُونَ إِلَى ٱلْإِبِلِ كَيْفَ خُلِقَتْ",
      "text_normalized": "افلا ينظرون الي الابل كيف خلقت",
      "aya_indic": "١٧"
    },
    {
      "sura": 88,
      "aya": 18,
      "text_uthmani": "وَإِلَى ٱلسَّمَآءِ كَيْفَ رُفِعَتْ",
      "text_normalized": "والي السماء كيف رفعت",
      "aya_indic": "١٨"
    },
    {
      "sura": 88,
      "aya": 19,
      "text_uthmani": "وَإِلَى ٱلْجِبَالِ كَيْفَ نُصِبَتْ",
      "text_normalized": "والي الجبال كيف نصبت",
      "aya_indic": "١٩"
    },
    {
      "sura": 88,
      "aya": 20,
      "text_uthmani": "وَإِلَى ٱلْأَرْضِ كَيْفَ سُطِحَتْ",
      "text_normalized": "والي الارض كيف سطحت",
      "aya_indic": "٢٠"
    },
    {
      "sura": 88,
      "aya": 21,
      "text_uthmani": "فَذَكِّرْ إِنَّمَآ أَنتَ مُذَكِّرٌ",
      "text_normalized": "فذكر انما انت مذكر",
      "aya_indic": "٢١"
    },
    {
      "sura": 88,
      "aya": 22,
      "text_uthmani": "لَّسْتَ عَلَيْهِم بِمُصَيْطِرٍ",
      "text_normalized": "لست عليهم بمصيطر",
      "aya_indic": "٢٢"
    },
    {
      "sura": 88,
      "aya": 23,
      "text_uthmani": "إِلَّا مَن تَوَلَّىٰ وَكَفَرَ",
      "text_normalized": "الا من توليا وكفر",
      "aya_indic": "٢٣"
    },
    {
      "sura": 88,
      "aya": 24,
      "text_uthmani": "فَيُعَذِّبُهُ ٱللَّهُ ٱلْعَذَابَ ٱلْأَكْبَرَ",
      "text_normalized": "فيعذبه الله العذاب الاكبر",
      "aya_indic": "٢٤"
    },
    {
      "sura": 88,
      "aya": 25,
      "text_uthmani": "إِنَّ إِلَيْنَآ إِيَابَهُمْ",
      "text_normalized": "ان الينا ايابهم",
      "aya_indic": "٢٥"
    },
    {
      "sura": 88,
      "aya": 26,
      "text_uthmani": "ثُمَّ إِنَّ عَلَيْنَا حِسَابَهُم",
      "text_normalized": "ثم ان علينا حسابهم",
      "aya_indic": "٢٦"
    }
  ]
}