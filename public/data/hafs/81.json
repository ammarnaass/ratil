{
  "id": 81,
  "name_ar": "التكوير",
  "name_en": "At-Takwir",
  "type": "مكية",
  "ayahs_hafs": 29,
  "ayahs_warsh": 29,
  "page": 586,
  "narration": "hafs",
  "narration_ar": "حفص عن عاصم",
  "ayahs": [
    {
      "sura": 81,
      "aya": 1,
      "text_uthmani": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِذَا ٱلشَّمْسُ كُوِّرَتْ",
      "text_normalized": "بسم الله الرحمن الرحيم اذا الشمس كورت",
      "aya_indic": "١"
    },
    {
      "sura": 81,
      "aya": 2,
      "text_uthmani": "وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتْ",
      "text_normalized": "واذا النجوم انكدرت",
      "aya_indic": "٢"
    },
    {
      "sura": 81,
      "aya": 3,
      "text_uthmani": "وَإِذَا ٱلْجِبَالُ سُيِّرَتْ",
      "text_normalized": "واذا الجبال سيرت",
      "aya_indic": "٣"
    },
    {
      "sura": 81,
      "aya": 4,
      "text_uthmani": "وَإِذَا ٱلْعِشَارُ عُطِّلَتْ",
      "text_normalized": "واذا العشار عطلت",
      "aya_indic": "٤"
    },
    {
      "sura": 81,
      "aya": 5,
      "text_uthmani": "وَإِذَا ٱلْوُحُوشُ حُشِرَتْ",
      "text_normalized": "واذا الوحوش حشرت",
      "aya_indic": "٥"
    },
    {
      "sura": 81,
      "aya": 6,
      "text_uthmani": "وَإِذَا ٱلْبِحَارُ سُجِّرَتْ",
      "text_normalized": "واذا البحار سجرت",
      "aya_indic": "٦"
    },
    {
      "sura": 81,
      "aya": 7,
      "text_uthmani": "وَإِذَا ٱلنُّفُوسُ زُوِّجَتْ",
      "text_normalized": "واذا النفوس زوجت",
      "aya_indic": "٧"
    },
    {
      "sura": 81,
      "aya": 8,
      "text_uthmani": "وَإِذَا ٱلْمَوْءُۥدَةُ سُئِلَتْ",
      "text_normalized": "واذا الموءده سيلت",
      "aya_indic": "٨"
    },
    {
      "sura": 81,
      "aya": 9,
      "text_uthmani": "بِأَىِّ ذَنۢبٍ قُتِلَتْ",
      "text_normalized": "باي ذنب قتلت",
      "aya_indic": "٩"
    },
    {
      "sura": 81,
      "aya": 10,
      "text_uthmani": "وَإِذَا ٱلصُّحُفُ نُشِرَتْ",
      "text_normalized": "واذا الصحف نشرت",
      "aya_indic": "١٠"
    },
    {
      "sura": 81,
      "aya": 11,
      "text_uthmani": "وَإِذَا ٱلسَّمَآءُ كُشِطَتْ",
      "text_normalized": "واذا السماء كشطت",
      "aya_indic": "١١"
    },
    {
      "sura": 81,
      "aya": 12,
      "text_uthmani": "وَإِذَا ٱلْجَحِيمُ سُعِّرَتْ",
      "text_normalized": "واذا الجحيم سعرت",
      "aya_indic": "١٢"
    },
    {
      "sura": 81,
      "aya": 13,
      "text_uthmani": "وَإِذَا ٱلْجَنَّةُ أُزْلِفَتْ",
      "text_normalized": "واذا الجنه ازلفت",
      "aya_indic": "١٣"
    },
    {
      "sura": 81,
      "aya": 14,
      "text_uthmani": "عَلِمَتْ نَفْسٌ مَّآ أَحْضَرَتْ",
      "text_normalized": "علمت نفس ما احضرت",
      "aya_indic": "١٤"
    },
    {
      "sura": 81,
      "aya": 15,
      "text_uthmani": "فَلَآ أُقْسِمُ بِٱلْخُنَّسِ",
      "text_normalized": "فلا اقسم بالخنس",
      "aya_indic": "١٥"
    },
    {
      "sura": 81,
      "aya": 16,
      "text_uthmani": "ٱلْجَوَارِ ٱلْكُنَّسِ",
      "text_normalized": "الجوار الكنس",
      "aya_indic": "١٦"
    },
    {
      "sura": 81,
      "aya": 17,
      "text_uthmani": "وَٱلَّيْلِ إِذَا عَسْعَسَ",
      "text_normalized": "واليل اذا عسعس",
      "aya_indic": "١٧"
    },
    {
      "sura": 81,
      "aya": 18,
      "text_uthmani": "وَٱلصُّبْحِ إِذَا تَنَفَّسَ",
      "text_normalized": "والصبح اذا تنفس",
      "aya_indic": "١٨"
    },
    {
      "sura": 81,
      "aya": 19,
      "text_uthmani": "إِنَّهُۥ لَقَوْلُ رَسُولٍ كَرِيمٍ",
      "text_normalized": "انه لقول رسول كريم",
      "aya_indic": "١٩"
    },
    {
      "sura": 81,
      "aya": 20,
      "text_uthmani": "ذِى قُوَّةٍ عِندَ ذِى ٱلْعَرْشِ مَكِينٍ",
      "text_normalized": "ذي قوه عند ذي العرش مكين",
      "aya_indic": "٢٠"
    },
    {
      "sura": 81,
      "aya": 21,
      "text_uthmani": "مُّطَاعٍ ثَمَّ أَمِينٍ",
      "text_normalized": "مطاع ثم امين",
      "aya_indic": "٢١"
    },
    {
      "sura": 81,
      "aya": 22,
      "text_uthmani": "وَمَا صَاحِبُكُم بِمَجْنُونٍ",
      "text_normalized": "وما صاحبكم بمجنون",
      "aya_indic": "٢٢"
    },
    {
      "sura": 81,
      "aya": 23,
      "text_uthmani": "وَلَقَدْ رَءَاهُ بِٱلْأُفُقِ ٱلْمُبِينِ",
      "text_normalized": "ولقد رءاه بالافق المبين",
      "aya_indic": "٢٣"
    },
    {
      "sura": 81,
      "aya": 24,
      "text_uthmani": "وَمَا هُوَ عَلَى ٱلْغَيْبِ بِضَنِينٍ",
      "text_normalized": "وما هو علي الغيب بضنين",
      "aya_indic": "٢٤"
    },
    {
      "sura": 81,
      "aya": 25,
      "text_uthmani": "وَمَا هُوَ بِقَوْلِ شَيْطَٰنٍ رَّجِيمٍ",
      "text_normalized": "وما هو بقول شيطان رجيم",
      "aya_indic": "٢٥"
    },
    {
      "sura": 81,
      "aya": 26,
      "text_uthmani": "فَأَيْنَ تَذْهَبُونَ",
      "text_normalized": "فاين تذهبون",
      "aya_indic": "٢٦"
    },
    {
      "sura": 81,
      "aya": 27,
      "text_uthmani": "إِنْ هُوَ إِلَّا ذِكْرٌ لِّلْعَٰلَمِينَ",
      "text_normalized": "ان هو الا ذكر للعالمين",
      "aya_indic": "٢٧"
    },
    {
      "sura": 81,
      "aya": 28,
      "text_uthmani": "لِمَن شَآءَ مِنكُمْ أَن يَسْتَقِيمَ",
      "text_normalized": "لمن شاء منكم ان يستقيم",
      "aya_indic": "٢٨"
    },
    {
      "sura": 81,
      "aya": 29,
      "text_uthmani": "وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلْعَٰلَمِينَ",
      "text_normalized": "وما تشاءون الا ان يشاء الله رب العالمين",
      "aya_indic": "٢٩"
    }
  ]
}