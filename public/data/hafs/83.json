{
  "id": 83,
  "name_ar": "المطففين",
  "name_en": "Al-Mutaffifin",
  "type": "مكية",
  "ayahs_hafs": 36,
  "ayahs_warsh": 36,
  "page": 587,
  "narration": "hafs",
  "narration_ar": "حفص عن عاصم",
  "ayahs": [
    {
      "sura": 83,
      "aya": 1,
      "text_uthmani": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَيْلٌ لِّلْمُطَفِّفِينَ",
      "text_normalized": "بسم الله الرحمن الرحيم ويل للمطففين",
      "aya_indic": "١"
    },
    {
      "sura": 83,
      "aya": 2,
      "text_uthmani": "ٱلَّذِينَ إِذَا ٱكْتَالُوا۟ عَلَى ٱلنَّاسِ يَسْتَوْفُونَ",
      "text_normalized": "الذين اذا اكتالوا علي الناس يستوفون",
      "aya_indic": "٢"
    },
    {
      "sura": 83,
      "aya": 3,
      "text_uthmani": "وَإِذَا كَالُوهُمْ أَو وَّزَنُوهُمْ يُخْسِرُونَ",
      "text_normalized": "واذا كالوهم او وزنوهم يخسرون",
      "aya_indic": "٣"
    },
    {
      "sura": 83,
      "aya": 4,
      "text_uthmani": "أَلَا يَظُنُّ أُو۟لَٰٓئِكَ أَنَّهُم مَّبْعُوثُونَ",
      "text_normalized": "الا يظن اولايك انهم مبعوثون",
      "aya_indic": "٤"
    },
    {
      "sura": 83,
      "aya": 5,
      "text_uthmani": "لِيَوْمٍ عَظِيمٍ",
      "text_normalized": "ليوم عظيم",
      "aya_indic": "٥"
    },
    {
      "sura": 83,
      "aya": 6,
      "text_uthmani": "يَوْمَ يَقُومُ ٱلنَّاسُ لِرَبِّ ٱلْعَٰلَمِينَ",
      "text_normalized": "يوم يقوم الناس لرب العالمين",
      "aya_indic": "٦"
    },
    {
      "sura": 83,
      "aya": 7,
      "text_uthmani": "كَلَّآ إِنَّ كِتَٰبَ ٱلْفُجَّارِ لَفِى سِجِّينٍ",
      "text_normalized": "كلا ان كتاب الفجار لفي سجين",
      "aya_indic": "٧"
    },
    {
      "sura": 83,
      "aya": 8,
      "text_uthmani": "وَمَآ أَدْرَىٰكَ مَا سِجِّينٌ",
      "text_normalized": "وما ادرياك ما سجين",
      "aya_indic": "٨"
    },
    {
      "sura": 83,
      "aya": 9,
      "text_uthmani": "كِتَٰبٌ مَّرْقُومٌ",
      "text_normalized": "كتاب مرقوم",
      "aya_indic": "٩"
    },
    {
      "sura": 83,
      "aya": 10,
      "text_uthmani": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
      "text_normalized": "ويل يوميذ للمكذبين",
      "aya_indic": "١٠"
    },
    {
      "sura": 83,
      "aya": 11,
      "text_uthmani": "ٱلَّذِينَ يُكَذِّبُونَ بِيَوْمِ ٱلدِّينِ",
      "text_normalized": "الذين يكذبون بيوم الدين",
      "aya_indic": "١١"
    },
    {
      "sura": 83,
      "aya": 12,
      "text_uthmani": "وَمَا يُكَذِّبُ بِهِۦٓ إِلَّا كُلُّ مُعْتَدٍ أَثِيمٍ",
      "text_normalized": "وما يكذب به الا كل معتد اثيم",
      "aya_indic": "١٢"
    },
    {
      "sura": 83,
      "aya": 13,
      "text_uthmani": "إِذَا تُتْلَىٰ عَلَيْهِ ءَايَٰتُنَا قَالَ أَسَٰطِيرُ ٱلْأَوَّلِينَ",
      "text_normalized": "اذا تتليا عليه ءاياتنا قال اساطير الاولين",
      "aya_indic": "١٣"
    },
    {
      "sura": 83,
      "aya": 14,
      "text_uthmani": "كَلَّا ۖ بَلْ ۜ رَانَ عَلَىٰ قُلُوبِهِم مَّا كَانُوا۟ يَكْسِبُونَ",
      "text_normalized": "كلا بل ران عليا قلوبهم ما كانوا يكسبون",
      "aya_indic": "١٤"
    },
    {
      "sura": 83,
      "aya": 15,
      "text_uthmani": "كَلَّآ إِنَّهُمْ عَن رَّبِّهِمْ يَوْمَئِذٍ لَّمَحْجُوبُونَ",
      "text_normalized": "كلا انهم عن ربهم يوميذ لمحجوبون",
      "aya_indic": "١٥"
    },
    {
      "sura": 83,
      "aya": 16,
      "text_uthmani": "ثُمَّ إِنَّهُمْ لَصَالُوا۟ ٱلْجَحِيمِ",
      "text_normalized": "ثم انهم لصالوا الجحيم",
      "aya_indic": "١٦"
    },
    {
      "sura": 83,
      "aya": 17,
      "text_uthmani": "ثُمَّ يُقَالُ هَٰذَا ٱلَّذِى كُنتُم بِهِۦ تُكَذِّبُونَ",
      "text_normalized": "ثم يقال هذا الذي كنتم به تكذبون",
      "aya_indic": "١٧"
    },
    {
      "sura": 83,
      "aya": 18,
      "text_uthmani": "كَلَّآ إِنَّ كِتَٰبَ ٱلْأَبْرَارِ لَفِى عِلِّيِّينَ",
      "text_normalized": "كلا ان كتاب الابرار لفي عليين",
      "aya_indic": "١٨"
    },
    {
      "sura": 83,
      "aya": 19,
      "text_uthmani": "وَمَآ أَدْرَىٰكَ مَا عِلِّيُّونَ",
      "text_normalized": "وما ادرياك ما عليون",
      "aya_indic": "١٩"
    },
    {
      "sura": 83,
      "aya": 20,
      "text_uthmani": "كِتَٰبٌ مَّرْقُومٌ",
      "text_normalized": "كتاب مرقوم",
      "aya_indic": "٢٠"
    },
    {
      "sura": 83,
      "aya": 21,
      "text_uthmani": "يَشْهَدُهُ ٱلْمُقَرَّبُونَ",
      "text_normalized": "يشهده المقربون",
      "aya_indic": "٢١"
    },
    {
      "sura": 83,
      "aya": 22,
      "text_uthmani": "إِنَّ ٱلْأَبْرَارَ لَفِى نَعِيمٍ",
      "text_normalized": "ان الابرار لفي نعيم",
      "aya_indic": "٢٢"
    },
    {
      "sura": 83,
      "aya": 23,
      "text_uthmani": "عَلَى ٱلْأَرَآئِكِ يَنظُرُونَ",
      "text_normalized": "علي الارايك ينظرون",
      "aya_indic": "٢٣"
    },
    {
      "sura": 83,
      "aya": 24,
      "text_uthmani": "تَعْرِفُ فِى وُجُوهِهِمْ نَضْرَةَ ٱلنَّعِيمِ",
      "text_normalized": "تعرف في وجوههم نضره النعيم",
      "aya_indic": "٢٤"
    },
    {
      "sura": 83,
      "aya": 25,
      "text_uthmani": "يُسْقَوْنَ مِن رَّحِيقٍ مَّخْتُومٍ",
      "text_normalized": "يسقون من رحيق مختوم",
      "aya_indic": "٢٥"
    },
    {
      "sura": 83,
      "aya": 26,
      "text_uthmani": "خِتَٰمُهُۥ مِسْكٌ ۚ وَفِى ذَٰلِكَ فَلْيَتَنَافَسِ ٱلْمُتَنَٰفِسُونَ",
      "text_normalized": "ختامه مسك وفي ذلك فليتنافس المتنافسون",
      "aya_indic": "٢٦"
    },
    {
      "sura": 83,
      "aya": 27,
      "text_uthmani": "وَمِزَاجُهُۥ مِن تَسْنِيمٍ",
      "text_normalized": "ومزاجه من تسنيم",
      "aya_indic": "٢٧"
    },
    {
      "sura": 83,
      "aya": 28,
      "text_uthmani": "عَيْنًا يَشْرَبُ بِهَا ٱلْمُقَرَّبُونَ",
      "text_normalized": "عينا يشرب بها المقربون",
      "aya_indic": "٢٨"
    },
    {
      "sura": 83,
      "aya": 29,
      "text_uthmani": "إِنَّ ٱلَّذِينَ أَجْرَمُوا۟ كَانُوا۟ مِنَ ٱلَّذِينَ ءَامَنُوا۟ يَضْحَكُونَ",
      "text_normalized": "ان الذين اجرموا كانوا من الذين ءامنوا يضحكون",
      "aya_indic": "٢٩"
    },
    {
      "sura": 83,
      "aya": 30,
      "text_uthmani": "وَإِذَا مَرُّوا۟ بِهِمْ يَتَغَامَزُونَ",
      "text_normalized": "واذا مروا بهم يتغامزون",
      "aya_indic": "٣٠"
    },
    {
      "sura": 83,
      "aya": 31,
      "text_uthmani": "وَإِذَا ٱنقَلَبُوٓا۟ إِلَىٰٓ أَهْلِهِمُ ٱنقَلَبُوا۟ فَكِهِينَ",
      "text_normalized": "واذا انقلبوا اليا اهلهم انقلبوا فكهين",
      "aya_indic": "٣١"
    },
    {
      "sura": 83,
      "aya": 32,
      "text_uthmani": "وَإِذَا رَأَوْهُمْ قَالُوٓا۟ إِنَّ هَٰٓؤُلَآءِ لَضَآلُّونَ",
      "text_normalized": "واذا راوهم قالوا ان هاولاء لضالون",
      "aya_indic": "٣٢"
    },
    {
      "sura": 83,
      "aya": 33,
      "text_uthmani": "وَمَآ أُرْسِلُوا۟ عَلَيْهِمْ حَٰفِظِينَ",
      "text_normalized": "وما ارسلوا عليهم حافظين",
      "aya_indic": "٣٣"
    },
    {
      "sura": 83,
      "aya": 34,
      "text_uthmani": "فَٱلْيَوْمَ ٱلَّذِينَ ءَامَنُوا۟ مِنَ ٱلْكُفَّارِ يَضْحَكُونَ",
      "text_normalized": "فاليوم الذين ءامنوا من الكفار يضحكون",
      "aya_indic": "٣٤"
    },
    {
      "sura": 83,
      "aya": 35,
      "text_uthmani": "عَلَى ٱلْأَرَآئِكِ يَنظُرُونَ",
      "text_normalized": "علي الارايك ينظرون",
      "aya_indic": "٣٥"
    },
    {
      "sura": 83,
      "aya": 36,
      "text_uthmani": "هَلْ ثُوِّبَ ٱلْكُفَّارُ مَا كَانُوا۟ يَفْعَلُونَ",
      "text_normalized": "هل ثوب الكفار ما كانوا يفعلون",
      "aya_indic": "٣٦"
    }
  ]
}