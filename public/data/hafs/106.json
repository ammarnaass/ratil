  "ayahs_warsh": 4,
  "page": 602,
  "narration": "hafs",
  "narration_ar": "حفص عن عاصم",
  "ayahs": [
    {
      "sura": 106,
      "aya": 1,
      "text_uthmani": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ لِإِيلَٰفِ قُرَيْشٍ",
      "text_normalized": "بسم الله الرحمن الرحيم لايلاف قريش",
      "aya_indic": "١"
    },
    {
      "sura": 106,
      "aya": 2,
      "text_uthmani": "إِۦلَٰفِهِمْ رِحْلَةَ ٱلشِّتَآءِ وَٱلصَّيْفِ",
      "text_normalized": "الافهم رحله الشتاء والصيف",
      "aya_indic": "٢"
    },
    {
      "sura": 106,
      "aya": 3,
      "text_uthmani": "فَلْيَعْبُدُوا۟ رَبَّ هَٰذَا ٱلْبَيْتِ",
      "text_normalized": "فليعبدوا رب هذا البيت",
      "aya_indic": "٣"
    },
    {
      "sura": 106,
      "aya": 4,
      "text_uthmani": "ٱلَّذِىٓ أَطْعَمَهُم مِّن جُوعٍ وَءَامَنَهُم مِّنْ خَوْفٍۭ",
      "text_normalized": "الذي اطعمهم من جوع وءامنهم من خوف",
      "aya_indic": "٤"
    }
  ]
}