      "aya_indic": "٥٣"
    },
    {
      "sura": 53,
      "aya": 54,
      "text_uthmani": "فَغَشَّىٰهَا مَا غَشَّىٰ",
      "text_normalized": "فغشياها ما غشيا",
      "aya_indic": "٥٤"
    },
    {
      "sura": 53,
      "aya": 55,
