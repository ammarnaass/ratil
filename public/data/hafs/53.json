  "narration": "hafs",
  "narration_ar": "حفص عن عاصم",
  "ayahs": [
    {
      "sura": 53,
      "aya": 1,
      "text_uthmani": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلنَّجْمِ إِذَا هَوَىٰ",
      "text_normalized": "بسم الله الرحمن الرحيم والنجم اذا هويا",
      "aya_indic": "١"
    },
    {
      "sura": 53,
      "aya": 2,
      "text_uthmani": "مَا ضَلَّ صَاحِبُكُمْ وَمَا غَوَىٰ",
      "text_normalized": "ما ضل صاحبكم وما غويا",
      "aya_indic": "٢"
    },
    {
      "sura": 53,
      "aya": 3,
      "text_uthmani": "وَمَا يَنطِقُ عَنِ ٱلْهَوَىٰٓ",
      "text_normalized": "وما ينطق عن الهويا",
      "aya_indic": "٣"
    },
    {
      "sura": 53,
      "aya": 4,
      "text_uthmani": "إِنْ هُوَ إِلَّا وَحْىٌ يُوحَىٰ",
      "text_normalized": "ان هو الا وحي يوحيا",
      "aya_indic": "٤"
    },
    {
      "sura": 53,
      "aya": 5,
      "text_uthmani": "عَلَّمَهُۥ شَدِيدُ ٱلْقُوَىٰ",
      "text_normalized": "علمه شديد القويا",
      "aya_indic": "٥"
    },
    {
      "sura": 53,
      "aya": 6,
      "text_uthmani": "ذُو مِرَّةٍ فَٱسْتَوَىٰ",
      "text_normalized": "ذو مره فاستويا",
      "aya_indic": "٦"
    },
    {
      "sura": 53,
      "aya": 7,
      "text_uthmani": "وَهُوَ بِٱلْأُفُقِ ٱلْأَعْلَىٰ",
      "text_normalized": "وهو بالافق الاعليا",
      "aya_indic": "٧"
    },
    {
      "sura": 53,
      "aya": 8,
      "text_uthmani": "ثُمَّ دَنَا فَتَدَلَّىٰ",
      "text_normalized": "ثم دنا فتدليا",
      "aya_indic": "٨"
    },
    {
      "sura": 53,
      "aya": 9,
      "text_uthmani": "فَكَانَ قَابَ قَوْسَيْنِ أَوْ أَدْنَىٰ",
      "text_normalized": "فكان قاب قوسين او ادنيا",
      "aya_indic": "٩"
    },
    {
      "sura": 53,
      "aya": 10,
      "text_uthmani": "فَأَوْحَىٰٓ إِلَىٰ عَبْدِهِۦ مَآ أَوْحَىٰ",
      "text_normalized": "فاوحيا اليا عبده ما اوحيا",
      "aya_indic": "١٠"
    },
    {
      "sura": 53,
      "aya": 11,
      "text_uthmani": "مَا كَذَبَ ٱلْفُؤَادُ مَا رَأَىٰٓ",
      "text_normalized": "ما كذب الفواد ما رايا",
      "aya_indic": "١١"
    },
    {
      "sura": 53,
      "aya": 12,
      "text_uthmani": "أَفَتُمَٰرُونَهُۥ عَلَىٰ مَا يَرَىٰ",
      "text_normalized": "افتمارونه عليا ما يريا",
      "aya_indic": "١٢"
    },
    {
      "sura": 53,
      "aya": 13,
      "text_uthmani": "وَلَقَدْ رَءَاهُ نَزْلَةً أُخْرَىٰ",
      "text_normalized": "ولقد رءاه نزله اخريا",
      "aya_indic": "١٣"
    },
    {
      "sura": 53,
      "aya": 14,
      "text_uthmani": "عِندَ سِدْرَةِ ٱلْمُنتَهَىٰ",
      "text_normalized": "عند سدره المنتهيا",
      "aya_indic": "١٤"
    },
    {
      "sura": 53,
      "aya": 15,
      "text_uthmani": "عِندَهَا جَنَّةُ ٱلْمَأْوَىٰٓ",
      "text_normalized": "عندها جنه الماويا",
      "aya_indic": "١٥"
    },
    {
      "sura": 53,
      "aya": 16,
      "text_uthmani": "إِذْ يَغْشَى ٱلسِّدْرَةَ مَا يَغْشَىٰ",
      "text_normalized": "اذ يغشي السدره ما يغشيا",
      "aya_indic": "١٦"
    },
    {
      "sura": 53,
      "aya": 17,
      "text_uthmani": "مَا زَاغَ ٱلْبَصَرُ وَمَا طَغَىٰ",
      "text_normalized": "ما زاغ البصر وما طغيا",
      "aya_indic": "١٧"
    },
    {
      "sura": 53,
      "aya": 18,
      "text_uthmani": "لَقَدْ رَأَىٰ مِنْ ءَايَٰتِ رَبِّهِ ٱلْكُبْرَىٰٓ",
      "text_normalized": "لقد رايا من ءايات ربه الكبريا",
      "aya_indic": "١٨"
    },
    {
      "sura": 53,
      "aya": 19,
      "text_uthmani": "أَفَرَءَيْتُمُ ٱللَّٰتَ وَٱلْعُزَّىٰ",
      "text_normalized": "افرءيتم اللات والعزيا",
      "aya_indic": "١٩"
    },
    {
      "sura": 53,
      "aya": 20,
      "text_uthmani": "وَمَنَوٰةَ ٱلثَّالِثَةَ ٱلْأُخْرَىٰٓ",
      "text_normalized": "ومناه الثالثه الاخريا",
      "aya_indic": "٢٠"
    },
    {
      "sura": 53,
      "aya": 21,
      "text_uthmani": "أَلَكُمُ ٱلذَّكَرُ وَلَهُ ٱلْأُنثَىٰ",
      "text_normalized": "الكم الذكر وله الانثيا",
      "aya_indic": "٢١"
    },
    {
      "sura": 53,
      "aya": 22,
      "text_uthmani": "تِلْكَ إِذًا قِسْمَةٌ ضِيزَىٰٓ",
      "text_normalized": "تلك اذا قسمه ضيزيا",
      "aya_indic": "٢٢"
    },
    {
      "sura": 53,
      "aya": 23,
      "text_uthmani": "إِنْ هِىَ إِلَّآ أَسْمَآءٌ سَمَّيْتُمُوهَآ أَنتُمْ وَءَابَآؤُكُم مَّآ أَنزَلَ ٱللَّهُ بِهَا مِن سُلْطَٰنٍ ۚ إِن يَتَّبِعُونَ إِلَّا ٱلظَّنَّ وَمَا تَهْوَى ٱلْأَنفُسُ ۖ وَلَقَدْ جَآءَهُم مِّن رَّبِّهِمُ ٱلْهُدَىٰٓ",
      "text_normalized": "ان هي الا اسماء سميتموها انتم وءاباوكم ما انزل الله بها من سلطان ان يتبعون الا الظن وما تهوي الانفس ولقد جاءهم من ربهم الهديا",
      "aya_indic": "٢٣"
    },
    {
      "sura": 53,
      "aya": 24,
      "text_uthmani": "أَمْ لِلْإِنسَٰنِ مَا تَمَنَّىٰ",
      "text_normalized": "ام للانسان ما تمنيا",
      "aya_indic": "٢٤"
    },
    {
      "sura": 53,
      "aya": 25,
      "text_uthmani": "فَلِلَّهِ ٱلْـَٔاخِرَةُ وَٱلْأُولَىٰ",
      "text_normalized": "فلله الاخره والاوليا",
      "aya_indic": "٢٥"
    },
    {
      "sura": 53,
      "aya": 26,
      "text_uthmani": "وَكَم مِّن مَّلَكٍ فِى ٱلسَّمَٰوَٰتِ لَا تُغْنِى شَفَٰعَتُهُمْ شَيْـًٔا إِلَّا مِنۢ بَعْدِ أَن يَأْذَنَ ٱللَّهُ لِمَن يَشَآءُ وَيَرْضَىٰٓ",
      "text_normalized": "وكم من ملك في السماوات لا تغني شفاعتهم شيا الا من بعد ان ياذن الله لمن يشاء ويرضيا",
      "aya_indic": "٢٦"
    },
    {
      "sura": 53,
      "aya": 27,
      "text_uthmani": "إِنَّ ٱلَّذِينَ لَا يُؤْمِنُونَ بِٱلْـَٔاخِرَةِ لَيُسَمُّونَ ٱلْمَلَٰٓئِكَةَ تَسْمِيَةَ ٱلْأُنثَىٰ",
      "text_normalized": "ان الذين لا يومنون بالاخره ليسمون الملايكه تسميه الانثيا",
      "aya_indic": "٢٧"
    },
    {
      "sura": 53,
      "aya": 28,
      "text_uthmani": "وَمَا لَهُم بِهِۦ مِنْ عِلْمٍ ۖ إِن يَتَّبِعُونَ إِلَّا ٱلظَّنَّ ۖ وَإِنَّ ٱلظَّنَّ لَا يُغْنِى مِنَ ٱلْحَقِّ شَيْـًٔا",
      "text_normalized": "وما لهم به من علم ان يتبعون الا الظن وان الظن لا يغني من الحق شيا",
      "aya_indic": "٢٨"
    },
    {
      "sura": 53,
      "aya": 29,
      "text_uthmani": "فَأَعْرِضْ عَن مَّن تَوَلَّىٰ عَن ذِكْرِنَا وَلَمْ يُرِدْ إِلَّا ٱلْحَيَوٰةَ ٱلدُّنْيَا",
      "text_normalized": "فاعرض عن من توليا عن ذكرنا ولم يرد الا الحياه الدنيا",
      "aya_indic": "٢٩"
    },
    {
      "sura": 53,
      "aya": 30,
      "text_uthmani": "ذَٰلِكَ مَبْلَغُهُم مِّنَ ٱلْعِلْمِ ۚ إِنَّ رَبَّكَ هُوَ أَعْلَمُ بِمَن ضَلَّ عَن سَبِيلِهِۦ وَهُوَ أَعْلَمُ بِمَنِ ٱهْتَدَىٰ",
      "text_normalized": "ذلك مبلغهم من العلم ان ربك هو اعلم بمن ضل عن سبيله وهو اعلم بمن اهتديا",
      "aya_indic": "٣٠"
    },
    {
      "sura": 53,
      "aya": 31,
      "text_uthmani": "وَلِلَّهِ مَا فِى ٱلسَّمَٰوَٰتِ وَمَا فِى ٱلْأَرْضِ لِيَجْزِىَ ٱلَّذِينَ أَسَٰٓـُٔوا۟ بِمَا عَمِلُوا۟ وَيَجْزِىَ ٱلَّذِينَ أَحْسَنُوا۟ بِٱلْحُسْنَى",
      "text_normalized": "ولله ما في السماوات وما في الارض ليجزي الذين اساوا بما عملوا ويجزي الذين احسنوا بالحسني",
      "aya_indic": "٣١"
    },
    {
      "sura": 53,
      "aya": 32,
      "text_uthmani": "ٱلَّذِينَ يَجْتَنِبُونَ كَبَٰٓئِرَ ٱلْإِثْمِ وَٱلْفَوَٰحِشَ إِلَّا ٱللَّمَمَ ۚ إِنَّ رَبَّكَ وَٰسِعُ ٱلْمَغْفِرَةِ ۚ هُوَ أَعْلَمُ بِكُمْ إِذْ أَنشَأَكُم مِّنَ ٱلْأَرْضِ وَإِذْ أَنتُمْ أَجِنَّةٌ فِى بُطُونِ أُمَّهَٰتِكُمْ ۖ فَلَا تُزَكُّوٓا۟ أَنفُسَكُمْ ۖ هُوَ أَعْلَمُ بِمَنِ ٱتَّقَىٰٓ",
      "text_normalized": "الذين يجتنبون كباير الاثم والفواحش الا اللمم ان ربك واسع المغفره هو اعلم بكم اذ انشاكم من الارض واذ انتم اجنه في بطون امهاتكم فلا تزكوا انفسكم هو اعلم بمن اتقيا",
      "aya_indic": "٣٢"
    },
    {
      "sura": 53,
      "aya": 33,
      "text_uthmani": "أَفَرَءَيْتَ ٱلَّذِى تَوَلَّىٰ",
      "text_normalized": "افرءيت الذي توليا",
      "aya_indic": "٣٣"
    },
    {
      "sura": 53,
      "aya": 34,
      "text_uthmani": "وَأَعْطَىٰ قَلِيلًا وَأَكْدَىٰٓ",
      "text_normalized": "واعطيا قليلا واكديا",
      "aya_indic": "٣٤"
    },
    {
      "sura": 53,
      "aya": 35,
      "text_uthmani": "أَعِندَهُۥ عِلْمُ ٱلْغَيْبِ فَهُوَ يَرَىٰٓ",
      "text_normalized": "اعنده علم الغيب فهو يريا",
      "aya_indic": "٣٥"
    },
    {
      "sura": 53,
      "aya": 36,
      "text_uthmani": "أَمْ لَمْ يُنَبَّأْ بِمَا فِى صُحُفِ مُوسَىٰ",
      "text_normalized": "ام لم ينبا بما في صحف موسيا",
      "aya_indic": "٣٦"
    },
    {
      "sura": 53,
      "aya": 37,
      "text_uthmani": "وَإِبْرَٰهِيمَ ٱلَّذِى وَفَّىٰٓ",
      "text_normalized": "وابراهيم الذي وفيا",
      "aya_indic": "٣٧"
    },
    {
      "sura": 53,
      "aya": 38,
      "text_uthmani": "أَلَّا تَزِرُ وَازِرَةٌ وِزْرَ أُخْرَىٰ",
      "text_normalized": "الا تزر وازره وزر اخريا",
      "aya_indic": "٣٨"
    },
    {
      "sura": 53,
      "aya": 39,
      "text_uthmani": "وَأَن لَّيْسَ لِلْإِنسَٰنِ إِلَّا مَا سَعَىٰ",
      "text_normalized": "وان ليس للانسان الا ما سعيا",
      "aya_indic": "٣٩"
    },
    {
      "sura": 53,
      "aya": 40,
      "text_uthmani": "وَأَنَّ سَعْيَهُۥ سَوْفَ يُرَىٰ",
      "text_normalized": "وان سعيه سوف يريا",
      "aya_indic": "٤٠"
    },
    {
      "sura": 53,
      "aya": 41,
      "text_uthmani": "ثُمَّ يُجْزَىٰهُ ٱلْجَزَآءَ ٱلْأَوْفَىٰ",
      "text_normalized": "ثم يجزياه الجزاء الاوفيا",
      "aya_indic": "٤١"
    },
    {
      "sura": 53,
      "aya": 42,
      "text_uthmani": "وَأَنَّ إِلَىٰ رَبِّكَ ٱلْمُنتَهَىٰ",
      "text_normalized": "وان اليا ربك المنتهيا",
      "aya_indic": "٤٢"
    },
    {
      "sura": 53,
      "aya": 43,
      "text_uthmani": "وَأَنَّهُۥ هُوَ أَضْحَكَ وَأَبْكَىٰ",
      "text_normalized": "وانه هو اضحك وابكيا",
      "aya_indic": "٤٣"
    },
    {
      "sura": 53,
      "aya": 44,
      "text_uthmani": "وَأَنَّهُۥ هُوَ أَمَاتَ وَأَحْيَا",
      "text_normalized": "وانه هو امات واحيا",
      "aya_indic": "٤٤"
    },
    {
      "sura": 53,
      "aya": 45,
      "text_uthmani": "وَأَنَّهُۥ خَلَقَ ٱلزَّوْجَيْنِ ٱلذَّكَرَ وَٱلْأُنثَىٰ",
      "text_normalized": "وانه خلق الزوجين الذكر والانثيا",
      "aya_indic": "٤٥"
    },
    {
      "sura": 53,
      "aya": 46,
      "text_uthmani": "مِن نُّطْفَةٍ إِذَا تُمْنَىٰ",
      "text_normalized": "من نطفه اذا تمنيا",
      "aya_indic": "٤٦"
    },
    {
      "sura": 53,
      "aya": 47,
      "text_uthmani": "وَأَنَّ عَلَيْهِ ٱلنَّشْأَةَ ٱلْأُخْرَىٰ",
      "text_normalized": "وان عليه النشاه الاخريا",
      "aya_indic": "٤٧"
    },
    {
      "sura": 53,
      "aya": 48,
      "text_uthmani": "وَأَنَّهُۥ هُوَ أَغْنَىٰ وَأَقْنَىٰ",
      "text_normalized": "وانه هو اغنيا واقنيا",
      "aya_indic": "٤٨"
    },
    {
      "sura": 53,
      "aya": 49,
      "text_uthmani": "وَأَنَّهُۥ هُوَ رَبُّ ٱلشِّعْرَىٰ",
      "text_normalized": "وانه هو رب الشعريا",
      "aya_indic": "٤٩"
    },
    {
      "sura": 53,
      "aya": 50,
      "text_uthmani": "وَأَنَّهُۥٓ أَهْلَكَ عَادًا ٱلْأُولَىٰ",
      "text_normalized": "وانه اهلك عادا الاوليا",
      "aya_indic": "٥٠"
    },
    {
      "sura": 53,
      "aya": 51,
      "text_uthmani": "وَثَمُودَا۟ فَمَآ أَبْقَىٰ",
      "text_normalized": "وثمودا فما ابقيا",
      "aya_indic": "٥١"
    },
    {
      "sura": 53,
      "aya": 52,
      "text_uthmani": "وَقَوْمَ نُوحٍ مِّن قَبْلُ ۖ إِنَّهُمْ كَانُوا۟ هُمْ أَظْلَمَ وَأَطْغَىٰ",
      "text_normalized": "وقوم نوح من قبل انهم كانوا هم اظلم واطغيا",
      "aya_indic": "٥٢"
    },
    {
      "sura": 53,
      "aya": 53,
      "text_uthmani": "وَٱلْمُؤْتَفِكَةَ أَهْوَىٰ",
