{
  "id": 56,
  "name_ar": "الواقعة",
  "name_en": "Al-Waqi'ah",
  "type": "مكية",
  "ayahs_hafs": 96,
  "ayahs_warsh": 97,
  "page": 534,
  "narration": "hafs",
  "narration_ar": "حفص عن عاصم",
  "ayahs": [
    {
      "sura": 56,
      "aya": 1,
      "text_uthmani": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِذَا وَقَعَتِ ٱلْوَاقِعَةُ",
      "text_normalized": "بسم الله الرحمن الرحيم اذا وقعت الواقعه",
      "aya_indic": "١"
    },
    {
      "sura": 56,
      "aya": 2,
      "text_uthmani": "لَيْسَ لِوَقْعَتِهَا كَاذِبَةٌ",
      "text_normalized": "ليس لوقعتها كاذبه",
      "aya_indic": "٢"
    },
    {
      "sura": 56,
      "aya": 3,
      "text_uthmani": "خَافِضَةٌ رَّافِعَةٌ",
      "text_normalized": "خافضه رافعه",
      "aya_indic": "٣"
    },
    {
      "sura": 56,
      "aya": 4,
      "text_uthmani": "إِذَا رُجَّتِ ٱلْأَرْضُ رَجًّا",
      "text_normalized": "اذا رجت الارض رجا",
      "aya_indic": "٤"
    },
    {
      "sura": 56,
      "aya": 5,
      "text_uthmani": "وَبُسَّتِ ٱلْجِبَالُ بَسًّا",
      "text_normalized": "وبست الجبال بسا",
      "aya_indic": "٥"
    },
    {
      "sura": 56,
      "aya": 6,
      "text_uthmani": "فَكَانَتْ هَبَآءً مُّنۢبَثًّا",
      "text_normalized": "فكانت هباء منبثا",
      "aya_indic": "٦"
    },
    {
      "sura": 56,
      "aya": 7,
      "text_uthmani": "وَكُنتُمْ أَزْوَٰجًا ثَلَٰثَةً",
      "text_normalized": "وكنتم ازواجا ثلاثه",
      "aya_indic": "٧"
    },
    {
      "sura": 56,
      "aya": 8,
      "text_uthmani": "فَأَصْحَٰبُ ٱلْمَيْمَنَةِ مَآ أَصْحَٰبُ ٱلْمَيْمَنَةِ",
      "text_normalized": "فاصحاب الميمنه ما اصحاب الميمنه",
      "aya_indic": "٨"
    },
    {
      "sura": 56,
      "aya": 9,
      "text_uthmani": "وَأَصْحَٰبُ ٱلْمَشْـَٔمَةِ مَآ أَصْحَٰبُ ٱلْمَشْـَٔمَةِ",
      "text_normalized": "واصحاب المشمه ما اصحاب المشمه",
      "aya_indic": "٩"
    },
    {
      "sura": 56,
      "aya": 10,
      "text_uthmani": "وَٱلسَّٰبِقُونَ ٱلسَّٰبِقُونَ",
      "text_normalized": "والسابقون السابقون",
      "aya_indic": "١٠"
    },
    {
      "sura": 56,
      "aya": 11,
      "text_uthmani": "أُو۟لَٰٓئِكَ ٱلْمُقَرَّبُونَ",
      "text_normalized": "اولايك المقربون",
      "aya_indic": "١١"
    },
    {
      "sura": 56,
      "aya": 12,
      "text_uthmani": "فِى جَنَّٰتِ ٱلنَّعِيمِ",
      "text_normalized": "في جنات النعيم",
      "aya_indic": "١٢"
    },
    {
      "sura": 56,
      "aya": 13,
      "text_uthmani": "ثُلَّةٌ مِّنَ ٱلْأَوَّلِينَ",
      "text_normalized": "ثله من الاولين",
      "aya_indic": "١٣"
    },
    {
      "sura": 56,
      "aya": 14,
      "text_uthmani": "وَقَلِيلٌ مِّنَ ٱلْـَٔاخِرِينَ",
      "text_normalized": "وقليل من الاخرين",
      "aya_indic": "١٤"
    },
    {
      "sura": 56,
      "aya": 15,
      "text_uthmani": "عَلَىٰ سُرُرٍ مَّوْضُونَةٍ",
      "text_normalized": "عليا سرر موضونه",
      "aya_indic": "١٥"
    },
    {
      "sura": 56,
      "aya": 16,
      "text_uthmani": "مُّتَّكِـِٔينَ عَلَيْهَا مُتَقَٰبِلِينَ",
      "text_normalized": "متكين عليها متقابلين",
      "aya_indic": "١٦"
    },
    {
      "sura": 56,
      "aya": 17,
      "text_uthmani": "يَطُوفُ عَلَيْهِمْ وِلْدَٰنٌ مُّخَلَّدُونَ",
      "text_normalized": "يطوف عليهم ولدان مخلدون",
      "aya_indic": "١٧"
    },
    {
      "sura": 56,
      "aya": 18,
      "text_uthmani": "بِأَكْوَابٍ وَأَبَارِيقَ وَكَأْسٍ مِّن مَّعِينٍ",
      "text_normalized": "باكواب واباريق وكاس من معين",
      "aya_indic": "١٨"
    },
    {
      "sura": 56,
      "aya": 19,
      "text_uthmani": "لَّا يُصَدَّعُونَ عَنْهَا وَلَا يُنزِفُونَ",
      "text_normalized": "لا يصدعون عنها ولا ينزفون",
      "aya_indic": "١٩"
    },
    {
      "sura": 56,
      "aya": 20,
      "text_uthmani": "وَفَٰكِهَةٍ مِّمَّا يَتَخَيَّرُونَ",
      "text_normalized": "وفاكهه مما يتخيرون",
      "aya_indic": "٢٠"
    },
    {
      "sura": 56,
      "aya": 21,
      "text_uthmani": "وَلَحْمِ طَيْرٍ مِّمَّا يَشْتَهُونَ",
      "text_normalized": "ولحم طير مما يشتهون",
      "aya_indic": "٢١"
    },
    {
      "sura": 56,
      "aya": 22,
      "text_uthmani": "وَحُورٌ عِينٌ",
      "text_normalized": "وحور عين",
      "aya_indic": "٢٢"
    },
    {
      "sura": 56,
      "aya": 23,
      "text_uthmani": "كَأَمْثَٰلِ ٱللُّؤْلُؤِ ٱلْمَكْنُونِ",
      "text_normalized": "كامثال اللولو المكنون",
      "aya_indic": "٢٣"
    },
    {
      "sura": 56,
      "aya": 24,
      "text_uthmani": "جَزَآءًۢ بِمَا كَانُوا۟ يَعْمَلُونَ",
      "text_normalized": "جزاء بما كانوا يعملون",
      "aya_indic": "٢٤"
    },
    {
      "sura": 56,
      "aya": 25,
      "text_uthmani": "لَا يَسْمَعُونَ فِيهَا لَغْوًا وَلَا تَأْثِيمًا",
      "text_normalized": "لا يسمعون فيها لغوا ولا تاثيما",
      "aya_indic": "٢٥"
    },
    {
      "sura": 56,
      "aya": 26,
      "text_uthmani": "إِلَّا قِيلًا سَلَٰمًا سَلَٰمًا",
      "text_normalized": "الا قيلا سلاما سلاما",
      "aya_indic": "٢٦"
    },
    {
      "sura": 56,
      "aya": 27,
      "text_uthmani": "وَأَصْحَٰبُ ٱلْيَمِينِ مَآ أَصْحَٰبُ ٱلْيَمِينِ",
      "text_normalized": "واصحاب اليمين ما اصحاب اليمين",
      "aya_indic": "٢٧"
    },
    {
      "sura": 56,
      "aya": 28,
      "text_uthmani": "فِى سِدْرٍ مَّخْضُودٍ",
      "text_normalized": "في سدر مخضود",
      "aya_indic": "٢٨"
    },
    {
      "sura": 56,
      "aya": 29,
      "text_uthmani": "وَطَلْحٍ مَّنضُودٍ",
      "text_normalized": "وطلح منضود",
      "aya_indic": "٢٩"
    },
    {
      "sura": 56,
      "aya": 30,
      "text_uthmani": "وَظِلٍّ مَّمْدُودٍ",
      "text_normalized": "وظل ممدود",
      "aya_indic": "٣٠"
    },
    {
      "sura": 56,
      "aya": 31,
      "text_uthmani": "وَمَآءٍ مَّسْكُوبٍ",
      "text_normalized": "وماء مسكوب",
      "aya_indic": "٣١"
    },
    {
      "sura": 56,
      "aya": 32,
      "text_uthmani": "وَفَٰكِهَةٍ كَثِيرَةٍ",
      "text_normalized": "وفاكهه كثيره",
      "aya_indic": "٣٢"
    },
    {
      "sura": 56,
      "aya": 33,
      "text_uthmani": "لَّا مَقْطُوعَةٍ وَلَا مَمْنُوعَةٍ",
      "text_normalized": "لا مقطوعه ولا ممنوعه",
      "aya_indic": "٣٣"
    },
    {
      "sura": 56,
      "aya": 34,
      "text_uthmani": "وَفُرُشٍ مَّرْفُوعَةٍ",
      "text_normalized": "وفرش مرفوعه",
      "aya_indic": "٣٤"
    },
    {
      "sura": 56,
      "aya": 35,
      "text_uthmani": "إِنَّآ أَنشَأْنَٰهُنَّ إِنشَآءً",
      "text_normalized": "انا انشاناهن انشاء",
      "aya_indic": "٣٥"
    },
    {
      "sura": 56,
      "aya": 36,
      "text_uthmani": "فَجَعَلْنَٰهُنَّ أَبْكَارًا",
      "text_normalized": "فجعلناهن ابكارا",
      "aya_indic": "٣٦"
    },
    {
      "sura": 56,
      "aya": 37,
      "text_uthmani": "عُرُبًا أَتْرَابًا",
      "text_normalized": "عربا اترابا",
      "aya_indic": "٣٧"
    },
    {
      "sura": 56,
      "aya": 38,
      "text_uthmani": "لِّأَصْحَٰبِ ٱلْيَمِينِ",
      "text_normalized": "لاصحاب اليمين",
      "aya_indic": "٣٨"
    },
    {
      "sura": 56,
      "aya": 39,
      "text_uthmani": "ثُلَّةٌ مِّنَ ٱلْأَوَّلِينَ",
      "text_normalized": "ثله من الاولين",
      "aya_indic": "٣٩"
    },
    {
      "sura": 56,
      "aya": 40,
      "text_uthmani": "وَثُلَّةٌ مِّنَ ٱلْـَٔاخِرِينَ",
      "text_normalized": "وثله من الاخرين",
      "aya_indic": "٤٠"
    },
    {
      "sura": 56,
      "aya": 41,
      "text_uthmani": "وَأَصْحَٰبُ ٱلشِّمَالِ مَآ أَصْحَٰبُ ٱلشِّمَالِ",
      "text_normalized": "واصحاب الشمال ما اصحاب الشمال",
      "aya_indic": "٤١"
    },
    {
      "sura": 56,
      "aya": 42,
      "text_uthmani": "فِى سَمُومٍ وَحَمِيمٍ",
      "text_normalized": "في سموم وحميم",
      "aya_indic": "٤٢"
    },
    {
      "sura": 56,
      "aya": 43,
      "text_uthmani": "وَظِلٍّ مِّن يَحْمُومٍ",
      "text_normalized": "وظل من يحموم",
      "aya_indic": "٤٣"
    },
    {
      "sura": 56,
      "aya": 44,
      "text_uthmani": "لَّا بَارِدٍ وَلَا كَرِيمٍ",
      "text_normalized": "لا بارد ولا كريم",
      "aya_indic": "٤٤"
    },
    {
      "sura": 56,
      "aya": 45,
      "text_uthmani": "إِنَّهُمْ كَانُوا۟ قَبْلَ ذَٰلِكَ مُتْرَفِينَ",
      "text_normalized": "انهم كانوا قبل ذلك مترفين",
      "aya_indic": "٤٥"
    },
    {
      "sura": 56,
      "aya": 46,
      "text_uthmani": "وَكَانُوا۟ يُصِرُّونَ عَلَى ٱلْحِنثِ ٱلْعَظِيمِ",
      "text_normalized": "وكانوا يصرون علي الحنث العظيم",
      "aya_indic": "٤٦"
    },
    {
      "sura": 56,
      "aya": 47,
      "text_uthmani": "وَكَانُوا۟ يَقُولُونَ أَئِذَا مِتْنَا وَكُنَّا تُرَابًا وَعِظَٰمًا أَءِنَّا لَمَبْعُوثُونَ",
      "text_normalized": "وكانوا يقولون ايذا متنا وكنا ترابا وعظاما اءنا لمبعوثون",
      "aya_indic": "٤٧"
    },
    {
      "sura": 56,
      "aya": 48,
      "text_uthmani": "أَوَءَابَآؤُنَا ٱلْأَوَّلُونَ",
      "text_normalized": "اوءاباونا الاولون",
      "aya_indic": "٤٨"
    },
    {
      "sura": 56,
      "aya": 49,
      "text_uthmani": "قُلْ إِنَّ ٱلْأَوَّلِينَ وَٱلْـَٔاخِرِينَ",
      "text_normalized": "قل ان الاولين والاخرين",
      "aya_indic": "٤٩"
    },
    {
      "sura": 56,
      "aya": 50,
      "text_uthmani": "لَمَجْمُوعُونَ إِلَىٰ مِيقَٰتِ يَوْمٍ مَّعْلُومٍ",
      "text_normalized": "لمجموعون اليا ميقات يوم معلوم",
      "aya_indic": "٥٠"
    },
    {
      "sura": 56,
      "aya": 51,
      "text_uthmani": "ثُمَّ إِنَّكُمْ أَيُّهَا ٱلضَّآلُّونَ ٱلْمُكَذِّبُونَ",
      "text_normalized": "ثم انكم ايها الضالون المكذبون",
      "aya_indic": "٥١"
    },
    {
      "sura": 56,
      "aya": 52,
      "text_uthmani": "لَـَٔاكِلُونَ مِن شَجَرٍ مِّن زَقُّومٍ",
      "text_normalized": "لاكلون من شجر من زقوم",
      "aya_indic": "٥٢"
    },
    {
      "sura": 56,
      "aya": 53,
      "text_uthmani": "فَمَالِـُٔونَ مِنْهَا ٱلْبُطُونَ",
      "text_normalized": "فمالون منها البطون",
      "aya_indic": "٥٣"
    },
    {
      "sura": 56,
      "aya": 54,
      "text_uthmani": "فَشَٰرِبُونَ عَلَيْهِ مِنَ ٱلْحَمِيمِ",
      "text_normalized": "فشاربون عليه من الحميم",
      "aya_indic": "٥٤"
    },
    {
      "sura": 56,
      "aya": 55,
      "text_uthmani": "فَشَٰرِبُونَ شُرْبَ ٱلْهِيمِ",
      "text_normalized": "فشاربون شرب الهيم",
      "aya_indic": "٥٥"
    },
    {
      "sura": 56,
      "aya": 56,
      "text_uthmani": "هَٰذَا نُزُلُهُمْ يَوْمَ ٱلدِّينِ",
      "text_normalized": "هذا نزلهم يوم الدين",
      "aya_indic": "٥٦"
    },
    {
      "sura": 56,
      "aya": 57,
      "text_uthmani": "نَحْنُ خَلَقْنَٰكُمْ فَلَوْلَا تُصَدِّقُونَ",
      "text_normalized": "نحن خلقناكم فلولا تصدقون",
      "aya_indic": "٥٧"
    },
    {
      "sura": 56,
      "aya": 58,
      "text_uthmani": "أَفَرَءَيْتُم مَّا تُمْنُونَ",
      "text_normalized": "افرءيتم ما تمنون",
      "aya_indic": "٥٨"
    },
    {
      "sura": 56,
      "aya": 59,
      "text_uthmani": "ءَأَنتُمْ تَخْلُقُونَهُۥٓ أَمْ نَحْنُ ٱلْخَٰلِقُونَ",
      "text_normalized": "ءانتم تخلقونه ام نحن الخالقون",
      "aya_indic": "٥٩"
    },
    {
      "sura": 56,
      "aya": 60,
      "text_uthmani": "نَحْنُ قَدَّرْنَا بَيْنَكُمُ ٱلْمَوْتَ وَمَا نَحْنُ بِمَسْبُوقِينَ",
      "text_normalized": "نحن قدرنا بينكم الموت وما نحن بمسبوقين",
      "aya_indic": "٦٠"
    },
    {
      "sura": 56,
      "aya": 61,
      "text_uthmani": "عَلَىٰٓ أَن نُّبَدِّلَ أَمْثَٰلَكُمْ وَنُنشِئَكُمْ فِى مَا لَا تَعْلَمُونَ",
      "text_normalized": "عليا ان نبدل امثالكم وننشيكم في ما لا تعلمون",
      "aya_indic": "٦١"
    },
    {
      "sura": 56,
      "aya": 62,
      "text_uthmani": "وَلَقَدْ عَلِمْتُمُ ٱلنَّشْأَةَ ٱلْأُولَىٰ فَلَوْلَا تَذَكَّرُونَ",
      "text_normalized": "ولقد علمتم النشاه الاوليا فلولا تذكرون",
      "aya_indic": "٦٢"
    },
    {
      "sura": 56,
      "aya": 63,
      "text_uthmani": "أَفَرَءَيْتُم مَّا تَحْرُثُونَ",
      "text_normalized": "افرءيتم ما تحرثون",
      "aya_indic": "٦٣"
    },
    {
      "sura": 56,
      "aya": 64,
      "text_uthmani": "ءَأَنتُمْ تَزْرَعُونَهُۥٓ أَمْ نَحْنُ ٱلزَّٰرِعُونَ",
      "text_normalized": "ءانتم تزرعونه ام نحن الزارعون",
      "aya_indic": "٦٤"
    },
    {
      "sura": 56,
      "aya": 65,
      "text_uthmani": "لَوْ نَشَآءُ لَجَعَلْنَٰهُ حُطَٰمًا فَظَلْتُمْ تَفَكَّهُونَ",
      "text_normalized": "لو نشاء لجعلناه حطاما فظلتم تفكهون",
      "aya_indic": "٦٥"
    },
    {
      "sura": 56,
      "aya": 66,
      "text_uthmani": "إِنَّا لَمُغْرَمُونَ",
      "text_normalized": "انا لمغرمون",
      "aya_indic": "٦٦"
    },
    {
      "sura": 56,
      "aya": 67,
      "text_uthmani": "بَلْ نَحْنُ مَحْرُومُونَ",
      "text_normalized": "بل نحن محرومون",
      "aya_indic": "٦٧"
    },
    {
      "sura": 56,
      "aya": 68,
      "text_uthmani": "أَفَرَءَيْتُمُ ٱلْمَآءَ ٱلَّذِى تَشْرَبُونَ",
      "text_normalized": "افرءيتم الماء الذي تشربون",
      "aya_indic": "٦٨"
    },
    {
      "sura": 56,
      "aya": 69,
      "text_uthmani": "ءَأَنتُمْ أَنزَلْتُمُوهُ مِنَ ٱلْمُزْنِ أَمْ نَحْنُ ٱلْمُنزِلُونَ",
      "text_normalized": "ءانتم انزلتموه من المزن ام نحن المنزلون",
      "aya_indic": "٦٩"
    },
    {
      "sura": 56,
      "aya": 70,
      "text_uthmani": "لَوْ نَشَآءُ جَعَلْنَٰهُ أُجَاجًا فَلَوْلَا تَشْكُرُونَ",
      "text_normalized": "لو نشاء جعلناه اجاجا فلولا تشكرون",
      "aya_indic": "٧٠"
    },
    {
      "sura": 56,
      "aya": 71,
      "text_uthmani": "أَفَرَءَيْتُمُ ٱلنَّارَ ٱلَّتِى تُورُونَ",
      "text_normalized": "افرءيتم النار التي تورون",
      "aya_indic": "٧١"
    },
    {
      "sura": 56,
      "aya": 72,
      "text_uthmani": "ءَأَنتُمْ أَنشَأْتُمْ شَجَرَتَهَآ أَمْ نَحْنُ ٱلْمُنشِـُٔونَ",
      "text_normalized": "ءانتم انشاتم شجرتها ام نحن المنشون",
      "aya_indic": "٧٢"
    },
    {
      "sura": 56,
      "aya": 73,
      "text_uthmani": "نَحْنُ جَعَلْنَٰهَا تَذْكِرَةً وَمَتَٰعًا لِّلْمُقْوِينَ",
      "text_normalized": "نحن جعلناها تذكره ومتاعا للمقوين",
      "aya_indic": "٧٣"
    },
    {
      "sura": 56,
      "aya": 74,
      "text_uthmani": "فَسَبِّحْ بِٱسْمِ رَبِّكَ ٱلْعَظِيمِ",
      "text_normalized": "فسبح باسم ربك العظيم",
      "aya_indic": "٧٤"
    },
    {
      "sura": 56,
      "aya": 75,
      "text_uthmani": "فَلَآ أُقْسِمُ بِمَوَٰقِعِ ٱلنُّجُومِ",
      "text_normalized": "فلا اقسم بمواقع النجوم",
      "aya_indic": "٧٥"
    },
    {
      "sura": 56,
      "aya": 76,
      "text_uthmani": "وَإِنَّهُۥ لَقَسَمٌ لَّوْ تَعْلَمُونَ عَظِيمٌ",
      "text_normalized": "وانه لقسم لو تعلمون عظيم",
      "aya_indic": "٧٦"
    },
    {
      "sura": 56,
      "aya": 77,
      "text_uthmani": "إِنَّهُۥ لَقُرْءَانٌ كَرِيمٌ",
      "text_normalized": "انه لقرءان كريم",
      "aya_indic": "٧٧"
    },
    {
      "sura": 56,
      "aya": 78,
      "text_uthmani": "فِى كِتَٰبٍ مَّكْنُونٍ",
      "text_normalized": "في كتاب مكنون",
      "aya_indic": "٧٨"
    },
    {
      "sura": 56,
      "aya": 79,
      "text_uthmani": "لَّا يَمَسُّهُۥٓ إِلَّا ٱلْمُطَهَّرُونَ",
      "text_normalized": "لا يمسه الا المطهرون",
      "aya_indic": "٧٩"
    },
    {
      "sura": 56,
      "aya": 80,
      "text_uthmani": "تَنزِيلٌ مِّن رَّبِّ ٱلْعَٰلَمِينَ",
      "text_normalized": "تنزيل من رب العالمين",
      "aya_indic": "٨٠"
    },
    {
      "sura": 56,
      "aya": 81,
      "text_uthmani": "أَفَبِهَٰذَا ٱلْحَدِيثِ أَنتُم مُّدْهِنُونَ",
      "text_normalized": "افبهاذا الحديث انتم مدهنون",
      "aya_indic": "٨١"
    },
    {
      "sura": 56,
      "aya": 82,
      "text_uthmani": "وَتَجْعَلُونَ رِزْقَكُمْ أَنَّكُمْ تُكَذِّبُونَ",
      "text_normalized": "وتجعلون رزقكم انكم تكذبون",
      "aya_indic": "٨٢"
    },
    {
      "sura": 56,
      "aya": 83,
      "text_uthmani": "فَلَوْلَآ إِذَا بَلَغَتِ ٱلْحُلْقُومَ",
      "text_normalized": "فلولا اذا بلغت الحلقوم",
      "aya_indic": "٨٣"
    },
    {
      "sura": 56,
      "aya": 84,
      "text_uthmani": "وَأَنتُمْ حِينَئِذٍ تَنظُرُونَ",
      "text_normalized": "وانتم حينيذ تنظرون",
      "aya_indic": "٨٤"
    },
    {
      "sura": 56,
      "aya": 85,
      "text_uthmani": "وَنَحْنُ أَقْرَبُ إِلَيْهِ مِنكُمْ وَلَٰكِن لَّا تُبْصِرُونَ",
      "text_normalized": "ونحن اقرب اليه منكم ولاكن لا تبصرون",
      "aya_indic": "٨٥"
    },
    {
      "sura": 56,
      "aya": 86,
      "text_uthmani": "فَلَوْلَآ إِن كُنتُمْ غَيْرَ مَدِينِينَ",
      "text_normalized": "فلولا ان كنتم غير مدينين",
      "aya_indic": "٨٦"
    },
    {
      "sura": 56,
      "aya": 87,
      "text_uthmani": "تَرْجِعُونَهَآ إِن كُنتُمْ صَٰدِقِينَ",
      "text_normalized": "ترجعونها ان كنتم صادقين",
      "aya_indic": "٨٧"
    },
    {
      "sura": 56,
      "aya": 88,
      "text_uthmani": "فَأَمَّآ إِن كَانَ مِنَ ٱلْمُقَرَّبِينَ",
      "text_normalized": "فاما ان كان من المقربين",
      "aya_indic": "٨٨"
    },
    {
      "sura": 56,
      "aya": 89,
      "text_uthmani": "فَرَوْحٌ وَرَيْحَانٌ وَجَنَّتُ نَعِيمٍ",
      "text_normalized": "فروح وريحان وجنت نعيم",
      "aya_indic": "٨٩"
    },
    {
      "sura": 56,
      "aya": 90,
      "text_uthmani": "وَأَمَّآ إِن كَانَ مِنْ أَصْحَٰبِ ٱلْيَمِينِ",
      "text_normalized": "واما ان كان من اصحاب اليمين",
      "aya_indic": "٩٠"
    },
    {
      "sura": 56,
      "aya": 91,
      "text_uthmani": "فَسَلَٰمٌ لَّكَ مِنْ أَصْحَٰبِ ٱلْيَمِينِ",
      "text_normalized": "فسلام لك من اصحاب اليمين",
      "aya_indic": "٩١"
    },
    {
      "sura": 56,
      "aya": 92,
      "text_uthmani": "وَأَمَّآ إِن كَانَ مِنَ ٱلْمُكَذِّبِينَ ٱلضَّآلِّينَ",
      "text_normalized": "واما ان كان من المكذبين الضالين",
      "aya_indic": "٩٢"
    },
    {
      "sura": 56,
      "aya": 93,
      "text_uthmani": "فَنُزُلٌ مِّنْ حَمِيمٍ",
      "text_normalized": "فنزل من حميم",
      "aya_indic": "٩٣"
    },
    {
      "sura": 56,
      "aya": 94,
      "text_uthmani": "وَتَصْلِيَةُ جَحِيمٍ",
      "text_normalized": "وتصليه جحيم",
      "aya_indic": "٩٤"
    },
    {
      "sura": 56,
      "aya": 95,
      "text_uthmani": "إِنَّ هَٰذَا لَهُوَ حَقُّ ٱلْيَقِينِ",
      "text_normalized": "ان هذا لهو حق اليقين",
      "aya_indic": "٩٥"
    },
    {
      "sura": 56,
      "aya": 96,
      "text_uthmani": "فَسَبِّحْ بِٱسْمِ رَبِّكَ ٱلْعَظِيمِ",
      "text_normalized": "فسبح باسم ربك العظيم",
      "aya_indic": "٩٦"
    }
  ]
}