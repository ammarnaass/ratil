{
  "id": 70,
  "name_ar": "المعارج",
  "name_en": "Al-Ma'arij",
  "type": "مكية",
  "ayahs_hafs": 44,
  "ayahs_warsh": 44,
  "page": 568,
  "narration": "hafs",
  "narration_ar": "حفص عن عاصم",
  "ayahs": [
    {
      "sura": 70,
      "aya": 1,
      "text_uthmani": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ سَأَلَ سَآئِلٌۢ بِعَذَابٍ وَاقِعٍ",
      "text_normalized": "بسم الله الرحمن الرحيم سال سايل بعذاب واقع",
      "aya_indic": "١"
    },
    {
      "sura": 70,
      "aya": 2,
      "text_uthmani": "لِّلْكَٰفِرِينَ لَيْسَ لَهُۥ دَافِعٌ",
      "text_normalized": "للكافرين ليس له دافع",
      "aya_indic": "٢"
    },
    {
      "sura": 70,
      "aya": 3,
      "text_uthmani": "مِّنَ ٱللَّهِ ذِى ٱلْمَعَارِجِ",
      "text_normalized": "من الله ذي المعارج",
      "aya_indic": "٣"
    },
    {
      "sura": 70,
      "aya": 4,
      "text_uthmani": "تَعْرُجُ ٱلْمَلَٰٓئِكَةُ وَٱلرُّوحُ إِلَيْهِ فِى يَوْمٍ كَانَ مِقْدَارُهُۥ خَمْسِينَ أَلْفَ سَنَةٍ",
      "text_normalized": "تعرج الملايكه والروح اليه في يوم كان مقداره خمسين الف سنه",
      "aya_indic": "٤"
    },
    {
      "sura": 70,
      "aya": 5,
      "text_uthmani": "فَٱصْبِرْ صَبْرًا جَمِيلًا",
      "text_normalized": "فاصبر صبرا جميلا",
      "aya_indic": "٥"
    },
    {
      "sura": 70,
      "aya": 6,
      "text_uthmani": "إِنَّهُمْ يَرَوْنَهُۥ بَعِيدًا",
      "text_normalized": "انهم يرونه بعيدا",
      "aya_indic": "٦"
    },
    {
      "sura": 70,
      "aya": 7,
      "text_uthmani": "وَنَرَىٰهُ قَرِيبًا",
      "text_normalized": "ونرياه قريبا",
      "aya_indic": "٧"
    },
    {
      "sura": 70,
      "aya": 8,
      "text_uthmani": "يَوْمَ تَكُونُ ٱلسَّمَآءُ كَٱلْمُهْلِ",
      "text_normalized": "يوم تكون السماء كالمهل",
      "aya_indic": "٨"
    },
    {
      "sura": 70,
      "aya": 9,
      "text_uthmani": "وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ",
      "text_normalized": "وتكون الجبال كالعهن",
      "aya_indic": "٩"
    },
    {
      "sura": 70,
      "aya": 10,
      "text_uthmani": "وَلَا يَسْـَٔلُ حَمِيمٌ حَمِيمًا",
      "text_normalized": "ولا يسل حميم حميما",
      "aya_indic": "١٠"
    },
    {
      "sura": 70,
      "aya": 11,
      "text_uthmani": "يُبَصَّرُونَهُمْ ۚ يَوَدُّ ٱلْمُجْرِمُ لَوْ يَفْتَدِى مِنْ عَذَابِ يَوْمِئِذٍۭ بِبَنِيهِ",
      "text_normalized": "يبصرونهم يود المجرم لو يفتدي من عذاب يوميذ ببنيه",
      "aya_indic": "١١"
    },
    {
      "sura": 70,
      "aya": 12,
      "text_uthmani": "وَصَٰحِبَتِهِۦ وَأَخِيهِ",
      "text_normalized": "وصاحبته واخيه",
      "aya_indic": "١٢"
    },
    {
      "sura": 70,
      "aya": 13,
      "text_uthmani": "وَفَصِيلَتِهِ ٱلَّتِى تُـْٔوِيهِ",
      "text_normalized": "وفصيلته التي تويه",
      "aya_indic": "١٣"
    },
    {
      "sura": 70,
      "aya": 14,
      "text_uthmani": "وَمَن فِى ٱلْأَرْضِ جَمِيعًا ثُمَّ يُنجِيهِ",
      "text_normalized": "ومن في الارض جميعا ثم ينجيه",
      "aya_indic": "١٤"
    },
    {
      "sura": 70,
      "aya": 15,
      "text_uthmani": "كَلَّآ ۖ إِنَّهَا لَظَىٰ",
      "text_normalized": "كلا انها لظيا",
      "aya_indic": "١٥"
    },
    {
      "sura": 70,
      "aya": 16,
      "text_uthmani": "نَزَّاعَةً لِّلشَّوَىٰ",
      "text_normalized": "نزاعه للشويا",
      "aya_indic": "١٦"
    },
    {
      "sura": 70,
      "aya": 17,
      "text_uthmani": "تَدْعُوا۟ مَنْ أَدْبَرَ وَتَوَلَّىٰ",
      "text_normalized": "تدعوا من ادبر وتوليا",
      "aya_indic": "١٧"
    },
    {
      "sura": 70,
      "aya": 18,
      "text_uthmani": "وَجَمَعَ فَأَوْعَىٰٓ",
      "text_normalized": "وجمع فاوعيا",
      "aya_indic": "١٨"
    },
    {
      "sura": 70,
      "aya": 19,
      "text_uthmani": "إِنَّ ٱلْإِنسَٰنَ خُلِقَ هَلُوعًا",
      "text_normalized": "ان الانسان خلق هلوعا",
      "aya_indic": "١٩"
    },
    {
      "sura": 70,
      "aya": 20,
      "text_uthmani": "إِذَا مَسَّهُ ٱلشَّرُّ جَزُوعًا",
      "text_normalized": "اذا مسه الشر جزوعا",
      "aya_indic": "٢٠"
    },
    {
      "sura": 70,
      "aya": 21,
      "text_uthmani": "وَإِذَا مَسَّهُ ٱلْخَيْرُ مَنُوعًا",
      "text_normalized": "واذا مسه الخير منوعا",
      "aya_indic": "٢١"
    },
    {
      "sura": 70,
      "aya": 22,
      "text_uthmani": "إِلَّا ٱلْمُصَلِّينَ",
      "text_normalized": "الا المصلين",
      "aya_indic": "٢٢"
    },
    {
      "sura": 70,
      "aya": 23,
      "text_uthmani": "ٱلَّذِينَ هُمْ عَلَىٰ صَلَاتِهِمْ دَآئِمُونَ",
      "text_normalized": "الذين هم عليا صلاتهم دايمون",
      "aya_indic": "٢٣"
    },
    {
      "sura": 70,
      "aya": 24,
      "text_uthmani": "وَٱلَّذِينَ فِىٓ أَمْوَٰلِهِمْ حَقٌّ مَّعْلُومٌ",
      "text_normalized": "والذين في اموالهم حق معلوم",
      "aya_indic": "٢٤"
    },
    {
      "sura": 70,
      "aya": 25,
      "text_uthmani": "لِّلسَّآئِلِ وَٱلْمَحْرُومِ",
      "text_normalized": "للسايل والمحروم",
      "aya_indic": "٢٥"
    },
    {
      "sura": 70,
      "aya": 26,
      "text_uthmani": "وَٱلَّذِينَ يُصَدِّقُونَ بِيَوْمِ ٱلدِّينِ",
      "text_normalized": "والذين يصدقون بيوم الدين",
      "aya_indic": "٢٦"
    },
    {
      "sura": 70,
      "aya": 27,
      "text_uthmani": "وَٱلَّذِينَ هُم مِّنْ عَذَابِ رَبِّهِم مُّشْفِقُونَ",
      "text_normalized": "والذين هم من عذاب ربهم مشفقون",
      "aya_indic": "٢٧"
    },
    {
      "sura": 70,
      "aya": 28,
      "text_uthmani": "إِنَّ عَذَابَ رَبِّهِمْ غَيْرُ مَأْمُونٍ",
      "text_normalized": "ان عذاب ربهم غير مامون",
      "aya_indic": "٢٨"
    },
    {
      "sura": 70,
      "aya": 29,
      "text_uthmani": "وَٱلَّذِينَ هُمْ لِفُرُوجِهِمْ حَٰفِظُونَ",
      "text_normalized": "والذين هم لفروجهم حافظون",
      "aya_indic": "٢٩"
    },
    {
      "sura": 70,
      "aya": 30,
      "text_uthmani": "إِلَّا عَلَىٰٓ أَزْوَٰجِهِمْ أَوْ مَا مَلَكَتْ أَيْمَٰنُهُمْ فَإِنَّهُمْ غَيْرُ مَلُومِينَ",
      "text_normalized": "الا عليا ازواجهم او ما ملكت ايمانهم فانهم غير ملومين",
      "aya_indic": "٣٠"
    },
    {
      "sura": 70,
      "aya": 31,
      "text_uthmani": "فَمَنِ ٱبْتَغَىٰ وَرَآءَ ذَٰلِكَ فَأُو۟لَٰٓئِكَ هُمُ ٱلْعَادُونَ",
      "text_normalized": "فمن ابتغيا وراء ذلك فاولايك هم العادون",
      "aya_indic": "٣١"
    },
    {
      "sura": 70,
      "aya": 32,
      "text_uthmani": "وَٱلَّذِينَ هُمْ لِأَمَٰنَٰتِهِمْ وَعَهْدِهِمْ رَٰعُونَ",
      "text_normalized": "والذين هم لاماناتهم وعهدهم راعون",
      "aya_indic": "٣٢"
    },
    {
      "sura": 70,
      "aya": 33,
      "text_uthmani": "وَٱلَّذِينَ هُم بِشَهَٰدَٰتِهِمْ قَآئِمُونَ",
      "text_normalized": "والذين هم بشهاداتهم قايمون",
      "aya_indic": "٣٣"
    },
    {
      "sura": 70,
      "aya": 34,
      "text_uthmani": "وَٱلَّذِينَ هُمْ عَلَىٰ صَلَاتِهِمْ يُحَافِظُونَ",
      "text_normalized": "والذين هم عليا صلاتهم يحافظون",
      "aya_indic": "٣٤"
    },
    {
      "sura": 70,
      "aya": 35,
      "text_uthmani": "أُو۟لَٰٓئِكَ فِى جَنَّٰتٍ مُّكْرَمُونَ",
      "text_normalized": "اولايك في جنات مكرمون",
      "aya_indic": "٣٥"
    },
    {
      "sura": 70,
      "aya": 36,
      "text_uthmani": "فَمَالِ ٱلَّذِينَ كَفَرُوا۟ قِبَلَكَ مُهْطِعِينَ",
      "text_normalized": "فمال الذين كفروا قبلك مهطعين",
      "aya_indic": "٣٦"
    },
    {
      "sura": 70,
      "aya": 37,
      "text_uthmani": "عَنِ ٱلْيَمِينِ وَعَنِ ٱلشِّمَالِ عِزِينَ",
      "text_normalized": "عن اليمين وعن الشمال عزين",
      "aya_indic": "٣٧"
    },
    {
      "sura": 70,
      "aya": 38,
      "text_uthmani": "أَيَطْمَعُ كُلُّ ٱمْرِئٍ مِّنْهُمْ أَن يُدْخَلَ جَنَّةَ نَعِيمٍ",
      "text_normalized": "ايطمع كل امري منهم ان يدخل جنه نعيم",
      "aya_indic": "٣٨"
    },
    {
      "sura": 70,
      "aya": 39,
      "text_uthmani": "كَلَّآ ۖ إِنَّا خَلَقْنَٰهُم مِّمَّا يَعْلَمُونَ",
      "text_normalized": "كلا انا خلقناهم مما يعلمون",
      "aya_indic": "٣٩"
    },
    {
      "sura": 70,
      "aya": 40,
      "text_uthmani": "فَلَآ أُقْسِمُ بِرَبِّ ٱلْمَشَٰرِقِ وَٱلْمَغَٰرِبِ إِنَّا لَقَٰدِرُونَ",
      "text_normalized": "فلا اقسم برب المشارق والمغارب انا لقادرون",
      "aya_indic": "٤٠"
    },
    {
      "sura": 70,
      "aya": 41,
      "text_uthmani": "عَلَىٰٓ أَن نُّبَدِّلَ خَيْرًا مِّنْهُمْ وَمَا نَحْنُ بِمَسْبُوقِينَ",
      "text_normalized": "عليا ان نبدل خيرا منهم وما نحن بمسبوقين",
      "aya_indic": "٤١"
    },
    {
      "sura": 70,
      "aya": 42,
      "text_uthmani": "فَذَرْهُمْ يَخُوضُوا۟ وَيَلْعَبُوا۟ حَتَّىٰ يُلَٰقُوا۟ يَوْمَهُمُ ٱلَّذِى يُوعَدُونَ",
      "text_normalized": "فذرهم يخوضوا ويلعبوا حتيا يلاقوا يومهم الذي يوعدون",
      "aya_indic": "٤٢"
    },
    {
      "sura": 70,
      "aya": 43,
      "text_uthmani": "يَوْمَ يَخْرُجُونَ مِنَ ٱلْأَجْدَاثِ سِرَاعًا كَأَنَّهُمْ إِلَىٰ نُصُبٍ يُوفِضُونَ",
      "text_normalized": "يوم يخرجون من الاجداث سراعا كانهم اليا نصب يوفضون",
      "aya_indic": "٤٣"
    },
    {
      "sura": 70,
      "aya": 44,
      "text_uthmani": "خَٰشِعَةً أَبْصَٰرُهُمْ تَرْهَقُهُمْ ذِلَّةٌ ۚ ذَٰلِكَ ٱلْيَوْمُ ٱلَّذِى كَانُوا۟ يُوعَدُونَ",
      "text_normalized": "خاشعه ابصارهم ترهقهم ذله ذلك اليوم الذي كانوا يوعدون",
      "aya_indic": "٤٤"
    }
  ]
}