{
  "id": 85,
  "name_ar": "البروج",
  "name_en": "Al-Buruj",
  "type": "مكية",
  "ayahs_hafs": 22,
  "ayahs_warsh": 22,
  "page": 590,
  "narration": "hafs",
  "narration_ar": "حفص عن عاصم",
  "ayahs": [
    {
      "sura": 85,
      "aya": 1,
      "text_uthmani": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلسَّمَآءِ ذَاتِ ٱلْبُرُوجِ",
      "text_normalized": "بسم الله الرحمن الرحيم والسماء ذات البروج",
      "aya_indic": "١"
    },
    {
      "sura": 85,
      "aya": 2,
      "text_uthmani": "وَٱلْيَوْمِ ٱلْمَوْعُودِ",
      "text_normalized": "واليوم الموعود",
      "aya_indic": "٢"
    },
    {
      "sura": 85,
      "aya": 3,
      "text_uthmani": "وَشَاهِدٍ وَمَشْهُودٍ",
      "text_normalized": "وشاهد ومشهود",
      "aya_indic": "٣"
    },
    {
      "sura": 85,
      "aya": 4,
      "text_uthmani": "قُتِلَ أَصْحَٰبُ ٱلْأُخْدُودِ",
      "text_normalized": "قتل اصحاب الاخدود",
      "aya_indic": "٤"
    },
    {
      "sura": 85,
      "aya": 5,
      "text_uthmani": "ٱلنَّارِ ذَاتِ ٱلْوَقُودِ",
      "text_normalized": "النار ذات الوقود",
      "aya_indic": "٥"
    },
    {
      "sura": 85,
      "aya": 6,
      "text_uthmani": "إِذْ هُمْ عَلَيْهَا قُعُودٌ",
      "text_normalized": "اذ هم عليها قعود",
      "aya_indic": "٦"
    },
    {
      "sura": 85,
      "aya": 7,
      "text_uthmani": "وَهُمْ عَلَىٰ مَا يَفْعَلُونَ بِٱلْمُؤْمِنِينَ شُهُودٌ",
      "text_normalized": "وهم عليا ما يفعلون بالمومنين شهود",
      "aya_indic": "٧"
    },
    {
      "sura": 85,
      "aya": 8,
      "text_uthmani": "وَمَا نَقَمُوا۟ مِنْهُمْ إِلَّآ أَن يُؤْمِنُوا۟ بِٱللَّهِ ٱلْعَزِيزِ ٱلْحَمِيدِ",
      "text_normalized": "وما نقموا منهم الا ان يومنوا بالله العزيز الحميد",
      "aya_indic": "٨"
    },
    {
      "sura": 85,
      "aya": 9,
      "text_uthmani": "ٱلَّذِى لَهُۥ مُلْكُ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ ۚ وَٱللَّهُ عَلَىٰ كُلِّ شَىْءٍ شَهِيدٌ",
      "text_normalized": "الذي له ملك السماوات والارض والله عليا كل شيء شهيد",
      "aya_indic": "٩"
    },
    {
      "sura": 85,
      "aya": 10,
      "text_uthmani": "إِنَّ ٱلَّذِينَ فَتَنُوا۟ ٱلْمُؤْمِنِينَ وَٱلْمُؤْمِنَٰتِ ثُمَّ لَمْ يَتُوبُوا۟ فَلَهُمْ عَذَابُ جَهَنَّمَ وَلَهُمْ عَذَابُ ٱلْحَرِيقِ",
      "text_normalized": "ان الذين فتنوا المومنين والمومنات ثم لم يتوبوا فلهم عذاب جهنم ولهم عذاب الحريق",
      "aya_indic": "١٠"
    },
    {
      "sura": 85,
      "aya": 11,
      "text_uthmani": "إِنَّ ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ لَهُمْ جَنَّٰتٌ تَجْرِى مِن تَحْتِهَا ٱلْأَنْهَٰرُ ۚ ذَٰلِكَ ٱلْفَوْزُ ٱلْكَبِيرُ",
      "text_normalized": "ان الذين ءامنوا وعملوا الصالحات لهم جنات تجري من تحتها الانهار ذلك الفوز الكبير",
      "aya_indic": "١١"
    },
    {
      "sura": 85,
      "aya": 12,
      "text_uthmani": "إِنَّ بَطْشَ رَبِّكَ لَشَدِيدٌ",
      "text_normalized": "ان بطش ربك لشديد",
      "aya_indic": "١٢"
    },
    {
      "sura": 85,
      "aya": 13,
      "text_uthmani": "إِنَّهُۥ هُوَ يُبْدِئُ وَيُعِيدُ",
      "text_normalized": "انه هو يبدي ويعيد",
      "aya_indic": "١٣"
    },
    {
      "sura": 85,
      "aya": 14,
      "text_uthmani": "وَهُوَ ٱلْغَفُورُ ٱلْوَدُودُ",
      "text_normalized": "وهو الغفور الودود",
      "aya_indic": "١٤"
    },
    {
      "sura": 85,
      "aya": 15,
      "text_uthmani": "ذُو ٱلْعَرْشِ ٱلْمَجِيدُ",
      "text_normalized": "ذو العرش المجيد",
      "aya_indic": "١٥"
    },
    {
      "sura": 85,
      "aya": 16,
      "text_uthmani": "فَعَّالٌ لِّمَا يُرِيدُ",
      "text_normalized": "فعال لما يريد",
      "aya_indic": "١٦"
    },
    {
      "sura": 85,
      "aya": 17,
      "text_uthmani": "هَلْ أَتَىٰكَ حَدِيثُ ٱلْجُنُودِ",
      "text_normalized": "هل اتياك حديث الجنود",
      "aya_indic": "١٧"
    },
    {
      "sura": 85,
      "aya": 18,
      "text_uthmani": "فِرْعَوْنَ وَثَمُودَ",
      "text_normalized": "فرعون وثمود",
      "aya_indic": "١٨"
    },
    {
      "sura": 85,
      "aya": 19,
      "text_uthmani": "بَلِ ٱلَّذِينَ كَفَرُوا۟ فِى تَكْذِيبٍ",
      "text_normalized": "بل الذين كفروا في تكذيب",
      "aya_indic": "١٩"
    },
    {
      "sura": 85,
      "aya": 20,
      "text_uthmani": "وَٱللَّهُ مِن وَرَآئِهِم مُّحِيطٌۢ",
      "text_normalized": "والله من ورايهم محيط",
      "aya_indic": "٢٠"
    },
    {
      "sura": 85,
      "aya": 21,
      "text_uthmani": "بَلْ هُوَ قُرْءَانٌ مَّجِيدٌ",
      "text_normalized": "بل هو قرءان مجيد",
      "aya_indic": "٢١"
    },
    {
      "sura": 85,
      "aya": 22,
      "text_uthmani": "فِى لَوْحٍ مَّحْفُوظٍۭ",
      "text_normalized": "في لوح محفوظ",
      "aya_indic": "٢٢"
    }
  ]
}