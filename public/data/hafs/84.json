{
  "id": 84,
  "name_ar": "الانشقاق",
  "name_en": "Al-Inshiqaq",
  "type": "مكية",
  "ayahs_hafs": 25,
  "ayahs_warsh": 25,
  "page": 589,
  "narration": "hafs",
  "narration_ar": "حفص عن عاصم",
  "ayahs": [
    {
      "sura": 84,
      "aya": 1,
      "text_uthmani": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِذَا ٱلسَّمَآءُ ٱنشَقَّتْ",
      "text_normalized": "بسم الله الرحمن الرحيم اذا السماء انشقت",
      "aya_indic": "١"
    },
    {
      "sura": 84,
      "aya": 2,
      "text_uthmani": "وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ",
      "text_normalized": "واذنت لربها وحقت",
      "aya_indic": "٢"
    },
    {
      "sura": 84,
      "aya": 3,
      "text_uthmani": "وَإِذَا ٱلْأَرْضُ مُدَّتْ",
      "text_normalized": "واذا الارض مدت",
      "aya_indic": "٣"
    },
    {
      "sura": 84,
      "aya": 4,
      "text_uthmani": "وَأَلْقَتْ مَا فِيهَا وَتَخَلَّتْ",
      "text_normalized": "والقت ما فيها وتخلت",
      "aya_indic": "٤"
    },
    {
      "sura": 84,
      "aya": 5,
      "text_uthmani": "وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ",
      "text_normalized": "واذنت لربها وحقت",
      "aya_indic": "٥"
    },
    {
      "sura": 84,
      "aya": 6,
      "text_uthmani": "يَٰٓأَيُّهَا ٱلْإِنسَٰنُ إِنَّكَ كَادِحٌ إِلَىٰ رَبِّكَ كَدْحًا فَمُلَٰقِيهِ",
      "text_normalized": "ياايها الانسان انك كادح اليا ربك كدحا فملاقيه",
      "aya_indic": "٦"
    },
    {
      "sura": 84,
      "aya": 7,
      "text_uthmani": "فَأَمَّا مَنْ أُوتِىَ كِتَٰبَهُۥ بِيَمِينِهِۦ",
      "text_normalized": "فاما من اوتي كتابه بيمينه",
      "aya_indic": "٧"
    },
    {
      "sura": 84,
      "aya": 8,
      "text_uthmani": "فَسَوْفَ يُحَاسَبُ حِسَابًا يَسِيرًا",
      "text_normalized": "فسوف يحاسب حسابا يسيرا",
      "aya_indic": "٨"
    },
    {
      "sura": 84,
      "aya": 9,
      "text_uthmani": "وَيَنقَلِبُ إِلَىٰٓ أَهْلِهِۦ مَسْرُورًا",
      "text_normalized": "وينقلب اليا اهله مسرورا",
      "aya_indic": "٩"
    },
    {
      "sura": 84,
      "aya": 10,
      "text_uthmani": "وَأَمَّا مَنْ أُوتِىَ كِتَٰبَهُۥ وَرَآءَ ظَهْرِهِۦ",
      "text_normalized": "واما من اوتي كتابه وراء ظهره",
      "aya_indic": "١٠"
    },
    {
      "sura": 84,
      "aya": 11,
      "text_uthmani": "فَسَوْفَ يَدْعُوا۟ ثُبُورًا",
      "text_normalized": "فسوف يدعوا ثبورا",
      "aya_indic": "١١"
    },
    {
      "sura": 84,
      "aya": 12,
      "text_uthmani": "وَيَصْلَىٰ سَعِيرًا",
      "text_normalized": "ويصليا سعيرا",
      "aya_indic": "١٢"
    },
    {
      "sura": 84,
      "aya": 13,
      "text_uthmani": "إِنَّهُۥ كَانَ فِىٓ أَهْلِهِۦ مَسْرُورًا",
      "text_normalized": "انه كان في اهله مسرورا",
      "aya_indic": "١٣"
    },
    {
      "sura": 84,
      "aya": 14,
      "text_uthmani": "إِنَّهُۥ ظَنَّ أَن لَّن يَحُورَ",
      "text_normalized": "انه ظن ان لن يحور",
      "aya_indic": "١٤"
    },
    {
      "sura": 84,
      "aya": 15,
      "text_uthmani": "بَلَىٰٓ إِنَّ رَبَّهُۥ كَانَ بِهِۦ بَصِيرًا",
      "text_normalized": "بليا ان ربه كان به بصيرا",
      "aya_indic": "١٥"
    },
    {
      "sura": 84,
      "aya": 16,
      "text_uthmani": "فَلَآ أُقْسِمُ بِٱلشَّفَقِ",
      "text_normalized": "فلا اقسم بالشفق",
      "aya_indic": "١٦"
    },
    {
      "sura": 84,
      "aya": 17,
      "text_uthmani": "وَٱلَّيْلِ وَمَا وَسَقَ",
      "text_normalized": "واليل وما وسق",
      "aya_indic": "١٧"
    },
    {
      "sura": 84,
      "aya": 18,
      "text_uthmani": "وَٱلْقَمَرِ إِذَا ٱتَّسَقَ",
      "text_normalized": "والقمر اذا اتسق",
      "aya_indic": "١٨"
    },
    {
      "sura": 84,
      "aya": 19,
      "text_uthmani": "لَتَرْكَبُنَّ طَبَقًا عَن طَبَقٍ",
      "text_normalized": "لتركبن طبقا عن طبق",
      "aya_indic": "١٩"
    },
    {
      "sura": 84,
      "aya": 20,
      "text_uthmani": "فَمَا لَهُمْ لَا يُؤْمِنُونَ",
      "text_normalized": "فما لهم لا يومنون",
      "aya_indic": "٢٠"
    },
    {
      "sura": 84,
      "aya": 21,
      "text_uthmani": "وَإِذَا قُرِئَ عَلَيْهِمُ ٱلْقُرْءَانُ لَا يَسْجُدُونَ ۩",
      "text_normalized": "واذا قري عليهم القرءان لا يسجدون",
      "aya_indic": "٢١"
    },
    {
      "sura": 84,
      "aya": 22,
      "text_uthmani": "بَلِ ٱلَّذِينَ كَفَرُوا۟ يُكَذِّبُونَ",
      "text_normalized": "بل الذين كفروا يكذبون",
      "aya_indic": "٢٢"
    },
    {
      "sura": 84,
      "aya": 23,
      "text_uthmani": "وَٱللَّهُ أَعْلَمُ بِمَا يُوعُونَ",
      "text_normalized": "والله اعلم بما يوعون",
      "aya_indic": "٢٣"
    },
    {
      "sura": 84,
      "aya": 24,
      "text_uthmani": "فَبَشِّرْهُم بِعَذَابٍ أَلِيمٍ",
      "text_normalized": "فبشرهم بعذاب اليم",
      "aya_indic": "٢٤"
    },
    {
      "sura": 84,
      "aya": 25,
      "text_uthmani": "إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ لَهُمْ أَجْرٌ غَيْرُ مَمْنُونٍۭ",
      "text_normalized": "الا الذين ءامنوا وعملوا الصالحات لهم اجر غير ممنون",
      "aya_indic": "٢٥"
    }
  ]
}