  "ayahs_warsh": 5,
  "page": 601,
  "narration": "hafs",
  "narration_ar": "حفص عن عاصم",
  "ayahs": [
    {
      "sura": 105,
      "aya": 1,
      "text_uthmani": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِأَصْحَٰبِ ٱلْفِيلِ",
      "text_normalized": "بسم الله الرحمن الرحيم الم تر كيف فعل ربك باصحاب الفيل",
      "aya_indic": "١"
    },
    {
      "sura": 105,
      "aya": 2,
      "text_uthmani": "أَلَمْ يَجْعَلْ كَيْدَهُمْ فِى تَضْلِيلٍ",
      "text_normalized": "الم يجعل كيدهم في تضليل",
      "aya_indic": "٢"
    },
    {
      "sura": 105,
      "aya": 3,
      "text_uthmani": "وَأَرْسَلَ عَلَيْهِمْ طَيْرًا أَبَابِيلَ",
      "text_normalized": "وارسل عليهم طيرا ابابيل",
      "aya_indic": "٣"
    },
    {
      "sura": 105,
      "aya": 4,
      "text_uthmani": "تَرْمِيهِم بِحِجَارَةٍ مِّن سِجِّيلٍ",
      "text_normalized": "ترميهم بحجاره من سجيل",
      "aya_indic": "٤"
    },
    {
      "sura": 105,
      "aya": 5,
      "text_uthmani": "فَجَعَلَهُمْ كَعَصْفٍ مَّأْكُولٍۭ",
      "text_normalized": "فجعلهم كعصف ماكول",
      "aya_indic": "٥"
    }
  ]
}