{
  "id": 79,
  "name_ar": "النازعات",
  "name_en": "An-Nazi'at",
  "type": "مكية",
  "ayahs_hafs": 46,
  "ayahs_warsh": 45,
  "page": 583,
  "narration": "hafs",
  "narration_ar": "حفص عن عاصم",
  "ayahs": [
    {
      "sura": 79,
      "aya": 1,
      "text_uthmani": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلنَّٰزِعَٰتِ غَرْقًا",
      "text_normalized": "بسم الله الرحمن الرحيم والنازعات غرقا",
      "aya_indic": "١"
    },
    {
      "sura": 79,
      "aya": 2,
      "text_uthmani": "وَٱلنَّٰشِطَٰتِ نَشْطًا",
      "text_normalized": "والناشطات نشطا",
      "aya_indic": "٢"
    },
    {
      "sura": 79,
      "aya": 3,
      "text_uthmani": "وَٱلسَّٰبِحَٰتِ سَبْحًا",
      "text_normalized": "والسابحات سبحا",
      "aya_indic": "٣"
    },
    {
      "sura": 79,
      "aya": 4,
      "text_uthmani": "فَٱلسَّٰبِقَٰتِ سَبْقًا",
      "text_normalized": "فالسابقات سبقا",
      "aya_indic": "٤"
    },
    {
      "sura": 79,
      "aya": 5,
      "text_uthmani": "فَٱلْمُدَبِّرَٰتِ أَمْرًا",
      "text_normalized": "فالمدبرات امرا",
      "aya_indic": "٥"
    },
    {
      "sura": 79,
      "aya": 6,
      "text_uthmani": "يَوْمَ تَرْجُفُ ٱلرَّاجِفَةُ",
      "text_normalized": "يوم ترجف الراجفه",
      "aya_indic": "٦"
    },
    {
      "sura": 79,
      "aya": 7,
      "text_uthmani": "تَتْبَعُهَا ٱلرَّادِفَةُ",
      "text_normalized": "تتبعها الرادفه",
      "aya_indic": "٧"
    },
    {
      "sura": 79,
      "aya": 8,
      "text_uthmani": "قُلُوبٌ يَوْمَئِذٍ وَاجِفَةٌ",
      "text_normalized": "قلوب يوميذ واجفه",
      "aya_indic": "٨"
    },
    {
      "sura": 79,
      "aya": 9,
      "text_uthmani": "أَبْصَٰرُهَا خَٰشِعَةٌ",
      "text_normalized": "ابصارها خاشعه",
      "aya_indic": "٩"
    },
    {
      "sura": 79,
      "aya": 10,
      "text_uthmani": "يَقُولُونَ أَءِنَّا لَمَرْدُودُونَ فِى ٱلْحَافِرَةِ",
      "text_normalized": "يقولون اءنا لمردودون في الحافره",
      "aya_indic": "١٠"
    },
    {
      "sura": 79,
      "aya": 11,
      "text_uthmani": "أَءِذَا كُنَّا عِظَٰمًا نَّخِرَةً",
      "text_normalized": "اءذا كنا عظاما نخره",
      "aya_indic": "١١"
    },
    {
      "sura": 79,
      "aya": 12,
      "text_uthmani": "قَالُوا۟ تِلْكَ إِذًا كَرَّةٌ خَاسِرَةٌ",
      "text_normalized": "قالوا تلك اذا كره خاسره",
      "aya_indic": "١٢"
    },
    {
      "sura": 79,
      "aya": 13,
      "text_uthmani": "فَإِنَّمَا هِىَ زَجْرَةٌ وَٰحِدَةٌ",
      "text_normalized": "فانما هي زجره واحده",
      "aya_indic": "١٣"
    },
    {
      "sura": 79,
      "aya": 14,
      "text_uthmani": "فَإِذَا هُم بِٱلسَّاهِرَةِ",
      "text_normalized": "فاذا هم بالساهره",
      "aya_indic": "١٤"
    },
    {
      "sura": 79,
      "aya": 15,
      "text_uthmani": "هَلْ أَتَىٰكَ حَدِيثُ مُوسَىٰٓ",
      "text_normalized": "هل اتياك حديث موسيا",
      "aya_indic": "١٥"
    },
    {
      "sura": 79,
      "aya": 16,
      "text_uthmani": "إِذْ نَادَىٰهُ رَبُّهُۥ بِٱلْوَادِ ٱلْمُقَدَّسِ طُوًى",
      "text_normalized": "اذ نادياه ربه بالواد المقدس طوي",
      "aya_indic": "١٦"
    },
    {
      "sura": 79,
      "aya": 17,
      "text_uthmani": "ٱذْهَبْ إِلَىٰ فِرْعَوْنَ إِنَّهُۥ طَغَىٰ",
      "text_normalized": "اذهب اليا فرعون انه طغيا",
      "aya_indic": "١٧"
    },
    {
      "sura": 79,
      "aya": 18,
      "text_uthmani": "فَقُلْ هَل لَّكَ إِلَىٰٓ أَن تَزَكَّىٰ",
      "text_normalized": "فقل هل لك اليا ان تزكيا",
      "aya_indic": "١٨"
    },
    {
      "sura": 79,
      "aya": 19,
      "text_uthmani": "وَأَهْدِيَكَ إِلَىٰ رَبِّكَ فَتَخْشَىٰ",
      "text_normalized": "واهديك اليا ربك فتخشيا",
      "aya_indic": "١٩"
    },
    {
      "sura": 79,
      "aya": 20,
      "text_uthmani": "فَأَرَىٰهُ ٱلْـَٔايَةَ ٱلْكُبْرَىٰ",
      "text_normalized": "فارياه الايه الكبريا",
      "aya_indic": "٢٠"
    },
    {
      "sura": 79,
      "aya": 21,
      "text_uthmani": "فَكَذَّبَ وَعَصَىٰ",
      "text_normalized": "فكذب وعصيا",
      "aya_indic": "٢١"
    },
    {
      "sura": 79,
      "aya": 22,
      "text_uthmani": "ثُمَّ أَدْبَرَ يَسْعَىٰ",
      "text_normalized": "ثم ادبر يسعيا",
      "aya_indic": "٢٢"
    },
    {
      "sura": 79,
      "aya": 23,
      "text_uthmani": "فَحَشَرَ فَنَادَىٰ",
      "text_normalized": "فحشر فناديا",
      "aya_indic": "٢٣"
    },
    {
      "sura": 79,
      "aya": 24,
      "text_uthmani": "فَقَالَ أَنَا۠ رَبُّكُمُ ٱلْأَعْلَىٰ",
      "text_normalized": "فقال انا ربكم الاعليا",
      "aya_indic": "٢٤"
    },
    {
      "sura": 79,
      "aya": 25,
      "text_uthmani": "فَأَخَذَهُ ٱللَّهُ نَكَالَ ٱلْـَٔاخِرَةِ وَٱلْأُولَىٰٓ",
      "text_normalized": "فاخذه الله نكال الاخره والاوليا",
      "aya_indic": "٢٥"
    },
    {
      "sura": 79,
      "aya": 26,
      "text_uthmani": "إِنَّ فِى ذَٰلِكَ لَعِبْرَةً لِّمَن يَخْشَىٰٓ",
      "text_normalized": "ان في ذلك لعبره لمن يخشيا",
      "aya_indic": "٢٦"
    },
    {
      "sura": 79,
      "aya": 27,
      "text_uthmani": "ءَأَنتُمْ أَشَدُّ خَلْقًا أَمِ ٱلسَّمَآءُ ۚ بَنَىٰهَا",
      "text_normalized": "ءانتم اشد خلقا ام السماء بنياها",
      "aya_indic": "٢٧"
    },
    {
      "sura": 79,
      "aya": 28,
      "text_uthmani": "رَفَعَ سَمْكَهَا فَسَوَّىٰهَا",
      "text_normalized": "رفع سمكها فسوياها",
      "aya_indic": "٢٨"
    },
    {
      "sura": 79,
      "aya": 29,
      "text_uthmani": "وَأَغْطَشَ لَيْلَهَا وَأَخْرَجَ ضُحَىٰهَا",
      "text_normalized": "واغطش ليلها واخرج ضحياها",
      "aya_indic": "٢٩"
    },
    {
      "sura": 79,
      "aya": 30,
      "text_uthmani": "وَٱلْأَرْضَ بَعْدَ ذَٰلِكَ دَحَىٰهَآ",
      "text_normalized": "والارض بعد ذلك دحياها",
      "aya_indic": "٣٠"
    },
    {
      "sura": 79,
      "aya": 31,
      "text_uthmani": "أَخْرَجَ مِنْهَا مَآءَهَا وَمَرْعَىٰهَا",
      "text_normalized": "اخرج منها ماءها ومرعياها",
      "aya_indic": "٣١"
    },
    {
      "sura": 79,
      "aya": 32,
      "text_uthmani": "وَٱلْجِبَالَ أَرْسَىٰهَا",
      "text_normalized": "والجبال ارسياها",
      "aya_indic": "٣٢"
    },
    {
      "sura": 79,
      "aya": 33,
      "text_uthmani": "مَتَٰعًا لَّكُمْ وَلِأَنْعَٰمِكُمْ",
      "text_normalized": "متاعا لكم ولانعامكم",
      "aya_indic": "٣٣"
    },
    {
      "sura": 79,
      "aya": 34,
      "text_uthmani": "فَإِذَا جَآءَتِ ٱلطَّآمَّةُ ٱلْكُبْرَىٰ",
      "text_normalized": "فاذا جاءت الطامه الكبريا",
      "aya_indic": "٣٤"
    },
    {
      "sura": 79,
      "aya": 35,
      "text_uthmani": "يَوْمَ يَتَذَكَّرُ ٱلْإِنسَٰنُ مَا سَعَىٰ",
      "text_normalized": "يوم يتذكر الانسان ما سعيا",
      "aya_indic": "٣٥"
    },
    {
      "sura": 79,
      "aya": 36,
      "text_uthmani": "وَبُرِّزَتِ ٱلْجَحِيمُ لِمَن يَرَىٰ",
      "text_normalized": "وبرزت الجحيم لمن يريا",
      "aya_indic": "٣٦"
    },
    {
      "sura": 79,
      "aya": 37,
      "text_uthmani": "فَأَمَّا مَن طَغَىٰ",
      "text_normalized": "فاما من طغيا",
      "aya_indic": "٣٧"
    },
    {
      "sura": 79,
      "aya": 38,
      "text_uthmani": "وَءَاثَرَ ٱلْحَيَوٰةَ ٱلدُّنْيَا",
      "text_normalized": "وءاثر الحياه الدنيا",
      "aya_indic": "٣٨"
    },
    {
      "sura": 79,
      "aya": 39,
      "text_uthmani": "فَإِنَّ ٱلْجَحِيمَ هِىَ ٱلْمَأْوَىٰ",
      "text_normalized": "فان الجحيم هي الماويا",
      "aya_indic": "٣٩"
    },
    {
      "sura": 79,
      "aya": 40,
      "text_uthmani": "وَأَمَّا مَنْ خَافَ مَقَامَ رَبِّهِۦ وَنَهَى ٱلنَّفْسَ عَنِ ٱلْهَوَىٰ",
      "text_normalized": "واما من خاف مقام ربه ونهي النفس عن الهويا",
      "aya_indic": "٤٠"
    },
    {
      "sura": 79,
      "aya": 41,
      "text_uthmani": "فَإِنَّ ٱلْجَنَّةَ هِىَ ٱلْمَأْوَىٰ",
      "text_normalized": "فان الجنه هي الماويا",
      "aya_indic": "٤١"
    },
    {
      "sura": 79,
      "aya": 42,
      "text_uthmani": "يَسْـَٔلُونَكَ عَنِ ٱلسَّاعَةِ أَيَّانَ مُرْسَىٰهَا",
      "text_normalized": "يسلونك عن الساعه ايان مرسياها",
      "aya_indic": "٤٢"
    },
    {
      "sura": 79,
      "aya": 43,
      "text_uthmani": "فِيمَ أَنتَ مِن ذِكْرَىٰهَآ",
      "text_normalized": "فيم انت من ذكرياها",
      "aya_indic": "٤٣"
    },
    {
      "sura": 79,
      "aya": 44,
      "text_uthmani": "إِلَىٰ رَبِّكَ مُنتَهَىٰهَآ",
      "text_normalized": "اليا ربك منتهياها",
      "aya_indic": "٤٤"
    },
    {
      "sura": 79,
      "aya": 45,
      "text_uthmani": "إِنَّمَآ أَنتَ مُنذِرُ مَن يَخْشَىٰهَا",
      "text_normalized": "انما انت منذر من يخشياها",
      "aya_indic": "٤٥"
    },
    {
      "sura": 79,
      "aya": 46,
      "text_uthmani": "كَأَنَّهُمْ يَوْمَ يَرَوْنَهَا لَمْ يَلْبَثُوٓا۟ إِلَّا عَشِيَّةً أَوْ ضُحَىٰهَا",
      "text_normalized": "كانهم يوم يرونها لم يلبثوا الا عشيه او ضحياها",
      "aya_indic": "٤٦"
    }
  ]
}