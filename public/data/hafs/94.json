{
  "id": 94,
  "name_ar": "الشرح",
  "name_en": "Ash-Sharh",
  "type": "مكية",
  "ayahs_hafs": 8,
  "ayahs_warsh": 8,
  "page": 596,
  "narration": "hafs",
  "narration_ar": "حفص عن عاصم",
  "ayahs": [
    {
      "sura": 94,
      "aya": 1,
      "text_uthmani": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ أَلَمْ نَشْرَحْ لَكَ صَدْرَكَ",
      "text_normalized": "بسم الله الرحمن الرحيم الم نشرح لك صدرك",
      "aya_indic": "١"
    },
    {
      "sura": 94,
      "aya": 2,
      "text_uthmani": "وَوَضَعْنَا عَنكَ وِزْرَكَ",
      "text_normalized": "ووضعنا عنك وزرك",
      "aya_indic": "٢"
    },
    {
      "sura": 94,
      "aya": 3,
      "text_uthmani": "ٱلَّذِىٓ أَنقَضَ ظَهْرَكَ",
      "text_normalized": "الذي انقض ظهرك",
      "aya_indic": "٣"
    },
    {
      "sura": 94,
      "aya": 4,
      "text_uthmani": "وَرَفَعْنَا لَكَ ذِكْرَكَ",
      "text_normalized": "ورفعنا لك ذكرك",
      "aya_indic": "٤"
    },
    {
      "sura": 94,
      "aya": 5,
      "text_uthmani": "فَإِنَّ مَعَ ٱلْعُسْرِ يُسْرًا",
      "text_normalized": "فان مع العسر يسرا",
      "aya_indic": "٥"
    },
    {
      "sura": 94,
      "aya": 6,
      "text_uthmani": "إِنَّ مَعَ ٱلْعُسْرِ يُسْرًا",
      "text_normalized": "ان مع العسر يسرا",
      "aya_indic": "٦"
    },
    {
      "sura": 94,
      "aya": 7,
      "text_uthmani": "فَإِذَا فَرَغْتَ فَٱنصَبْ",
      "text_normalized": "فاذا فرغت فانصب",
      "aya_indic": "٧"
    },
    {
      "sura": 94,
      "aya": 8,
      "text_uthmani": "وَإِلَىٰ رَبِّكَ فَٱرْغَب",
      "text_normalized": "واليا ربك فارغب",
      "aya_indic": "٨"
    }
  ]
}