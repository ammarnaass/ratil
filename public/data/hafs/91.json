{
  "id": 91,
  "name_ar": "الشمس",
  "name_en": "Ash-Shams",
  "type": "مكية",
  "ayahs_hafs": 15,
  "ayahs_warsh": 15,
  "page": 595,
  "narration": "hafs",
  "narration_ar": "حفص عن عاصم",
  "ayahs": [
    {
      "sura": 91,
      "aya": 1,
      "text_uthmani": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلشَّمْسِ وَضُحَىٰهَا",
      "text_normalized": "بسم الله الرحمن الرحيم والشمس وضحياها",
      "aya_indic": "١"
    },
    {
      "sura": 91,
      "aya": 2,
      "text_uthmani": "وَٱلْقَمَرِ إِذَا تَلَىٰهَا",
      "text_normalized": "والقمر اذا تلياها",
      "aya_indic": "٢"
    },
    {
      "sura": 91,
      "aya": 3,
      "text_uthmani": "وَٱلنَّهَارِ إِذَا جَلَّىٰهَا",
      "text_normalized": "والنهار اذا جلياها",
      "aya_indic": "٣"
    },
    {
      "sura": 91,
      "aya": 4,
      "text_uthmani": "وَٱلَّيْلِ إِذَا يَغْشَىٰهَا",
      "text_normalized": "واليل اذا يغشياها",
      "aya_indic": "٤"
    },
    {
      "sura": 91,
      "aya": 5,
      "text_uthmani": "وَٱلسَّمَآءِ وَمَا بَنَىٰهَا",
      "text_normalized": "والسماء وما بنياها",
      "aya_indic": "٥"
    },
    {
      "sura": 91,
      "aya": 6,
      "text_uthmani": "وَٱلْأَرْضِ وَمَا طَحَىٰهَا",
      "text_normalized": "والارض وما طحياها",
      "aya_indic": "٦"
    },
    {
      "sura": 91,
      "aya": 7,
      "text_uthmani": "وَنَفْسٍ وَمَا سَوَّىٰهَا",
      "text_normalized": "ونفس وما سوياها",
      "aya_indic": "٧"
    },
    {
      "sura": 91,
      "aya": 8,
      "text_uthmani": "فَأَلْهَمَهَا فُجُورَهَا وَتَقْوَىٰهَا",
      "text_normalized": "فالهمها فجورها وتقوياها",
      "aya_indic": "٨"
    },
    {
      "sura": 91,
      "aya": 9,
      "text_uthmani": "قَدْ أَفْلَحَ مَن زَكَّىٰهَا",
      "text_normalized": "قد افلح من زكياها",
      "aya_indic": "٩"
    },
    {
      "sura": 91,
      "aya": 10,
      "text_uthmani": "وَقَدْ خَابَ مَن دَسَّىٰهَا",
      "text_normalized": "وقد خاب من دسياها",
      "aya_indic": "١٠"
    },
    {
      "sura": 91,
      "aya": 11,
      "text_uthmani": "كَذَّبَتْ ثَمُودُ بِطَغْوَىٰهَآ",
      "text_normalized": "كذبت ثمود بطغوياها",
      "aya_indic": "١١"
    },
    {
      "sura": 91,
      "aya": 12,
      "text_uthmani": "إِذِ ٱنۢبَعَثَ أَشْقَىٰهَا",
      "text_normalized": "اذ انبعث اشقياها",
      "aya_indic": "١٢"
    },
    {
      "sura": 91,
      "aya": 13,
      "text_uthmani": "فَقَالَ لَهُمْ رَسُولُ ٱللَّهِ نَاقَةَ ٱللَّهِ وَسُقْيَٰهَا",
      "text_normalized": "فقال لهم رسول الله ناقه الله وسقياها",
      "aya_indic": "١٣"
    },
    {
      "sura": 91,
      "aya": 14,
      "text_uthmani": "فَكَذَّبُوهُ فَعَقَرُوهَا فَدَمْدَمَ عَلَيْهِمْ رَبُّهُم بِذَنۢبِهِمْ فَسَوَّىٰهَا",
      "text_normalized": "فكذبوه فعقروها فدمدم عليهم ربهم بذنبهم فسوياها",
      "aya_indic": "١٤"
    },
    {
      "sura": 91,
      "aya": 15,
      "text_uthmani": "وَلَا يَخَافُ عُقْبَٰهَا",
      "text_normalized": "ولا يخاف عقباها",
      "aya_indic": "١٥"
    }
  ]
}