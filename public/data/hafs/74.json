{
  "id": 74,
  "name_ar": "المدثر",
  "name_en": "Al-Muddaththir",
  "type": "مكية",
  "ayahs_hafs": 56,
  "ayahs_warsh": 55,
  "page": 575,
  "narration": "hafs",
  "narration_ar": "حفص عن عاصم",
  "ayahs": [
    {
      "sura": 74,
      "aya": 1,
      "text_uthmani": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ يَٰٓأَيُّهَا ٱلْمُدَّثِّرُ",
      "text_normalized": "بسم الله الرحمن الرحيم ياايها المدثر",
      "aya_indic": "١"
    },
    {
      "sura": 74,
      "aya": 2,
      "text_uthmani": "قُمْ فَأَنذِرْ",
      "text_normalized": "قم فانذر",
      "aya_indic": "٢"
    },
    {
      "sura": 74,
      "aya": 3,
      "text_uthmani": "وَرَبَّكَ فَكَبِّرْ",
      "text_normalized": "وربك فكبر",
      "aya_indic": "٣"
    },
    {
      "sura": 74,
      "aya": 4,
      "text_uthmani": "وَثِيَابَكَ فَطَهِّرْ",
      "text_normalized": "وثيابك فطهر",
      "aya_indic": "٤"
    },
    {
      "sura": 74,
      "aya": 5,
      "text_uthmani": "وَٱلرُّجْزَ فَٱهْجُرْ",
      "text_normalized": "والرجز فاهجر",
      "aya_indic": "٥"
    },
    {
      "sura": 74,
      "aya": 6,
      "text_uthmani": "وَلَا تَمْنُن تَسْتَكْثِرُ",
      "text_normalized": "ولا تمنن تستكثر",
      "aya_indic": "٦"
    },
    {
      "sura": 74,
      "aya": 7,
      "text_uthmani": "وَلِرَبِّكَ فَٱصْبِرْ",
      "text_normalized": "ولربك فاصبر",
      "aya_indic": "٧"
    },
    {
      "sura": 74,
      "aya": 8,
      "text_uthmani": "فَإِذَا نُقِرَ فِى ٱلنَّاقُورِ",
      "text_normalized": "فاذا نقر في الناقور",
      "aya_indic": "٨"
    },
    {
      "sura": 74,
      "aya": 9,
      "text_uthmani": "فَذَٰلِكَ يَوْمَئِذٍ يَوْمٌ عَسِيرٌ",
      "text_normalized": "فذالك يوميذ يوم عسير",
      "aya_indic": "٩"
    },
    {
      "sura": 74,
      "aya": 10,
      "text_uthmani": "عَلَى ٱلْكَٰفِرِينَ غَيْرُ يَسِيرٍ",
      "text_normalized": "علي الكافرين غير يسير",
      "aya_indic": "١٠"
    },
    {
      "sura": 74,
      "aya": 11,
      "text_uthmani": "ذَرْنِى وَمَنْ خَلَقْتُ وَحِيدًا",
      "text_normalized": "ذرني ومن خلقت وحيدا",
      "aya_indic": "١١"
    },
    {
      "sura": 74,
      "aya": 12,
      "text_uthmani": "وَجَعَلْتُ لَهُۥ مَالًا مَّمْدُودًا",
      "text_normalized": "وجعلت له مالا ممدودا",
      "aya_indic": "١٢"
    },
    {
      "sura": 74,
      "aya": 13,
      "text_uthmani": "وَبَنِينَ شُهُودًا",
      "text_normalized": "وبنين شهودا",
      "aya_indic": "١٣"
    },
    {
      "sura": 74,
      "aya": 14,
      "text_uthmani": "وَمَهَّدتُّ لَهُۥ تَمْهِيدًا",
      "text_normalized": "ومهدت له تمهيدا",
      "aya_indic": "١٤"
    },
    {
      "sura": 74,
      "aya": 15,
      "text_uthmani": "ثُمَّ يَطْمَعُ أَنْ أَزِيدَ",
      "text_normalized": "ثم يطمع ان ازيد",
      "aya_indic": "١٥"
    },
    {
      "sura": 74,
      "aya": 16,
      "text_uthmani": "كَلَّآ ۖ إِنَّهُۥ كَانَ لِـَٔايَٰتِنَا عَنِيدًا",
      "text_normalized": "كلا انه كان لاياتنا عنيدا",
      "aya_indic": "١٦"
    },
    {
      "sura": 74,
      "aya": 17,
      "text_uthmani": "سَأُرْهِقُهُۥ صَعُودًا",
      "text_normalized": "سارهقه صعودا",
      "aya_indic": "١٧"
    },
    {
      "sura": 74,
      "aya": 18,
      "text_uthmani": "إِنَّهُۥ فَكَّرَ وَقَدَّرَ",
      "text_normalized": "انه فكر وقدر",
      "aya_indic": "١٨"
    },
    {
      "sura": 74,
      "aya": 19,
      "text_uthmani": "فَقُتِلَ كَيْفَ قَدَّرَ",
      "text_normalized": "فقتل كيف قدر",
      "aya_indic": "١٩"
    },
    {
      "sura": 74,
      "aya": 20,
      "text_uthmani": "ثُمَّ قُتِلَ كَيْفَ قَدَّرَ",
      "text_normalized": "ثم قتل كيف قدر",
      "aya_indic": "٢٠"
    },
    {
      "sura": 74,
      "aya": 21,
      "text_uthmani": "ثُمَّ نَظَرَ",
      "text_normalized": "ثم نظر",
      "aya_indic": "٢١"
    },
    {
      "sura": 74,
      "aya": 22,
      "text_uthmani": "ثُمَّ عَبَسَ وَبَسَرَ",
      "text_normalized": "ثم عبس وبسر",
      "aya_indic": "٢٢"
    },
    {
      "sura": 74,
      "aya": 23,
      "text_uthmani": "ثُمَّ أَدْبَرَ وَٱسْتَكْبَرَ",
      "text_normalized": "ثم ادبر واستكبر",
      "aya_indic": "٢٣"
    },
    {
      "sura": 74,
      "aya": 24,
      "text_uthmani": "فَقَالَ إِنْ هَٰذَآ إِلَّا سِحْرٌ يُؤْثَرُ",
      "text_normalized": "فقال ان هذا الا سحر يوثر",
      "aya_indic": "٢٤"
    },
    {
      "sura": 74,
      "aya": 25,
      "text_uthmani": "إِنْ هَٰذَآ إِلَّا قَوْلُ ٱلْبَشَرِ",
      "text_normalized": "ان هذا الا قول البشر",
      "aya_indic": "٢٥"
    },
    {
      "sura": 74,
      "aya": 26,
      "text_uthmani": "سَأُصْلِيهِ سَقَرَ",
      "text_normalized": "ساصليه سقر",
      "aya_indic": "٢٦"
    },
    {
      "sura": 74,
      "aya": 27,
      "text_uthmani": "وَمَآ أَدْرَىٰكَ مَا سَقَرُ",
      "text_normalized": "وما ادرياك ما سقر",
      "aya_indic": "٢٧"
    },
    {
      "sura": 74,
      "aya": 28,
      "text_uthmani": "لَا تُبْقِى وَلَا تَذَرُ",
      "text_normalized": "لا تبقي ولا تذر",
      "aya_indic": "٢٨"
    },
    {
      "sura": 74,
      "aya": 29,
      "text_uthmani": "لَوَّاحَةٌ لِّلْبَشَرِ",
      "text_normalized": "لواحه للبشر",
      "aya_indic": "٢٩"
    },
    {
      "sura": 74,
      "aya": 30,
      "text_uthmani": "عَلَيْهَا تِسْعَةَ عَشَرَ",
      "text_normalized": "عليها تسعه عشر",
      "aya_indic": "٣٠"
    },
    {
      "sura": 74,
      "aya": 31,
      "text_uthmani": "وَمَا جَعَلْنَآ أَصْحَٰبَ ٱلنَّارِ إِلَّا مَلَٰٓئِكَةً ۙ وَمَا جَعَلْنَا عِدَّتَهُمْ إِلَّا فِتْنَةً لِّلَّذِينَ كَفَرُوا۟ لِيَسْتَيْقِنَ ٱلَّذِينَ أُوتُوا۟ ٱلْكِتَٰبَ وَيَزْدَادَ ٱلَّذِينَ ءَامَنُوٓا۟ إِيمَٰنًا ۙ وَلَا يَرْتَابَ ٱلَّذِينَ أُوتُوا۟ ٱلْكِتَٰبَ وَٱلْمُؤْمِنُونَ ۙ وَلِيَقُولَ ٱلَّذِينَ فِى قُلُوبِهِم مَّرَضٌ وَٱلْكَٰفِرُونَ مَاذَآ أَرَادَ ٱللَّهُ بِهَٰذَا مَثَلًا ۚ كَذَٰلِكَ يُضِلُّ ٱللَّهُ مَن يَشَآءُ وَيَهْدِى مَن يَشَآءُ ۚ وَمَا يَعْلَمُ جُنُودَ رَبِّكَ إِلَّا هُوَ ۚ وَمَا هِىَ إِلَّا ذِكْرَىٰ لِلْبَشَرِ",
      "text_normalized": "وما جعلنا اصحاب النار الا ملايكه وما جعلنا عدتهم الا فتنه للذين كفروا ليستيقن الذين اوتوا الكتاب ويزداد الذين ءامنوا ايمانا ولا يرتاب الذين اوتوا الكتاب والمومنون وليقول الذين في قلوبهم مرض والكافرون ماذا اراد الله بهاذا مثلا كذالك يضل الله من يشاء ويهدي من يشاء وما يعلم جنود ربك الا هو وما هي الا ذكريا للبشر",
      "aya_indic": "٣١"
    },
    {
      "sura": 74,
      "aya": 32,
      "text_uthmani": "كَلَّا وَٱلْقَمَرِ",
      "text_normalized": "كلا والقمر",
      "aya_indic": "٣٢"
    },
    {
      "sura": 74,
      "aya": 33,
      "text_uthmani": "وَٱلَّيْلِ إِذْ أَدْبَرَ",
      "text_normalized": "واليل اذ ادبر",
      "aya_indic": "٣٣"
    },
    {
      "sura": 74,
      "aya": 34,
      "text_uthmani": "وَٱلصُّبْحِ إِذَآ أَسْفَرَ",
      "text_normalized": "والصبح اذا اسفر",
      "aya_indic": "٣٤"
    },
    {
      "sura": 74,
      "aya": 35,
      "text_uthmani": "إِنَّهَا لَإِحْدَى ٱلْكُبَرِ",
      "text_normalized": "انها لاحدي الكبر",
      "aya_indic": "٣٥"
    },
    {
      "sura": 74,
      "aya": 36,
      "text_uthmani": "نَذِيرًا لِّلْبَشَرِ",
      "text_normalized": "نذيرا للبشر",
      "aya_indic": "٣٦"
    },
    {
      "sura": 74,
      "aya": 37,
      "text_uthmani": "لِمَن شَآءَ مِنكُمْ أَن يَتَقَدَّمَ أَوْ يَتَأَخَّرَ",
      "text_normalized": "لمن شاء منكم ان يتقدم او يتاخر",
      "aya_indic": "٣٧"
    },
    {
      "sura": 74,
      "aya": 38,
      "text_uthmani": "كُلُّ نَفْسٍۭ بِمَا كَسَبَتْ رَهِينَةٌ",
      "text_normalized": "كل نفس بما كسبت رهينه",
      "aya_indic": "٣٨"
    },
    {
      "sura": 74,
      "aya": 39,
      "text_uthmani": "إِلَّآ أَصْحَٰبَ ٱلْيَمِينِ",
      "text_normalized": "الا اصحاب اليمين",
      "aya_indic": "٣٩"
    },
    {
      "sura": 74,
      "aya": 40,
      "text_uthmani": "فِى جَنَّٰتٍ يَتَسَآءَلُونَ",
      "text_normalized": "في جنات يتساءلون",
      "aya_indic": "٤٠"
    },
    {
      "sura": 74,
      "aya": 41,
      "text_uthmani": "عَنِ ٱلْمُجْرِمِينَ",
      "text_normalized": "عن المجرمين",
      "aya_indic": "٤١"
    },
    {
      "sura": 74,
      "aya": 42,
      "text_uthmani": "مَا سَلَكَكُمْ فِى سَقَرَ",
      "text_normalized": "ما سلككم في سقر",
      "aya_indic": "٤٢"
    },
    {
      "sura": 74,
      "aya": 43,
      "text_uthmani": "قَالُوا۟ لَمْ نَكُ مِنَ ٱلْمُصَلِّينَ",
      "text_normalized": "قالوا لم نك من المصلين",
      "aya_indic": "٤٣"
    },
    {
      "sura": 74,
      "aya": 44,
      "text_uthmani": "وَلَمْ نَكُ نُطْعِمُ ٱلْمِسْكِينَ",
      "text_normalized": "ولم نك نطعم المسكين",
      "aya_indic": "٤٤"
    },
    {
      "sura": 74,
      "aya": 45,
      "text_uthmani": "وَكُنَّا نَخُوضُ مَعَ ٱلْخَآئِضِينَ",
      "text_normalized": "وكنا نخوض مع الخايضين",
      "aya_indic": "٤٥"
    },
    {
      "sura": 74,
      "aya": 46,
      "text_uthmani": "وَكُنَّا نُكَذِّبُ بِيَوْمِ ٱلدِّينِ",
      "text_normalized": "وكنا نكذب بيوم الدين",
      "aya_indic": "٤٦"
    },
    {
      "sura": 74,
      "aya": 47,
      "text_uthmani": "حَتَّىٰٓ أَتَىٰنَا ٱلْيَقِينُ",
      "text_normalized": "حتيا اتيانا اليقين",
      "aya_indic": "٤٧"
    },
    {
      "sura": 74,
      "aya": 48,
      "text_uthmani": "فَمَا تَنفَعُهُمْ شَفَٰعَةُ ٱلشَّٰفِعِينَ",
      "text_normalized": "فما تنفعهم شفاعه الشافعين",
      "aya_indic": "٤٨"
    },
    {
      "sura": 74,
      "aya": 49,
      "text_uthmani": "فَمَا لَهُمْ عَنِ ٱلتَّذْكِرَةِ مُعْرِضِينَ",
      "text_normalized": "فما لهم عن التذكره معرضين",
      "aya_indic": "٤٩"
    },
    {
      "sura": 74,
      "aya": 50,
      "text_uthmani": "كَأَنَّهُمْ حُمُرٌ مُّسْتَنفِرَةٌ",
      "text_normalized": "كانهم حمر مستنفره",
      "aya_indic": "٥٠"
    },
    {
      "sura": 74,
      "aya": 51,
      "text_uthmani": "فَرَّتْ مِن قَسْوَرَةٍۭ",
      "text_normalized": "فرت من قسوره",
      "aya_indic": "٥١"
    },
    {
      "sura": 74,
      "aya": 52,
      "text_uthmani": "بَلْ يُرِيدُ كُلُّ ٱمْرِئٍ مِّنْهُمْ أَن يُؤْتَىٰ صُحُفًا مُّنَشَّرَةً",
      "text_normalized": "بل يريد كل امري منهم ان يوتيا صحفا منشره",
      "aya_indic": "٥٢"
    },
    {
      "sura": 74,
      "aya": 53,
      "text_uthmani": "كَلَّا ۖ بَل لَّا يَخَافُونَ ٱلْـَٔاخِرَةَ",
      "text_normalized": "كلا بل لا يخافون الاخره",
      "aya_indic": "٥٣"
    },
    {
      "sura": 74,
      "aya": 54,
      "text_uthmani": "كَلَّآ إِنَّهُۥ تَذْكِرَةٌ",
      "text_normalized": "كلا انه تذكره",
      "aya_indic": "٥٤"
    },
    {
      "sura": 74,
      "aya": 55,
      "text_uthmani": "فَمَن شَآءَ ذَكَرَهُۥ",
      "text_normalized": "فمن شاء ذكره",
      "aya_indic": "٥٥"
    },
    {
      "sura": 74,
      "aya": 56,
      "text_uthmani": "وَمَا يَذْكُرُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ ۚ هُوَ أَهْلُ ٱلتَّقْوَىٰ وَأَهْلُ ٱلْمَغْفِرَةِ",
      "text_normalized": "وما يذكرون الا ان يشاء الله هو اهل التقويا واهل المغفره",
      "aya_indic": "٥٦"
    }
  ]
}