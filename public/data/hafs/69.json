{
  "id": 69,
  "name_ar": "الحاقة",
  "name_en": "Al-Haqqah",
  "type": "مكية",
  "ayahs_hafs": 52,
  "ayahs_warsh": 51,
  "page": 566,
  "narration": "hafs",
  "narration_ar": "حفص عن عاصم",
  "ayahs": [
    {
      "sura": 69,
      "aya": 1,
      "text_uthmani": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ ٱلْحَآقَّةُ",
      "text_normalized": "بسم الله الرحمن الرحيم الحاقه",
      "aya_indic": "١"
    },
    {
      "sura": 69,
      "aya": 2,
      "text_uthmani": "مَا ٱلْحَآقَّةُ",
      "text_normalized": "ما الحاقه",
      "aya_indic": "٢"
    },
    {
      "sura": 69,
      "aya": 3,
      "text_uthmani": "وَمَآ أَدْرَىٰكَ مَا ٱلْحَآقَّةُ",
      "text_normalized": "وما ادرياك ما الحاقه",
      "aya_indic": "٣"
    },
    {
      "sura": 69,
      "aya": 4,
      "text_uthmani": "كَذَّبَتْ ثَمُودُ وَعَادٌۢ بِٱلْقَارِعَةِ",
      "text_normalized": "كذبت ثمود وعاد بالقارعه",
      "aya_indic": "٤"
    },
    {
      "sura": 69,
      "aya": 5,
      "text_uthmani": "فَأَمَّا ثَمُودُ فَأُهْلِكُوا۟ بِٱلطَّاغِيَةِ",
      "text_normalized": "فاما ثمود فاهلكوا بالطاغيه",
      "aya_indic": "٥"
    },
    {
      "sura": 69,
      "aya": 6,
      "text_uthmani": "وَأَمَّا عَادٌ فَأُهْلِكُوا۟ بِرِيحٍ صَرْصَرٍ عَاتِيَةٍ",
      "text_normalized": "واما عاد فاهلكوا بريح صرصر عاتيه",
      "aya_indic": "٦"
    },
    {
      "sura": 69,
      "aya": 7,
      "text_uthmani": "سَخَّرَهَا عَلَيْهِمْ سَبْعَ لَيَالٍ وَثَمَٰنِيَةَ أَيَّامٍ حُسُومًا فَتَرَى ٱلْقَوْمَ فِيهَا صَرْعَىٰ كَأَنَّهُمْ أَعْجَازُ نَخْلٍ خَاوِيَةٍ",
      "text_normalized": "سخرها عليهم سبع ليال وثمانيه ايام حسوما فتري القوم فيها صرعيا كانهم اعجاز نخل خاويه",
      "aya_indic": "٧"
    },
    {
      "sura": 69,
      "aya": 8,
      "text_uthmani": "فَهَلْ تَرَىٰ لَهُم مِّنۢ بَاقِيَةٍ",
      "text_normalized": "فهل تريا لهم من باقيه",
      "aya_indic": "٨"
    },
    {
      "sura": 69,
      "aya": 9,
      "text_uthmani": "وَجَآءَ فِرْعَوْنُ وَمَن قَبْلَهُۥ وَٱلْمُؤْتَفِكَٰتُ بِٱلْخَاطِئَةِ",
      "text_normalized": "وجاء فرعون ومن قبله والموتفكات بالخاطيه",
      "aya_indic": "٩"
    },
    {
      "sura": 69,
      "aya": 10,
      "text_uthmani": "فَعَصَوْا۟ رَسُولَ رَبِّهِمْ فَأَخَذَهُمْ أَخْذَةً رَّابِيَةً",
      "text_normalized": "فعصوا رسول ربهم فاخذهم اخذه رابيه",
      "aya_indic": "١٠"
    },
    {
      "sura": 69,
      "aya": 11,
      "text_uthmani": "إِنَّا لَمَّا طَغَا ٱلْمَآءُ حَمَلْنَٰكُمْ فِى ٱلْجَارِيَةِ",
      "text_normalized": "انا لما طغا الماء حملناكم في الجاريه",
      "aya_indic": "١١"
    },
    {
      "sura": 69,
      "aya": 12,
      "text_uthmani": "لِنَجْعَلَهَا لَكُمْ تَذْكِرَةً وَتَعِيَهَآ أُذُنٌ وَٰعِيَةٌ",
      "text_normalized": "لنجعلها لكم تذكره وتعيها اذن واعيه",
      "aya_indic": "١٢"
    },
    {
      "sura": 69,
      "aya": 13,
      "text_uthmani": "فَإِذَا نُفِخَ فِى ٱلصُّورِ نَفْخَةٌ وَٰحِدَةٌ",
      "text_normalized": "فاذا نفخ في الصور نفخه واحده",
      "aya_indic": "١٣"
    },
    {
      "sura": 69,
      "aya": 14,
      "text_uthmani": "وَحُمِلَتِ ٱلْأَرْضُ وَٱلْجِبَالُ فَدُكَّتَا دَكَّةً وَٰحِدَةً",
      "text_normalized": "وحملت الارض والجبال فدكتا دكه واحده",
      "aya_indic": "١٤"
    },
    {
      "sura": 69,
      "aya": 15,
      "text_uthmani": "فَيَوْمَئِذٍ وَقَعَتِ ٱلْوَاقِعَةُ",
      "text_normalized": "فيوميذ وقعت الواقعه",
      "aya_indic": "١٥"
    },
    {
      "sura": 69,
      "aya": 16,
      "text_uthmani": "وَٱنشَقَّتِ ٱلسَّمَآءُ فَهِىَ يَوْمَئِذٍ وَاهِيَةٌ",
      "text_normalized": "وانشقت السماء فهي يوميذ واهيه",
      "aya_indic": "١٦"
    },
    {
      "sura": 69,
      "aya": 17,
      "text_uthmani": "وَٱلْمَلَكُ عَلَىٰٓ أَرْجَآئِهَا ۚ وَيَحْمِلُ عَرْشَ رَبِّكَ فَوْقَهُمْ يَوْمَئِذٍ ثَمَٰنِيَةٌ",
      "text_normalized": "والملك عليا ارجايها ويحمل عرش ربك فوقهم يوميذ ثمانيه",
      "aya_indic": "١٧"
    },
    {
      "sura": 69,
      "aya": 18,
      "text_uthmani": "يَوْمَئِذٍ تُعْرَضُونَ لَا تَخْفَىٰ مِنكُمْ خَافِيَةٌ",
      "text_normalized": "يوميذ تعرضون لا تخفيا منكم خافيه",
      "aya_indic": "١٨"
    },
    {
      "sura": 69,
      "aya": 19,
      "text_uthmani": "فَأَمَّا مَنْ أُوتِىَ كِتَٰبَهُۥ بِيَمِينِهِۦ فَيَقُولُ هَآؤُمُ ٱقْرَءُوا۟ كِتَٰبِيَهْ",
      "text_normalized": "فاما من اوتي كتابه بيمينه فيقول هاوم اقرءوا كتابيه",
      "aya_indic": "١٩"
    },
    {
      "sura": 69,
      "aya": 20,
      "text_uthmani": "إِنِّى ظَنَنتُ أَنِّى مُلَٰقٍ حِسَابِيَهْ",
      "text_normalized": "اني ظننت اني ملاق حسابيه",
      "aya_indic": "٢٠"
    },
    {
      "sura": 69,
      "aya": 21,
      "text_uthmani": "فَهُوَ فِى عِيشَةٍ رَّاضِيَةٍ",
      "text_normalized": "فهو في عيشه راضيه",
      "aya_indic": "٢١"
    },
    {
      "sura": 69,
      "aya": 22,
      "text_uthmani": "فِى جَنَّةٍ عَالِيَةٍ",
      "text_normalized": "في جنه عاليه",
      "aya_indic": "٢٢"
    },
    {
      "sura": 69,
      "aya": 23,
      "text_uthmani": "قُطُوفُهَا دَانِيَةٌ",
      "text_normalized": "قطوفها دانيه",
      "aya_indic": "٢٣"
    },
    {
      "sura": 69,
      "aya": 24,
      "text_uthmani": "كُلُوا۟ وَٱشْرَبُوا۟ هَنِيٓـًٔۢا بِمَآ أَسْلَفْتُمْ فِى ٱلْأَيَّامِ ٱلْخَالِيَةِ",
      "text_normalized": "كلوا واشربوا هنيا بما اسلفتم في الايام الخاليه",
      "aya_indic": "٢٤"
    },
    {
      "sura": 69,
      "aya": 25,
      "text_uthmani": "وَأَمَّا مَنْ أُوتِىَ كِتَٰبَهُۥ بِشِمَالِهِۦ فَيَقُولُ يَٰلَيْتَنِى لَمْ أُوتَ كِتَٰبِيَهْ",
      "text_normalized": "واما من اوتي كتابه بشماله فيقول ياليتني لم اوت كتابيه",
      "aya_indic": "٢٥"
    },
    {
      "sura": 69,
      "aya": 26,
      "text_uthmani": "وَلَمْ أَدْرِ مَا حِسَابِيَهْ",
      "text_normalized": "ولم ادر ما حسابيه",
      "aya_indic": "٢٦"
    },
    {
      "sura": 69,
      "aya": 27,
      "text_uthmani": "يَٰلَيْتَهَا كَانَتِ ٱلْقَاضِيَةَ",
      "text_normalized": "ياليتها كانت القاضيه",
      "aya_indic": "٢٧"
    },
    {
      "sura": 69,
      "aya": 28,
      "text_uthmani": "مَآ أَغْنَىٰ عَنِّى مَالِيَهْ ۜ",
      "text_normalized": "ما اغنيا عني ماليه",
      "aya_indic": "٢٨"
    },
    {
      "sura": 69,
      "aya": 29,
      "text_uthmani": "هَلَكَ عَنِّى سُلْطَٰنِيَهْ",
      "text_normalized": "هلك عني سلطانيه",
      "aya_indic": "٢٩"
    },
    {
      "sura": 69,
      "aya": 30,
      "text_uthmani": "خُذُوهُ فَغُلُّوهُ",
      "text_normalized": "خذوه فغلوه",
      "aya_indic": "٣٠"
    },
    {
      "sura": 69,
      "aya": 31,
      "text_uthmani": "ثُمَّ ٱلْجَحِيمَ صَلُّوهُ",
      "text_normalized": "ثم الجحيم صلوه",
      "aya_indic": "٣١"
    },
    {
      "sura": 69,
      "aya": 32,
      "text_uthmani": "ثُمَّ فِى سِلْسِلَةٍ ذَرْعُهَا سَبْعُونَ ذِرَاعًا فَٱسْلُكُوهُ",
      "text_normalized": "ثم في سلسله ذرعها سبعون ذراعا فاسلكوه",
      "aya_indic": "٣٢"
    },
    {
      "sura": 69,
      "aya": 33,
      "text_uthmani": "إِنَّهُۥ كَانَ لَا يُؤْمِنُ بِٱللَّهِ ٱلْعَظِيمِ",
      "text_normalized": "انه كان لا يومن بالله العظيم",
      "aya_indic": "٣٣"
    },
    {
      "sura": 69,
      "aya": 34,
      "text_uthmani": "وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ",
      "text_normalized": "ولا يحض عليا طعام المسكين",
      "aya_indic": "٣٤"
    },
    {
      "sura": 69,
      "aya": 35,
      "text_uthmani": "فَلَيْسَ لَهُ ٱلْيَوْمَ هَٰهُنَا حَمِيمٌ",
      "text_normalized": "فليس له اليوم هاهنا حميم",
      "aya_indic": "٣٥"
    },
    {
      "sura": 69,
      "aya": 36,
      "text_uthmani": "وَلَا طَعَامٌ إِلَّا مِنْ غِسْلِينٍ",
      "text_normalized": "ولا طعام الا من غسلين",
      "aya_indic": "٣٦"
    },
    {
      "sura": 69,
      "aya": 37,
      "text_uthmani": "لَّا يَأْكُلُهُۥٓ إِلَّا ٱلْخَٰطِـُٔونَ",
      "text_normalized": "لا ياكله الا الخاطون",
      "aya_indic": "٣٧"
    },
    {
      "sura": 69,
      "aya": 38,
      "text_uthmani": "فَلَآ أُقْسِمُ بِمَا تُبْصِرُونَ",
      "text_normalized": "فلا اقسم بما تبصرون",
      "aya_indic": "٣٨"
    },
    {
      "sura": 69,
      "aya": 39,
      "text_uthmani": "وَمَا لَا تُبْصِرُونَ",
      "text_normalized": "وما لا تبصرون",
      "aya_indic": "٣٩"
    },
    {
      "sura": 69,
      "aya": 40,
      "text_uthmani": "إِنَّهُۥ لَقَوْلُ رَسُولٍ كَرِيمٍ",
      "text_normalized": "انه لقول رسول كريم",
      "aya_indic": "٤٠"
    },
    {
      "sura": 69,
      "aya": 41,
      "text_uthmani": "وَمَا هُوَ بِقَوْلِ شَاعِرٍ ۚ قَلِيلًا مَّا تُؤْمِنُونَ",
      "text_normalized": "وما هو بقول شاعر قليلا ما تومنون",
      "aya_indic": "٤١"
    },
    {
      "sura": 69,
      "aya": 42,
      "text_uthmani": "وَلَا بِقَوْلِ كَاهِنٍ ۚ قَلِيلًا مَّا تَذَكَّرُونَ",
      "text_normalized": "ولا بقول كاهن قليلا ما تذكرون",
      "aya_indic": "٤٢"
    },
    {
      "sura": 69,
      "aya": 43,
      "text_uthmani": "تَنزِيلٌ مِّن رَّبِّ ٱلْعَٰلَمِينَ",
      "text_normalized": "تنزيل من رب العالمين",
      "aya_indic": "٤٣"
    },
    {
      "sura": 69,
      "aya": 44,
      "text_uthmani": "وَلَوْ تَقَوَّلَ عَلَيْنَا بَعْضَ ٱلْأَقَاوِيلِ",
      "text_normalized": "ولو تقول علينا بعض الاقاويل",
      "aya_indic": "٤٤"
    },
    {
      "sura": 69,
      "aya": 45,
      "text_uthmani": "لَأَخَذْنَا مِنْهُ بِٱلْيَمِينِ",
      "text_normalized": "لاخذنا منه باليمين",
      "aya_indic": "٤٥"
    },
    {
      "sura": 69,
      "aya": 46,
      "text_uthmani": "ثُمَّ لَقَطَعْنَا مِنْهُ ٱلْوَتِينَ",
      "text_normalized": "ثم لقطعنا منه الوتين",
      "aya_indic": "٤٦"
    },
    {
      "sura": 69,
      "aya": 47,
      "text_uthmani": "فَمَا مِنكُم مِّنْ أَحَدٍ عَنْهُ حَٰجِزِينَ",
      "text_normalized": "فما منكم من احد عنه حاجزين",
      "aya_indic": "٤٧"
    },
    {
      "sura": 69,
      "aya": 48,
      "text_uthmani": "وَإِنَّهُۥ لَتَذْكِرَةٌ لِّلْمُتَّقِينَ",
      "text_normalized": "وانه لتذكره للمتقين",
      "aya_indic": "٤٨"
    },
    {
      "sura": 69,
      "aya": 49,
      "text_uthmani": "وَإِنَّا لَنَعْلَمُ أَنَّ مِنكُم مُّكَذِّبِينَ",
      "text_normalized": "وانا لنعلم ان منكم مكذبين",
      "aya_indic": "٤٩"
    },
    {
      "sura": 69,
      "aya": 50,
      "text_uthmani": "وَإِنَّهُۥ لَحَسْرَةٌ عَلَى ٱلْكَٰفِرِينَ",
      "text_normalized": "وانه لحسره علي الكافرين",
      "aya_indic": "٥٠"
    },
    {
      "sura": 69,
      "aya": 51,
      "text_uthmani": "وَإِنَّهُۥ لَحَقُّ ٱلْيَقِينِ",
      "text_normalized": "وانه لحق اليقين",
      "aya_indic": "٥١"
    },
    {
      "sura": 69,
      "aya": 52,
      "text_uthmani": "فَسَبِّحْ بِٱسْمِ رَبِّكَ ٱلْعَظِيمِ",
      "text_normalized": "فسبح باسم ربك العظيم",
      "aya_indic": "٥٢"
    }
  ]
}