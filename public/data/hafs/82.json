{
  "id": 82,
  "name_ar": "الانفطار",
  "name_en": "Al-Infitar",
  "type": "مكية",
  "ayahs_hafs": 19,
  "ayahs_warsh": 19,
  "page": 587,
  "narration": "hafs",
  "narration_ar": "حفص عن عاصم",
  "ayahs": [
    {
      "sura": 82,
      "aya": 1,
      "text_uthmani": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِذَا ٱلسَّمَآءُ ٱنفَطَرَتْ",
      "text_normalized": "بسم الله الرحمن الرحيم اذا السماء انفطرت",
      "aya_indic": "١"
    },
    {
      "sura": 82,
      "aya": 2,
      "text_uthmani": "وَإِذَا ٱلْكَوَاكِبُ ٱنتَثَرَتْ",
      "text_normalized": "واذا الكواكب انتثرت",
      "aya_indic": "٢"
    },
    {
      "sura": 82,
      "aya": 3,
      "text_uthmani": "وَإِذَا ٱلْبِحَارُ فُجِّرَتْ",
      "text_normalized": "واذا البحار فجرت",
      "aya_indic": "٣"
    },
    {
      "sura": 82,
      "aya": 4,
      "text_uthmani": "وَإِذَا ٱلْقُبُورُ بُعْثِرَتْ",
      "text_normalized": "واذا القبور بعثرت",
      "aya_indic": "٤"
    },
    {
      "sura": 82,
      "aya": 5,
      "text_uthmani": "عَلِمَتْ نَفْسٌ مَّا قَدَّمَتْ وَأَخَّرَتْ",
      "text_normalized": "علمت نفس ما قدمت واخرت",
      "aya_indic": "٥"
    },
    {
      "sura": 82,
      "aya": 6,
      "text_uthmani": "يَٰٓأَيُّهَا ٱلْإِنسَٰنُ مَا غَرَّكَ بِرَبِّكَ ٱلْكَرِيمِ",
      "text_normalized": "ياايها الانسان ما غرك بربك الكريم",
      "aya_indic": "٦"
    },
    {
      "sura": 82,
      "aya": 7,
      "text_uthmani": "ٱلَّذِى خَلَقَكَ فَسَوَّىٰكَ فَعَدَلَكَ",
      "text_normalized": "الذي خلقك فسوياك فعدلك",
      "aya_indic": "٧"
    },
    {
      "sura": 82,
      "aya": 8,
      "text_uthmani": "فِىٓ أَىِّ صُورَةٍ مَّا شَآءَ رَكَّبَكَ",
      "text_normalized": "في اي صوره ما شاء ركبك",
      "aya_indic": "٨"
    },
    {
      "sura": 82,
      "aya": 9,
      "text_uthmani": "كَلَّا بَلْ تُكَذِّبُونَ بِٱلدِّينِ",
      "text_normalized": "كلا بل تكذبون بالدين",
      "aya_indic": "٩"
    },
    {
      "sura": 82,
      "aya": 10,
      "text_uthmani": "وَإِنَّ عَلَيْكُمْ لَحَٰفِظِينَ",
      "text_normalized": "وان عليكم لحافظين",
      "aya_indic": "١٠"
    },
    {
      "sura": 82,
      "aya": 11,
      "text_uthmani": "كِرَامًا كَٰتِبِينَ",
      "text_normalized": "كراما كاتبين",
      "aya_indic": "١١"
    },
    {
      "sura": 82,
      "aya": 12,
      "text_uthmani": "يَعْلَمُونَ مَا تَفْعَلُونَ",
      "text_normalized": "يعلمون ما تفعلون",
      "aya_indic": "١٢"
    },
    {
      "sura": 82,
      "aya": 13,
      "text_uthmani": "إِنَّ ٱلْأَبْرَارَ لَفِى نَعِيمٍ",
      "text_normalized": "ان الابرار لفي نعيم",
      "aya_indic": "١٣"
    },
    {
      "sura": 82,
      "aya": 14,
      "text_uthmani": "وَإِنَّ ٱلْفُجَّارَ لَفِى جَحِيمٍ",
      "text_normalized": "وان الفجار لفي جحيم",
      "aya_indic": "١٤"
    },
    {
      "sura": 82,
      "aya": 15,
      "text_uthmani": "يَصْلَوْنَهَا يَوْمَ ٱلدِّينِ",
      "text_normalized": "يصلونها يوم الدين",
      "aya_indic": "١٥"
    },
    {
      "sura": 82,
      "aya": 16,
      "text_uthmani": "وَمَا هُمْ عَنْهَا بِغَآئِبِينَ",
      "text_normalized": "وما هم عنها بغايبين",
      "aya_indic": "١٦"
    },
    {
      "sura": 82,
      "aya": 17,
      "text_uthmani": "وَمَآ أَدْرَىٰكَ مَا يَوْمُ ٱلدِّينِ",
      "text_normalized": "وما ادرياك ما يوم الدين",
      "aya_indic": "١٧"
    },
    {
      "sura": 82,
      "aya": 18,
      "text_uthmani": "ثُمَّ مَآ أَدْرَىٰكَ مَا يَوْمُ ٱلدِّينِ",
      "text_normalized": "ثم ما ادرياك ما يوم الدين",
      "aya_indic": "١٨"
    },
    {
      "sura": 82,
      "aya": 19,
      "text_uthmani": "يَوْمَ لَا تَمْلِكُ نَفْسٌ لِّنَفْسٍ شَيْـًٔا ۖ وَٱلْأَمْرُ يَوْمَئِذٍ لِّلَّهِ",
      "text_normalized": "يوم لا تملك نفس لنفس شيا والامر يوميذ لله",
      "aya_indic": "١٩"
    }
  ]
}