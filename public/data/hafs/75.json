{
  "id": 75,
  "name_ar": "القيامة",
  "name_en": "Al-Qiyamah",
  "type": "مكية",
  "ayahs_hafs": 40,
  "ayahs_warsh": 39,
  "page": 577,
  "narration": "hafs",
  "narration_ar": "حفص عن عاصم",
  "ayahs": [
    {
      "sura": 75,
      "aya": 1,
      "text_uthmani": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ لَآ أُقْسِمُ بِيَوْمِ ٱلْقِيَٰمَةِ",
      "text_normalized": "بسم الله الرحمن الرحيم لا اقسم بيوم القيامه",
      "aya_indic": "١"
    },
    {
      "sura": 75,
      "aya": 2,
      "text_uthmani": "وَلَآ أُقْسِمُ بِٱلنَّفْسِ ٱللَّوَّامَةِ",
      "text_normalized": "ولا اقسم بالنفس اللوامه",
      "aya_indic": "٢"
    },
    {
      "sura": 75,
      "aya": 3,
      "text_uthmani": "أَيَحْسَبُ ٱلْإِنسَٰنُ أَلَّن نَّجْمَعَ عِظَامَهُۥ",
      "text_normalized": "ايحسب الانسان الن نجمع عظامه",
      "aya_indic": "٣"
    },
    {
      "sura": 75,
      "aya": 4,
      "text_uthmani": "بَلَىٰ قَٰدِرِينَ عَلَىٰٓ أَن نُّسَوِّىَ بَنَانَهُۥ",
      "text_normalized": "بليا قادرين عليا ان نسوي بنانه",
      "aya_indic": "٤"
    },
    {
      "sura": 75,
      "aya": 5,
      "text_uthmani": "بَلْ يُرِيدُ ٱلْإِنسَٰنُ لِيَفْجُرَ أَمَامَهُۥ",
      "text_normalized": "بل يريد الانسان ليفجر امامه",
      "aya_indic": "٥"
    },
    {
      "sura": 75,
      "aya": 6,
      "text_uthmani": "يَسْـَٔلُ أَيَّانَ يَوْمُ ٱلْقِيَٰمَةِ",
      "text_normalized": "يسل ايان يوم القيامه",
      "aya_indic": "٦"
    },
    {
      "sura": 75,
      "aya": 7,
      "text_uthmani": "فَإِذَا بَرِقَ ٱلْبَصَرُ",
      "text_normalized": "فاذا برق البصر",
      "aya_indic": "٧"
    },
    {
      "sura": 75,
      "aya": 8,
      "text_uthmani": "وَخَسَفَ ٱلْقَمَرُ",
      "text_normalized": "وخسف القمر",
      "aya_indic": "٨"
    },
    {
      "sura": 75,
      "aya": 9,
      "text_uthmani": "وَجُمِعَ ٱلشَّمْسُ وَٱلْقَمَرُ",
      "text_normalized": "وجمع الشمس والقمر",
      "aya_indic": "٩"
    },
    {
      "sura": 75,
      "aya": 10,
      "text_uthmani": "يَقُولُ ٱلْإِنسَٰنُ يَوْمَئِذٍ أَيْنَ ٱلْمَفَرُّ",
      "text_normalized": "يقول الانسان يوميذ اين المفر",
      "aya_indic": "١٠"
    },
    {
      "sura": 75,
      "aya": 11,
      "text_uthmani": "كَلَّا لَا وَزَرَ",
      "text_normalized": "كلا لا وزر",
      "aya_indic": "١١"
    },
    {
      "sura": 75,
      "aya": 12,
      "text_uthmani": "إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمُسْتَقَرُّ",
      "text_normalized": "اليا ربك يوميذ المستقر",
      "aya_indic": "١٢"
    },
    {
      "sura": 75,
      "aya": 13,
      "text_uthmani": "يُنَبَّؤُا۟ ٱلْإِنسَٰنُ يَوْمَئِذٍۭ بِمَا قَدَّمَ وَأَخَّرَ",
      "text_normalized": "ينبوا الانسان يوميذ بما قدم واخر",
      "aya_indic": "١٣"
    },
    {
      "sura": 75,
      "aya": 14,
      "text_uthmani": "بَلِ ٱلْإِنسَٰنُ عَلَىٰ نَفْسِهِۦ بَصِيرَةٌ",
      "text_normalized": "بل الانسان عليا نفسه بصيره",
      "aya_indic": "١٤"
    },
    {
      "sura": 75,
      "aya": 15,
      "text_uthmani": "وَلَوْ أَلْقَىٰ مَعَاذِيرَهُۥ",
      "text_normalized": "ولو القيا معاذيره",
      "aya_indic": "١٥"
    },
    {
      "sura": 75,
      "aya": 16,
      "text_uthmani": "لَا تُحَرِّكْ بِهِۦ لِسَانَكَ لِتَعْجَلَ بِهِۦٓ",
      "text_normalized": "لا تحرك به لسانك لتعجل به",
      "aya_indic": "١٦"
    },
    {
      "sura": 75,
      "aya": 17,
      "text_uthmani": "إِنَّ عَلَيْنَا جَمْعَهُۥ وَقُرْءَانَهُۥ",
      "text_normalized": "ان علينا جمعه وقرءانه",
      "aya_indic": "١٧"
    },
    {
      "sura": 75,
      "aya": 18,
      "text_uthmani": "فَإِذَا قَرَأْنَٰهُ فَٱتَّبِعْ قُرْءَانَهُۥ",
      "text_normalized": "فاذا قراناه فاتبع قرءانه",
      "aya_indic": "١٨"
    },
    {
      "sura": 75,
      "aya": 19,
      "text_uthmani": "ثُمَّ إِنَّ عَلَيْنَا بَيَانَهُۥ",
      "text_normalized": "ثم ان علينا بيانه",
      "aya_indic": "١٩"
    },
    {
      "sura": 75,
      "aya": 20,
      "text_uthmani": "كَلَّا بَلْ تُحِبُّونَ ٱلْعَاجِلَةَ",
      "text_normalized": "كلا بل تحبون العاجله",
      "aya_indic": "٢٠"
    },
    {
      "sura": 75,
      "aya": 21,
      "text_uthmani": "وَتَذَرُونَ ٱلْـَٔاخِرَةَ",
      "text_normalized": "وتذرون الاخره",
      "aya_indic": "٢١"
    },
    {
      "sura": 75,
      "aya": 22,
      "text_uthmani": "وُجُوهٌ يَوْمَئِذٍ نَّاضِرَةٌ",
      "text_normalized": "وجوه يوميذ ناضره",
      "aya_indic": "٢٢"
    },
    {
      "sura": 75,
      "aya": 23,
      "text_uthmani": "إِلَىٰ رَبِّهَا نَاظِرَةٌ",
      "text_normalized": "اليا ربها ناظره",
      "aya_indic": "٢٣"
    },
    {
      "sura": 75,
      "aya": 24,
      "text_uthmani": "وَوُجُوهٌ يَوْمَئِذٍۭ بَاسِرَةٌ",
      "text_normalized": "ووجوه يوميذ باسره",
      "aya_indic": "٢٤"
    },
    {
      "sura": 75,
      "aya": 25,
      "text_uthmani": "تَظُنُّ أَن يُفْعَلَ بِهَا فَاقِرَةٌ",
      "text_normalized": "تظن ان يفعل بها فاقره",
      "aya_indic": "٢٥"
    },
    {
      "sura": 75,
      "aya": 26,
      "text_uthmani": "كَلَّآ إِذَا بَلَغَتِ ٱلتَّرَاقِىَ",
      "text_normalized": "كلا اذا بلغت التراقي",
      "aya_indic": "٢٦"
    },
    {
      "sura": 75,
      "aya": 27,
      "text_uthmani": "وَقِيلَ مَنْ ۜ رَاقٍ",
      "text_normalized": "وقيل من راق",
      "aya_indic": "٢٧"
    },
    {
      "sura": 75,
      "aya": 28,
      "text_uthmani": "وَظَنَّ أَنَّهُ ٱلْفِرَاقُ",
      "text_normalized": "وظن انه الفراق",
      "aya_indic": "٢٨"
    },
    {
      "sura": 75,
      "aya": 29,
      "text_uthmani": "وَٱلْتَفَّتِ ٱلسَّاقُ بِٱلسَّاقِ",
      "text_normalized": "والتفت الساق بالساق",
      "aya_indic": "٢٩"
    },
    {
      "sura": 75,
      "aya": 30,
      "text_uthmani": "إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمَسَاقُ",
      "text_normalized": "اليا ربك يوميذ المساق",
      "aya_indic": "٣٠"
    },
    {
      "sura": 75,
      "aya": 31,
      "text_uthmani": "فَلَا صَدَّقَ وَلَا صَلَّىٰ",
      "text_normalized": "فلا صدق ولا صليا",
      "aya_indic": "٣١"
    },
    {
      "sura": 75,
      "aya": 32,
      "text_uthmani": "وَلَٰكِن كَذَّبَ وَتَوَلَّىٰ",
      "text_normalized": "ولاكن كذب وتوليا",
      "aya_indic": "٣٢"
    },
    {
      "sura": 75,
      "aya": 33,
      "text_uthmani": "ثُمَّ ذَهَبَ إِلَىٰٓ أَهْلِهِۦ يَتَمَطَّىٰٓ",
      "text_normalized": "ثم ذهب اليا اهله يتمطيا",
      "aya_indic": "٣٣"
    },
    {
      "sura": 75,
      "aya": 34,
      "text_uthmani": "أَوْلَىٰ لَكَ فَأَوْلَىٰ",
      "text_normalized": "اوليا لك فاوليا",
      "aya_indic": "٣٤"
    },
    {
      "sura": 75,
      "aya": 35,
      "text_uthmani": "ثُمَّ أَوْلَىٰ لَكَ فَأَوْلَىٰٓ",
      "text_normalized": "ثم اوليا لك فاوليا",
      "aya_indic": "٣٥"
    },
    {
      "sura": 75,
      "aya": 36,
      "text_uthmani": "أَيَحْسَبُ ٱلْإِنسَٰنُ أَن يُتْرَكَ سُدًى",
      "text_normalized": "ايحسب الانسان ان يترك سدي",
      "aya_indic": "٣٦"
    },
    {
      "sura": 75,
      "aya": 37,
      "text_uthmani": "أَلَمْ يَكُ نُطْفَةً مِّن مَّنِىٍّ يُمْنَىٰ",
      "text_normalized": "الم يك نطفه من مني يمنيا",
      "aya_indic": "٣٧"
    },
    {
      "sura": 75,
      "aya": 38,
      "text_uthmani": "ثُمَّ كَانَ عَلَقَةً فَخَلَقَ فَسَوَّىٰ",
      "text_normalized": "ثم كان علقه فخلق فسويا",
      "aya_indic": "٣٨"
    },
    {
      "sura": 75,
      "aya": 39,
      "text_uthmani": "فَجَعَلَ مِنْهُ ٱلزَّوْجَيْنِ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ",
      "text_normalized": "فجعل منه الزوجين الذكر والانثيا",
      "aya_indic": "٣٩"
    },
    {
      "sura": 75,
      "aya": 40,
      "text_uthmani": "أَلَيْسَ ذَٰلِكَ بِقَٰدِرٍ عَلَىٰٓ أَن يُحْـِۧىَ ٱلْمَوْتَىٰ",
      "text_normalized": "اليس ذلك بقادر عليا ان يحي الموتيا",
      "aya_indic": "٤٠"
    }
  ]
}