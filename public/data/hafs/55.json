    {
      "sura": 55,
      "aya": 47,
      "text_uthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "text_normalized": "فباي ءالاء ربكما تكذبان",
      "aya_indic": "٤٧"
    },
    {
      "sura": 55,
      "aya": 48,
      "text_uthmani": "ذَوَاتَآ أَفْنَانٍ",
      "text_normalized": "ذواتا افنان",
      "aya_indic": "٤٨"
    },
    {
      "sura": 55,
      "aya": 49,
      "text_uthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "text_normalized": "فباي ءالاء ربكما تكذبان",
      "aya_indic": "٤٩"
    },
    {
      "sura": 55,
      "aya": 50,
      "text_uthmani": "فِيهِمَا عَيْنَانِ تَجْرِيَانِ",
