      "text_normalized": "فباي ءالاء ربكما تكذبان",
      "aya_indic": "٥١"
    },
    {
      "sura": 55,
      "aya": 52,
      "text_uthmani": "فِيهِمَا مِن كُلِّ فَٰكِهَةٍ زَوْجَانِ",
