  "narration": "hafs",
  "narration_ar": "حفص عن عاصم",
  "ayahs": [
    {
      "sura": 55,
      "aya": 1,
      "text_uthmani": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ ٱلرَّحْمَٰنُ",
      "text_normalized": "بسم الله الرحمن الرحيم الرحمن",
      "aya_indic": "١"
    },
    {
      "sura": 55,
      "aya": 2,
      "text_uthmani": "عَلَّمَ ٱلْقُرْءَانَ",
      "text_normalized": "علم القرءان",
      "aya_indic": "٢"
    },
    {
      "sura": 55,
      "aya": 3,
      "text_uthmani": "خَلَقَ ٱلْإِنسَٰنَ",
      "text_normalized": "خلق الانسان",
      "aya_indic": "٣"
    },
    {
      "sura": 55,
      "aya": 4,
      "text_uthmani": "عَلَّمَهُ ٱلْبَيَانَ",
      "text_normalized": "علمه البيان",
      "aya_indic": "٤"
    },
    {
      "sura": 55,
      "aya": 5,
      "text_uthmani": "ٱلشَّمْسُ وَٱلْقَمَرُ بِحُسْبَانٍ",
      "text_normalized": "الشمس والقمر بحسبان",
      "aya_indic": "٥"
    },
    {
      "sura": 55,
      "aya": 6,
      "text_uthmani": "وَٱلنَّجْمُ وَٱلشَّجَرُ يَسْجُدَانِ",
      "text_normalized": "والنجم والشجر يسجدان",
      "aya_indic": "٦"
    },
    {
      "sura": 55,
      "aya": 7,
      "text_uthmani": "وَٱلسَّمَآءَ رَفَعَهَا وَوَضَعَ ٱلْمِيزَانَ",
      "text_normalized": "والسماء رفعها ووضع الميزان",
      "aya_indic": "٧"
    },
    {
      "sura": 55,
      "aya": 8,
      "text_uthmani": "أَلَّا تَطْغَوْا۟ فِى ٱلْمِيزَانِ",
      "text_normalized": "الا تطغوا في الميزان",
      "aya_indic": "٨"
    },
    {
      "sura": 55,
      "aya": 9,
      "text_uthmani": "وَأَقِيمُوا۟ ٱلْوَزْنَ بِٱلْقِسْطِ وَلَا تُخْسِرُوا۟ ٱلْمِيزَانَ",
      "text_normalized": "واقيموا الوزن بالقسط ولا تخسروا الميزان",
      "aya_indic": "٩"
    },
    {
      "sura": 55,
      "aya": 10,
      "text_uthmani": "وَٱلْأَرْضَ وَضَعَهَا لِلْأَنَامِ",
      "text_normalized": "والارض وضعها للانام",
      "aya_indic": "١٠"
    },
    {
      "sura": 55,
      "aya": 11,
      "text_uthmani": "فِيهَا فَٰكِهَةٌ وَٱلنَّخْلُ ذَاتُ ٱلْأَكْمَامِ",
      "text_normalized": "فيها فاكهه والنخل ذات الاكمام",
      "aya_indic": "١١"
    },
    {
      "sura": 55,
      "aya": 12,
      "text_uthmani": "وَٱلْحَبُّ ذُو ٱلْعَصْفِ وَٱلرَّيْحَانُ",
      "text_normalized": "والحب ذو العصف والريحان",
      "aya_indic": "١٢"
    },
    {
      "sura": 55,
      "aya": 13,
      "text_uthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "text_normalized": "فباي ءالاء ربكما تكذبان",
      "aya_indic": "١٣"
    },
    {
      "sura": 55,
      "aya": 14,
      "text_uthmani": "خَلَقَ ٱلْإِنسَٰنَ مِن صَلْصَٰلٍ كَٱلْفَخَّارِ",
      "text_normalized": "خلق الانسان من صلصال كالفخار",
      "aya_indic": "١٤"
    },
    {
      "sura": 55,
      "aya": 15,
      "text_uthmani": "وَخَلَقَ ٱلْجَآنَّ مِن مَّارِجٍ مِّن نَّارٍ",
      "text_normalized": "وخلق الجان من مارج من نار",
      "aya_indic": "١٥"
    },
    {
      "sura": 55,
      "aya": 16,
      "text_uthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "text_normalized": "فباي ءالاء ربكما تكذبان",
      "aya_indic": "١٦"
    },
    {
      "sura": 55,
      "aya": 17,
      "text_uthmani": "رَبُّ ٱلْمَشْرِقَيْنِ وَرَبُّ ٱلْمَغْرِبَيْنِ",
      "text_normalized": "رب المشرقين ورب المغربين",
      "aya_indic": "١٧"
    },
    {
      "sura": 55,
      "aya": 18,
      "text_uthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "text_normalized": "فباي ءالاء ربكما تكذبان",
      "aya_indic": "١٨"
    },
    {
      "sura": 55,
      "aya": 19,
      "text_uthmani": "مَرَجَ ٱلْبَحْرَيْنِ يَلْتَقِيَانِ",
      "text_normalized": "مرج البحرين يلتقيان",
      "aya_indic": "١٩"
    },
    {
      "sura": 55,
      "aya": 20,
      "text_uthmani": "بَيْنَهُمَا بَرْزَخٌ لَّا يَبْغِيَانِ",
      "text_normalized": "بينهما برزخ لا يبغيان",
      "aya_indic": "٢٠"
    },
    {
      "sura": 55,
      "aya": 21,
      "text_uthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "text_normalized": "فباي ءالاء ربكما تكذبان",
      "aya_indic": "٢١"
    },
    {
      "sura": 55,
      "aya": 22,
      "text_uthmani": "يَخْرُجُ مِنْهُمَا ٱللُّؤْلُؤُ وَٱلْمَرْجَانُ",
      "text_normalized": "يخرج منهما اللولو والمرجان",
      "aya_indic": "٢٢"
    },
    {
      "sura": 55,
      "aya": 23,
      "text_uthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "text_normalized": "فباي ءالاء ربكما تكذبان",
      "aya_indic": "٢٣"
    },
    {
      "sura": 55,
      "aya": 24,
      "text_uthmani": "وَلَهُ ٱلْجَوَارِ ٱلْمُنشَـَٔاتُ فِى ٱلْبَحْرِ كَٱلْأَعْلَٰمِ",
      "text_normalized": "وله الجوار المنشات في البحر كالاعلام",
      "aya_indic": "٢٤"
    },
    {
      "sura": 55,
      "aya": 25,
      "text_uthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "text_normalized": "فباي ءالاء ربكما تكذبان",
      "aya_indic": "٢٥"
    },
    {
      "sura": 55,
      "aya": 26,
      "text_uthmani": "كُلُّ مَنْ عَلَيْهَا فَانٍ",
      "text_normalized": "كل من عليها فان",
      "aya_indic": "٢٦"
    },
    {
      "sura": 55,
      "aya": 27,
      "text_uthmani": "وَيَبْقَىٰ وَجْهُ رَبِّكَ ذُو ٱلْجَلَٰلِ وَٱلْإِكْرَامِ",
      "text_normalized": "ويبقيا وجه ربك ذو الجلال والاكرام",
      "aya_indic": "٢٧"
    },
    {
      "sura": 55,
      "aya": 28,
      "text_uthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "text_normalized": "فباي ءالاء ربكما تكذبان",
      "aya_indic": "٢٨"
    },
    {
      "sura": 55,
      "aya": 29,
      "text_uthmani": "يَسْـَٔلُهُۥ مَن فِى ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ ۚ كُلَّ يَوْمٍ هُوَ فِى شَأْنٍ",
      "text_normalized": "يسله من في السماوات والارض كل يوم هو في شان",
      "aya_indic": "٢٩"
    },
    {
      "sura": 55,
      "aya": 30,
      "text_uthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "text_normalized": "فباي ءالاء ربكما تكذبان",
      "aya_indic": "٣٠"
    },
    {
      "sura": 55,
      "aya": 31,
      "text_uthmani": "سَنَفْرُغُ لَكُمْ أَيُّهَ ٱلثَّقَلَانِ",
      "text_normalized": "سنفرغ لكم ايه الثقلان",
      "aya_indic": "٣١"
    },
    {
      "sura": 55,
      "aya": 32,
      "text_uthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "text_normalized": "فباي ءالاء ربكما تكذبان",
      "aya_indic": "٣٢"
    },
    {
      "sura": 55,
      "aya": 33,
      "text_uthmani": "يَٰمَعْشَرَ ٱلْجِنِّ وَٱلْإِنسِ إِنِ ٱسْتَطَعْتُمْ أَن تَنفُذُوا۟ مِنْ أَقْطَارِ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ فَٱنفُذُوا۟ ۚ لَا تَنفُذُونَ إِلَّا بِسُلْطَٰنٍ",
      "text_normalized": "يامعشر الجن والانس ان استطعتم ان تنفذوا من اقطار السماوات والارض فانفذوا لا تنفذون الا بسلطان",
      "aya_indic": "٣٣"
    },
    {
      "sura": 55,
      "aya": 34,
      "text_uthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "text_normalized": "فباي ءالاء ربكما تكذبان",
      "aya_indic": "٣٤"
    },
    {
      "sura": 55,
      "aya": 35,
      "text_uthmani": "يُرْسَلُ عَلَيْكُمَا شُوَاظٌ مِّن نَّارٍ وَنُحَاسٌ فَلَا تَنتَصِرَانِ",
      "text_normalized": "يرسل عليكما شواظ من نار ونحاس فلا تنتصران",
      "aya_indic": "٣٥"
    },
    {
      "sura": 55,
      "aya": 36,
      "text_uthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "text_normalized": "فباي ءالاء ربكما تكذبان",
      "aya_indic": "٣٦"
    },
    {
      "sura": 55,
      "aya": 37,
      "text_uthmani": "فَإِذَا ٱنشَقَّتِ ٱلسَّمَآءُ فَكَانَتْ وَرْدَةً كَٱلدِّهَانِ",
      "text_normalized": "فاذا انشقت السماء فكانت ورده كالدهان",
      "aya_indic": "٣٧"
    },
    {
      "sura": 55,
      "aya": 38,
      "text_uthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "text_normalized": "فباي ءالاء ربكما تكذبان",
      "aya_indic": "٣٨"
    },
    {
      "sura": 55,
      "aya": 39,
      "text_uthmani": "فَيَوْمَئِذٍ لَّا يُسْـَٔلُ عَن ذَنۢبِهِۦٓ إِنسٌ وَلَا جَآنٌّ",
      "text_normalized": "فيوميذ لا يسل عن ذنبه انس ولا جان",
      "aya_indic": "٣٩"
    },
    {
      "sura": 55,
      "aya": 40,
      "text_uthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "text_normalized": "فباي ءالاء ربكما تكذبان",
      "aya_indic": "٤٠"
    },
    {
      "sura": 55,
      "aya": 41,
      "text_uthmani": "يُعْرَفُ ٱلْمُجْرِمُونَ بِسِيمَٰهُمْ فَيُؤْخَذُ بِٱلنَّوَٰصِى وَٱلْأَقْدَامِ",
      "text_normalized": "يعرف المجرمون بسيماهم فيوخذ بالنواصي والاقدام",
      "aya_indic": "٤١"
    },
    {
      "sura": 55,
      "aya": 42,
      "text_uthmani": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "text_normalized": "فباي ءالاء ربكما تكذبان",
      "aya_indic": "٤٢"
    },
    {
      "sura": 55,
      "aya": 43,
      "text_uthmani": "هَٰذِهِۦ جَهَنَّمُ ٱلَّتِى يُكَذِّبُ بِهَا ٱلْمُجْرِمُونَ",
