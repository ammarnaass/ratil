{
  "id": 80,
  "name_ar": "عبس",
  "name_en": "'Abasa",
  "type": "مكية",
  "ayahs_hafs": 42,
  "ayahs_warsh": 41,
  "page": 585,
  "narration": "hafs",
  "narration_ar": "حفص عن عاصم",
  "ayahs": [
    {
      "sura": 80,
      "aya": 1,
      "text_uthmani": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ عَبَسَ وَتَوَلَّىٰٓ",
      "text_normalized": "بسم الله الرحمن الرحيم عبس وتوليا",
      "aya_indic": "١"
    },
    {
      "sura": 80,
      "aya": 2,
      "text_uthmani": "أَن جَآءَهُ ٱلْأَعْمَىٰ",
      "text_normalized": "ان جاءه الاعميا",
      "aya_indic": "٢"
    },
    {
      "sura": 80,
      "aya": 3,
      "text_uthmani": "وَمَا يُدْرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ",
      "text_normalized": "وما يدريك لعله يزكيا",
      "aya_indic": "٣"
    },
    {
      "sura": 80,
      "aya": 4,
      "text_uthmani": "أَوْ يَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكْرَىٰٓ",
      "text_normalized": "او يذكر فتنفعه الذكريا",
      "aya_indic": "٤"
    },
    {
      "sura": 80,
      "aya": 5,
      "text_uthmani": "أَمَّا مَنِ ٱسْتَغْنَىٰ",
      "text_normalized": "اما من استغنيا",
      "aya_indic": "٥"
    },
    {
      "sura": 80,
      "aya": 6,
      "text_uthmani": "فَأَنتَ لَهُۥ تَصَدَّىٰ",
      "text_normalized": "فانت له تصديا",
      "aya_indic": "٦"
    },
    {
      "sura": 80,
      "aya": 7,
      "text_uthmani": "وَمَا عَلَيْكَ أَلَّا يَزَّكَّىٰ",
      "text_normalized": "وما عليك الا يزكيا",
      "aya_indic": "٧"
    },
    {
      "sura": 80,
      "aya": 8,
      "text_uthmani": "وَأَمَّا مَن جَآءَكَ يَسْعَىٰ",
      "text_normalized": "واما من جاءك يسعيا",
      "aya_indic": "٨"
    },
    {
      "sura": 80,
      "aya": 9,
      "text_uthmani": "وَهُوَ يَخْشَىٰ",
      "text_normalized": "وهو يخشيا",
      "aya_indic": "٩"
    },
    {
      "sura": 80,
      "aya": 10,
      "text_uthmani": "فَأَنتَ عَنْهُ تَلَهَّىٰ",
      "text_normalized": "فانت عنه تلهيا",
      "aya_indic": "١٠"
    },
    {
      "sura": 80,
      "aya": 11,
      "text_uthmani": "كَلَّآ إِنَّهَا تَذْكِرَةٌ",
      "text_normalized": "كلا انها تذكره",
      "aya_indic": "١١"
    },
    {
      "sura": 80,
      "aya": 12,
      "text_uthmani": "فَمَن شَآءَ ذَكَرَهُۥ",
      "text_normalized": "فمن شاء ذكره",
      "aya_indic": "١٢"
    },
    {
      "sura": 80,
      "aya": 13,
      "text_uthmani": "فِى صُحُفٍ مُّكَرَّمَةٍ",
      "text_normalized": "في صحف مكرمه",
      "aya_indic": "١٣"
    },
    {
      "sura": 80,
      "aya": 14,
      "text_uthmani": "مَّرْفُوعَةٍ مُّطَهَّرَةٍۭ",
      "text_normalized": "مرفوعه مطهره",
      "aya_indic": "١٤"
    },
    {
      "sura": 80,
      "aya": 15,
      "text_uthmani": "بِأَيْدِى سَفَرَةٍ",
      "text_normalized": "بايدي سفره",
      "aya_indic": "١٥"
    },
    {
      "sura": 80,
      "aya": 16,
      "text_uthmani": "كِرَامٍۭ بَرَرَةٍ",
      "text_normalized": "كرام برره",
      "aya_indic": "١٦"
    },
    {
      "sura": 80,
      "aya": 17,
      "text_uthmani": "قُتِلَ ٱلْإِنسَٰنُ مَآ أَكْفَرَهُۥ",
      "text_normalized": "قتل الانسان ما اكفره",
      "aya_indic": "١٧"
    },
    {
      "sura": 80,
      "aya": 18,
      "text_uthmani": "مِنْ أَىِّ شَىْءٍ خَلَقَهُۥ",
      "text_normalized": "من اي شيء خلقه",
      "aya_indic": "١٨"
    },
    {
      "sura": 80,
      "aya": 19,
      "text_uthmani": "مِن نُّطْفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ",
      "text_normalized": "من نطفه خلقه فقدره",
      "aya_indic": "١٩"
    },
    {
      "sura": 80,
      "aya": 20,
      "text_uthmani": "ثُمَّ ٱلسَّبِيلَ يَسَّرَهُۥ",
      "text_normalized": "ثم السبيل يسره",
      "aya_indic": "٢٠"
    },
    {
      "sura": 80,
      "aya": 21,
      "text_uthmani": "ثُمَّ أَمَاتَهُۥ فَأَقْبَرَهُۥ",
      "text_normalized": "ثم اماته فاقبره",
      "aya_indic": "٢١"
    },
    {
      "sura": 80,
      "aya": 22,
      "text_uthmani": "ثُمَّ إِذَا شَآءَ أَنشَرَهُۥ",
      "text_normalized": "ثم اذا شاء انشره",
      "aya_indic": "٢٢"
    },
    {
      "sura": 80,
      "aya": 23,
      "text_uthmani": "كَلَّا لَمَّا يَقْضِ مَآ أَمَرَهُۥ",
      "text_normalized": "كلا لما يقض ما امره",
      "aya_indic": "٢٣"
    },
    {
      "sura": 80,
      "aya": 24,
      "text_uthmani": "فَلْيَنظُرِ ٱلْإِنسَٰنُ إِلَىٰ طَعَامِهِۦٓ",
      "text_normalized": "فلينظر الانسان اليا طعامه",
      "aya_indic": "٢٤"
    },
    {
      "sura": 80,
      "aya": 25,
      "text_uthmani": "أَنَّا صَبَبْنَا ٱلْمَآءَ صَبًّا",
      "text_normalized": "انا صببنا الماء صبا",
      "aya_indic": "٢٥"
    },
    {
      "sura": 80,
      "aya": 26,
      "text_uthmani": "ثُمَّ شَقَقْنَا ٱلْأَرْضَ شَقًّا",
      "text_normalized": "ثم شققنا الارض شقا",
      "aya_indic": "٢٦"
    },
    {
      "sura": 80,
      "aya": 27,
      "text_uthmani": "فَأَنۢبَتْنَا فِيهَا حَبًّا",
      "text_normalized": "فانبتنا فيها حبا",
      "aya_indic": "٢٧"
    },
    {
      "sura": 80,
      "aya": 28,
      "text_uthmani": "وَعِنَبًا وَقَضْبًا",
      "text_normalized": "وعنبا وقضبا",
      "aya_indic": "٢٨"
    },
    {
      "sura": 80,
      "aya": 29,
      "text_uthmani": "وَزَيْتُونًا وَنَخْلًا",
      "text_normalized": "وزيتونا ونخلا",
      "aya_indic": "٢٩"
    },
    {
      "sura": 80,
      "aya": 30,
      "text_uthmani": "وَحَدَآئِقَ غُلْبًا",
      "text_normalized": "وحدايق غلبا",
      "aya_indic": "٣٠"
    },
    {
      "sura": 80,
      "aya": 31,
      "text_uthmani": "وَفَٰكِهَةً وَأَبًّا",
      "text_normalized": "وفاكهه وابا",
      "aya_indic": "٣١"
    },
    {
      "sura": 80,
      "aya": 32,
      "text_uthmani": "مَّتَٰعًا لَّكُمْ وَلِأَنْعَٰمِكُمْ",
      "text_normalized": "متاعا لكم ولانعامكم",
      "aya_indic": "٣٢"
    },
    {
      "sura": 80,
      "aya": 33,
      "text_uthmani": "فَإِذَا جَآءَتِ ٱلصَّآخَّةُ",
      "text_normalized": "فاذا جاءت الصاخه",
      "aya_indic": "٣٣"
    },
    {
      "sura": 80,
      "aya": 34,
      "text_uthmani": "يَوْمَ يَفِرُّ ٱلْمَرْءُ مِنْ أَخِيهِ",
      "text_normalized": "يوم يفر المرء من اخيه",
      "aya_indic": "٣٤"
    },
    {
      "sura": 80,
      "aya": 35,
      "text_uthmani": "وَأُمِّهِۦ وَأَبِيهِ",
      "text_normalized": "وامه وابيه",
      "aya_indic": "٣٥"
    },
    {
      "sura": 80,
      "aya": 36,
      "text_uthmani": "وَصَٰحِبَتِهِۦ وَبَنِيهِ",
      "text_normalized": "وصاحبته وبنيه",
      "aya_indic": "٣٦"
    },
    {
      "sura": 80,
      "aya": 37,
      "text_uthmani": "لِكُلِّ ٱمْرِئٍ مِّنْهُمْ يَوْمَئِذٍ شَأْنٌ يُغْنِيهِ",
      "text_normalized": "لكل امري منهم يوميذ شان يغنيه",
      "aya_indic": "٣٧"
    },
    {
      "sura": 80,
      "aya": 38,
      "text_uthmani": "وُجُوهٌ يَوْمَئِذٍ مُّسْفِرَةٌ",
      "text_normalized": "وجوه يوميذ مسفره",
      "aya_indic": "٣٨"
    },
    {
      "sura": 80,
      "aya": 39,
      "text_uthmani": "ضَاحِكَةٌ مُّسْتَبْشِرَةٌ",
      "text_normalized": "ضاحكه مستبشره",
      "aya_indic": "٣٩"
    },
    {
      "sura": 80,
      "aya": 40,
      "text_uthmani": "وَوُجُوهٌ يَوْمَئِذٍ عَلَيْهَا غَبَرَةٌ",
      "text_normalized": "ووجوه يوميذ عليها غبره",
      "aya_indic": "٤٠"
    },
    {
      "sura": 80,
      "aya": 41,
      "text_uthmani": "تَرْهَقُهَا قَتَرَةٌ",
      "text_normalized": "ترهقها قتره",
      "aya_indic": "٤١"
    },
    {
      "sura": 80,
      "aya": 42,
      "text_uthmani": "أُو۟لَٰٓئِكَ هُمُ ٱلْكَفَرَةُ ٱلْفَجَرَةُ",
      "text_normalized": "اولايك هم الكفره الفجره",
      "aya_indic": "٤٢"
    }
  ]
}