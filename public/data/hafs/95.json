{
  "id": 95,
  "name_ar": "التين",
  "name_en": "At-Tin",
  "type": "مكية",
  "ayahs_hafs": 8,
  "ayahs_warsh": 8,
  "page": 597,
  "narration": "hafs",
  "narration_ar": "حفص عن عاصم",
  "ayahs": [
    {
      "sura": 95,
      "aya": 1,
      "text_uthmani": "بِّسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلتِّينِ وَٱلزَّيْتُونِ",
      "text_normalized": "بسم الله الرحمن الرحيم والتين والزيتون",
      "aya_indic": "١"
    },
    {
      "sura": 95,
      "aya": 2,
      "text_uthmani": "وَطُورِ سِينِينَ",
      "text_normalized": "وطور سينين",
      "aya_indic": "٢"
    },
    {
      "sura": 95,
      "aya": 3,
      "text_uthmani": "وَهَٰذَا ٱلْبَلَدِ ٱلْأَمِينِ",
      "text_normalized": "وهاذا البلد الامين",
      "aya_indic": "٣"
    },
    {
      "sura": 95,
      "aya": 4,
      "text_uthmani": "لَقَدْ خَلَقْنَا ٱلْإِنسَٰنَ فِىٓ أَحْسَنِ تَقْوِيمٍ",
      "text_normalized": "لقد خلقنا الانسان في احسن تقويم",
      "aya_indic": "٤"
    },
    {
      "sura": 95,
      "aya": 5,
      "text_uthmani": "ثُمَّ رَدَدْنَٰهُ أَسْفَلَ سَٰفِلِينَ",
      "text_normalized": "ثم رددناه اسفل سافلين",
      "aya_indic": "٥"
    },
    {
      "sura": 95,
      "aya": 6,
      "text_uthmani": "إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ فَلَهُمْ أَجْرٌ غَيْرُ مَمْنُونٍ",
      "text_normalized": "الا الذين ءامنوا وعملوا الصالحات فلهم اجر غير ممنون",
      "aya_indic": "٦"
    },
    {
      "sura": 95,
      "aya": 7,
      "text_uthmani": "فَمَا يُكَذِّبُكَ بَعْدُ بِٱلدِّينِ",
      "text_normalized": "فما يكذبك بعد بالدين",
      "aya_indic": "٧"
    },
    {
      "sura": 95,
      "aya": 8,
      "text_uthmani": "أَلَيْسَ ٱللَّهُ بِأَحْكَمِ ٱلْحَٰكِمِينَ",
      "text_normalized": "اليس الله باحكم الحاكمين",
      "aya_indic": "٨"
    }
  ]
}