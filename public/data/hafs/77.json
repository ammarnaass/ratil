{
  "id": 77,
  "name_ar": "المرسلات",
  "name_en": "Al-Mursalat",
  "type": "مكية",
  "ayahs_hafs": 50,
  "ayahs_warsh": 50,
  "page": 580,
  "narration": "hafs",
  "narration_ar": "حفص عن عاصم",
  "ayahs": [
    {
      "sura": 77,
      "aya": 1,
      "text_uthmani": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلْمُرْسَلَٰتِ عُرْفًا",
      "text_normalized": "بسم الله الرحمن الرحيم والمرسلات عرفا",
      "aya_indic": "١"
    },
    {
      "sura": 77,
      "aya": 2,
      "text_uthmani": "فَٱلْعَٰصِفَٰتِ عَصْفًا",
      "text_normalized": "فالعاصفات عصفا",
      "aya_indic": "٢"
    },
    {
      "sura": 77,
      "aya": 3,
      "text_uthmani": "وَٱلنَّٰشِرَٰتِ نَشْرًا",
      "text_normalized": "والناشرات نشرا",
      "aya_indic": "٣"
    },
    {
      "sura": 77,
      "aya": 4,
      "text_uthmani": "فَٱلْفَٰرِقَٰتِ فَرْقًا",
      "text_normalized": "فالفارقات فرقا",
      "aya_indic": "٤"
    },
    {
      "sura": 77,
      "aya": 5,
      "text_uthmani": "فَٱلْمُلْقِيَٰتِ ذِكْرًا",
      "text_normalized": "فالملقيات ذكرا",
      "aya_indic": "٥"
    },
    {
      "sura": 77,
      "aya": 6,
      "text_uthmani": "عُذْرًا أَوْ نُذْرًا",
      "text_normalized": "عذرا او نذرا",
      "aya_indic": "٦"
    },
    {
      "sura": 77,
      "aya": 7,
      "text_uthmani": "إِنَّمَا تُوعَدُونَ لَوَٰقِعٌ",
      "text_normalized": "انما توعدون لواقع",
      "aya_indic": "٧"
    },
    {
      "sura": 77,
      "aya": 8,
      "text_uthmani": "فَإِذَا ٱلنُّجُومُ طُمِسَتْ",
      "text_normalized": "فاذا النجوم طمست",
      "aya_indic": "٨"
    },
    {
      "sura": 77,
      "aya": 9,
      "text_uthmani": "وَإِذَا ٱلسَّمَآءُ فُرِجَتْ",
      "text_normalized": "واذا السماء فرجت",
      "aya_indic": "٩"
    },
    {
      "sura": 77,
      "aya": 10,
      "text_uthmani": "وَإِذَا ٱلْجِبَالُ نُسِفَتْ",
      "text_normalized": "واذا الجبال نسفت",
      "aya_indic": "١٠"
    },
    {
      "sura": 77,
      "aya": 11,
      "text_uthmani": "وَإِذَا ٱلرُّسُلُ أُقِّتَتْ",
      "text_normalized": "واذا الرسل اقتت",
      "aya_indic": "١١"
    },
    {
      "sura": 77,
      "aya": 12,
      "text_uthmani": "لِأَىِّ يَوْمٍ أُجِّلَتْ",
      "text_normalized": "لاي يوم اجلت",
      "aya_indic": "١٢"
    },
    {
      "sura": 77,
      "aya": 13,
      "text_uthmani": "لِيَوْمِ ٱلْفَصْلِ",
      "text_normalized": "ليوم الفصل",
      "aya_indic": "١٣"
    },
    {
      "sura": 77,
      "aya": 14,
      "text_uthmani": "وَمَآ أَدْرَىٰكَ مَا يَوْمُ ٱلْفَصْلِ",
      "text_normalized": "وما ادرياك ما يوم الفصل",
      "aya_indic": "١٤"
    },
    {
      "sura": 77,
      "aya": 15,
      "text_uthmani": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
      "text_normalized": "ويل يوميذ للمكذبين",
      "aya_indic": "١٥"
    },
    {
      "sura": 77,
      "aya": 16,
      "text_uthmani": "أَلَمْ نُهْلِكِ ٱلْأَوَّلِينَ",
      "text_normalized": "الم نهلك الاولين",
      "aya_indic": "١٦"
    },
    {
      "sura": 77,
      "aya": 17,
      "text_uthmani": "ثُمَّ نُتْبِعُهُمُ ٱلْـَٔاخِرِينَ",
      "text_normalized": "ثم نتبعهم الاخرين",
      "aya_indic": "١٧"
    },
    {
      "sura": 77,
      "aya": 18,
      "text_uthmani": "كَذَٰلِكَ نَفْعَلُ بِٱلْمُجْرِمِينَ",
      "text_normalized": "كذالك نفعل بالمجرمين",
      "aya_indic": "١٨"
    },
    {
      "sura": 77,
      "aya": 19,
      "text_uthmani": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
      "text_normalized": "ويل يوميذ للمكذبين",
      "aya_indic": "١٩"
    },
    {
      "sura": 77,
      "aya": 20,
      "text_uthmani": "أَلَمْ نَخْلُقكُّم مِّن مَّآءٍ مَّهِينٍ",
      "text_normalized": "الم نخلقكم من ماء مهين",
      "aya_indic": "٢٠"
    },
    {
      "sura": 77,
      "aya": 21,
      "text_uthmani": "فَجَعَلْنَٰهُ فِى قَرَارٍ مَّكِينٍ",
      "text_normalized": "فجعلناه في قرار مكين",
      "aya_indic": "٢١"
    },
    {
      "sura": 77,
      "aya": 22,
      "text_uthmani": "إِلَىٰ قَدَرٍ مَّعْلُومٍ",
      "text_normalized": "اليا قدر معلوم",
      "aya_indic": "٢٢"
    },
    {
      "sura": 77,
      "aya": 23,
      "text_uthmani": "فَقَدَرْنَا فَنِعْمَ ٱلْقَٰدِرُونَ",
      "text_normalized": "فقدرنا فنعم القادرون",
      "aya_indic": "٢٣"
    },
    {
      "sura": 77,
      "aya": 24,
      "text_uthmani": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
      "text_normalized": "ويل يوميذ للمكذبين",
      "aya_indic": "٢٤"
    },
    {
      "sura": 77,
      "aya": 25,
      "text_uthmani": "أَلَمْ نَجْعَلِ ٱلْأَرْضَ كِفَاتًا",
      "text_normalized": "الم نجعل الارض كفاتا",
      "aya_indic": "٢٥"
    },
    {
      "sura": 77,
      "aya": 26,
      "text_uthmani": "أَحْيَآءً وَأَمْوَٰتًا",
      "text_normalized": "احياء وامواتا",
      "aya_indic": "٢٦"
    },
    {
      "sura": 77,
      "aya": 27,
      "text_uthmani": "وَجَعَلْنَا فِيهَا رَوَٰسِىَ شَٰمِخَٰتٍ وَأَسْقَيْنَٰكُم مَّآءً فُرَاتًا",
      "text_normalized": "وجعلنا فيها رواسي شامخات واسقيناكم ماء فراتا",
      "aya_indic": "٢٧"
    },
    {
      "sura": 77,
      "aya": 28,
      "text_uthmani": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
      "text_normalized": "ويل يوميذ للمكذبين",
      "aya_indic": "٢٨"
    },
    {
      "sura": 77,
      "aya": 29,
      "text_uthmani": "ٱنطَلِقُوٓا۟ إِلَىٰ مَا كُنتُم بِهِۦ تُكَذِّبُونَ",
      "text_normalized": "انطلقوا اليا ما كنتم به تكذبون",
      "aya_indic": "٢٩"
    },
    {
      "sura": 77,
      "aya": 30,
      "text_uthmani": "ٱنطَلِقُوٓا۟ إِلَىٰ ظِلٍّ ذِى ثَلَٰثِ شُعَبٍ",
      "text_normalized": "انطلقوا اليا ظل ذي ثلاث شعب",
      "aya_indic": "٣٠"
    },
    {
      "sura": 77,
      "aya": 31,
      "text_uthmani": "لَّا ظَلِيلٍ وَلَا يُغْنِى مِنَ ٱللَّهَبِ",
      "text_normalized": "لا ظليل ولا يغني من اللهب",
      "aya_indic": "٣١"
    },
    {
      "sura": 77,
      "aya": 32,
      "text_uthmani": "إِنَّهَا تَرْمِى بِشَرَرٍ كَٱلْقَصْرِ",
      "text_normalized": "انها ترمي بشرر كالقصر",
      "aya_indic": "٣٢"
    },
    {
      "sura": 77,
      "aya": 33,
      "text_uthmani": "كَأَنَّهُۥ جِمَٰلَتٌ صُفْرٌ",
      "text_normalized": "كانه جمالت صفر",
      "aya_indic": "٣٣"
    },
    {
      "sura": 77,
      "aya": 34,
      "text_uthmani": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
      "text_normalized": "ويل يوميذ للمكذبين",
      "aya_indic": "٣٤"
    },
    {
      "sura": 77,
      "aya": 35,
      "text_uthmani": "هَٰذَا يَوْمُ لَا يَنطِقُونَ",
      "text_normalized": "هذا يوم لا ينطقون",
      "aya_indic": "٣٥"
    },
    {
      "sura": 77,
      "aya": 36,
      "text_uthmani": "وَلَا يُؤْذَنُ لَهُمْ فَيَعْتَذِرُونَ",
      "text_normalized": "ولا يوذن لهم فيعتذرون",
      "aya_indic": "٣٦"
    },
    {
      "sura": 77,
      "aya": 37,
      "text_uthmani": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
      "text_normalized": "ويل يوميذ للمكذبين",
      "aya_indic": "٣٧"
    },
    {
      "sura": 77,
      "aya": 38,
      "text_uthmani": "هَٰذَا يَوْمُ ٱلْفَصْلِ ۖ جَمَعْنَٰكُمْ وَٱلْأَوَّلِينَ",
      "text_normalized": "هذا يوم الفصل جمعناكم والاولين",
      "aya_indic": "٣٨"
    },
    {
      "sura": 77,
      "aya": 39,
      "text_uthmani": "فَإِن كَانَ لَكُمْ كَيْدٌ فَكِيدُونِ",
      "text_normalized": "فان كان لكم كيد فكيدون",
      "aya_indic": "٣٩"
    },
    {
      "sura": 77,
      "aya": 40,
      "text_uthmani": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
      "text_normalized": "ويل يوميذ للمكذبين",
      "aya_indic": "٤٠"
    },
    {
      "sura": 77,
      "aya": 41,
      "text_uthmani": "إِنَّ ٱلْمُتَّقِينَ فِى ظِلَٰلٍ وَعُيُونٍ",
      "text_normalized": "ان المتقين في ظلال وعيون",
      "aya_indic": "٤١"
    },
    {
      "sura": 77,
      "aya": 42,
      "text_uthmani": "وَفَوَٰكِهَ مِمَّا يَشْتَهُونَ",
      "text_normalized": "وفواكه مما يشتهون",
      "aya_indic": "٤٢"
    },
    {
      "sura": 77,
      "aya": 43,
      "text_uthmani": "كُلُوا۟ وَٱشْرَبُوا۟ هَنِيٓـًٔۢا بِمَا كُنتُمْ تَعْمَلُونَ",
      "text_normalized": "كلوا واشربوا هنيا بما كنتم تعملون",
      "aya_indic": "٤٣"
    },
    {
      "sura": 77,
      "aya": 44,
      "text_uthmani": "إِنَّا كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ",
      "text_normalized": "انا كذالك نجزي المحسنين",
      "aya_indic": "٤٤"
    },
    {
      "sura": 77,
      "aya": 45,
      "text_uthmani": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
      "text_normalized": "ويل يوميذ للمكذبين",
      "aya_indic": "٤٥"
    },
    {
      "sura": 77,
      "aya": 46,
      "text_uthmani": "كُلُوا۟ وَتَمَتَّعُوا۟ قَلِيلًا إِنَّكُم مُّجْرِمُونَ",
      "text_normalized": "كلوا وتمتعوا قليلا انكم مجرمون",
      "aya_indic": "٤٦"
    },
    {
      "sura": 77,
      "aya": 47,
      "text_uthmani": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
      "text_normalized": "ويل يوميذ للمكذبين",
      "aya_indic": "٤٧"
    },
    {
      "sura": 77,
      "aya": 48,
      "text_uthmani": "وَإِذَا قِيلَ لَهُمُ ٱرْكَعُوا۟ لَا يَرْكَعُونَ",
      "text_normalized": "واذا قيل لهم اركعوا لا يركعون",
      "aya_indic": "٤٨"
    },
    {
      "sura": 77,
      "aya": 49,
      "text_uthmani": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
      "text_normalized": "ويل يوميذ للمكذبين",
      "aya_indic": "٤٩"
    },
    {
      "sura": 77,
      "aya": 50,
      "text_uthmani": "فَبِأَىِّ حَدِيثٍۭ بَعْدَهُۥ يُؤْمِنُونَ",
      "text_normalized": "فباي حديث بعده يومنون",
      "aya_indic": "٥٠"
    }
  ]
}