      "text_uthmani": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ قُلْ يَٰٓأَيُّهَا ٱلْكَٰفِرُونَ",
      "text_normalized": "بسم الله الرحمن الرحيم قل ياايها الكافرون",
      "aya_indic": "١"
    },
    {
      "sura": 109,
      "aya": 2,
      "text_uthmani": "لَآ أَعْبُدُ مَا تَعْبُدُونَ",
      "text_normalized": "لا اعبد ما تعبدون",
      "aya_indic": "٢"
    },
    {
      "sura": 109,
      "aya": 3,
      "text_uthmani": "وَلَآ أَنتُمْ عَٰبِدُونَ مَآ أَعْبُدُ",
      "text_normalized": "ولا انتم عابدون ما اعبد",
      "aya_indic": "٣"
    },
    {
      "sura": 109,
      "aya": 4,
      "text_uthmani": "وَلَآ أَنَا۠ عَابِدٌ مَّا عَبَدتُّمْ",
      "text_normalized": "ولا انا عابد ما عبدتم",
      "aya_indic": "٤"
    },
    {
      "sura": 109,
      "aya": 5,
      "text_uthmani": "وَلَآ أَنتُمْ عَٰبِدُونَ مَآ أَعْبُدُ",
      "text_normalized": "ولا انتم عابدون ما اعبد",
      "aya_indic": "٥"
    },
    {
