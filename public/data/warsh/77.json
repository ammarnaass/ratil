{
  "id": 77,
  "name_ar": "المرسلات",
  "name_en": "Al-Mursalat",
  "type": "مكية",
  "ayahs_hafs": 50,
  "ayahs_warsh": 50,
  "page": 580,
  "narration": "warsh",
  "narration_ar": "ورش عن نافع",
  "ayahs": [
    {
      "sura": 77,
      "aya": 1,
      "text_uthmani": "وَالْمُرْسَلَٰتِ عُرْفاٗ",
      "text_normalized": "والمرسلات عرفا",
      "aya_indic": "١",
      "jozz": 29,
      "page": 580
    },
    {
      "sura": 77,
      "aya": 2,
      "text_uthmani": "فَالْعَٰصِفَٰتِ عَصْفاٗ",
      "text_normalized": "فالعاصفات عصفا",
      "aya_indic": "٢",
      "jozz": 29,
      "page": 580
    },
    {
      "sura": 77,
      "aya": 3,
      "text_uthmani": "وَالنَّٰشِرَٰتِ نَشْراٗ",
      "text_normalized": "والناشرات نشرا",
      "aya_indic": "٣",
      "jozz": 29,
      "page": 580
    },
    {
      "sura": 77,
      "aya": 4,
      "text_uthmani": "فَالْفَٰرِقَٰتِ فَرْقاٗ",
      "text_normalized": "فالفارقات فرقا",
      "aya_indic": "٤",
      "jozz": 29,
      "page": 580
    },
    {
      "sura": 77,
      "aya": 5,
      "text_uthmani": "فَالْمُلْقِيَٰتِ ذِكْراً",
      "text_normalized": "فالملقيات ذكرا",
      "aya_indic": "٥",
      "jozz": 29,
      "page": 580
    },
    {
      "sura": 77,
      "aya": 6,
      "text_uthmani": "عُذْراً اَوْ نُذُراً",
      "text_normalized": "عذرا او نذرا",
      "aya_indic": "٦",
      "jozz": 29,
      "page": 580
    },
    {
      "sura": 77,
      "aya": 7,
      "text_uthmani": "اِنَّمَا تُوعَدُونَ لَوَٰقِعٞۖ",
      "text_normalized": "انما توعدون لواقع",
      "aya_indic": "٧",
      "jozz": 29,
      "page": 580
    },
    {
      "sura": 77,
      "aya": 8,
      "text_uthmani": "فَإِذَا اَ۬لنُّجُومُ طُمِسَتْ",
      "text_normalized": "فاذا النجوم طمست",
      "aya_indic": "٨",
      "jozz": 29,
      "page": 580
    },
    {
      "sura": 77,
      "aya": 9,
      "text_uthmani": "وَإِذَا اَ۬لسَّمَآءُ فُرِجَتْ",
      "text_normalized": "واذا السماء فرجت",
      "aya_indic": "٩",
      "jozz": 29,
      "page": 580
    },
    {
      "sura": 77,
      "aya": 10,
      "text_uthmani": "وَإِذَا اَ۬لْجِبَالُ نُسِفَتْ",
      "text_normalized": "واذا الجبال نسفت",
      "aya_indic": "١٠",
      "jozz": 29,
      "page": 580
    },
    {
      "sura": 77,
      "aya": 11,
      "text_uthmani": "وَإِذَا اَ۬لرُّسُلُ أُقِّتَتْ",
      "text_normalized": "واذا الرسل اقتت",
      "aya_indic": "١١",
      "jozz": 29,
      "page": 580
    },
    {
      "sura": 77,
      "aya": 12,
      "text_uthmani": "لِأَيِّ يَوْمٍ ا۟جِّلَتْ",
      "text_normalized": "لاي يوم اجلت",
      "aya_indic": "١٢",
      "jozz": 29,
      "page": 580
    },
    {
      "sura": 77,
      "aya": 13,
      "text_uthmani": "لِيَوْمِ اِ۬لْفَصْلِۖ",
      "text_normalized": "ليوم الفصل",
      "aya_indic": "١٣",
      "jozz": 29,
      "page": 580
    },
    {
      "sura": 77,
      "aya": 14,
      "text_uthmani": "وَمَآ أَدْر۪يٰكَ مَا يَوْمُ اُ۬لْفَصْلِۖ",
      "text_normalized": "وما ادرياك ما يوم الفصل",
      "aya_indic": "١٤",
      "jozz": 29,
      "page": 580
    },
    {
      "sura": 77,
      "aya": 15,
      "text_uthmani": "وَيْلٞ يَوْمَئِذٖ لِّلْمُكَذِّبِينَۖ",
      "text_normalized": "ويل يوميذ للمكذبين",
      "aya_indic": "١٥",
      "jozz": 29,
      "page": 580
    },
    {
      "sura": 77,
      "aya": 16,
      "text_uthmani": "۞ أَلَمْ نُهْلِكِ اِ۬لَاوَّلِينَۖ",
      "text_normalized": "الم نهلك الاولين",
      "aya_indic": "١٦",
      "jozz": 29,
      "page": 580
    },
    {
      "sura": 77,
      "aya": 17,
      "text_uthmani": "ثُمَّ نُتْبِعُهُمُ اُ۬لَاخِرِينَۖ",
      "text_normalized": "ثم نتبعهم الاخرين",
      "aya_indic": "١٧",
      "jozz": 29,
      "page": 580
    },
    {
      "sura": 77,
      "aya": 18,
      "text_uthmani": "كَذَٰلِكَ نَفْعَلُ بِالْمُجْرِمِينَۖ",
      "text_normalized": "كذالك نفعل بالمجرمين",
      "aya_indic": "١٨",
      "jozz": 29,
      "page": 580
    },
    {
      "sura": 77,
      "aya": 19,
      "text_uthmani": "وَيْلٞ يَوْمَئِذٖ لِّلْمُكَذِّبِينَۖ",
      "text_normalized": "ويل يوميذ للمكذبين",
      "aya_indic": "١٩",
      "jozz": 29,
      "page": 580
    },
    {
      "sura": 77,
      "aya": 20,
      "text_uthmani": "أَلَمْ نَخْلُقكُّم مِّن مَّآءٖ مَّهِينٖ",
      "text_normalized": "الم نخلقكم من ماء مهين",
      "aya_indic": "٢٠",
      "jozz": 29,
      "page": 581
    },
    {
      "sura": 77,
      "aya": 21,
      "text_uthmani": "فَجَعَلْنَٰهُ فِے قَر۪ارٖ مَّكِينٍ",
      "text_normalized": "فجعلناه فے قرار مكين",
      "aya_indic": "٢١",
      "jozz": 29,
      "page": 581
    },
    {
      "sura": 77,
      "aya": 22,
      "text_uthmani": "اِلَىٰ قَدَرٖ مَّعْلُومٖ",
      "text_normalized": "اليا قدر معلوم",
      "aya_indic": "٢٢",
      "jozz": 29,
      "page": 581
    },
    {
      "sura": 77,
      "aya": 23,
      "text_uthmani": "فَقَدَّرْنَاۖ فَنِعْمَ اَ۬لْقَٰدِرُونَۖ",
      "text_normalized": "فقدرنا فنعم القادرون",
      "aya_indic": "٢٣",
      "jozz": 29,
      "page": 581
    },
    {
      "sura": 77,
      "aya": 24,
      "text_uthmani": "وَيْلٞ يَوْمَئِذٖ لِّلْمُكَذِّبِينَۖ",
      "text_normalized": "ويل يوميذ للمكذبين",
      "aya_indic": "٢٤",
      "jozz": 29,
      "page": 581
    },
    {
      "sura": 77,
      "aya": 25,
      "text_uthmani": "أَلَمْ نَجْعَلِ اِ۬لَارْضَ كِفَاتاً",
      "text_normalized": "الم نجعل الارض كفاتا",
      "aya_indic": "٢٥",
      "jozz": 29,
      "page": 581
    },
    {
      "sura": 77,
      "aya": 26,
      "text_uthmani": "اَحْيَآءٗ وَأَمْوَٰتاٗ",
      "text_normalized": "احياء وامواتا",
      "aya_indic": "٢٦",
      "jozz": 29,
      "page": 581
    },
    {
      "sura": 77,
      "aya": 27,
      "text_uthmani": "وَجَعَلْنَا فِيهَا رَوَٰسِيَ شَٰمِخَٰتٖ وَأَسْقَيْنَٰكُم مَّآءٗ فُرَاتاٗۖ",
      "text_normalized": "وجعلنا فيها رواسي شامخات واسقيناكم ماء فراتا",
      "aya_indic": "٢٧",
      "jozz": 29,
      "page": 581
    },
    {
      "sura": 77,
      "aya": 28,
      "text_uthmani": "وَيْلٞ يَوْمَئِذٖ لِّلْمُكَذِّبِينَۖ",
      "text_normalized": "ويل يوميذ للمكذبين",
      "aya_indic": "٢٨",
      "jozz": 29,
      "page": 581
    },
    {
      "sura": 77,
      "aya": 29,
      "text_uthmani": "اَ۪نطَلِقُوٓاْ إِلَىٰ مَا كُنتُم بِهِۦ تُكَذِّبُونَ",
      "text_normalized": "انطلقوا اليا ما كنتم به تكذبون",
      "aya_indic": "٢٩",
      "jozz": 29,
      "page": 581
    },
    {
      "sura": 77,
      "aya": 30,
      "text_uthmani": "اَ۪نطَلِقُوٓاْ إِلَىٰ ظِلّٖ ذِے ثَلَٰثِ شُعَبٖ",
      "text_normalized": "انطلقوا اليا ظل ذے ثلاث شعب",
      "aya_indic": "٣٠",
      "jozz": 29,
      "page": 581
    },
    {
      "sura": 77,
      "aya": 31,
      "text_uthmani": "لَّا ظَلِيلٖ وَلَا يُغْنِے مِنَ اَ۬للَّهَبِۖ",
      "text_normalized": "لا ظليل ولا يغنے من اللهب",
      "aya_indic": "٣١",
      "jozz": 29,
      "page": 581
    },
    {
      "sura": 77,
      "aya": 32,
      "text_uthmani": "إِنَّهَا تَرْمِے بِشَرَرٖ كَالْقَصْرِ",
      "text_normalized": "انها ترمے بشرر كالقصر",
      "aya_indic": "٣٢",
      "jozz": 29,
      "page": 581
    },
    {
      "sura": 77,
      "aya": 33,
      "text_uthmani": "كَأَنَّهُۥ جِمَٰلَٰتٞ صُفْرٞۖ",
      "text_normalized": "كانه جمالات صفر",
      "aya_indic": "٣٣",
      "jozz": 29,
      "page": 581
    },
    {
      "sura": 77,
      "aya": 34,
      "text_uthmani": "وَيْلٞ يَوْمَئِذٖ لِّلْمُكَذِّبِينَۖ",
      "text_normalized": "ويل يوميذ للمكذبين",
      "aya_indic": "٣٤",
      "jozz": 29,
      "page": 581
    },
    {
      "sura": 77,
      "aya": 35,
      "text_uthmani": "هَٰذَا يَوْمُ لَا يَنطِقُونَ",
      "text_normalized": "هذا يوم لا ينطقون",
      "aya_indic": "٣٥",
      "jozz": 29,
      "page": 581
    },
    {
      "sura": 77,
      "aya": 36,
      "text_uthmani": "وَلَا يُوذَنُ لَهُمْ فَيَعْتَذِرُونَۖ",
      "text_normalized": "ولا يوذن لهم فيعتذرون",
      "aya_indic": "٣٦",
      "jozz": 29,
      "page": 581
    },
    {
      "sura": 77,
      "aya": 37,
      "text_uthmani": "وَيْلٞ يَوْمَئِذٖ لِّلْمُكَذِّبِينَۖ",
      "text_normalized": "ويل يوميذ للمكذبين",
      "aya_indic": "٣٧",
      "jozz": 29,
      "page": 581
    },
    {
      "sura": 77,
      "aya": 38,
      "text_uthmani": "هَٰذَا يَوْمُ اُ۬لْفَصْلِ جَمَعْنَٰكُمْ وَالَاوَّلِينَ",
      "text_normalized": "هذا يوم الفصل جمعناكم والاولين",
      "aya_indic": "٣٨",
      "jozz": 29,
      "page": 581
    },
    {
      "sura": 77,
      "aya": 39,
      "text_uthmani": "فَإِن كَانَ لَكُمْ كَيْدٞ فَكِيدُونِۖ",
      "text_normalized": "فان كان لكم كيد فكيدون",
      "aya_indic": "٣٩",
      "jozz": 29,
      "page": 581
    },
    {
      "sura": 77,
      "aya": 40,
      "text_uthmani": "وَيْلٞ يَوْمَئِذٖ لِّلْمُكَذِّبِينَۖ",
      "text_normalized": "ويل يوميذ للمكذبين",
      "aya_indic": "٤٠",
      "jozz": 29,
      "page": 581
    },
    {
      "sura": 77,
      "aya": 41,
      "text_uthmani": "إِنَّ اَ۬لْمُتَّقِينَ فِے ظِلَٰلٖ وَعُيُونٖ",
      "text_normalized": "ان المتقين فے ظلال وعيون",
      "aya_indic": "٤١",
      "jozz": 29,
      "page": 581
    },
    {
      "sura": 77,
      "aya": 42,
      "text_uthmani": "وَفَوَٰكِهَ مِمَّا يَشْتَهُونَۖ",
      "text_normalized": "وفواكه مما يشتهون",
      "aya_indic": "٤٢",
      "jozz": 29,
      "page": 581
    },
    {
      "sura": 77,
      "aya": 43,
      "text_uthmani": "كُلُواْ وَاشْرَبُواْۖ هَنِيٓـٔاَۢ بِمَا كُنتُمْ تَعْمَلُونَۖ",
      "text_normalized": "كلوا واشربوا هنيا بما كنتم تعملون",
      "aya_indic": "٤٣",
      "jozz": 29,
      "page": 581
    },
    {
      "sura": 77,
      "aya": 44,
      "text_uthmani": "إِنَّا كَذَٰلِكَ نَجْزِے اِ۬لْمُحْسِنِينَۖ",
      "text_normalized": "انا كذالك نجزے المحسنين",
      "aya_indic": "٤٤",
      "jozz": 29,
      "page": 581
    },
    {
      "sura": 77,
      "aya": 45,
      "text_uthmani": "وَيْلٞ يَوْمَئِذٖ لِّلْمُكَذِّبِينَۖ",
      "text_normalized": "ويل يوميذ للمكذبين",
      "aya_indic": "٤٥",
      "jozz": 29,
      "page": 581
    },
    {
      "sura": 77,
      "aya": 46,
      "text_uthmani": "كُلُواْ وَتَمَتَّعُواْ قَلِيلاً اِنَّكُم مُّجْرِمُونَۖ",
      "text_normalized": "كلوا وتمتعوا قليلا انكم مجرمون",
      "aya_indic": "٤٦",
      "jozz": 29,
      "page": 581
    },
    {
      "sura": 77,
      "aya": 47,
      "text_uthmani": "وَيْلٞ يَوْمَئِذٖ لِّلْمُكَذِّبِينَۖ",
      "text_normalized": "ويل يوميذ للمكذبين",
      "aya_indic": "٤٧",
      "jozz": 29,
      "page": 581
    },
    {
      "sura": 77,
      "aya": 48,
      "text_uthmani": "وَإِذَا قِيلَ لَهُمُ اُ۪رْكَعُواْ لَا يَرْكَعُونَۖ",
      "text_normalized": "واذا قيل لهم اركعوا لا يركعون",
      "aya_indic": "٤٨",
      "jozz": 29,
      "page": 581
    },
    {
      "sura": 77,
      "aya": 49,
      "text_uthmani": "وَيْلٞ يَوْمَئِذٖ لِّلْمُكَذِّبِينَۖ",
      "text_normalized": "ويل يوميذ للمكذبين",
      "aya_indic": "٤٩",
      "jozz": 29,
      "page": 581
    },
    {
      "sura": 77,
      "aya": 50,
      "text_uthmani": "فَبِأَيِّ حَدِيثِۢ بَعْدَهُۥ يُومِنُونَۖ",
      "text_normalized": "فباي حديث بعده يومنون",
      "aya_indic": "٥٠",
      "jozz": 29,
      "page": 581
    }
  ]
}