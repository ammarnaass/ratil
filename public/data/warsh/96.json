{
  "id": 96,
  "name_ar": "العلق",
  "name_en": "Al-'Alaq",
  "type": "مكية",
  "ayahs_hafs": 19,
  "ayahs_warsh": 19,
  "page": 597,
  "narration": "warsh",
  "narration_ar": "ورش عن نافع",
  "ayahs": [
    {
      "sura": 96,
      "aya": 1,
      "text_uthmani": "اَ۪قْرَأْ بِاسْمِ رَبِّكَ اَ۬لذِے خَلَقَۖ",
      "text_normalized": "اقرا باسم ربك الذے خلق",
      "aya_indic": "١",
      "jozz": 30,
      "page": 597
    },
    {
      "sura": 96,
      "aya": 2,
      "text_uthmani": "خَلَقَ اَ۬لِانسَٰنَ مِنْ عَلَقٍۖ",
      "text_normalized": "خلق الانسان من علق",
      "aya_indic": "٢",
      "jozz": 30,
      "page": 597
    },
    {
      "sura": 96,
      "aya": 3,
      "text_uthmani": "اِ۪قْرَأْ وَرَبُّكَ اَ۬لَاكْرَمُ",
      "text_normalized": "اقرا وربك الاكرم",
      "aya_indic": "٣",
      "jozz": 30,
      "page": 597
    },
    {
      "sura": 96,
      "aya": 4,
      "text_uthmani": "اُ۬لذِے عَلَّمَ بِالْقَلَمِ",
      "text_normalized": "الذے علم بالقلم",
      "aya_indic": "٤",
      "jozz": 30,
      "page": 597
    },
    {
      "sura": 96,
      "aya": 5,
      "text_uthmani": "عَلَّمَ اَ۬لِانسَٰنَ مَا لَمْ يَعْلَمْۖ",
      "text_normalized": "علم الانسان ما لم يعلم",
      "aya_indic": "٥",
      "jozz": 30,
      "page": 597
    },
    {
      "sura": 96,
      "aya": 6,
      "text_uthmani": "كَلَّآ إِنَّ اَ۬لِانسَٰنَ لَيَطْغ۪ىٰٓ",
      "text_normalized": "كلا ان الانسان ليطغيا",
      "aya_indic": "٦",
      "jozz": 30,
      "page": 597
    },
    {
      "sura": 96,
      "aya": 7,
      "text_uthmani": "أَن رّ۪ء۪اهُ اُ۪سْتَغْن۪ىٰٓۖ",
      "text_normalized": "ان رءاه استغنيا",
      "aya_indic": "٧",
      "jozz": 30,
      "page": 597
    },
    {
      "sura": 96,
      "aya": 8,
      "text_uthmani": "إِنَّ إِلَىٰ رَبِّكَ اَ۬لرُّجْع۪ىٰٓۖ",
      "text_normalized": "ان اليا ربك الرجعيا",
      "aya_indic": "٨",
      "jozz": 30,
      "page": 597
    },
    {
      "sura": 96,
      "aya": 9,
      "text_uthmani": "أَرَٰٓيْتَ اَ۬لذِے يَنْه۪ىٰ",
      "text_normalized": "ارايت الذے ينهيا",
      "aya_indic": "٩",
      "jozz": 30,
      "page": 597
    },
    {
      "sura": 96,
      "aya": 10,
      "text_uthmani": "عَبْداً اِذَا صَلّ۪ىٰٓۖ",
      "text_normalized": "عبدا اذا صليا",
      "aya_indic": "١٠",
      "jozz": 30,
      "page": 597
    },
    {
      "sura": 96,
      "aya": 11,
      "text_uthmani": "أَرَٰٓيْتَ إِن كَانَ عَلَى اَ۬لْهُد۪ىٰٓ",
      "text_normalized": "ارايت ان كان علي الهديا",
      "aya_indic": "١١",
      "jozz": 30,
      "page": 597
    },
    {
      "sura": 96,
      "aya": 12,
      "text_uthmani": "أَوَ اَمَرَ بِالتَّقْو۪ىٰٓۖ",
      "text_normalized": "او امر بالتقويا",
      "aya_indic": "١٢",
      "jozz": 30,
      "page": 597
    },
    {
      "sura": 96,
      "aya": 13,
      "text_uthmani": "أَرَٰٓيْتَ إِن كَذَّبَ وَتَوَلّ۪ىٰٓ",
      "text_normalized": "ارايت ان كذب وتوليا",
      "aya_indic": "١٣",
      "jozz": 30,
      "page": 598
    },
    {
      "sura": 96,
      "aya": 14,
      "text_uthmani": "أَلَمْ يَعْلَم بِأَنَّ اَ۬للَّهَ يَر۪ىٰۖ",
      "text_normalized": "الم يعلم بان الله يريا",
      "aya_indic": "١٤",
      "jozz": 30,
      "page": 598
    },
    {
      "sura": 96,
      "aya": 15,
      "text_uthmani": "كَلَّا لَئِن لَّمْ يَنتَهِ",
      "text_normalized": "كلا لين لم ينته",
      "aya_indic": "١٥",
      "jozz": 30,
      "page": 598
    },
    {
      "sura": 96,
      "aya": 16,
      "text_uthmani": "لَنَسْفَعاَۢ بِالنَّاصِيَةِ",
      "text_normalized": "لنسفعا بالناصيه",
      "aya_indic": "١٦",
      "jozz": 30,
      "page": 598
    },
    {
      "sura": 96,
      "aya": 17,
      "text_uthmani": "نَاصِيَةٖ كَٰذِبَةٍ خَاطِئَةٖۖ",
      "text_normalized": "ناصيه كاذبه خاطيه",
      "aya_indic": "١٧",
      "jozz": 30,
      "page": 598
    },
    {
      "sura": 96,
      "aya": 18,
      "text_uthmani": "فَلْيَدْعُ نَادِيَهُۥ",
      "text_normalized": "فليدع ناديه",
      "aya_indic": "١٨",
      "jozz": 30,
      "page": 598
    },
    {
      "sura": 96,
      "aya": 19,
      "text_uthmani": "سَنَدْعُ اُ۬لزَّبَانِيَةَۖ",
      "text_normalized": "سندع الزبانيه",
      "aya_indic": "١٩",
      "jozz": 30,
      "page": 598
    },
    {
      "sura": 96,
      "aya": 20,
      "text_uthmani": "كَلَّا لَا تُطِعْهُ وَاسْجُدْ وَاقْتَرِبِۖ",
      "text_normalized": "كلا لا تطعه واسجد واقترب",
      "aya_indic": "٢٠",
      "jozz": 30,
      "page": 598
    }
  ]
}