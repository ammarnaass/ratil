{
  "id": 68,
  "name_ar": "القلم",
  "name_en": "Al-Qalam",
  "type": "مكية",
  "ayahs_hafs": 52,
  "ayahs_warsh": 52,
  "page": 564,
  "narration": "warsh",
  "narration_ar": "ورش عن نافع",
  "ayahs": [
    {
      "sura": 68,
      "aya": 1,
      "text_uthmani": "نُّٓۖ وَالْقَلَمِ وَمَا يَسْطُرُونَ",
      "text_normalized": "ن والقلم وما يسطرون",
      "aya_indic": "١",
      "jozz": 29,
      "page": 564
    },
    {
      "sura": 68,
      "aya": 2,
      "text_uthmani": "مَآ أَنتَ بِنِعْمَةِ رَبِّكَ بِمَجْنُونٖ",
      "text_normalized": "ما انت بنعمه ربك بمجنون",
      "aya_indic": "٢",
      "jozz": 29,
      "page": 564
    },
    {
      "sura": 68,
      "aya": 3,
      "text_uthmani": "وَإِنَّ لَكَ لَأَجْراً غَيْرَ مَمْنُونٖ",
      "text_normalized": "وان لك لاجرا غير ممنون",
      "aya_indic": "٣",
      "jozz": 29,
      "page": 564
    },
    {
      "sura": 68,
      "aya": 4,
      "text_uthmani": "وَإِنَّكَ لَعَلَىٰ خُلُقٍ عَظِيمٖۖ",
      "text_normalized": "وانك لعليا خلق عظيم",
      "aya_indic": "٤",
      "jozz": 29,
      "page": 564
    },
    {
      "sura": 68,
      "aya": 5,
      "text_uthmani": "فَسَتُبْصِرُ وَيُبْصِرُونَ",
      "text_normalized": "فستبصر ويبصرون",
      "aya_indic": "٥",
      "jozz": 29,
      "page": 564
    },
    {
      "sura": 68,
      "aya": 6,
      "text_uthmani": "بِأَييِّكُمُ اُ۬لْمَفْتُونُۖ",
      "text_normalized": "باييكم المفتون",
      "aya_indic": "٦",
      "jozz": 29,
      "page": 564
    },
    {
      "sura": 68,
      "aya": 7,
      "text_uthmani": "إِنَّ رَبَّكَ هُوَ أَعْلَمُ بِمَن ضَلَّ عَن سَبِيلِهِۦۖ وَهُوَ أَعْلَمُ بِالْمُهْتَدِينَۖ",
      "text_normalized": "ان ربك هو اعلم بمن ضل عن سبيله وهو اعلم بالمهتدين",
      "aya_indic": "٧",
      "jozz": 29,
      "page": 564
    },
    {
      "sura": 68,
      "aya": 8,
      "text_uthmani": "فَلَا تُطِعِ اِ۬لْمُكَذِّبِينَۖ",
      "text_normalized": "فلا تطع المكذبين",
      "aya_indic": "٨",
      "jozz": 29,
      "page": 564
    },
    {
      "sura": 68,
      "aya": 9,
      "text_uthmani": "وَدُّواْ لَوْ تُدْهِنُ فَيُدْهِنُونَۖ",
      "text_normalized": "ودوا لو تدهن فيدهنون",
      "aya_indic": "٩",
      "jozz": 29,
      "page": 564
    },
    {
      "sura": 68,
      "aya": 10,
      "text_uthmani": "وَلَا تُطِعْ كُلَّ حَلَّٰفٖ مَّهِينٍ",
      "text_normalized": "ولا تطع كل حلاف مهين",
      "aya_indic": "١٠",
      "jozz": 29,
      "page": 564
    },
    {
      "sura": 68,
      "aya": 11,
      "text_uthmani": "هَمَّازٖ مَّشَّآءِۢ بِنَمِيمٖ",
      "text_normalized": "هماز مشاء بنميم",
      "aya_indic": "١١",
      "jozz": 29,
      "page": 564
    },
    {
      "sura": 68,
      "aya": 12,
      "text_uthmani": "مَّنَّاعٖ لِّلْخَيْرِ مُعْتَدٍ اَثِيمٍ",
      "text_normalized": "مناع للخير معتد اثيم",
      "aya_indic": "١٢",
      "jozz": 29,
      "page": 564
    },
    {
      "sura": 68,
      "aya": 13,
      "text_uthmani": "عُتُلِّۢ بَعْدَ ذَٰلِكَ زَنِيمٍ",
      "text_normalized": "عتل بعد ذلك زنيم",
      "aya_indic": "١٣",
      "jozz": 29,
      "page": 564
    },
    {
      "sura": 68,
      "aya": 14,
      "text_uthmani": "اَن كَانَ ذَا مَالٖ وَبَنِينَ",
      "text_normalized": "ان كان ذا مال وبنين",
      "aya_indic": "١٤",
      "jozz": 29,
      "page": 564
    },
    {
      "sura": 68,
      "aya": 15,
      "text_uthmani": "إِذَا تُتْل۪ىٰ عَلَيْهِ ءَايَٰتُنَا قَالَ أَسَٰطِيرُ اُ۬لَاوَّلِينَۖ",
      "text_normalized": "اذا تتليا عليه ءاياتنا قال اساطير الاولين",
      "aya_indic": "١٥",
      "jozz": 29,
      "page": 564
    },
    {
      "sura": 68,
      "aya": 16,
      "text_uthmani": "سَنَسِمُهُۥ عَلَى اَ۬لْخُرْطُومِۖ",
      "text_normalized": "سنسمه علي الخرطوم",
      "aya_indic": "١٦",
      "jozz": 29,
      "page": 564
    },
    {
      "sura": 68,
      "aya": 17,
      "text_uthmani": "إِنَّا بَلَوْنَٰهُمْ كَمَا بَلَوْنَآ أَصْحَٰبَ اَ۬لْجَنَّةِ إِذَ اَقْسَمُواْ لَيَصْرِمُنَّهَا مُصْبِحِينَ",
      "text_normalized": "انا بلوناهم كما بلونا اصحاب الجنه اذ اقسموا ليصرمنها مصبحين",
      "aya_indic": "١٧",
      "jozz": 29,
      "page": 565
    },
    {
      "sura": 68,
      "aya": 18,
      "text_uthmani": "وَلَا يَسْتَثْنُونَۖ",
      "text_normalized": "ولا يستثنون",
      "aya_indic": "١٨",
      "jozz": 29,
      "page": 565
    },
    {
      "sura": 68,
      "aya": 19,
      "text_uthmani": "۞ فَطَافَ عَلَيْهَا طَآئِفٞ مِّن رَّبِّكَ وَهُمْ نَآئِمُونَ",
      "text_normalized": "فطاف عليها طايف من ربك وهم نايمون",
      "aya_indic": "١٩",
      "jozz": 29,
      "page": 565
    },
    {
      "sura": 68,
      "aya": 20,
      "text_uthmani": "فَأَصْبَحَتْ كَالصَّرِيمِۖ",
      "text_normalized": "فاصبحت كالصريم",
      "aya_indic": "٢٠",
      "jozz": 29,
      "page": 565
    },
    {
      "sura": 68,
      "aya": 21,
      "text_uthmani": "فَتَنَادَوْاْ مُصْبِحِينَ",
      "text_normalized": "فتنادوا مصبحين",
      "aya_indic": "٢١",
      "jozz": 29,
      "page": 565
    },
    {
      "sura": 68,
      "aya": 22,
      "text_uthmani": "أَنُ اُ۟غْدُواْ عَلَىٰ حَرْثِكُمُۥٓ إِن كُنتُمْ صَٰرِمِينَۖ",
      "text_normalized": "ان اغدوا عليا حرثكم ان كنتم صارمين",
      "aya_indic": "٢٢",
      "jozz": 29,
      "page": 565
    },
    {
      "sura": 68,
      "aya": 23,
      "text_uthmani": "فَانطَلَقُواْ وَهُمْ يَتَخَٰفَتُونَ",
      "text_normalized": "فانطلقوا وهم يتخافتون",
      "aya_indic": "٢٣",
      "jozz": 29,
      "page": 565
    },
    {
      "sura": 68,
      "aya": 24,
      "text_uthmani": "أَن لَّا يَدْخُلَنَّهَا اَ۬لْيَوْمَ عَلَيْكُم مِّسْكِينٞۖ",
      "text_normalized": "ان لا يدخلنها اليوم عليكم مسكين",
      "aya_indic": "٢٤",
      "jozz": 29,
      "page": 565
    },
    {
      "sura": 68,
      "aya": 25,
      "text_uthmani": "وَغَدَوْاْ عَلَىٰ حَرْدٖ قَٰدِرِينَۖ",
      "text_normalized": "وغدوا عليا حرد قادرين",
      "aya_indic": "٢٥",
      "jozz": 29,
      "page": 565
    },
    {
      "sura": 68,
      "aya": 26,
      "text_uthmani": "فَلَمَّا رَأَوْهَا قَالُوٓاْ إِنَّا لَضَآلُّونَ",
      "text_normalized": "فلما راوها قالوا انا لضالون",
      "aya_indic": "٢٦",
      "jozz": 29,
      "page": 565
    },
    {
      "sura": 68,
      "aya": 27,
      "text_uthmani": "بَلْ نَحْنُ مَحْرُومُونَۖ",
      "text_normalized": "بل نحن محرومون",
      "aya_indic": "٢٧",
      "jozz": 29,
      "page": 565
    },
    {
      "sura": 68,
      "aya": 28,
      "text_uthmani": "قَالَ أَوْسَطُهُمُۥٓ أَلَمَ اَقُل لَّكُمْ لَوْلَا تُسَبِّحُونَۖ",
      "text_normalized": "قال اوسطهم الم اقل لكم لولا تسبحون",
      "aya_indic": "٢٨",
      "jozz": 29,
      "page": 565
    },
    {
      "sura": 68,
      "aya": 29,
      "text_uthmani": "قَالُواْ سُبْحَٰنَ رَبِّنَآ إِنَّا كُنَّا ظَٰلِمِينَۖ",
      "text_normalized": "قالوا سبحان ربنا انا كنا ظالمين",
      "aya_indic": "٢٩",
      "jozz": 29,
      "page": 565
    },
    {
      "sura": 68,
      "aya": 30,
      "text_uthmani": "فَأَقْبَلَ بَعْضُهُمْ عَلَىٰ بَعْضٖ يَتَلَٰوَمُونَۖ",
      "text_normalized": "فاقبل بعضهم عليا بعض يتلاومون",
      "aya_indic": "٣٠",
      "jozz": 29,
      "page": 565
    },
    {
      "sura": 68,
      "aya": 31,
      "text_uthmani": "قَالُواْ يَٰوَيْلَنَآ إِنَّا كُنَّا طَٰغِينَ",
      "text_normalized": "قالوا ياويلنا انا كنا طاغين",
      "aya_indic": "٣١",
      "jozz": 29,
      "page": 565
    },
    {
      "sura": 68,
      "aya": 32,
      "text_uthmani": "عَس۪ىٰ رَبُّنَآ أَنْ يُّبَدِّلَنَا خَيْراٗ مِّنْهَآ إِنَّآ إِلَىٰ رَبِّنَا رَٰغِبُونَۖ",
      "text_normalized": "عسيا ربنا ان يبدلنا خيرا منها انا اليا ربنا راغبون",
      "aya_indic": "٣٢",
      "jozz": 29,
      "page": 565
    },
    {
      "sura": 68,
      "aya": 33,
      "text_uthmani": "كَذَٰلِكَ اَ۬لْعَذَابُۖ وَلَعَذَابُ اُ۬لَاخِرَةِ أَكْبَرُ لَوْ كَانُواْ يَعْلَمُونَۖ",
      "text_normalized": "كذالك العذاب ولعذاب الاخره اكبر لو كانوا يعلمون",
      "aya_indic": "٣٣",
      "jozz": 29,
      "page": 565
    },
    {
      "sura": 68,
      "aya": 34,
      "text_uthmani": "إِنَّ لِلْمُتَّقِينَ عِندَ رَبِّهِمْ جَنَّٰتِ اِ۬لنَّعِيمِۖ",
      "text_normalized": "ان للمتقين عند ربهم جنات النعيم",
      "aya_indic": "٣٤",
      "jozz": 29,
      "page": 565
    },
    {
      "sura": 68,
      "aya": 35,
      "text_uthmani": "أَفَنَجْعَلُ اُ۬لْمُسْلِمِينَ كَالْمُجْرِمِينَۖ",
      "text_normalized": "افنجعل المسلمين كالمجرمين",
      "aya_indic": "٣٥",
      "jozz": 29,
      "page": 565
    },
    {
      "sura": 68,
      "aya": 36,
      "text_uthmani": "مَا لَكُمْۖ كَيْفَ تَحْكُمُونَۖ",
      "text_normalized": "ما لكم كيف تحكمون",
      "aya_indic": "٣٦",
      "jozz": 29,
      "page": 565
    },
    {
      "sura": 68,
      "aya": 37,
      "text_uthmani": "أَمْ لَكُمْ كِتَٰبٞ فِيهِ تَدْرُسُونَ",
      "text_normalized": "ام لكم كتاب فيه تدرسون",
      "aya_indic": "٣٧",
      "jozz": 29,
      "page": 565
    },
    {
      "sura": 68,
      "aya": 38,
      "text_uthmani": "إِنَّ لَكُمْ فِيهِ لَمَا تَخَيَّرُونَۖ",
      "text_normalized": "ان لكم فيه لما تخيرون",
      "aya_indic": "٣٨",
      "jozz": 29,
      "page": 565
    },
    {
      "sura": 68,
      "aya": 39,
      "text_uthmani": "أَمْ لَكُمُۥٓ أَيْمَٰنٌ عَلَيْنَا بَٰلِغَةٌ اِلَىٰ يَوْمِ اِ۬لْقِيَٰمَةِ إِنَّ لَكُمْ لَمَا تَحْكُمُونَۖ",
      "text_normalized": "ام لكم ايمان علينا بالغه اليا يوم القيامه ان لكم لما تحكمون",
      "aya_indic": "٣٩",
      "jozz": 29,
      "page": 565
    },
    {
      "sura": 68,
      "aya": 40,
      "text_uthmani": "سَلْهُمُۥٓ أَيُّهُم بِذَٰلِكَ زَعِيمٌۖ",
      "text_normalized": "سلهم ايهم بذالك زعيم",
      "aya_indic": "٤٠",
      "jozz": 29,
      "page": 565
    },
    {
      "sura": 68,
      "aya": 41,
      "text_uthmani": "اَمْ لَهُمْ شُرَكَآءُ فَلْيَاتُواْ بِشُرَكَآئِهِمُۥٓ إِن كَانُواْ صَٰدِقِينَۖ",
      "text_normalized": "ام لهم شركاء فلياتوا بشركايهم ان كانوا صادقين",
      "aya_indic": "٤١",
      "jozz": 29,
      "page": 565
    },
    {
      "sura": 68,
      "aya": 42,
      "text_uthmani": "يَوْمَ يُكْشَفُ عَن سَاقٖ وَيُدْعَوْنَ إِلَى اَ۬لسُّجُودِ فَلَا يَسْتَطِيعُونَۖ",
      "text_normalized": "يوم يكشف عن ساق ويدعون الي السجود فلا يستطيعون",
      "aya_indic": "٤٢",
      "jozz": 29,
      "page": 565
    },
    {
      "sura": 68,
      "aya": 43,
      "text_uthmani": "خَٰشِعَةً اَبْصَٰرُهُمْ تَرْهَقُهُمْ ذِلَّةٞۖ وَقَدْ كَانُواْ يُدْعَوْنَ إِلَى اَ۬لسُّجُودِ وَهُمْ سَٰلِمُونَۖ",
      "text_normalized": "خاشعه ابصارهم ترهقهم ذله وقد كانوا يدعون الي السجود وهم سالمون",
      "aya_indic": "٤٣",
      "jozz": 29,
      "page": 566
    },
    {
      "sura": 68,
      "aya": 44,
      "text_uthmani": "فَذَرْنِے وَمَنْ يُّكَذِّبُ بِهَٰذَا اَ۬لْحَدِيثِۖ سَنَسْتَدْرِجُهُم مِّنْ حَيْثُ لَا يَعْلَمُونَ",
      "text_normalized": "فذرنے ومن يكذب بهاذا الحديث سنستدرجهم من حيث لا يعلمون",
      "aya_indic": "٤٤",
      "jozz": 29,
      "page": 566
    },
    {
      "sura": 68,
      "aya": 45,
      "text_uthmani": "وَأُمْلِے لَهُمُۥٓۖ إِنَّ كَيْدِے مَتِينٌۖ",
      "text_normalized": "واملے لهم ان كيدے متين",
      "aya_indic": "٤٥",
      "jozz": 29,
      "page": 566
    },
    {
      "sura": 68,
      "aya": 46,
      "text_uthmani": "اَمْ تَسْـَٔلُهُمُۥٓ أَجْراٗ فَهُم مِّن مَّغْرَمٖ مُّثْقَلُونَۖ",
      "text_normalized": "ام تسلهم اجرا فهم من مغرم مثقلون",
      "aya_indic": "٤٦",
      "jozz": 29,
      "page": 566
    },
    {
      "sura": 68,
      "aya": 47,
      "text_uthmani": "أَمْ عِندَهُمُ اُ۬لْغَيْبُ فَهُمْ يَكْتُبُونَۖ",
      "text_normalized": "ام عندهم الغيب فهم يكتبون",
      "aya_indic": "٤٧",
      "jozz": 29,
      "page": 566
    },
    {
      "sura": 68,
      "aya": 48,
      "text_uthmani": "۞ فَاصْبِرْ لِحُكْمِ رَبِّكَ وَلَا تَكُن كَصَٰحِبِ اِ۬لْحُوتِ إِذْ نَاد۪ىٰ وَهُوَ مَكْظُومٞۖ",
      "text_normalized": "فاصبر لحكم ربك ولا تكن كصاحب الحوت اذ ناديا وهو مكظوم",
      "aya_indic": "٤٨",
      "jozz": 29,
      "page": 566
    },
    {
      "sura": 68,
      "aya": 49,
      "text_uthmani": "لَّوْلَآ أَن تَدَٰرَكَهُۥ نِعْمَةٞ مِّن رَّبِّهِۦ لَنُبِذَ بِالْعَرَآءِ وَهُوَ مَذْمُومٞۖ",
      "text_normalized": "لولا ان تداركه نعمه من ربه لنبذ بالعراء وهو مذموم",
      "aya_indic": "٤٩",
      "jozz": 29,
      "page": 566
    },
    {
      "sura": 68,
      "aya": 50,
      "text_uthmani": "فَاجْتَبٰ۪هُ رَبُّهُۥ فَجَعَلَهُۥ مِنَ اَ۬لصَّٰلِحِينَۖ",
      "text_normalized": "فاجتباه ربه فجعله من الصالحين",
