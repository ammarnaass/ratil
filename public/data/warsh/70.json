{
  "id": 70,
  "name_ar": "المعارج",
  "name_en": "Al-Ma'arij",
  "type": "مكية",
  "ayahs_hafs": 44,
  "ayahs_warsh": 44,
  "page": 568,
  "narration": "warsh",
  "narration_ar": "ورش عن نافع",
  "ayahs": [
    {
      "sura": 70,
      "aya": 1,
      "text_uthmani": "سَالَ سَآئِلُۢ بِعَذَابٖ وَاقِعٖ",
      "text_normalized": "سال سايل بعذاب واقع",
      "aya_indic": "١",
      "jozz": 29,
      "page": 568
    },
    {
      "sura": 70,
      "aya": 2,
      "text_uthmani": "لِّلْكٰ۪فِرِينَ لَيْسَ لَهُۥ دَافِعٞ",
      "text_normalized": "للكافرين ليس له دافع",
      "aya_indic": "٢",
      "jozz": 29,
      "page": 568
    },
    {
      "sura": 70,
      "aya": 3,
      "text_uthmani": "مِّنَ اَ۬للَّهِ ذِے اِ۬لْمَعَارِجِۖ",
      "text_normalized": "من الله ذے المعارج",
      "aya_indic": "٣",
      "jozz": 29,
      "page": 568
    },
    {
      "sura": 70,
      "aya": 4,
      "text_uthmani": "تَعْرُجُ اُ۬لْمَلَٰٓئِكَةُ وَالرُّوحُ إِلَيْهِ فِے يَوْمٖ كَانَ مِقْدَارُهُۥ خَمْسِينَ أَلْفَ سَنَةٖۖ",
      "text_normalized": "تعرج الملايكه والروح اليه فے يوم كان مقداره خمسين الف سنه",
      "aya_indic": "٤",
      "jozz": 29,
      "page": 568
    },
    {
      "sura": 70,
      "aya": 5,
      "text_uthmani": "فَاصْبِرْ صَبْراٗ جَمِيلاًۖ",
      "text_normalized": "فاصبر صبرا جميلا",
      "aya_indic": "٥",
      "jozz": 29,
      "page": 568
    },
    {
      "sura": 70,
      "aya": 6,
      "text_uthmani": "اِنَّهُمْ يَرَوْنَهُۥ بَعِيداٗ",
      "text_normalized": "انهم يرونه بعيدا",
      "aya_indic": "٦",
      "jozz": 29,
      "page": 568
    },
    {
      "sura": 70,
      "aya": 7,
      "text_uthmani": "وَنَر۪يٰهُ قَرِيباٗۖ",
      "text_normalized": "ونرياه قريبا",
      "aya_indic": "٧",
      "jozz": 29,
      "page": 568
    },
    {
      "sura": 70,
      "aya": 8,
      "text_uthmani": "يَوْمَ تَكُونُ اُ۬لسَّمَآءُ كَالْمُهْلِ",
      "text_normalized": "يوم تكون السماء كالمهل",
      "aya_indic": "٨",
      "jozz": 29,
      "page": 568
    },
    {
      "sura": 70,
      "aya": 9,
      "text_uthmani": "وَتَكُونُ اُ۬لْجِبَالُ كَالْعِهْنِ",
      "text_normalized": "وتكون الجبال كالعهن",
      "aya_indic": "٩",
      "jozz": 29,
      "page": 568
    },
    {
      "sura": 70,
      "aya": 10,
      "text_uthmani": "وَلَا يَسْـَٔلُ حَمِيمٌ حَمِيماٗ",
      "text_normalized": "ولا يسل حميم حميما",
      "aya_indic": "١٠",
      "jozz": 29,
      "page": 568
    },
    {
      "sura": 70,
      "aya": 11,
      "text_uthmani": "يُبَصَّرُونَهُمْۖ يَوَدُّ اُ۬لْمُجْرِمُ لَوْ يَفْتَدِے مِنْ عَذَابِ يَوْمَئِذِۢ بِبَنِيهِ",
      "text_normalized": "يبصرونهم يود المجرم لو يفتدے من عذاب يوميذ ببنيه",
      "aya_indic": "١١",
      "jozz": 29,
      "page": 569
    },
    {
      "sura": 70,
      "aya": 12,
      "text_uthmani": "وَصَٰحِبَتِهِۦ وَأَخِيهِ",
      "text_normalized": "وصاحبته واخيه",
      "aya_indic": "١٢",
      "jozz": 29,
      "page": 569
    },
    {
      "sura": 70,
      "aya": 13,
      "text_uthmani": "وَفَصِيلَتِهِ اِ۬لتِے تُـْٔوِيهِ",
      "text_normalized": "وفصيلته التے تويه",
      "aya_indic": "١٣",
      "jozz": 29,
      "page": 569
    },
    {
      "sura": 70,
      "aya": 14,
      "text_uthmani": "وَمَن فِے اِ۬لَارْضِ جَمِيعاٗ ثُمَّ يُنجِيهِ",
      "text_normalized": "ومن فے الارض جميعا ثم ينجيه",
      "aya_indic": "١٤",
      "jozz": 29,
      "page": 569
    },
    {
      "sura": 70,
      "aya": 15,
      "text_uthmani": "كَلَّآۖ إِنَّهَا لَظ۪ىٰ",
      "text_normalized": "كلا انها لظيا",
      "aya_indic": "١٥",
      "jozz": 29,
      "page": 569
    },
    {
      "sura": 70,
      "aya": 16,
      "text_uthmani": "نَزَّاعَةٞ لِّلشَّو۪ىٰ",
      "text_normalized": "نزاعه للشويا",
      "aya_indic": "١٦",
      "jozz": 29,
      "page": 569
    },
    {
      "sura": 70,
      "aya": 17,
      "text_uthmani": "تَدْعُواْ مَنَ اَدْبَرَ وَتَوَلّ۪ىٰ",
      "text_normalized": "تدعوا من ادبر وتوليا",
      "aya_indic": "١٧",
      "jozz": 29,
      "page": 569
    },
    {
      "sura": 70,
      "aya": 18,
      "text_uthmani": "وَجَمَعَ فَأَوْع۪ىٰٓۖ",
      "text_normalized": "وجمع فاوعيا",
      "aya_indic": "١٨",
      "jozz": 29,
      "page": 569
    },
    {
      "sura": 70,
      "aya": 19,
      "text_uthmani": "إِنَّ اَ۬لِانسَٰنَ خُلِقَ هَلُوعاً",
      "text_normalized": "ان الانسان خلق هلوعا",
      "aya_indic": "١٩",
      "jozz": 29,
      "page": 569
    },
    {
      "sura": 70,
      "aya": 20,
      "text_uthmani": "اِذَا مَسَّهُ اُ۬لشَّرُّ جَزُوعاٗ",
      "text_normalized": "اذا مسه الشر جزوعا",
      "aya_indic": "٢٠",
      "jozz": 29,
      "page": 569
    },
    {
      "sura": 70,
      "aya": 21,
      "text_uthmani": "وَإِذَا مَسَّهُ اُ۬لْخَيْرُ مَنُوعاً",
      "text_normalized": "واذا مسه الخير منوعا",
      "aya_indic": "٢١",
      "jozz": 29,
      "page": 569
    },
    {
      "sura": 70,
      "aya": 22,
      "text_uthmani": "اِلَّا اَ۬لْمُصَلِّينَ",
      "text_normalized": "الا المصلين",
      "aya_indic": "٢٢",
      "jozz": 29,
      "page": 569
    },
    {
      "sura": 70,
      "aya": 23,
      "text_uthmani": "اَ۬لذِينَ هُمْ عَلَىٰ صَلَاتِهِمْ دَآئِمُونَۖ",
      "text_normalized": "الذين هم عليا صلاتهم دايمون",
      "aya_indic": "٢٣",
      "jozz": 29,
      "page": 569
    },
    {
      "sura": 70,
      "aya": 24,
      "text_uthmani": "وَالذِينَ فِےٓ أَمْوَٰلِهِمْ حَقّٞ مَّعْلُومٞ",
      "text_normalized": "والذين فے اموالهم حق معلوم",
      "aya_indic": "٢٤",
      "jozz": 29,
      "page": 569
    },
    {
      "sura": 70,
      "aya": 25,
      "text_uthmani": "لِّلسَّآئِلِ وَالْمَحْرُومِۖ",
      "text_normalized": "للسايل والمحروم",
      "aya_indic": "٢٥",
      "jozz": 29,
      "page": 569
    },
    {
      "sura": 70,
      "aya": 26,
      "text_uthmani": "وَالذِينَ يُصَدِّقُونَ بِيَوْمِ اِ۬لدِّينِۖ",
      "text_normalized": "والذين يصدقون بيوم الدين",
      "aya_indic": "٢٦",
      "jozz": 29,
      "page": 569
    },
    {
      "sura": 70,
      "aya": 27,
      "text_uthmani": "وَالذِينَ هُم مِّنْ عَذَابِ رَبِّهِم مُّشْفِقُونَ",
      "text_normalized": "والذين هم من عذاب ربهم مشفقون",
      "aya_indic": "٢٧",
      "jozz": 29,
      "page": 569
    },
    {
      "sura": 70,
      "aya": 28,
      "text_uthmani": "إِنَّ عَذَابَ رَبِّهِمْ غَيْرُ مَامُونٖۖ",
      "text_normalized": "ان عذاب ربهم غير مامون",
      "aya_indic": "٢٨",
      "jozz": 29,
      "page": 569
    },
    {
      "sura": 70,
      "aya": 29,
      "text_uthmani": "وَالذِينَ هُمْ لِفُرُوجِهِمْ حَٰفِظُونَ",
      "text_normalized": "والذين هم لفروجهم حافظون",
      "aya_indic": "٢٩",
      "jozz": 29,
      "page": 569
    },
    {
      "sura": 70,
      "aya": 30,
      "text_uthmani": "إِلَّا عَلَىٰٓ أَزْوَٰجِهِمُۥٓ أَوْ مَا مَلَكَتَ اَيْمَٰنُهُمْ فَإِنَّهُمْ غَيْرُ مَلُومِينَۖ",
      "text_normalized": "الا عليا ازواجهم او ما ملكت ايمانهم فانهم غير ملومين",
      "aya_indic": "٣٠",
      "jozz": 29,
      "page": 569
    },
    {
      "sura": 70,
      "aya": 31,
      "text_uthmani": "فَمَنِ اِ۪بْتَغ۪ىٰ وَرَآءَ ذَٰلِكَ فَأُوْلَٰٓئِكَ هُمُ اُ۬لْعَادُونَۖ",
      "text_normalized": "فمن ابتغيا وراء ذلك فاولايك هم العادون",
      "aya_indic": "٣١",
      "jozz": 29,
      "page": 569
    },
    {
      "sura": 70,
      "aya": 32,
      "text_uthmani": "وَالذِينَ هُمْ لِأَمَٰنَٰتِهِمْ وَعَهْدِهِمْ رَٰعُونَۖ",
      "text_normalized": "والذين هم لاماناتهم وعهدهم راعون",
      "aya_indic": "٣٢",
      "jozz": 29,
      "page": 569
    },
    {
      "sura": 70,
      "aya": 33,
      "text_uthmani": "وَالذِينَ هُم بِشَهَٰدَتِهِمْ قَآئِمُونَۖ",
      "text_normalized": "والذين هم بشهادتهم قايمون",
      "aya_indic": "٣٣",
      "jozz": 29,
      "page": 569
    },
    {
      "sura": 70,
      "aya": 34,
      "text_uthmani": "وَالذِينَ هُمْ عَلَىٰ صَلَاتِهِمْ يُحَافِظُونَ",
      "text_normalized": "والذين هم عليا صلاتهم يحافظون",
      "aya_indic": "٣٤",
      "jozz": 29,
      "page": 569
    },
    {
      "sura": 70,
      "aya": 35,
      "text_uthmani": "أُوْلَٰٓئِكَ فِے جَنَّٰتٖ مُّكْرَمُونَۖ",
      "text_normalized": "اولايك فے جنات مكرمون",
      "aya_indic": "٣٥",
      "jozz": 29,
      "page": 569
    },
    {
      "sura": 70,
      "aya": 36,
      "text_uthmani": "فَمَالِ اِ۬لذِينَ كَفَرُواْ قِبَلَكَ مُهْطِعِينَ",
      "text_normalized": "فمال الذين كفروا قبلك مهطعين",
      "aya_indic": "٣٦",
      "jozz": 29,
      "page": 569
    },
    {
      "sura": 70,
      "aya": 37,
      "text_uthmani": "عَنِ اِ۬لْيَمِينِ وَعَنِ اِ۬لشِّمَالِ عِزِينَۖ",
      "text_normalized": "عن اليمين وعن الشمال عزين",
      "aya_indic": "٣٧",
      "jozz": 29,
      "page": 569
    },
    {
      "sura": 70,
      "aya": 38,
      "text_uthmani": "أَيَطْمَعُ كُلُّ اُ۪مْرِےٕٖ مِّنْهُمُۥٓ أَنْ يُّدْخَلَ جَنَّةَ نَعِيمٖ",
      "text_normalized": "ايطمع كل امرے منهم ان يدخل جنه نعيم",
      "aya_indic": "٣٨",
      "jozz": 29,
      "page": 569
    },
    {
      "sura": 70,
      "aya": 39,
      "text_uthmani": "كَلَّآۖ إِنَّا خَلَقْنَٰهُم مِّمَّا يَعْلَمُونَۖ",
      "text_normalized": "كلا انا خلقناهم مما يعلمون",
      "aya_indic": "٣٩",
      "jozz": 29,
      "page": 569
    },
    {
      "sura": 70,
      "aya": 40,
      "text_uthmani": "۞ فَلَآ أُقْسِمُ بِرَبِّ اِ۬لْمَشَٰرِقِ وَالْمَغَٰرِبِ إِنَّا لَقَٰدِرُونَ",
      "text_normalized": "فلا اقسم برب المشارق والمغارب انا لقادرون",
      "aya_indic": "٤٠",
      "jozz": 29,
      "page": 569
    },
    {
      "sura": 70,
      "aya": 41,
      "text_uthmani": "عَلَىٰٓ أَن نُّبَدِّلَ خَيْراٗ مِّنْهُمْ وَمَا نَحْنُ بِمَسْبُوقِينَۖ",
      "text_normalized": "عليا ان نبدل خيرا منهم وما نحن بمسبوقين",
      "aya_indic": "٤١",
      "jozz": 29,
      "page": 570
    },
    {
      "sura": 70,
      "aya": 42,
      "text_uthmani": "فَذَرْهُمْ يَخُوضُواْ وَيَلْعَبُواْ حَتَّىٰ يُلَٰقُواْ يَوْمَهُمُ اُ۬لذِے يُوعَدُونَ",
      "text_normalized": "فذرهم يخوضوا ويلعبوا حتيا يلاقوا يومهم الذے يوعدون",
      "aya_indic": "٤٢",
      "jozz": 29,
      "page": 570
    },
    {
      "sura": 70,
      "aya": 43,
      "text_uthmani": "يَوْمَ يَخْرُجُونَ مِنَ اَ۬لَاجْدَاثِ سِرَاعاٗ كَأَنَّهُمُۥٓ إِلَىٰ نَصْبٖ يُوفِضُونَ",
      "text_normalized": "يوم يخرجون من الاجداث سراعا كانهم اليا نصب يوفضون",
      "aya_indic": "٤٣",
      "jozz": 29,
      "page": 570
    },
    {
      "sura": 70,
      "aya": 44,
      "text_uthmani": "خَٰشِعَةً اَبْصَٰرُهُمْ تَرْهَقُهُمْ ذِلَّةٞۖ ذَٰلِكَ اَ۬لْيَوْمُ اُ۬لذِے كَانُواْ يُوعَدُونَۖ",
      "text_normalized": "خاشعه ابصارهم ترهقهم ذله ذلك اليوم الذے كانوا يوعدون",
      "aya_indic": "٤٤",
      "jozz": 29,
      "page": 570
    }
  ]
}