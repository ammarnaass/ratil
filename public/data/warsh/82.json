{
  "id": 82,
  "name_ar": "الانفطار",
  "name_en": "Al-Infitar",
  "type": "مكية",
  "ayahs_hafs": 19,
  "ayahs_warsh": 19,
  "page": 587,
  "narration": "warsh",
  "narration_ar": "ورش عن نافع",
  "ayahs": [
    {
      "sura": 82,
      "aya": 1,
      "text_uthmani": "إِذَا اَ۬لسَّمَآءُ اُ۪نفَطَرَتْ",
      "text_normalized": "اذا السماء انفطرت",
      "aya_indic": "١",
      "jozz": 30,
      "page": 587
    },
    {
      "sura": 82,
      "aya": 2,
      "text_uthmani": "وَإِذَا اَ۬لْكَوَاكِبُ اُ۪نتَثَرَتْ",
      "text_normalized": "واذا الكواكب انتثرت",
      "aya_indic": "٢",
      "jozz": 30,
      "page": 587
    },
    {
      "sura": 82,
      "aya": 3,
      "text_uthmani": "وَإِذَا اَ۬لْبِحَارُ فُجِّرَتْ",
      "text_normalized": "واذا البحار فجرت",
      "aya_indic": "٣",
      "jozz": 30,
      "page": 587
    },
    {
      "sura": 82,
      "aya": 4,
      "text_uthmani": "وَإِذَا اَ۬لْقُبُورُ بُعْثِرَتْ",
      "text_normalized": "واذا القبور بعثرت",
      "aya_indic": "٤",
      "jozz": 30,
      "page": 587
    },
    {
      "sura": 82,
      "aya": 5,
      "text_uthmani": "عَلِمَتْ نَفْسٞ مَّا قَدَّمَتْ وَأَخَّرَتْۖ",
      "text_normalized": "علمت نفس ما قدمت واخرت",
      "aya_indic": "٥",
      "jozz": 30,
      "page": 587
    },
    {
      "sura": 82,
      "aya": 6,
      "text_uthmani": "يَٰٓأَيُّهَا اَ۬لِانسَٰنُ مَا غَرَّكَ بِرَبِّكَ اَ۬لْكَرِيمِ",
      "text_normalized": "ياايها الانسان ما غرك بربك الكريم",
      "aya_indic": "٦",
      "jozz": 30,
      "page": 587
    },
    {
      "sura": 82,
      "aya": 7,
      "text_uthmani": "اِ۬لذِے خَلَقَكَ فَسَوّ۪يٰكَ فَعَدَّلَكَ",
      "text_normalized": "الذے خلقك فسوياك فعدلك",
      "aya_indic": "٧",
      "jozz": 30,
      "page": 587
    },
    {
      "sura": 82,
      "aya": 8,
      "text_uthmani": "فِےٓ أَيِّ صُورَةٖ مَّا شَآءَ رَكَّبَكَۖ",
      "text_normalized": "فے اي صوره ما شاء ركبك",
      "aya_indic": "٨",
      "jozz": 30,
      "page": 587
    },
    {
      "sura": 82,
      "aya": 9,
      "text_uthmani": "كَلَّا بَلْ تُكَذِّبُونَ بِالدِّينِ",
      "text_normalized": "كلا بل تكذبون بالدين",
      "aya_indic": "٩",
      "jozz": 30,
      "page": 587
    },
    {
      "sura": 82,
      "aya": 10,
      "text_uthmani": "وَإِنَّ عَلَيْكُمْ لَحَٰفِظِينَ",
      "text_normalized": "وان عليكم لحافظين",
      "aya_indic": "١٠",
      "jozz": 30,
      "page": 587
    },
    {
      "sura": 82,
      "aya": 11,
      "text_uthmani": "كِرَاماٗ كَٰتِبِينَ",
      "text_normalized": "كراما كاتبين",
      "aya_indic": "١١",
      "jozz": 30,
      "page": 587
    },
    {
      "sura": 82,
      "aya": 12,
      "text_uthmani": "يَعْلَمُونَ مَا تَفْعَلُونَۖ",
      "text_normalized": "يعلمون ما تفعلون",
      "aya_indic": "١٢",
      "jozz": 30,
      "page": 587
    },
    {
      "sura": 82,
      "aya": 13,
      "text_uthmani": "إِنَّ اَ۬لَابْرَارَ لَفِے نَعِيمٖۖ",
      "text_normalized": "ان الابرار لفے نعيم",
      "aya_indic": "١٣",
      "jozz": 30,
      "page": 587
    },
    {
      "sura": 82,
      "aya": 14,
      "text_uthmani": "وَإِنَّ اَ۬لْفُجَّارَ لَفِے جَحِيمٖ",
      "text_normalized": "وان الفجار لفے جحيم",
      "aya_indic": "١٤",
      "jozz": 30,
      "page": 587
    },
    {
      "sura": 82,
      "aya": 15,
      "text_uthmani": "يَصْلَوْنَهَا يَوْمَ اَ۬لدِّينِ",
      "text_normalized": "يصلونها يوم الدين",
      "aya_indic": "١٥",
      "jozz": 30,
      "page": 587
    },
    {
      "sura": 82,
      "aya": 16,
      "text_uthmani": "وَمَا هُمْ عَنْهَا بِغَآئِبِينَۖ",
      "text_normalized": "وما هم عنها بغايبين",
      "aya_indic": "١٦",
      "jozz": 30,
      "page": 587
    },
    {
      "sura": 82,
      "aya": 17,
      "text_uthmani": "وَمَآ أَدْر۪يٰكَ مَا يَوْمُ اُ۬لدِّينِ",
      "text_normalized": "وما ادرياك ما يوم الدين",
      "aya_indic": "١٧",
      "jozz": 30,
      "page": 587
    },
    {
      "sura": 82,
      "aya": 18,
      "text_uthmani": "ثُمَّ مَآ أَدْر۪يٰكَ مَا يَوْمُ اُ۬لدِّينِۖ",
      "text_normalized": "ثم ما ادرياك ما يوم الدين",
      "aya_indic": "١٨",
      "jozz": 30,
      "page": 587
    },
    {
      "sura": 82,
      "aya": 19,
      "text_uthmani": "يَوْمَ لَا تَمْلِكُ نَفْسٞ لِّنَفْسٖ شَئْاٗۖ وَالَامْرُ يَوْمَئِذٖ لِّلهِۖ",
      "text_normalized": "يوم لا تملك نفس لنفس شيا والامر يوميذ لله",
      "aya_indic": "١٩",
      "jozz": 30,
      "page": 587
    }
  ]
}