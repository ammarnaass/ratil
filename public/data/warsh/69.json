{
  "id": 69,
  "name_ar": "الحاقة",
  "name_en": "Al-Haqqah",
  "type": "مكية",
  "ayahs_hafs": 52,
  "ayahs_warsh": 51,
  "page": 566,
  "narration": "warsh",
  "narration_ar": "ورش عن نافع",
  "ayahs": [
    {
      "sura": 69,
      "aya": 1,
      "text_uthmani": "اَ۬لْحَآقَّةُ مَا اَ۬لْحَآقَّةُۖ",
      "text_normalized": "الحاقه ما الحاقه",
      "aya_indic": "١",
      "jozz": 29,
      "page": 566
    },
    {
      "sura": 69,
      "aya": 2,
      "text_uthmani": "وَمَآ أَدْر۪يٰكَ مَا اَ۬لْحَآقَّةُۖ",
      "text_normalized": "وما ادرياك ما الحاقه",
      "aya_indic": "٢",
      "jozz": 29,
      "page": 566
    },
    {
      "sura": 69,
      "aya": 3,
      "text_uthmani": "كَذَّبَتْ ثَمُودُ وَعَادُۢ بِالْقَارِعَةِۖ",
      "text_normalized": "كذبت ثمود وعاد بالقارعه",
      "aya_indic": "٣",
      "jozz": 29,
      "page": 566
    },
    {
      "sura": 69,
      "aya": 4,
      "text_uthmani": "فَأَمَّا ثَمُودُ فَأُهْلِكُواْ بِالطَّاغِيَةِۖ",
      "text_normalized": "فاما ثمود فاهلكوا بالطاغيه",
      "aya_indic": "٤",
      "jozz": 29,
      "page": 566
    },
    {
      "sura": 69,
      "aya": 5,
      "text_uthmani": "وَأَمَّا عَادٞ فَأُهْلِكُواْ بِرِيحٖ صَرْصَرٍ عَاتِيَةٖ",
      "text_normalized": "واما عاد فاهلكوا بريح صرصر عاتيه",
      "aya_indic": "٥",
      "jozz": 29,
      "page": 566
    },
    {
      "sura": 69,
      "aya": 6,
      "text_uthmani": "سَخَّرَهَا عَلَيْهِمْ سَبْعَ لَيَالٖ وَثَمَٰنِيَةَ أَيَّامٍ حُسُوماٗۖ فَتَرَى اَ۬لْقَوْمَ فِيهَا صَرْع۪ىٰ كَأَنَّهُمُۥٓ أَعْجَازُ نَخْلٍ خَاوِيَةٖۖ",
      "text_normalized": "سخرها عليهم سبع ليال وثمانيه ايام حسوما فتري القوم فيها صرعيا كانهم اعجاز نخل خاويه",
      "aya_indic": "٦",
      "jozz": 29,
      "page": 566
    },
    {
      "sura": 69,
      "aya": 7,
      "text_uthmani": "فَهَلْ تَر۪ىٰ لَهُم مِّنۢ بَاقِيَةٖۖ",
      "text_normalized": "فهل تريا لهم من باقيه",
      "aya_indic": "٧",
      "jozz": 29,
      "page": 566
    },
    {
      "sura": 69,
      "aya": 8,
      "text_uthmani": "وَجَآءَ فِرْعَوْنُ وَمَن قَبْلَهُۥ وَالْمُوتَفِكَٰتُ بِالْخَاطِئَةِ",
      "text_normalized": "وجاء فرعون ومن قبله والموتفكات بالخاطيه",
      "aya_indic": "٨",
      "jozz": 29,
      "page": 567
    },
    {
      "sura": 69,
      "aya": 9,
      "text_uthmani": "فَعَصَوْاْ رَسُولَ رَبِّهِمْ فَأَخَذَهُمُۥٓ أَخْذَةٗ رَّابِيَةًۖ",
      "text_normalized": "فعصوا رسول ربهم فاخذهم اخذه رابيه",
      "aya_indic": "٩",
      "jozz": 29,
      "page": 567
    },
    {
      "sura": 69,
      "aya": 10,
      "text_uthmani": "اِنَّا لَمَّا طَغَا اَ۬لْمَآءُ حَمَلْنَٰكُمْ فِے اِ۬لْجَارِيَةِ",
      "text_normalized": "انا لما طغا الماء حملناكم فے الجاريه",
      "aya_indic": "١٠",
      "jozz": 29,
      "page": 567
    },
    {
      "sura": 69,
      "aya": 11,
      "text_uthmani": "لِنَجْعَلَهَا لَكُمْ تَذْكِرَةٗ وَتَعِيَهَآ أُذْنٞ وَٰعِيَةٞۖ",
      "text_normalized": "لنجعلها لكم تذكره وتعيها اذن واعيه",
      "aya_indic": "١١",
      "jozz": 29,
      "page": 567
    },
    {
      "sura": 69,
      "aya": 12,
      "text_uthmani": "فَإِذَا نُفِخَ فِے اِ۬لصُّورِ نَفْخَةٞ وَٰحِدَةٞ",
      "text_normalized": "فاذا نفخ فے الصور نفخه واحده",
      "aya_indic": "١٢",
      "jozz": 29,
      "page": 567
    },
    {
      "sura": 69,
      "aya": 13,
      "text_uthmani": "وَحُمِلَتِ اِ۬لَارْضُ وَالْجِبَالُ فَدُكَّتَا دَكَّةٗ وَٰحِدَةٗ",
      "text_normalized": "وحملت الارض والجبال فدكتا دكه واحده",
      "aya_indic": "١٣",
      "jozz": 29,
      "page": 567
    },
    {
      "sura": 69,
      "aya": 14,
      "text_uthmani": "فَيَوْمَئِذٖ وَقَعَتِ اِ۬لْوَاقِعَةُ",
      "text_normalized": "فيوميذ وقعت الواقعه",
      "aya_indic": "١٤",
      "jozz": 29,
      "page": 567
    },
    {
      "sura": 69,
      "aya": 15,
      "text_uthmani": "وَانشَقَّتِ اِ۬لسَّمَآءُ فَهِيَ يَوْمَئِذٖ وَاهِيَةٞ",
      "text_normalized": "وانشقت السماء فهي يوميذ واهيه",
      "aya_indic": "١٥",
      "jozz": 29,
      "page": 567
    },
    {
      "sura": 69,
      "aya": 16,
      "text_uthmani": "وَالْمَلَكُ عَلَىٰٓ أَرْجَآئِهَاۖ وَيَحْمِلُ عَرْشَ رَبِّكَ فَوْقَهُمْ يَوْمَئِذٖ ثَمَٰنِيَةٞ",
      "text_normalized": "والملك عليا ارجايها ويحمل عرش ربك فوقهم يوميذ ثمانيه",
      "aya_indic": "١٦",
      "jozz": 29,
      "page": 567
    },
    {
      "sura": 69,
      "aya": 17,
      "text_uthmani": "يَوْمَئِذٖ تُعْرَضُونَ لَا تَخْف۪ىٰ مِنكُمْ خَافِيَةٞۖ",
      "text_normalized": "يوميذ تعرضون لا تخفيا منكم خافيه",
      "aya_indic": "١٧",
      "jozz": 29,
      "page": 567
    },
    {
      "sura": 69,
      "aya": 18,
      "text_uthmani": "۞ فَأَمَّا مَنُ ا۟وتِيَ كِتَٰبَهُۥ بِيَمِينِهِۦ فَيَقُولُ هَآؤُمُ اُ۪قْرَءُواْ كِتَٰبِيَهْۖ",
      "text_normalized": "فاما من اوتي كتابه بيمينه فيقول هاوم اقرءوا كتابيه",
      "aya_indic": "١٨",
      "jozz": 29,
      "page": 567
    },
    {
      "sura": 69,
      "aya": 19,
      "text_uthmani": "إِنِّے ظَنَنتُ أَنِّے مُلَٰقٍ حِسَابِيَهْۖ",
      "text_normalized": "انے ظننت انے ملاق حسابيه",
      "aya_indic": "١٩",
      "jozz": 29,
      "page": 567
    },
    {
      "sura": 69,
      "aya": 20,
      "text_uthmani": "فَهُوَ فِے عِيشَةٖ رَّاضِيَةٖ",
      "text_normalized": "فهو فے عيشه راضيه",
      "aya_indic": "٢٠",
      "jozz": 29,
      "page": 567
    },
    {
      "sura": 69,
      "aya": 21,
      "text_uthmani": "فِے جَنَّةٍ عَالِيَةٖ",
      "text_normalized": "فے جنه عاليه",
      "aya_indic": "٢١",
      "jozz": 29,
      "page": 567
    },
    {
      "sura": 69,
      "aya": 22,
      "text_uthmani": "قُطُوفُهَا دَانِيَةٞۖ",
      "text_normalized": "قطوفها دانيه",
      "aya_indic": "٢٢",
      "jozz": 29,
      "page": 567
    },
    {
      "sura": 69,
      "aya": 23,
      "text_uthmani": "كُلُواْ وَاشْرَبُواْۖ هَنِيٓـٔاَۢ بِمَآ أَسْلَفْتُمْ فِے اِ۬لَايَّامِ اِ۬لْخَالِيَةِۖ",
      "text_normalized": "كلوا واشربوا هنيا بما اسلفتم فے الايام الخاليه",
      "aya_indic": "٢٣",
      "jozz": 29,
      "page": 567
    },
    {
      "sura": 69,
      "aya": 24,
      "text_uthmani": "وَأَمَّا مَنُ ا۟وتِيَ كِتَٰبَهُۥ بِشِمَالِهِۦ",
      "text_normalized": "واما من اوتي كتابه بشماله",
      "aya_indic": "٢٤",
      "jozz": 29,
      "page": 567
    },
    {
      "sura": 69,
      "aya": 25,
      "text_uthmani": "فَيَقُولُ يَٰلَيْتَنِے لَمُ ا۟وتَ كِتَٰبِيَهْۖ",
      "text_normalized": "فيقول ياليتنے لم اوت كتابيه",
      "aya_indic": "٢٥",
      "jozz": 29,
      "page": 567
    },
    {
      "sura": 69,
      "aya": 26,
      "text_uthmani": "وَلَمَ اَدْرِ مَا حِسَابِيَهْۖ",
      "text_normalized": "ولم ادر ما حسابيه",
      "aya_indic": "٢٦",
      "jozz": 29,
      "page": 567
    },
    {
      "sura": 69,
      "aya": 27,
      "text_uthmani": "يَٰلَيْتَهَا كَانَتِ اِ۬لْقَاضِيَةَ",
      "text_normalized": "ياليتها كانت القاضيه",
      "aya_indic": "٢٧",
      "jozz": 29,
      "page": 567
    },
    {
      "sura": 69,
      "aya": 28,
      "text_uthmani": "مَآ أَغْن۪ىٰ عَنِّے مَالِيَهۖ",
      "text_normalized": "ما اغنيا عنے ماليه",
      "aya_indic": "٢٨",
      "jozz": 29,
      "page": 567
    },
    {
      "sura": 69,
      "aya": 29,
      "text_uthmani": "هَّلَكَ عَنِّے سُلْطَٰنِيَهْۖ",
      "text_normalized": "هلك عنے سلطانيه",
      "aya_indic": "٢٩",
      "jozz": 29,
      "page": 567
    },
    {
      "sura": 69,
      "aya": 30,
      "text_uthmani": "خُذُوهُ فَغُلُّوهُ",
      "text_normalized": "خذوه فغلوه",
      "aya_indic": "٣٠",
      "jozz": 29,
      "page": 567
    },
    {
      "sura": 69,
      "aya": 31,
      "text_uthmani": "ثُمَّ اَ۬لْجَحِيمَ صَلُّوهُ",
      "text_normalized": "ثم الجحيم صلوه",
      "aya_indic": "٣١",
      "jozz": 29,
      "page": 567
    },
    {
      "sura": 69,
      "aya": 32,
      "text_uthmani": "ثُمَّ فِے سِلْسِلَةٖ ذَرْعُهَا سَبْعُونَ ذِرَاعاٗ فَاسْلُكُوهُۖ",
      "text_normalized": "ثم فے سلسله ذرعها سبعون ذراعا فاسلكوه",
      "aya_indic": "٣٢",
      "jozz": 29,
      "page": 567
    },
    {
      "sura": 69,
      "aya": 33,
      "text_uthmani": "إِنَّهُۥ كَانَ لَا يُومِنُ بِاللَّهِ اِ۬لْعَظِيمِ",
      "text_normalized": "انه كان لا يومن بالله العظيم",
      "aya_indic": "٣٣",
      "jozz": 29,
      "page": 567
    },
    {
      "sura": 69,
      "aya": 34,
      "text_uthmani": "وَلَا يَحُضُّ عَلَىٰ طَعَامِ اِ۬لْمِسْكِينِۖ",
      "text_normalized": "ولا يحض عليا طعام المسكين",
      "aya_indic": "٣٤",
      "jozz": 29,
      "page": 567
    },
    {
      "sura": 69,
      "aya": 35,
      "text_uthmani": "فَلَيْسَ لَهُ اُ۬لْيَوْمَ هَٰهُنَا حَمِيمٞ",
      "text_normalized": "فليس له اليوم هاهنا حميم",
      "aya_indic": "٣٥",
      "jozz": 29,
      "page": 567
    },
    {
      "sura": 69,
      "aya": 36,
      "text_uthmani": "وَلَا طَعَامٌ اِلَّا مِنْ غِسْلِينٖ",
      "text_normalized": "ولا طعام الا من غسلين",
      "aya_indic": "٣٦",
      "jozz": 29,
      "page": 568
    },
    {
      "sura": 69,
      "aya": 37,
      "text_uthmani": "لَّا يَاكُلُهُۥٓ إِلَّا اَ۬لْخَٰطِـُٔونَۖ",
      "text_normalized": "لا ياكله الا الخاطون",
      "aya_indic": "٣٧",
      "jozz": 29,
      "page": 568
    },
    {
      "sura": 69,
      "aya": 38,
      "text_uthmani": "فَلَآ أُقْسِمُ بِمَا تُبْصِرُونَ",
      "text_normalized": "فلا اقسم بما تبصرون",
      "aya_indic": "٣٨",
      "jozz": 29,
      "page": 568
    },
    {
      "sura": 69,
      "aya": 39,
      "text_uthmani": "وَمَا لَا تُبْصِرُونَ",
      "text_normalized": "وما لا تبصرون",
      "aya_indic": "٣٩",
      "jozz": 29,
      "page": 568
    },
    {
      "sura": 69,
      "aya": 40,
      "text_uthmani": "إِنَّهُۥ لَقَوْلُ رَسُولٖ كَرِيمٖ",
      "text_normalized": "انه لقول رسول كريم",
      "aya_indic": "٤٠",
      "jozz": 29,
      "page": 568
    },
    {
      "sura": 69,
      "aya": 41,
      "text_uthmani": "وَمَا هُوَ بِقَوْلِ شَاعِرٖ قَلِيلاٗ مَّا تُومِنُونَ",
      "text_normalized": "وما هو بقول شاعر قليلا ما تومنون",
      "aya_indic": "٤١",
      "jozz": 29,
      "page": 568
    },
    {
      "sura": 69,
      "aya": 42,
      "text_uthmani": "وَلَا بِقَوْلِ كَاهِنٖۖ قَلِيلاٗ مَّا تَذَّكَّرُونَۖ",
      "text_normalized": "ولا بقول كاهن قليلا ما تذكرون",
      "aya_indic": "٤٢",
      "jozz": 29,
      "page": 568
    },
    {
      "sura": 69,
      "aya": 43,
      "text_uthmani": "تَنزِيلٞ مِّن رَّبِّ اِ۬لْعَٰلَمِينَۖ",
      "text_normalized": "تنزيل من رب العالمين",
      "aya_indic": "٤٣",
      "jozz": 29,
      "page": 568
    },
    {
      "sura": 69,
      "aya": 44,
      "text_uthmani": "وَلَوْ تَقَوَّلَ عَلَيْنَا بَعْضَ اَ۬لَاقَاوِيلِ",
      "text_normalized": "ولو تقول علينا بعض الاقاويل",
      "aya_indic": "٤٤",
      "jozz": 29,
      "page": 568
    },
    {
      "sura": 69,
      "aya": 45,
      "text_uthmani": "لَأَخَذْنَا مِنْهُ بِالْيَمِينِ",
      "text_normalized": "لاخذنا منه باليمين",
      "aya_indic": "٤٥",
      "jozz": 29,
      "page": 568
    },
    {
      "sura": 69,
      "aya": 46,
      "text_uthmani": "ثُمَّ لَقَطَعْنَا مِنْهُ اُ۬لْوَتِينَ",
      "text_normalized": "ثم لقطعنا منه الوتين",
      "aya_indic": "٤٦",
      "jozz": 29,
      "page": 568
    },
    {
      "sura": 69,
      "aya": 47,
      "text_uthmani": "فَمَا مِنكُم مِّنَ اَحَدٍ عَنْهُ حَٰجِزِينَۖ",
      "text_normalized": "فما منكم من احد عنه حاجزين",
      "aya_indic": "٤٧",
      "jozz": 29,
      "page": 568
    },
    {
      "sura": 69,
      "aya": 48,
      "text_uthmani": "وَإِنَّهُۥ لَتَذْكِرَةٞ لِّلْمُتَّقِينَۖ",
      "text_normalized": "وانه لتذكره للمتقين",
      "aya_indic": "٤٨",
      "jozz": 29,
      "page": 568
    },
    {
      "sura": 69,
      "aya": 49,
      "text_uthmani": "وَإِنَّا لَنَعْلَمُ أَنَّ مِنكُم مُّكَذِّبِينَۖ",
      "text_normalized": "وانا لنعلم ان منكم مكذبين",
      "aya_indic": "٤٩",
      "jozz": 29,
      "page": 568
    },
    {
      "sura": 69,
      "aya": 50,
      "text_uthmani": "وَإِنَّهُۥ لَحَسْرَةٌ عَلَى اَ۬لْكٰ۪فِرِينَۖ",
      "text_normalized": "وانه لحسره علي الكافرين",
      "aya_indic": "٥٠",
      "jozz": 29,
      "page": 568
    },
    {
      "sura": 69,
      "aya": 51,
      "text_uthmani": "وَإِنَّهُۥ لَحَقُّ اُ۬لْيَقِينِۖ",
      "text_normalized": "وانه لحق اليقين",
      "aya_indic": "٥١",
      "jozz": 29,
      "page": 568
    },
    {
      "sura": 69,
      "aya": 52,
      "text_uthmani": "فَسَبِّحْ بِاسْمِ رَبِّكَ اَ۬لْعَظِيمِۖ",
      "text_normalized": "فسبح باسم ربك العظيم",
      "aya_indic": "٥٢",
      "jozz": 29,
      "page": 568
    }
  ]
}