{
  "id": 37,
  "name_ar": "الصافات",
  "name_en": "As-Saffat",
  "type": "مكية",
  "ayahs_hafs": 182,
  "ayahs_warsh": 182,
  "page": 446,
  "narration": "warsh",
  "narration_ar": "ورش عن نافع",
  "ayahs": [
    {
      "sura": 37,
      "aya": 1,
      "text_uthmani": "وَالصَّٰٓفَّٰتِ صَفّاٗ",
      "text_normalized": "والصافات صفا",
      "aya_indic": "١",
      "jozz": 23,
      "page": 446
    },
    {
      "sura": 37,
      "aya": 2,
      "text_uthmani": "فَالزَّٰجِرَٰتِ زَجْراٗ",
      "text_normalized": "فالزاجرات زجرا",
      "aya_indic": "٢",
      "jozz": 23,
      "page": 446
    },
    {
      "sura": 37,
      "aya": 3,
      "text_uthmani": "فَالتَّٰلِيَٰتِ ذِكْراً",
      "text_normalized": "فالتاليات ذكرا",
      "aya_indic": "٣",
      "jozz": 23,
      "page": 446
    },
    {
      "sura": 37,
      "aya": 4,
      "text_uthmani": "اِنَّ إِلَٰهَكُمْ لَوَٰحِدٞۖ",
      "text_normalized": "ان الاهكم لواحد",
      "aya_indic": "٤",
      "jozz": 23,
      "page": 446
    },
    {
      "sura": 37,
      "aya": 5,
      "text_uthmani": "رَّبُّ اُ۬لسَّمَٰوَٰتِ وَالَارْضِ وَمَا بَيْنَهُمَا وَرَبُّ اُ۬لْمَشَٰرِقِۖ",
      "text_normalized": "رب السماوات والارض وما بينهما ورب المشارق",
      "aya_indic": "٥",
      "jozz": 23,
      "page": 446
    },
    {
      "sura": 37,
      "aya": 6,
      "text_uthmani": "إِنَّا زَيَّنَّا اَ۬لسَّمَآءَ اَ۬لدُّنْي۪ا بِزِينَةِ اِ۬لْكَوَاكِبِۖ",
      "text_normalized": "انا زينا السماء الدنيا بزينه الكواكب",
      "aya_indic": "٦",
      "jozz": 23,
      "page": 446
    },
    {
      "sura": 37,
      "aya": 7,
      "text_uthmani": "وَحِفْظاٗ مِّن كُلِّ شَيْطَٰنٖ مَّارِدٖۖ",
      "text_normalized": "وحفظا من كل شيطان مارد",
      "aya_indic": "٧",
      "jozz": 23,
      "page": 446
    },
    {
      "sura": 37,
      "aya": 8,
      "text_uthmani": "لَّا يَسْمَعُونَ إِلَى اَ۬لْمَلَإِ اِ۬لَاعْل۪ىٰ وَيُقْذَفُونَ مِن كُلِّ جَانِبٖۖ",
      "text_normalized": "لا يسمعون الي الملا الاعليا ويقذفون من كل جانب",
      "aya_indic": "٨",
      "jozz": 23,
      "page": 446
    },
    {
      "sura": 37,
      "aya": 9,
      "text_uthmani": "دُحُوراٗۖ وَلَهُمْ عَذَابٞ وَاصِبٌ",
      "text_normalized": "دحورا ولهم عذاب واصب",
      "aya_indic": "٩",
      "jozz": 23,
      "page": 446
    },
    {
      "sura": 37,
      "aya": 10,
      "text_uthmani": "اِلَّا مَنْ خَطِفَ اَ۬لْخَطْفَةَ فَأَتْبَعَهُۥ شِهَابٞ ثَاقِبٞۖ",
      "text_normalized": "الا من خطف الخطفه فاتبعه شهاب ثاقب",
      "aya_indic": "١٠",
      "jozz": 23,
      "page": 446
    },
    {
      "sura": 37,
      "aya": 11,
      "text_uthmani": "فَاسْتَفْتِهِمُۥٓ أَهُمُۥٓ أَشَدُّ خَلْقاً اَم مَّنْ خَلَقْنَآۖ إِنَّا خَلَقْنَٰهُم مِّن طِينٖ لَّٰزِبِۢۖ",
      "text_normalized": "فاستفتهم اهم اشد خلقا ام من خلقنا انا خلقناهم من طين لازب",
      "aya_indic": "١١",
      "jozz": 23,
      "page": 446
    },
    {
      "sura": 37,
      "aya": 12,
      "text_uthmani": "بَلْ عَجِبْتَ وَيَسْخَرُونَۖ",
      "text_normalized": "بل عجبت ويسخرون",
      "aya_indic": "١٢",
      "jozz": 23,
      "page": 446
    },
    {
      "sura": 37,
      "aya": 13,
      "text_uthmani": "وَإِذَا ذُكِّرُواْ لَا يَذْكُرُونَۖ",
      "text_normalized": "واذا ذكروا لا يذكرون",
      "aya_indic": "١٣",
      "jozz": 23,
      "page": 446
    },
    {
      "sura": 37,
      "aya": 14,
      "text_uthmani": "وَإِذَا رَأَوَاْ اٰيَةٗ يَسْتَسْخِرُونَۖ",
      "text_normalized": "واذا راوا اايه يستسخرون",
      "aya_indic": "١٤",
      "jozz": 23,
      "page": 446
    },
    {
      "sura": 37,
      "aya": 15,
      "text_uthmani": "وَقَالُوٓاْ إِنْ هَٰذَآ إِلَّا سِحْرٞ مُّبِينٌ",
      "text_normalized": "وقالوا ان هذا الا سحر مبين",
      "aya_indic": "١٥",
      "jozz": 23,
      "page": 446
    },
    {
      "sura": 37,
      "aya": 16,
      "text_uthmani": "اَ۟ذَا مِتْنَا وَكُنَّا تُرَاباٗ وَعِظَٰماً اِنَّا لَمَبْعُوثُونَ",
      "text_normalized": "اذا متنا وكنا ترابا وعظاما انا لمبعوثون",
      "aya_indic": "١٦",
      "jozz": 23,
      "page": 446
    },
    {
      "sura": 37,
      "aya": 17,
      "text_uthmani": "أَوَ ءَابَآؤُنَا اَ۬لَاوَّلُونَۖ",
      "text_normalized": "او ءاباونا الاولون",
      "aya_indic": "١٧",
      "jozz": 23,
      "page": 446
    },
    {
      "sura": 37,
      "aya": 18,
      "text_uthmani": "قُلْ نَعَمْ وَأَنتُمْ دَٰخِرُونَۖ",
      "text_normalized": "قل نعم وانتم داخرون",
      "aya_indic": "١٨",
      "jozz": 23,
      "page": 446
    },
    {
      "sura": 37,
      "aya": 19,
      "text_uthmani": "فَإِنَّمَا هِيَ زَجْرَةٞ وَٰحِدَةٞ فَإِذَا هُمْ يَنظُرُونَۖ",
      "text_normalized": "فانما هي زجره واحده فاذا هم ينظرون",
      "aya_indic": "١٩",
      "jozz": 23,
      "page": 446
    },
    {
      "sura": 37,
      "aya": 20,
      "text_uthmani": "وَقَالُواْ يَٰوَيْلَنَا هَٰذَا يَوْمُ اُ۬لدِّينِۖ",
      "text_normalized": "وقالوا ياويلنا هذا يوم الدين",
      "aya_indic": "٢٠",
      "jozz": 23,
      "page": 446
    },
    {
      "sura": 37,
      "aya": 21,
      "text_uthmani": "هَٰذَا يَوْمُ اُ۬لْفَصْلِ اِ۬لذِے كُنتُم بِهِۦ تُكَذِّبُونَۖ",
      "text_normalized": "هذا يوم الفصل الذے كنتم به تكذبون",
      "aya_indic": "٢١",
      "jozz": 23,
      "page": 446
    },
    {
      "sura": 37,
      "aya": 22,
      "text_uthmani": "۞ اَ۟حْشُرُواْ اُ۬لذِينَ ظَلَمُواْ وَأَزْوَٰجَهُمْ وَمَا كَانُواْ يَعْبُدُونَ",
      "text_normalized": "احشروا الذين ظلموا وازواجهم وما كانوا يعبدون",
      "aya_indic": "٢٢",
      "jozz": 23,
      "page": 446
    },
    {
      "sura": 37,
      "aya": 23,
      "text_uthmani": "مِن دُونِ اِ۬للَّهِ فَاهْدُوهُمُۥٓ إِلَىٰ صِرَٰطِ اِ۬لْجَحِيمِۖ",
      "text_normalized": "من دون الله فاهدوهم اليا صراط الجحيم",
      "aya_indic": "٢٣",
      "jozz": 23,
      "page": 446
    },
    {
      "sura": 37,
      "aya": 24,
      "text_uthmani": "وَقِفُوهُمُۥٓ إِنَّهُم مَّسْـُٔولُونَۖ",
      "text_normalized": "وقفوهم انهم مسولون",
      "aya_indic": "٢٤",
      "jozz": 23,
      "page": 446
    },
    {
      "sura": 37,
      "aya": 25,
      "text_uthmani": "مَا لَكُمْ لَا تَنَاصَرُونَۖ",
      "text_normalized": "ما لكم لا تناصرون",
      "aya_indic": "٢٥",
      "jozz": 23,
      "page": 447
    },
    {
      "sura": 37,
      "aya": 26,
      "text_uthmani": "بَلْ هُمُ اُ۬لْيَوْمَ مُسْتَسْلِمُونَۖ",
      "text_normalized": "بل هم اليوم مستسلمون",
      "aya_indic": "٢٦",
      "jozz": 23,
      "page": 447
    },
    {
      "sura": 37,
      "aya": 27,
      "text_uthmani": "وَأَقْبَلَ بَعْضُهُمْ عَلَىٰ بَعْضٖ يَتَسَآءَلُونَۖ",
      "text_normalized": "واقبل بعضهم عليا بعض يتساءلون",
      "aya_indic": "٢٧",
      "jozz": 23,
      "page": 447
    },
    {
      "sura": 37,
      "aya": 28,
      "text_uthmani": "قَالُوٓاْ إِنَّكُمْ كُنتُمْ تَاتُونَنَا عَنِ اِ۬لْيَمِينِۖ",
      "text_normalized": "قالوا انكم كنتم تاتوننا عن اليمين",
      "aya_indic": "٢٨",
      "jozz": 23,
      "page": 447
    },
    {
      "sura": 37,
      "aya": 29,
      "text_uthmani": "قَالُواْ بَل لَّمْ تَكُونُواْ مُومِنِينَۖ",
      "text_normalized": "قالوا بل لم تكونوا مومنين",
      "aya_indic": "٢٩",
      "jozz": 23,
      "page": 447
    },
    {
      "sura": 37,
      "aya": 30,
      "text_uthmani": "وَمَا كَانَ لَنَا عَلَيْكُم مِّن سُلْطَٰنِۢ بَلْ كُنتُمْ قَوْماٗ طَٰغِينَۖ",
      "text_normalized": "وما كان لنا عليكم من سلطان بل كنتم قوما طاغين",
      "aya_indic": "٣٠",
      "jozz": 23,
      "page": 447
    },
    {
      "sura": 37,
      "aya": 31,
      "text_uthmani": "فَحَقَّ عَلَيْنَا قَوْلُ رَبِّنَآ إِنَّا لَذَآئِقُونَ",
      "text_normalized": "فحق علينا قول ربنا انا لذايقون",
      "aya_indic": "٣١",
      "jozz": 23,
      "page": 447
    },
    {
      "sura": 37,
      "aya": 32,
      "text_uthmani": "فَأَغْوَيْنَٰكُمُۥٓ إِنَّا كُنَّا غَٰوِينَۖ",
      "text_normalized": "فاغويناكم انا كنا غاوين",
      "aya_indic": "٣٢",
      "jozz": 23,
      "page": 447
    },
    {
      "sura": 37,
      "aya": 33,
      "text_uthmani": "فَإِنَّهُمْ يَوْمَئِذٖ فِے اِ۬لْعَذَابِ مُشْتَرِكُونَۖ",
      "text_normalized": "فانهم يوميذ فے العذاب مشتركون",
      "aya_indic": "٣٣",
      "jozz": 23,
      "page": 447
    },
    {
      "sura": 37,
      "aya": 34,
      "text_uthmani": "إِنَّا كَذَٰلِكَ نَفْعَلُ بِالْمُجْرِمِينَۖ",
      "text_normalized": "انا كذالك نفعل بالمجرمين",
      "aya_indic": "٣٤",
      "jozz": 23,
      "page": 447
    },
    {
      "sura": 37,
      "aya": 35,
      "text_uthmani": "إِنَّهُمْ كَانُوٓاْ إِذَا قِيلَ لَهُمْ لَآ إِلَٰهَ إِلَّا اَ۬للَّهُ يَسْتَكْبِرُونَ",
      "text_normalized": "انهم كانوا اذا قيل لهم لا اله الا الله يستكبرون",
      "aya_indic": "٣٥",
      "jozz": 23,
      "page": 447
    },
    {
      "sura": 37,
      "aya": 36,
      "text_uthmani": "وَيَقُولُونَ أَئِنَّا لَتَارِكُوٓاْ ءَالِهَتِنَا لِشَاعِرٖ مَّجْنُونِۢۖ",
      "text_normalized": "ويقولون اينا لتاركوا ءالهتنا لشاعر مجنون",
      "aya_indic": "٣٦",
      "jozz": 23,
      "page": 447
    },
    {
      "sura": 37,
      "aya": 37,
      "text_uthmani": "بَلْ جَآءَ بِالْحَقِّ وَصَدَّقَ اَ۬لْمُرْسَلِينَۖ",
      "text_normalized": "بل جاء بالحق وصدق المرسلين",
      "aya_indic": "٣٧",
      "jozz": 23,
      "page": 447
    },
    {
      "sura": 37,
      "aya": 38,
      "text_uthmani": "إِنَّكُمْ لَذَآئِقُواْ اُ۬لْعَذَابِ اِ۬لَالِيمِۖ",
      "text_normalized": "انكم لذايقوا العذاب الاليم",
      "aya_indic": "٣٨",
      "jozz": 23,
      "page": 447
    },
    {
      "sura": 37,
      "aya": 39,
      "text_uthmani": "وَمَا تُجْزَوْنَ إِلَّا مَا كُنتُمْ تَعْمَلُونَ",
      "text_normalized": "وما تجزون الا ما كنتم تعملون",
      "aya_indic": "٣٩",
      "jozz": 23,
      "page": 447
    },
    {
      "sura": 37,
      "aya": 40,
      "text_uthmani": "إِلَّا عِبَادَ اَ۬للَّهِ اِ۬لْمُخْلَصِينَۖ",
      "text_normalized": "الا عباد الله المخلصين",
      "aya_indic": "٤٠",
      "jozz": 23,
      "page": 447
    },
    {
      "sura": 37,
      "aya": 41,
      "text_uthmani": "أُوْلَٰٓئِكَ لَهُمْ رِزْقٞ مَّعْلُومٞ",
      "text_normalized": "اولايك لهم رزق معلوم",
      "aya_indic": "٤١",
      "jozz": 23,
      "page": 447
    },
    {
      "sura": 37,
      "aya": 42,
      "text_uthmani": "فَوَٰكِهُۖ وَهُم مُّكْرَمُونَ",
      "text_normalized": "فواكه وهم مكرمون",
      "aya_indic": "٤٢",
      "jozz": 23,
      "page": 447
    },
    {
      "sura": 37,
      "aya": 43,
      "text_uthmani": "فِے جَنَّٰتِ اِ۬لنَّعِيمِ",
      "text_normalized": "فے جنات النعيم",
      "aya_indic": "٤٣",
      "jozz": 23,
      "page": 447
    },
    {
      "sura": 37,
      "aya": 44,
      "text_uthmani": "عَلَىٰ سُرُرٖ مُّتَقَٰبِلِينَۖ",
      "text_normalized": "عليا سرر متقابلين",
      "aya_indic": "٤٤",
      "jozz": 23,
      "page": 447
    },
    {
      "sura": 37,
      "aya": 45,
      "text_uthmani": "يُطَافُ عَلَيْهِم بِكَأْسٖ مِّن مَّعِينِۢ",
      "text_normalized": "يطاف عليهم بكاس من معين",
      "aya_indic": "٤٥",
      "jozz": 23,
      "page": 447
    },
    {
      "sura": 37,
      "aya": 46,
      "text_uthmani": "بَيْضَآءَ لَذَّةٖ لِّلشَّٰرِبِينَ",
      "text_normalized": "بيضاء لذه للشاربين",
      "aya_indic": "٤٦",
      "jozz": 23,
      "page": 447
    },
    {
      "sura": 37,
      "aya": 47,
      "text_uthmani": "لَا فِيهَا غَوْلٞ وَلَا هُمْ عَنْهَا يُنزَفُونَۖ",
      "text_normalized": "لا فيها غول ولا هم عنها ينزفون",
      "aya_indic": "٤٧",
      "jozz": 23,
      "page": 447
    },
    {
      "sura": 37,
      "aya": 48,
      "text_uthmani": "وَعِندَهُمْ قَٰصِرَٰتُ اُ۬لطَّرْفِ عِينٞ",
      "text_normalized": "وعندهم قاصرات الطرف عين",
      "aya_indic": "٤٨",
      "jozz": 23,
      "page": 447
    },
    {
      "sura": 37,
      "aya": 49,
      "text_uthmani": "كَأَنَّهُنَّ بَيْضٞ مَّكْنُونٞۖ",
      "text_normalized": "كانهن بيض مكنون",
      "aya_indic": "٤٩",
      "jozz": 23,
      "page": 447
    },
    {
      "sura": 37,
      "aya": 50,
      "text_uthmani": "فَأَقْبَلَ بَعْضُهُمْ عَلَىٰ بَعْضٖ يَتَسَآءَلُونَۖ",
      "text_normalized": "فاقبل بعضهم عليا بعض يتساءلون",
      "aya_indic": "٥٠",
      "jozz": 23,
      "page": 447
    },
    {
      "sura": 37,
      "aya": 51,
      "text_uthmani": "۞ قَالَ قَآئِلٞ مِّنْهُمُۥٓ إِنِّے كَانَ لِے قَرِينٞ",
      "text_normalized": "قال قايل منهم انے كان لے قرين",
      "aya_indic": "٥١",
      "jozz": 23,
      "page": 447
    },
    {
      "sura": 37,
      "aya": 52,
      "text_uthmani": "يَقُولُ أَ۟نَّكَ لَمِنَ اَ۬لْمُصَدِّقِينَ",
      "text_normalized": "يقول انك لمن المصدقين",
      "aya_indic": "٥٢",
      "jozz": 23,
      "page": 448
    },
    {
      "sura": 37,
      "aya": 53,
      "text_uthmani": "أَ۟ذَا مِتْنَا وَكُنَّا تُرَاباٗ وَعِظَٰماً اِنَّا لَمَدِينُونَۖ",
      "text_normalized": "اذا متنا وكنا ترابا وعظاما انا لمدينون",
      "aya_indic": "٥٣",
      "jozz": 23,
      "page": 448
    },
    {
      "sura": 37,
      "aya": 54,
      "text_uthmani": "قَالَ هَلَ اَنتُم مُّطَّلِعُونَ",
      "text_normalized": "قال هل انتم مطلعون",
      "aya_indic": "٥٤",
      "jozz": 23,
      "page": 448
    },
    {
      "sura": 37,
      "aya": 55,
      "text_uthmani": "فَاطَّلَعَ فَر۪ء۪اهُ فِے سَوَآءِ اِ۬لْجَحِيمِۖ",
      "text_normalized": "فاطلع فرءاه فے سواء الجحيم",
      "aya_indic": "٥٥",
      "jozz": 23,
      "page": 448
    },
    {
      "sura": 37,
      "aya": 56,
      "text_uthmani": "قَالَ تَاللَّهِ إِن كِدتَّ لَتُرْدِينِۦ",
      "text_normalized": "قال تالله ان كدت لتردين",
      "aya_indic": "٥٦",
      "jozz": 23,
      "page": 448
    },
    {
      "sura": 37,
      "aya": 57,
      "text_uthmani": "وَلَوْلَا نِعْمَةُ رَبِّے لَكُنتُ مِنَ اَ۬لْمُحْضَرِينَۖ",
      "text_normalized": "ولولا نعمه ربے لكنت من المحضرين",
      "aya_indic": "٥٧",
      "jozz": 23,
      "page": 448
    },
    {
      "sura": 37,
      "aya": 58,
      "text_uthmani": "أَفَمَا نَحْنُ بِمَيِّتِينَ",
      "text_normalized": "افما نحن بميتين",
      "aya_indic": "٥٨",
      "jozz": 23,
      "page": 448
    },
    {
      "sura": 37,
      "aya": 59,
      "text_uthmani": "إِلَّا مَوْتَتَنَا اَ۬لُاول۪ىٰ وَمَا نَحْنُ بِمُعَذَّبِينَۖ",
      "text_normalized": "الا موتتنا الاوليا وما نحن بمعذبين",
      "aya_indic": "٥٩",
      "jozz": 23,
      "page": 448
    },
    {
      "sura": 37,
      "aya": 60,
      "text_uthmani": "إِنَّ هَٰذَا لَهُوَ اَ۬لْفَوْزُ اُ۬لْعَظِيمُۖ",
      "text_normalized": "ان هذا لهو الفوز العظيم",
      "aya_indic": "٦٠",
      "jozz": 23,
      "page": 448
    },
    {
      "sura": 37,
      "aya": 61,
      "text_uthmani": "لِمِثْلِ هَٰذَا فَلْيَعْمَلِ اِ۬لْعَٰمِلُونَۖ",
      "text_normalized": "لمثل هذا فليعمل العاملون",
      "aya_indic": "٦١",
      "jozz": 23,
      "page": 448
    },
    {
      "sura": 37,
      "aya": 62,
      "text_uthmani": "أَذَٰلِكَ خَيْرٞ نُّزُلاً اَمْ شَجَرَةُ اُ۬لزَّقُّومِۖ",
      "text_normalized": "اذالك خير نزلا ام شجره الزقوم",
      "aya_indic": "٦٢",
      "jozz": 23,
      "page": 448
    },
    {
      "sura": 37,
      "aya": 63,
      "text_uthmani": "إِنَّا جَعَلْنَٰهَا فِتْنَةٗ لِّلظَّٰلِمِينَۖ",
      "text_normalized": "انا جعلناها فتنه للظالمين",
      "aya_indic": "٦٣",
      "jozz": 23,
      "page": 448
    },
    {
      "sura": 37,
      "aya": 64,
      "text_uthmani": "إِنَّهَا شَجَرَةٞ تَخْرُجُ فِےٓ أَصْلِ اِ۬لْجَحِيمِ",
      "text_normalized": "انها شجره تخرج فے اصل الجحيم",
      "aya_indic": "٦٤",
      "jozz": 23,
      "page": 448
    },
    {
      "sura": 37,
      "aya": 65,
      "text_uthmani": "طَلْعُهَا كَأَنَّهُۥ رُءُوسُ اُ۬لشَّيَٰطِينِۖ",
      "text_normalized": "طلعها كانه رءوس الشياطين",
      "aya_indic": "٦٥",
      "jozz": 23,
      "page": 448
    },
    {
      "sura": 37,
      "aya": 66,
      "text_uthmani": "فَإِنَّهُمْ لَأٓكِلُونَ مِنْهَا فَمَالِـُٔونَ مِنْهَا اَ۬لْبُطُونَ",
      "text_normalized": "فانهم لاكلون منها فمالون منها البطون",
      "aya_indic": "٦٦",
      "jozz": 23,
      "page": 448
    },
    {
      "sura": 37,
      "aya": 67,
      "text_uthmani": "ثُمَّ إِنَّ لَهُمْ عَلَيْهَا لَشَوْباٗ مِّنْ حَمِيمٖۖ",
      "text_normalized": "ثم ان لهم عليها لشوبا من حميم",
      "aya_indic": "٦٧",
      "jozz": 23,
      "page": 448
    },
    {
      "sura": 37,
      "aya": 68,
      "text_uthmani": "ثُمَّ إِنَّ مَرْجِعَهُمْ لَإِلَى اَ۬لْجَحِيمِۖ",
      "text_normalized": "ثم ان مرجعهم لالي الجحيم",
      "aya_indic": "٦٨",
      "jozz": 23,
      "page": 448
    },
    {
      "sura": 37,
      "aya": 69,
      "text_uthmani": "إِنَّهُمُۥٓ أَلْفَوَاْ اٰبَآءَهُمْ ضَآلِّينَ",
      "text_normalized": "انهم الفوا ااباءهم ضالين",
      "aya_indic": "٦٩",
      "jozz": 23,
      "page": 448
    },
    {
      "sura": 37,
      "aya": 70,
      "text_uthmani": "فَهُمْ عَلَىٰٓ ءَاثٰ۪رِهِمْ يُهْرَعُونَۖ",
      "text_normalized": "فهم عليا ءاثارهم يهرعون",
      "aya_indic": "٧٠",
      "jozz": 23,
      "page": 448
    },
    {
      "sura": 37,
      "aya": 71,
      "text_uthmani": "وَلَقَد ضَّلَّ قَبْلَهُمُۥٓ أَكْثَرُ اُ۬لَاوَّلِينَۖ",
      "text_normalized": "ولقد ضل قبلهم اكثر الاولين",
      "aya_indic": "٧١",
      "jozz": 23,
      "page": 448
    },
    {
      "sura": 37,
      "aya": 72,
      "text_uthmani": "وَلَقَدَ اَرْسَلْنَا فِيهِم مُّنذِرِينَۖ",
      "text_normalized": "ولقد ارسلنا فيهم منذرين",
      "aya_indic": "٧٢",
      "jozz": 23,
      "page": 448
    },
    {
      "sura": 37,
      "aya": 73,
      "text_uthmani": "فَانظُرْ كَيْفَ كَانَ عَٰقِبَةُ اُ۬لْمُنذَرِينَ",
      "text_normalized": "فانظر كيف كان عاقبه المنذرين",
      "aya_indic": "٧٣",
      "jozz": 23,
      "page": 448
    },
    {
      "sura": 37,
      "aya": 74,
      "text_uthmani": "إِلَّا عِبَادَ اَ۬للَّهِ اِ۬لْمُخْلَصِينَۖ",
      "text_normalized": "الا عباد الله المخلصين",
      "aya_indic": "٧٤",
      "jozz": 23,
      "page": 448
    },
    {
      "sura": 37,
      "aya": 75,
      "text_uthmani": "وَلَقَدْ نَاد۪يٰنَا نُوحٞ فَلَنِعْمَ اَ۬لْمُجِيبُونَۖ",
      "text_normalized": "ولقد ناديانا نوح فلنعم المجيبون",
      "aya_indic": "٧٥",
      "jozz": 23,
      "page": 448
    },
    {
      "sura": 37,
      "aya": 76,
      "text_uthmani": "وَنَجَّيْنَٰهُ وَأَهْلَهُۥ مِنَ اَ۬لْكَرْبِ اِ۬لْعَظِيمِۖ",
      "text_normalized": "ونجيناه واهله من الكرب العظيم",
      "aya_indic": "٧٦",
      "jozz": 23,
      "page": 448
    },
    {
      "sura": 37,
      "aya": 77,
      "text_uthmani": "وَجَعَلْنَا ذُرِّيَّتَهُۥ هُمُ اُ۬لْبَاقِينَۖ",
      "text_normalized": "وجعلنا ذريته هم الباقين",
      "aya_indic": "٧٧",
      "jozz": 23,
      "page": 449
    },
    {
      "sura": 37,
      "aya": 78,
      "text_uthmani": "وَتَرَكْنَا عَلَيْهِ فِے اِ۬لَاخِرِينَۖ",
      "text_normalized": "وتركنا عليه فے الاخرين",
      "aya_indic": "٧٨",
      "jozz": 23,
      "page": 449
    },
    {
      "sura": 37,
      "aya": 79,
      "text_uthmani": "سَلَٰمٌ عَلَىٰ نُوحٖ فِے اِ۬لْعَٰلَمِينَۖ",
      "text_normalized": "سلام عليا نوح فے العالمين",
      "aya_indic": "٧٩",
      "jozz": 23,
      "page": 449
    },
    {
      "sura": 37,
      "aya": 80,
      "text_uthmani": "إِنَّا كَذَٰلِكَ نَجْزِے اِ۬لْمُحْسِنِينَۖ",
      "text_normalized": "انا كذالك نجزے المحسنين",
      "aya_indic": "٨٠",
      "jozz": 23,
      "page": 449
    },
    {
      "sura": 37,
      "aya": 81,
      "text_uthmani": "إِنَّهُۥ مِنْ عِبَادِنَا اَ۬لْمُومِنِينَۖ",
      "text_normalized": "انه من عبادنا المومنين",
      "aya_indic": "٨١",
      "jozz": 23,
      "page": 449
    },
    {
      "sura": 37,
      "aya": 82,
      "text_uthmani": "ثُمَّ أَغْرَقْنَا اَ۬لَاخَرِينَۖ",
      "text_normalized": "ثم اغرقنا الاخرين",
      "aya_indic": "٨٢",
      "jozz": 23,
      "page": 449
    },
    {
      "sura": 37,
      "aya": 83,
      "text_uthmani": "۞ وَإِنَّ مِن شِيعَتِهِۦ لَإِبْرَٰهِيمَ",
      "text_normalized": "وان من شيعته لابراهيم",
      "aya_indic": "٨٣",
      "jozz": 23,
      "page": 449
    },
    {
      "sura": 37,
      "aya": 84,
      "text_uthmani": "إِذْ جَآءَ رَبَّهُۥ بِقَلْبٖ سَلِيمٍ",
      "text_normalized": "اذ جاء ربه بقلب سليم",
      "aya_indic": "٨٤",
      "jozz": 23,
      "page": 449
    },
    {
      "sura": 37,
      "aya": 85,
      "text_uthmani": "اِذْ قَالَ لِأَبِيهِ وَقَوْمِهِۦ مَاذَا تَعْبُدُونَۖ",
      "text_normalized": "اذ قال لابيه وقومه ماذا تعبدون",
      "aya_indic": "٨٥",
      "jozz": 23,
      "page": 449
    },
    {
      "sura": 37,
      "aya": 86,
      "text_uthmani": "أَئِفْكاً اٰلِهَةٗ دُونَ اَ۬للَّهِ تُرِيدُونَۖ",
      "text_normalized": "ايفكا االهه دون الله تريدون",
      "aya_indic": "٨٦",
      "jozz": 23,
      "page": 449
    },
    {
      "sura": 37,
      "aya": 87,
      "text_uthmani": "فَمَا ظَنُّكُم بِرَبِّ اِ۬لْعَٰلَمِينَۖ",
      "text_normalized": "فما ظنكم برب العالمين",
      "aya_indic": "٨٧",
      "jozz": 23,
      "page": 449
    },
    {
      "sura": 37,
      "aya": 88,
      "text_uthmani": "فَنَظَرَ نَظْرَةٗ فِے اِ۬لنُّجُومِ",
      "text_normalized": "فنظر نظره فے النجوم",
      "aya_indic": "٨٨",
      "jozz": 23,
      "page": 449
    },
    {
      "sura": 37,
      "aya": 89,
      "text_uthmani": "فَقَالَ إِنِّے سَقِيمٞ",
      "text_normalized": "فقال انے سقيم",
      "aya_indic": "٨٩",
      "jozz": 23,
      "page": 449
    },
    {
      "sura": 37,
      "aya": 90,
      "text_uthmani": "فَتَوَلَّوْاْ عَنْهُ مُدْبِرِينَۖ",
      "text_normalized": "فتولوا عنه مدبرين",
      "aya_indic": "٩٠",
      "jozz": 23,
      "page": 449
    },
    {
      "sura": 37,
      "aya": 91,
      "text_uthmani": "فَرَاغَ إِلَىٰٓ ءَالِهَتِهِمْ فَقَالَ أَلَا تَاكُلُونَ",
      "text_normalized": "فراغ اليا ءالهتهم فقال الا تاكلون",
      "aya_indic": "٩١",
      "jozz": 23,
      "page": 449
    },
    {
      "sura": 37,
      "aya": 92,
      "text_uthmani": "مَا لَكُمْ لَا تَنطِقُونَۖ",
      "text_normalized": "ما لكم لا تنطقون",
      "aya_indic": "٩٢",
      "jozz": 23,
      "page": 449
    },
    {
      "sura": 37,
      "aya": 93,
      "text_uthmani": "فَرَاغَ عَلَيْهِمْ ضَرْباَۢ بِالْيَمِينِ",
      "text_normalized": "فراغ عليهم ضربا باليمين",
      "aya_indic": "٩٣",
      "jozz": 23,
      "page": 449
    },
    {
      "sura": 37,
      "aya": 94,
      "text_uthmani": "فَأَقْبَلُوٓاْ إِلَيْهِ يَزِفُّونَۖ",
      "text_normalized": "فاقبلوا اليه يزفون",
      "aya_indic": "٩٤",
      "jozz": 23,
      "page": 449
    },
    {
      "sura": 37,
      "aya": 95,
      "text_uthmani": "قَالَ أَتَعْبُدُونَ مَا تَنْحِتُونَ",
      "text_normalized": "قال اتعبدون ما تنحتون",
      "aya_indic": "٩٥",
      "jozz": 23,
      "page": 449
    },
    {
      "sura": 37,
      "aya": 96,
      "text_uthmani": "وَاللَّهُ خَلَقَكُمْ وَمَا تَعْمَلُونَۖ",
      "text_normalized": "والله خلقكم وما تعملون",
      "aya_indic": "٩٦",
      "jozz": 23,
      "page": 449
    },
    {
      "sura": 37,
      "aya": 97,
      "text_uthmani": "قَالُواْ اُ۪بْنُواْ لَهُۥ بُنْيَٰناٗ فَأَلْقُوهُ فِے اِ۬لْجَحِيمِ",
      "text_normalized": "قالوا ابنوا له بنيانا فالقوه فے الجحيم",
      "aya_indic": "٩٧",
      "jozz": 23,
      "page": 449
    },
    {
      "sura": 37,
      "aya": 98,
      "text_uthmani": "فَأَرَادُواْ بِهِۦ كَيْداٗ فَجَعَلْنَٰهُمُ اُ۬لَاسْفَلِينَۖ",
      "text_normalized": "فارادوا به كيدا فجعلناهم الاسفلين",
      "aya_indic": "٩٨",
      "jozz": 23,
      "page": 449
    },
    {
      "sura": 37,
      "aya": 99,
      "text_uthmani": "وَقَالَ إِنِّے ذَاهِبٌ اِلَىٰ رَبِّے سَيَهْدِينِۖ",
      "text_normalized": "وقال انے ذاهب اليا ربے سيهدين",
      "aya_indic": "٩٩",
      "jozz": 23,
      "page": 449
    },
    {
      "sura": 37,
      "aya": 100,
      "text_uthmani": "رَبِّ هَبْ لِے مِنَ اَ۬لصَّٰلِحِينَۖ",
      "text_normalized": "رب هب لے من الصالحين",
      "aya_indic": "١٠٠",
      "jozz": 23,
      "page": 449
    },
    {
      "sura": 37,
      "aya": 101,
      "text_uthmani": "فَبَشَّرْنَٰهُ بِغُلَٰمٍ حَلِيمٖۖ",
      "text_normalized": "فبشرناه بغلام حليم",
      "aya_indic": "١٠١",
      "jozz": 23,
      "page": 449
    },
    {
      "sura": 37,
      "aya": 102,
      "text_uthmani": "فَلَمَّا بَلَغَ مَعَهُ اُ۬لسَّعْيَ قَالَ يَٰبُنَيِّ إِنِّيَ أَر۪ىٰ فِے اِ۬لْمَنَامِ أَنِّيَ أَذْبَحُكَ فَانظُرْ مَاذَا تَر۪ىٰۖ قَالَ يَٰٓأَبَتِ اِ۪فْعَلْ مَا تُومَرُۖ سَتَجِدُنِيَ إِن شَآءَ اَ۬للَّهُ مِنَ اَ۬لصَّٰبِرِينَۖ",
      "text_normalized": "فلما بلغ معه السعي قال يابني اني اريا فے المنام اني اذبحك فانظر ماذا تريا قال ياابت افعل ما تومر ستجدني ان شاء الله من الصابرين",
      "aya_indic": "١٠٢",
      "jozz": 23,
      "page": 449
    },
    {
      "sura": 37,
      "aya": 103,
      "text_uthmani": "فَلَمَّآ أَسْلَمَا وَتَلَّهُۥ لِلْجَبِينِ",
      "text_normalized": "فلما اسلما وتله للجبين",
      "aya_indic": "١٠٣",
      "jozz": 23,
      "page": 450
    },
    {
      "sura": 37,
      "aya": 104,
      "text_uthmani": "وَنَٰدَيْنَٰهُ أَنْ يَّٰٓإِبْرَٰهِيمُ",
      "text_normalized": "وناديناه ان ياابراهيم",
      "aya_indic": "١٠٤",
      "jozz": 23,
      "page": 450
    },
    {
      "sura": 37,
      "aya": 105,
      "text_uthmani": "قَدْ صَدَّقْتَ اَ۬لرُّءْي۪آۖ إِنَّا كَذَٰلِكَ نَجْزِے اِ۬لْمُحْسِنِينَۖ",
      "text_normalized": "قد صدقت الرءيا انا كذالك نجزے المحسنين",
      "aya_indic": "١٠٥",
      "jozz": 23,
      "page": 450
    },
    {
      "sura": 37,
      "aya": 106,
      "text_uthmani": "إِنَّ هَٰذَا لَهُوَ اَ۬لْبَلَٰٓؤُاْ اُ۬لْمُبِينُۖ",
      "text_normalized": "ان هذا لهو البلاوا المبين",
      "aya_indic": "١٠٦",
      "jozz": 23,
      "page": 450
    },
    {
      "sura": 37,
      "aya": 107,
      "text_uthmani": "وَفَدَيْنَٰهُ بِذِبْحٍ عَظِيمٖۖ",
      "text_normalized": "وفديناه بذبح عظيم",
      "aya_indic": "١٠٧",
      "jozz": 23,
      "page": 450
    },
    {
      "sura": 37,
      "aya": 108,
      "text_uthmani": "وَتَرَكْنَا عَلَيْهِ فِے اِ۬لَاخِرِينَۖ",
      "text_normalized": "وتركنا عليه فے الاخرين",
      "aya_indic": "١٠٨",
      "jozz": 23,
      "page": 450
    },
    {
      "sura": 37,
      "aya": 109,
      "text_uthmani": "سَلَٰمٌ عَلَىٰٓ إِبْرَٰهِيمَۖ",
      "text_normalized": "سلام عليا ابراهيم",
      "aya_indic": "١٠٩",
      "jozz": 23,
      "page": 450
    },
    {
      "sura": 37,
      "aya": 110,
      "text_uthmani": "كَذَٰلِكَ نَجْزِے اِ۬لْمُحْسِنِينَۖ",
      "text_normalized": "كذالك نجزے المحسنين",
      "aya_indic": "١١٠",
      "jozz": 23,
      "page": 450
    },
    {
      "sura": 37,
      "aya": 111,
      "text_uthmani": "إِنَّهُۥ مِنْ عِبَادِنَا اَ۬لْمُومِنِينَۖ",
      "text_normalized": "انه من عبادنا المومنين",
      "aya_indic": "١١١",
      "jozz": 23,
      "page": 450
    },
    {
      "sura": 37,
      "aya": 112,
      "text_uthmani": "وَبَشَّرْنَٰهُ بِإِسْحَٰقَ نَبِيٓـٔاٗ مِّنَ اَ۬لصَّٰلِحِينَ",
      "text_normalized": "وبشرناه باسحاق نبيا من الصالحين",
      "aya_indic": "١١٢",
      "jozz": 23,
      "page": 450
    },
    {
      "sura": 37,
      "aya": 113,
      "text_uthmani": "وَبَٰرَكْنَا عَلَيْهِ وَعَلَىٰٓ إِسْحَٰقَۖ وَمِن ذُرِّيَّتِهِمَا مُحْسِنٞ وَظَالِمٞ لِّنَفْسِهِۦ مُبِينٞۖ",
      "text_normalized": "وباركنا عليه وعليا اسحاق ومن ذريتهما محسن وظالم لنفسه مبين",
      "aya_indic": "١١٣",
      "jozz": 23,
      "page": 450
    },
    {
      "sura": 37,
      "aya": 114,
      "text_uthmani": "۞ وَلَقَدْ مَنَنَّا عَلَىٰ مُوس۪ىٰ وَهَٰرُونَ",
      "text_normalized": "ولقد مننا عليا موسيا وهارون",
      "aya_indic": "١١٤",
      "jozz": 23,
      "page": 450
    },
    {
      "sura": 37,
      "aya": 115,
      "text_uthmani": "وَنَجَّيْنَٰهُمَا وَقَوْمَهُمَا مِنَ اَ۬لْكَرْبِ اِ۬لْعَظِيمِۖ",
      "text_normalized": "ونجيناهما وقومهما من الكرب العظيم",
      "aya_indic": "١١٥",
      "jozz": 23,
      "page": 450
    },
    {
      "sura": 37,
      "aya": 116,
      "text_uthmani": "وَنَصَرْنَٰهُمْ فَكَانُواْ هُمُ اُ۬لْغَٰلِبِينَۖ",
      "text_normalized": "ونصرناهم فكانوا هم الغالبين",
      "aya_indic": "١١٦",
      "jozz": 23,
      "page": 450
    },
    {
      "sura": 37,
      "aya": 117,
      "text_uthmani": "وَءَاتَيْنَٰهُمَا اَ۬لْكِتَٰبَ اَ۬لْمُسْتَبِينَۖ",
      "text_normalized": "وءاتيناهما الكتاب المستبين",
      "aya_indic": "١١٧",
      "jozz": 23,
      "page": 450
    },
    {
      "sura": 37,
      "aya": 118,
      "text_uthmani": "وَهَدَيْنَٰهُمَا اَ۬لصِّرَٰطَ اَ۬لْمُسْتَقِيمَۖ",
      "text_normalized": "وهديناهما الصراط المستقيم",
      "aya_indic": "١١٨",
      "jozz": 23,
      "page": 450
    },
    {
      "sura": 37,
      "aya": 119,
      "text_uthmani": "وَتَرَكْنَا عَلَيْهِمَا فِے اِ۬لَاخِرِينَۖ",
      "text_normalized": "وتركنا عليهما فے الاخرين",
      "aya_indic": "١١٩",
      "jozz": 23,
      "page": 450
    },
    {
      "sura": 37,
      "aya": 120,
      "text_uthmani": "سَلَٰمٌ عَلَىٰ مُوس۪ىٰ وَهَٰرُونَۖ",
      "text_normalized": "سلام عليا موسيا وهارون",
      "aya_indic": "١٢٠",
      "jozz": 23,
      "page": 450
    },
    {
      "sura": 37,
      "aya": 121,
      "text_uthmani": "إِنَّا كَذَٰلِكَ نَجْزِے اِ۬لْمُحْسِنِينَۖ",
      "text_normalized": "انا كذالك نجزے المحسنين",
      "aya_indic": "١٢١",
      "jozz": 23,
      "page": 450
    },
    {
      "sura": 37,
      "aya": 122,
      "text_uthmani": "إِنَّهُمَا مِنْ عِبَادِنَا اَ۬لْمُومِنِينَۖ",
      "text_normalized": "انهما من عبادنا المومنين",
      "aya_indic": "١٢٢",
      "jozz": 23,
      "page": 450
    },
    {
      "sura": 37,
      "aya": 123,
      "text_uthmani": "وَإِنَّ إِلْيَاسَ لَمِنَ اَ۬لْمُرْسَلِينَ",
      "text_normalized": "وان الياس لمن المرسلين",
      "aya_indic": "١٢٣",
      "jozz": 23,
      "page": 450
    },
    {
      "sura": 37,
      "aya": 124,
      "text_uthmani": "إِذْ قَالَ لِقَوْمِهِۦٓ أَلَا تَتَّقُونَ",
      "text_normalized": "اذ قال لقومه الا تتقون",
      "aya_indic": "١٢٤",
      "jozz": 23,
      "page": 450
    },
    {
      "sura": 37,
      "aya": 125,
      "text_uthmani": "أَتَدْعُونَ بَعْلاٗ وَتَذَرُونَ أَحْسَنَ اَ۬لْخَٰلِقِينَۖ",
      "text_normalized": "اتدعون بعلا وتذرون احسن الخالقين",
      "aya_indic": "١٢٥",
      "jozz": 23,
      "page": 450
    },
    {
      "sura": 37,
      "aya": 126,
      "text_uthmani": "اَ۬للَّهُ رَبُّكُمْ وَرَبُّ ءَابَآئِكُمُ اُ۬لَاوَّلِينَۖ",
      "text_normalized": "الله ربكم ورب ءابايكم الاولين",
      "aya_indic": "١٢٦",
      "jozz": 23,
      "page": 450
    },
    {
      "sura": 37,
      "aya": 127,
      "text_uthmani": "فَكَذَّبُوهُ فَإِنَّهُمْ لَمُحْضَرُونَ",
      "text_normalized": "فكذبوه فانهم لمحضرون",
      "aya_indic": "١٢٧",
      "jozz": 23,
      "page": 451
    },
    {
      "sura": 37,
      "aya": 128,
      "text_uthmani": "إِلَّا عِبَادَ اَ۬للَّهِ اِ۬لْمُخْلَصِينَۖ",
      "text_normalized": "الا عباد الله المخلصين",
      "aya_indic": "١٢٨",
      "jozz": 23,
      "page": 451
    },
    {
      "sura": 37,
      "aya": 129,
      "text_uthmani": "وَتَرَكْنَا عَلَيْهِ فِے اِ۬لَاخِرِينَۖ",
      "text_normalized": "وتركنا عليه فے الاخرين",
      "aya_indic": "١٢٩",
      "jozz": 23,
      "page": 451
    },
    {
      "sura": 37,
      "aya": 130,
      "text_uthmani": "سَلَٰمٌ عَلَىٰٓ ءَالِ يَاسِينَۖ",
      "text_normalized": "سلام عليا ءال ياسين",
      "aya_indic": "١٣٠",
      "jozz": 23,
      "page": 451
    },
    {
      "sura": 37,
      "aya": 131,
      "text_uthmani": "إِنَّا كَذَٰلِكَ نَجْزِے اِ۬لْمُحْسِنِينَۖ",
      "text_normalized": "انا كذالك نجزے المحسنين",
      "aya_indic": "١٣١",
      "jozz": 23,
      "page": 451
    },
    {
      "sura": 37,
      "aya": 132,
      "text_uthmani": "إِنَّهُۥ مِنْ عِبَادِنَا اَ۬لْمُومِنِينَۖ",
      "text_normalized": "انه من عبادنا المومنين",
      "aya_indic": "١٣٢",
      "jozz": 23,
      "page": 451
    },
    {
      "sura": 37,
      "aya": 133,
      "text_uthmani": "وَإِنَّ لُوطاٗ لَّمِنَ اَ۬لْمُرْسَلِينَ",
      "text_normalized": "وان لوطا لمن المرسلين",
      "aya_indic": "١٣٣",
      "jozz": 23,
      "page": 451
    },
    {
      "sura": 37,
      "aya": 134,
      "text_uthmani": "إِذْ نَجَّيْنَٰهُ وَأَهْلَهُۥٓ أَجْمَعِينَ",
      "text_normalized": "اذ نجيناه واهله اجمعين",
      "aya_indic": "١٣٤",
      "jozz": 23,
      "page": 451
    },
    {
      "sura": 37,
      "aya": 135,
      "text_uthmani": "إِلَّا عَجُوزاٗ فِے اِ۬لْغَٰبِرِينَ",
      "text_normalized": "الا عجوزا فے الغابرين",
      "aya_indic": "١٣٥",
      "jozz": 23,
      "page": 451
    },
    {
      "sura": 37,
      "aya": 136,
      "text_uthmani": "ثُمَّ دَمَّرْنَا اَ۬لَاخَرِينَۖ",
      "text_normalized": "ثم دمرنا الاخرين",
      "aya_indic": "١٣٦",
      "jozz": 23,
      "page": 451
    },
    {
      "sura": 37,
      "aya": 137,
      "text_uthmani": "وَإِنَّكُمْ لَتَمُرُّونَ عَلَيْهِم مُّصْبِحِينَ",
      "text_normalized": "وانكم لتمرون عليهم مصبحين",
      "aya_indic": "١٣٧",
      "jozz": 23,
      "page": 451
    },
    {
      "sura": 37,
      "aya": 138,
      "text_uthmani": "وَبِاليْلِۖ أَفَلَا تَعْقِلُونَۖ",
      "text_normalized": "وباليل افلا تعقلون",
      "aya_indic": "١٣٨",
      "jozz": 23,
      "page": 451
    },
    {
      "sura": 37,
      "aya": 139,
      "text_uthmani": "وَإِنَّ يُونُسَ لَمِنَ اَ۬لْمُرْسَلِينَ",
      "text_normalized": "وان يونس لمن المرسلين",
      "aya_indic": "١٣٩",
      "jozz": 23,
      "page": 451
    },
    {
      "sura": 37,
      "aya": 140,
      "text_uthmani": "إِذَ اَبَقَ إِلَى اَ۬لْفُلْكِ اِ۬لْمَشْحُونِ",
      "text_normalized": "اذ ابق الي الفلك المشحون",
      "aya_indic": "١٤٠",
      "jozz": 23,
      "page": 451
    },
    {
      "sura": 37,
      "aya": 141,
      "text_uthmani": "فَسَاهَمَ فَكَانَ مِنَ اَ۬لْمُدْحَضِينَ",
      "text_normalized": "فساهم فكان من المدحضين",
      "aya_indic": "١٤١",
      "jozz": 23,
      "page": 451
    },
    {
      "sura": 37,
      "aya": 142,
      "text_uthmani": "فَالْتَقَمَهُ اُ۬لْحُوتُ وَهُوَ مُلِيمٞۖ",
      "text_normalized": "فالتقمه الحوت وهو مليم",
      "aya_indic": "١٤٢",
      "jozz": 23,
      "page": 451
    },
    {
      "sura": 37,
      "aya": 143,
      "text_uthmani": "فَلَوْلَآ أَنَّهُۥ كَانَ مِنَ اَ۬لْمُسَبِّحِينَ",
      "text_normalized": "فلولا انه كان من المسبحين",
      "aya_indic": "١٤٣",
      "jozz": 23,
      "page": 451
    },
    {
      "sura": 37,
      "aya": 144,
      "text_uthmani": "لَلَبِثَ فِے بَطْنِهِۦٓ إِلَىٰ يَوْمِ يُبْعَثُونَۖ",
      "text_normalized": "للبث فے بطنه اليا يوم يبعثون",
      "aya_indic": "١٤٤",
      "jozz": 23,
      "page": 451
    },
    {
      "sura": 37,
      "aya": 145,
      "text_uthmani": "۞ فَنَبَذْنَٰهُ بِالْعَرَآءِ وَهُوَ سَقِيمٞۖ",
      "text_normalized": "فنبذناه بالعراء وهو سقيم",
      "aya_indic": "١٤٥",
      "jozz": 23,
      "page": 451
    },
    {
      "sura": 37,
      "aya": 146,
      "text_uthmani": "وَأَنۢبَتْنَا عَلَيْهِ شَجَرَةٗ مِّنْ يَّقْطِينٖۖ",
      "text_normalized": "وانبتنا عليه شجره من يقطين",
      "aya_indic": "١٤٦",
      "jozz": 23,
      "page": 451
    },
    {
      "sura": 37,
      "aya": 147,
      "text_uthmani": "وَأَرْسَلْنَٰهُ إِلَىٰ مِاْئَةِ أَلْفٍ اَوْ يَزِيدُونَۖ",
      "text_normalized": "وارسلناه اليا مايه الف او يزيدون",
      "aya_indic": "١٤٧",
      "jozz": 23,
      "page": 451
    },
    {
      "sura": 37,
      "aya": 148,
      "text_uthmani": "فَـَٔامَنُواْ فَمَتَّعْنَٰهُمُۥٓ إِلَىٰ حِينٖۖ",
      "text_normalized": "فامنوا فمتعناهم اليا حين",
      "aya_indic": "١٤٨",
      "jozz": 23,
      "page": 451
    },
    {
      "sura": 37,
      "aya": 149,
      "text_uthmani": "فَاسْتَفْتِهِمُۥٓ أَلِرَبِّكَ اَ۬لْبَنَاتُ وَلَهُمُ اُ۬لْبَنُونَۖ",
      "text_normalized": "فاستفتهم الربك البنات ولهم البنون",
      "aya_indic": "١٤٩",
      "jozz": 23,
      "page": 451
    },
    {
      "sura": 37,
      "aya": 150,
      "text_uthmani": "أَمْ خَلَقْنَا اَ۬لْمَلَٰٓئِكَةَ إِنَٰثاٗ وَهُمْ شَٰهِدُونَۖ",
      "text_normalized": "ام خلقنا الملايكه اناثا وهم شاهدون",
      "aya_indic": "١٥٠",
      "jozz": 23,
      "page": 451
    },
    {
      "sura": 37,
      "aya": 151,
      "text_uthmani": "أَلَآ إِنَّهُم مِّنِ اِفْكِهِمْ لَيَقُولُونَ",
      "text_normalized": "الا انهم من افكهم ليقولون",
      "aya_indic": "١٥١",
      "jozz": 23,
      "page": 451
    },
    {
      "sura": 37,
      "aya": 152,
      "text_uthmani": "وَلَدَ اَ۬للَّهُ وَإِنَّهُمْ لَكَٰذِبُونَۖ",
      "text_normalized": "ولد الله وانهم لكاذبون",
      "aya_indic": "١٥٢",
      "jozz": 23,
      "page": 451
    },
    {
      "sura": 37,
      "aya": 153,
      "text_uthmani": "أَصْطَفَى اَ۬لْبَنَاتِ عَلَى اَ۬لْبَنِينَۖ",
      "text_normalized": "اصطفي البنات علي البنين",
      "aya_indic": "١٥٣",
      "jozz": 23,
      "page": 451
    },
    {
      "sura": 37,
      "aya": 154,
      "text_uthmani": "مَا لَكُمْۖ كَيْفَ تَحْكُمُونَۖ",
      "text_normalized": "ما لكم كيف تحكمون",
      "aya_indic": "١٥٤",
      "jozz": 23,
      "page": 452
    },
    {
      "sura": 37,
      "aya": 155,
      "text_uthmani": "أَفَلَا تَذَّكَّرُونَۖ",
      "text_normalized": "افلا تذكرون",
      "aya_indic": "١٥٥",
      "jozz": 23,
      "page": 452
    },
    {
      "sura": 37,
      "aya": 156,
      "text_uthmani": "أَمْ لَكُمْ سُلْطَٰنٞ مُّبِينٞ",
      "text_normalized": "ام لكم سلطان مبين",
      "aya_indic": "١٥٦",
      "jozz": 23,
      "page": 452
    },
    {
      "sura": 37,
      "aya": 157,
      "text_uthmani": "فَاتُواْ بِكِتَٰبِكُمُۥٓ إِن كُنتُمْ صَٰدِقِينَۖ",
      "text_normalized": "فاتوا بكتابكم ان كنتم صادقين",
      "aya_indic": "١٥٧",
      "jozz": 23,
      "page": 452
    },
    {
      "sura": 37,
      "aya": 158,
      "text_uthmani": "وَجَعَلُواْ بَيْنَهُۥ وَبَيْنَ اَ۬لْجِنَّةِ نَسَباٗۖ وَلَقَدْ عَلِمَتِ اِ۬لْجِنَّةُ إِنَّهُمْ لَمُحْضَرُونَۖ",
      "text_normalized": "وجعلوا بينه وبين الجنه نسبا ولقد علمت الجنه انهم لمحضرون",
      "aya_indic": "١٥٨",
      "jozz": 23,
      "page": 452
    },
    {
      "sura": 37,
      "aya": 159,
      "text_uthmani": "سُبْحَٰنَ اَ۬للَّهِ عَمَّا يَصِفُونَۖ",
      "text_normalized": "سبحان الله عما يصفون",
      "aya_indic": "١٥٩",
      "jozz": 23,
      "page": 452
    },
    {
      "sura": 37,
      "aya": 160,
      "text_uthmani": "إِلَّا عِبَادَ اَ۬للَّهِ اِ۬لْمُخْلَصِينَۖ",
      "text_normalized": "الا عباد الله المخلصين",
      "aya_indic": "١٦٠",
      "jozz": 23,
      "page": 452
    },
    {
      "sura": 37,
      "aya": 161,
      "text_uthmani": "فَإِنَّكُمْ وَمَا تَعْبُدُونَ",
      "text_normalized": "فانكم وما تعبدون",
      "aya_indic": "١٦١",
      "jozz": 23,
      "page": 452
    },
    {
      "sura": 37,
      "aya": 162,
      "text_uthmani": "مَآ أَنتُمْ عَلَيْهِ بِفَٰتِنِينَ",
      "text_normalized": "ما انتم عليه بفاتنين",
      "aya_indic": "١٦٢",
      "jozz": 23,
      "page": 452
    },
    {
      "sura": 37,
      "aya": 163,
      "text_uthmani": "إِلَّا مَنْ هُوَ صَالِ اِ۬لْجَحِيمِۖ",
      "text_normalized": "الا من هو صال الجحيم",
      "aya_indic": "١٦٣",
      "jozz": 23,
      "page": 452
    },
    {
      "sura": 37,
      "aya": 164,
      "text_uthmani": "وَمَا مِنَّآ إِلَّا لَهُۥ مَقَامٞ مَّعْلُومٞۖ",
      "text_normalized": "وما منا الا له مقام معلوم",
      "aya_indic": "١٦٤",
      "jozz": 23,
      "page": 452
    },
    {
      "sura": 37,
      "aya": 165,
      "text_uthmani": "وَإِنَّا لَنَحْنُ اُ۬لصَّآفُّونَ",
      "text_normalized": "وانا لنحن الصافون",
      "aya_indic": "١٦٥",
      "jozz": 23,
      "page": 452
    },
    {
      "sura": 37,
      "aya": 166,
      "text_uthmani": "وَإِنَّا لَنَحْنُ اُ۬لْمُسَبِّحُونَۖ",
      "text_normalized": "وانا لنحن المسبحون",
      "aya_indic": "١٦٦",
      "jozz": 23,
      "page": 452
    },
    {
      "sura": 37,
      "aya": 167,
      "text_uthmani": "وَإِن كَانُواْ لَيَقُولُونَ",
      "text_normalized": "وان كانوا ليقولون",
      "aya_indic": "١٦٧",
      "jozz": 23,
      "page": 452
    },
    {
      "sura": 37,
      "aya": 168,
      "text_uthmani": "لَوَ اَنَّ عِندَنَا ذِكْراٗ مِّنَ اَ۬لَاوَّلِينَ",
      "text_normalized": "لو ان عندنا ذكرا من الاولين",
      "aya_indic": "١٦٨",
      "jozz": 23,
      "page": 452
    },
    {
      "sura": 37,
      "aya": 169,
      "text_uthmani": "لَكُنَّا عِبَادَ اَ۬للَّهِ اِ۬لْمُخْلَصِينَۖ",
      "text_normalized": "لكنا عباد الله المخلصين",
      "aya_indic": "١٦٩",
      "jozz": 23,
      "page": 452
    },
    {
      "sura": 37,
      "aya": 170,
      "text_uthmani": "فَكَفَرُواْ بِهِۦۖ فَسَوْفَ يَعْلَمُونَۖ",
      "text_normalized": "فكفروا به فسوف يعلمون",
      "aya_indic": "١٧٠",
      "jozz": 23,
      "page": 452
    },
    {
      "sura": 37,
      "aya": 171,
      "text_uthmani": "وَلَقَدْ سَبَقَتْ كَلِمَتُنَا لِعِبَادِنَا اَ۬لْمُرْسَلِينَ",
      "text_normalized": "ولقد سبقت كلمتنا لعبادنا المرسلين",
      "aya_indic": "١٧١",
      "jozz": 23,
      "page": 452
    },
    {
      "sura": 37,
      "aya": 172,
      "text_uthmani": "إِنَّهُمْ لَهُمُ اُ۬لْمَنصُورُونَ",
      "text_normalized": "انهم لهم المنصورون",
      "aya_indic": "١٧٢",
      "jozz": 23,
      "page": 452
    },
    {
      "sura": 37,
      "aya": 173,
      "text_uthmani": "وَإِنَّ جُندَنَا لَهُمُ اُ۬لْغَٰلِبُونَۖ",
      "text_normalized": "وان جندنا لهم الغالبون",
      "aya_indic": "١٧٣",
      "jozz": 23,
      "page": 452
    },
    {
      "sura": 37,
      "aya": 174,
      "text_uthmani": "فَتَوَلَّ عَنْهُمْ حَتَّىٰ حِينٖۖ",
      "text_normalized": "فتول عنهم حتيا حين",
      "aya_indic": "١٧٤",
      "jozz": 23,
      "page": 452
    },
    {
      "sura": 37,
      "aya": 175,
      "text_uthmani": "وَأَبْصِرْهُمْ فَسَوْفَ يُبْصِرُونَۖ",
      "text_normalized": "وابصرهم فسوف يبصرون",
      "aya_indic": "١٧٥",
      "jozz": 23,
      "page": 452
    },
    {
      "sura": 37,
      "aya": 176,
      "text_uthmani": "أَفَبِعَذَابِنَا يَسْتَعْجِلُونَۖ",
      "text_normalized": "افبعذابنا يستعجلون",
      "aya_indic": "١٧٦",
      "jozz": 23,
      "page": 452
    },
    {
      "sura": 37,
      "aya": 177,
      "text_uthmani": "فَإِذَا نَزَلَ بِسَاحَتِهِمْ فَسَآءَ صَبَاحُ اُ۬لْمُنذَرِينَۖ",
      "text_normalized": "فاذا نزل بساحتهم فساء صباح المنذرين",
      "aya_indic": "١٧٧",
      "jozz": 23,
      "page": 452
    },
    {
      "sura": 37,
      "aya": 178,
      "text_uthmani": "وَتَوَلَّ عَنْهُمْ حَتَّىٰ حِينٖۖ",
      "text_normalized": "وتول عنهم حتيا حين",
      "aya_indic": "١٧٨",
      "jozz": 23,
      "page": 452
    },
    {
      "sura": 37,
      "aya": 179,
      "text_uthmani": "وَأَبْصِرْ فَسَوْفَ يُبْصِرُونَۖ",
      "text_normalized": "وابصر فسوف يبصرون",
      "aya_indic": "١٧٩",
      "jozz": 23,
      "page": 452
    },
    {
      "sura": 37,
      "aya": 180,
      "text_uthmani": "سُبْحَٰنَ رَبِّكَ رَبِّ اِ۬لْعِزَّةِ عَمَّا يَصِفُونَۖ",
      "text_normalized": "سبحان ربك رب العزه عما يصفون",
      "aya_indic": "١٨٠",
      "jozz": 23,
      "page": 452
    },
    {
      "sura": 37,
      "aya": 181,
      "text_uthmani": "وَسَلَٰمٌ عَلَى اَ۬لْمُرْسَلِينَۖ",
      "text_normalized": "وسلام علي المرسلين",
      "aya_indic": "١٨١",
      "jozz": 23,
      "page": 452
    },
    {
      "sura": 37,
      "aya": 182,
      "text_uthmani": "وَالْحَمْدُ لِلهِ رَبِّ اِ۬لْعَٰلَمِينَۖ",
      "text_normalized": "والحمد لله رب العالمين",
      "aya_indic": "١٨٢",
      "jozz": 23,
      "page": 452
    }
  ]
}