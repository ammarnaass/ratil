{
  "id": 74,
  "name_ar": "المدثر",
  "name_en": "Al-Muddaththir",
  "type": "مكية",
  "ayahs_hafs": 56,
  "ayahs_warsh": 55,
  "page": 575,
  "narration": "warsh",
  "narration_ar": "ورش عن نافع",
  "ayahs": [
    {
      "sura": 74,
      "aya": 1,
      "text_uthmani": "يَٰٓأَيُّهَا اَ۬لْمُدَّثِّرُ",
      "text_normalized": "ياايها المدثر",
      "aya_indic": "١",
      "jozz": 29,
      "page": 575
    },
    {
      "sura": 74,
      "aya": 2,
      "text_uthmani": "قُمْ فَأَنذِرْۖ",
      "text_normalized": "قم فانذر",
      "aya_indic": "٢",
      "jozz": 29,
      "page": 575
    },
    {
      "sura": 74,
      "aya": 3,
      "text_uthmani": "وَرَبَّكَ فَكَبِّرْۖ",
      "text_normalized": "وربك فكبر",
      "aya_indic": "٣",
      "jozz": 29,
      "page": 575
    },
    {
      "sura": 74,
      "aya": 4,
      "text_uthmani": "وَثِيَابَكَ فَطَهِّرْۖ",
      "text_normalized": "وثيابك فطهر",
      "aya_indic": "٤",
      "jozz": 29,
      "page": 575
    },
    {
      "sura": 74,
      "aya": 5,
      "text_uthmani": "وَالرِّجْزَ فَاهْجُرْۖ",
      "text_normalized": "والرجز فاهجر",
      "aya_indic": "٥",
      "jozz": 29,
      "page": 575
    },
    {
      "sura": 74,
      "aya": 6,
      "text_uthmani": "وَلَا تَمْنُن تَسْتَكْثِرُۖ",
      "text_normalized": "ولا تمنن تستكثر",
      "aya_indic": "٦",
      "jozz": 29,
      "page": 575
    },
    {
      "sura": 74,
      "aya": 7,
      "text_uthmani": "وَلِرَبِّكَ فَاصْبِرْۖ",
      "text_normalized": "ولربك فاصبر",
      "aya_indic": "٧",
      "jozz": 29,
      "page": 575
    },
    {
      "sura": 74,
      "aya": 8,
      "text_uthmani": "فَإِذَا نُقِرَ فِے اِ۬لنَّاقُورِ",
      "text_normalized": "فاذا نقر فے الناقور",
      "aya_indic": "٨",
      "jozz": 29,
      "page": 575
    },
    {
      "sura": 74,
      "aya": 9,
      "text_uthmani": "فَذَٰلِكَ يَوْمَئِذٖ يَوْمٌ عَسِيرٌ",
      "text_normalized": "فذالك يوميذ يوم عسير",
      "aya_indic": "٩",
      "jozz": 29,
      "page": 575
    },
    {
      "sura": 74,
      "aya": 10,
      "text_uthmani": "عَلَى اَ۬لْكٰ۪فِرِينَ غَيْرُ يَسِيرٖۖ",
      "text_normalized": "علي الكافرين غير يسير",
      "aya_indic": "١٠",
      "jozz": 29,
      "page": 575
    },
    {
      "sura": 74,
      "aya": 11,
      "text_uthmani": "ذَرْنِے وَمَنْ خَلَقْتُ وَحِيداٗ",
      "text_normalized": "ذرنے ومن خلقت وحيدا",
      "aya_indic": "١١",
      "jozz": 29,
      "page": 575
    },
    {
      "sura": 74,
      "aya": 12,
      "text_uthmani": "وَجَعَلْتُ لَهُۥ مَالاٗ مَّمْدُوداٗ",
      "text_normalized": "وجعلت له مالا ممدودا",
      "aya_indic": "١٢",
      "jozz": 29,
      "page": 575
    },
    {
      "sura": 74,
      "aya": 13,
      "text_uthmani": "وَبَنِينَ شُهُوداٗ",
      "text_normalized": "وبنين شهودا",
      "aya_indic": "١٣",
      "jozz": 29,
      "page": 575
    },
    {
      "sura": 74,
      "aya": 14,
      "text_uthmani": "وَمَهَّدتُّ لَهُۥ تَمْهِيداٗ",
      "text_normalized": "ومهدت له تمهيدا",
      "aya_indic": "١٤",
      "jozz": 29,
      "page": 575
    },
    {
      "sura": 74,
      "aya": 15,
      "text_uthmani": "ثُمَّ يَطْمَعُ أَنَ اَزِيدَ",
      "text_normalized": "ثم يطمع ان ازيد",
      "aya_indic": "١٥",
      "jozz": 29,
      "page": 575
    },
    {
      "sura": 74,
      "aya": 16,
      "text_uthmani": "كَلَّآۖ إِنَّهُۥ كَانَ لِأٓيَٰتِنَا عَنِيداٗۖ",
      "text_normalized": "كلا انه كان لاياتنا عنيدا",
      "aya_indic": "١٦",
      "jozz": 29,
      "page": 575
    },
    {
      "sura": 74,
      "aya": 17,
      "text_uthmani": "سَأُرْهِقُهُۥ صَعُوداًۖ",
      "text_normalized": "سارهقه صعودا",
      "aya_indic": "١٧",
      "jozz": 29,
      "page": 575
    },
    {
      "sura": 74,
      "aya": 18,
      "text_uthmani": "اِنَّهُۥ فَكَّرَ وَقَدَّرَ",
      "text_normalized": "انه فكر وقدر",
      "aya_indic": "١٨",
      "jozz": 29,
      "page": 575
    },
    {
      "sura": 74,
      "aya": 19,
      "text_uthmani": "فَقُتِلَ كَيْفَ قَدَّرَ",
      "text_normalized": "فقتل كيف قدر",
      "aya_indic": "١٩",
      "jozz": 29,
      "page": 576
    },
    {
      "sura": 74,
      "aya": 20,
      "text_uthmani": "ثُمَّ قُتِلَ كَيْفَ قَدَّرَ",
      "text_normalized": "ثم قتل كيف قدر",
      "aya_indic": "٢٠",
      "jozz": 29,
      "page": 576
    },
    {
      "sura": 74,
      "aya": 21,
      "text_uthmani": "ثُمَّ نَظَرَ",
      "text_normalized": "ثم نظر",
      "aya_indic": "٢١",
      "jozz": 29,
      "page": 576
    },
    {
      "sura": 74,
      "aya": 22,
      "text_uthmani": "ثُمَّ عَبَسَ وَبَسَرَ",
      "text_normalized": "ثم عبس وبسر",
      "aya_indic": "٢٢",
      "jozz": 29,
      "page": 576
    },
    {
      "sura": 74,
      "aya": 23,
      "text_uthmani": "ثُمَّ أَدْبَرَ وَاسْتَكْبَرَ",
      "text_normalized": "ثم ادبر واستكبر",
      "aya_indic": "٢٣",
      "jozz": 29,
      "page": 576
    },
    {
      "sura": 74,
      "aya": 24,
      "text_uthmani": "فَقَالَ إِنْ هَٰذَآ إِلَّا سِحْرٞ يُوثَرُ",
      "text_normalized": "فقال ان هذا الا سحر يوثر",
      "aya_indic": "٢٤",
      "jozz": 29,
      "page": 576
    },
    {
      "sura": 74,
      "aya": 25,
      "text_uthmani": "إِنْ هَٰذَآ إِلَّا قَوْلُ اُ۬لْبَشَرِۖ",
      "text_normalized": "ان هذا الا قول البشر",
      "aya_indic": "٢٥",
      "jozz": 29,
      "page": 576
    },
    {
      "sura": 74,
      "aya": 26,
      "text_uthmani": "سَأُصْلِيهِ سَقَرَۖ",
      "text_normalized": "ساصليه سقر",
      "aya_indic": "٢٦",
      "jozz": 29,
      "page": 576
    },
    {
      "sura": 74,
      "aya": 27,
      "text_uthmani": "وَمَآ أَدْر۪يٰكَ مَا سَقَرُۖ",
      "text_normalized": "وما ادرياك ما سقر",
      "aya_indic": "٢٧",
      "jozz": 29,
      "page": 576
    },
    {
      "sura": 74,
      "aya": 28,
      "text_uthmani": "لَا تُبْقِے وَلَا تَذَرُۖ",
      "text_normalized": "لا تبقے ولا تذر",
      "aya_indic": "٢٨",
      "jozz": 29,
      "page": 576
    },
    {
      "sura": 74,
      "aya": 29,
      "text_uthmani": "لَوَّاحَةٞ لِّلْبَشَرِۖ",
      "text_normalized": "لواحه للبشر",
      "aya_indic": "٢٩",
      "jozz": 29,
      "page": 576
    },
    {
      "sura": 74,
      "aya": 30,
      "text_uthmani": "عَلَيْهَا تِسْعَةَ عَشَرَۖ",
      "text_normalized": "عليها تسعه عشر",
      "aya_indic": "٣٠",
      "jozz": 29,
      "page": 576
    },
    {
      "sura": 74,
      "aya": 31,
      "text_uthmani": "۞ وَمَا جَعَلْنَآ أَصْحَٰبَ اَ۬لنّ۪ارِ إِلَّا مَلَٰٓئِكَةٗۖ وَمَا جَعَلْنَا عِدَّتَهُمُۥٓ إِلَّا فِتْنَةٗ لِّلذِينَ كَفَرُواْ لِيَسْتَيْقِنَ اَ۬لذِينَ أُوتُواْ اُ۬لْكِتَٰبَ وَيَزْدَادَ اَ۬لذِينَ ءَامَنُوٓاْ إِيمَٰناٗ وَلَا يَرْتَابَ اَ۬لذِينَ أُوتُواْ اُ۬لْكِتَٰبَ وَالْمُومِنُونَ وَلِيَقُولَ اَ۬لذِينَ فِے قُلُوبِهِم مَّرَضٞ وَالْكَٰفِرُونَ مَاذَآ أَرَادَ اَ۬للَّهُ بِهَٰذَا مَثَلاٗۖ كَذَٰلِكَ يُضِلُّ اُ۬للَّهُ مَنْ يَّشَآءُ وَيَهْدِے مَنْ يَّشَآءُۖ وَمَا يَعْلَمُ جُنُودَ رَبِّكَ إِلَّا هُوَۖ وَمَا هِيَ إِلَّا ذِكْر۪ىٰ لِلْبَشَرِۖ",
      "text_normalized": "وما جعلنا اصحاب النار الا ملايكه وما جعلنا عدتهم الا فتنه للذين كفروا ليستيقن الذين اوتوا الكتاب ويزداد الذين ءامنوا ايمانا ولا يرتاب الذين اوتوا الكتاب والمومنون وليقول الذين فے قلوبهم مرض والكافرون ماذا اراد الله بهاذا مثلا كذالك يضل الله من يشاء ويهدے من يشاء وما يعلم جنود ربك الا هو وما هي الا ذكريا للبشر",
      "aya_indic": "٣١",
      "jozz": 29,
      "page": 576
    },
    {
      "sura": 74,
      "aya": 32,
      "text_uthmani": "كَلَّا وَالْقَمَرِ",
      "text_normalized": "كلا والقمر",
      "aya_indic": "٣٢",
      "jozz": 29,
      "page": 576
    },
    {
      "sura": 74,
      "aya": 33,
      "text_uthmani": "وَاليْلِ إِذَ اَدْبَرَ",
      "text_normalized": "واليل اذ ادبر",
      "aya_indic": "٣٣",
      "jozz": 29,
      "page": 576
    },
    {
      "sura": 74,
      "aya": 34,
      "text_uthmani": "وَالصُّبْحِ إِذَآ أَسْفَرَ",
      "text_normalized": "والصبح اذا اسفر",
      "aya_indic": "٣٤",
      "jozz": 29,
      "page": 576
    },
    {
      "sura": 74,
      "aya": 35,
      "text_uthmani": "إِنَّهَا لَإِحْدَى اَ۬لْكُبَرِ",
      "text_normalized": "انها لاحدي الكبر",
      "aya_indic": "٣٥",
      "jozz": 29,
      "page": 576
    },
    {
      "sura": 74,
      "aya": 36,
      "text_uthmani": "نَذِيراٗ لِّلْبَشَرِ",
      "text_normalized": "نذيرا للبشر",
      "aya_indic": "٣٦",
      "jozz": 29,
      "page": 576
    },
    {
      "sura": 74,
      "aya": 37,
      "text_uthmani": "لِمَن شَآءَ مِنكُمُۥٓ أَنْ يَّتَقَدَّمَ أَوْ يَتَأَخَّرَۖ",
      "text_normalized": "لمن شاء منكم ان يتقدم او يتاخر",
      "aya_indic": "٣٧",
      "jozz": 29,
      "page": 576
    },
    {
      "sura": 74,
      "aya": 38,
      "text_uthmani": "كُلُّ نَفْسِۢ بِمَا كَسَبَتْ رَهِينَةٌ",
      "text_normalized": "كل نفس بما كسبت رهينه",
      "aya_indic": "٣٨",
      "jozz": 29,
      "page": 576
    },
    {
      "sura": 74,
      "aya": 39,
      "text_uthmani": "اِلَّآ أَصْحَٰبَ اَ۬لْيَمِينِۖ",
      "text_normalized": "الا اصحاب اليمين",
      "aya_indic": "٣٩",
      "jozz": 29,
      "page": 576
    },
    {
      "sura": 74,
      "aya": 40,
      "text_uthmani": "فِے جَنَّٰتٖ يَتَسَآءَلُونَ عَنِ اِ۬لْمُجْرِمِينَ",
      "text_normalized": "فے جنات يتساءلون عن المجرمين",
      "aya_indic": "٤٠",
      "jozz": 29,
      "page": 576
    },
    {
      "sura": 74,
      "aya": 41,
      "text_uthmani": "مَا سَلَكَكُمْ فِے سَقَرَۖ",
      "text_normalized": "ما سلككم فے سقر",
      "aya_indic": "٤١",
      "jozz": 29,
      "page": 576
    },
    {
      "sura": 74,
      "aya": 42,
      "text_uthmani": "قَالُواْ لَمْ نَكُ مِنَ اَ۬لْمُصَلِّينَ",
      "text_normalized": "قالوا لم نك من المصلين",
      "aya_indic": "٤٢",
      "jozz": 29,
      "page": 576
    },
    {
      "sura": 74,
      "aya": 43,
      "text_uthmani": "وَلَمْ نَكُ نُطْعِمُ اُ۬لْمِسْكِينَ",
      "text_normalized": "ولم نك نطعم المسكين",
      "aya_indic": "٤٣",
      "jozz": 29,
      "page": 576
    },
    {
      "sura": 74,
      "aya": 44,
      "text_uthmani": "وَكُنَّا نَخُوضُ مَعَ اَ۬لْخَآئِضِينَ",
      "text_normalized": "وكنا نخوض مع الخايضين",
      "aya_indic": "٤٤",
      "jozz": 29,
      "page": 576
    },
    {
      "sura": 74,
      "aya": 45,
      "text_uthmani": "وَكُنَّا نُكَذِّبُ بِيَوْمِ اِ۬لدِّينِ",
      "text_normalized": "وكنا نكذب بيوم الدين",
      "aya_indic": "٤٥",
      "jozz": 29,
      "page": 576
    },
    {
      "sura": 74,
      "aya": 46,
      "text_uthmani": "حَتَّىٰٓ أَت۪يٰنَا اَ۬لْيَقِينُۖ",
      "text_normalized": "حتيا اتيانا اليقين",
      "aya_indic": "٤٦",
      "jozz": 29,
      "page": 576
    },
    {
      "sura": 74,
      "aya": 47,
      "text_uthmani": "فَمَا تَنفَعُهُمْ شَفَٰعَةُ اُ۬لشَّٰفِعِينَۖ",
      "text_normalized": "فما تنفعهم شفاعه الشافعين",
      "aya_indic": "٤٧",
      "jozz": 29,
      "page": 577
    },
    {
      "sura": 74,
      "aya": 48,
      "text_uthmani": "فَمَا لَهُمْ عَنِ اِ۬لتَّذْكِرَةِ مُعْرِضِينَ",
      "text_normalized": "فما لهم عن التذكره معرضين",
      "aya_indic": "٤٨",
      "jozz": 29,
      "page": 577
    },
    {
      "sura": 74,
      "aya": 49,
      "text_uthmani": "كَأَنَّهُمْ حُمُرٞ مُّسْتَنفَرَةٞ",
      "text_normalized": "كانهم حمر مستنفره",
      "aya_indic": "٤٩",
      "jozz": 29,
      "page": 577
    },
    {
      "sura": 74,
      "aya": 50,
      "text_uthmani": "فَرَّتْ مِن قَسْوَرَةِۢۖ",
      "text_normalized": "فرت من قسوره",
      "aya_indic": "٥٠",
      "jozz": 29,
      "page": 577
    },
    {
      "sura": 74,
      "aya": 51,
      "text_uthmani": "بَلْ يُرِيدُ كُلُّ اُ۪مْرِےٕٖ مِّنْهُمُۥٓ أَنْ يُّوت۪ىٰ صُحُفاٗ مُّنَشَّرَةٗۖ",
      "text_normalized": "بل يريد كل امرے منهم ان يوتيا صحفا منشره",
      "aya_indic": "٥١",
      "jozz": 29,
      "page": 577
    },
    {
      "sura": 74,
      "aya": 52,
      "text_uthmani": "كَلَّا بَل لَّا يَخَافُونَ اَ۬لَاخِرَةَۖ",
      "text_normalized": "كلا بل لا يخافون الاخره",
      "aya_indic": "٥٢",
      "jozz": 29,
      "page": 577
    },
    {
      "sura": 74,
      "aya": 53,
      "text_uthmani": "كَلَّآ إِنَّهُۥ تَذْكِرَةٞۖ",
      "text_normalized": "كلا انه تذكره",
      "aya_indic": "٥٣",
      "jozz": 29,
      "page": 577
    },
    {
      "sura": 74,
      "aya": 54,
      "text_uthmani": "فَمَن شَآءَ ذَكَرَهُۥۖ",
      "text_normalized": "فمن شاء ذكره",
      "aya_indic": "٥٤",
      "jozz": 29,
      "page": 577
    },
    {
      "sura": 74,
      "aya": 55,
      "text_uthmani": "وَمَا تَذْكُرُونَ إِلَّآ أَنْ يَّشَآءَ اَ۬للَّهُۖ هُوَ أَهْلُ اُ۬لتَّقْو۪ىٰ وَأَهْلُ اُ۬لْمَغْفِرَةِۖ",
      "text_normalized": "وما تذكرون الا ان يشاء الله هو اهل التقويا واهل المغفره",
      "aya_indic": "٥٥",
      "jozz": 29,
      "page": 577
    }
  ]
}