{
  "id": 83,
  "name_ar": "المطففين",
  "name_en": "Al-Mutaffifin",
  "type": "مكية",
  "ayahs_hafs": 36,
  "ayahs_warsh": 36,
  "page": 587,
  "narration": "warsh",
  "narration_ar": "ورش عن نافع",
  "ayahs": [
    {
      "sura": 83,
      "aya": 1,
      "text_uthmani": "وَيْلٞ لِّلْمُطَفِّفِينَ",
      "text_normalized": "ويل للمطففين",
      "aya_indic": "١",
      "jozz": 30,
      "page": 587
    },
    {
      "sura": 83,
      "aya": 2,
      "text_uthmani": "اَ۬لذِينَ إِذَا اَ۪كْتَالُواْ عَلَى اَ۬لنَّاسِ يَسْتَوْفُونَ",
      "text_normalized": "الذين اذا اكتالوا علي الناس يستوفون",
      "aya_indic": "٢",
      "jozz": 30,
      "page": 587
    },
    {
      "sura": 83,
      "aya": 3,
      "text_uthmani": "وَإِذَا كَالُوهُمُۥٓ أَو وَّزَنُوهُمْ يُخْسِرُونَۖ",
      "text_normalized": "واذا كالوهم او وزنوهم يخسرون",
      "aya_indic": "٣",
      "jozz": 30,
      "page": 587
    },
    {
      "sura": 83,
      "aya": 4,
      "text_uthmani": "أَلَا يَظُنُّ أُوْلَٰٓئِكَ أَنَّهُم مَّبْعُوثُونَ",
      "text_normalized": "الا يظن اولايك انهم مبعوثون",
      "aya_indic": "٤",
      "jozz": 30,
      "page": 587
    },
    {
      "sura": 83,
      "aya": 5,
      "text_uthmani": "لِيَوْمٍ عَظِيمٖ",
      "text_normalized": "ليوم عظيم",
      "aya_indic": "٥",
      "jozz": 30,
      "page": 588
    },
    {
      "sura": 83,
      "aya": 6,
      "text_uthmani": "يَوْمَ يَقُومُ اُ۬لنَّاسُ لِرَبِّ اِ۬لْعَٰلَمِينَۖ",
      "text_normalized": "يوم يقوم الناس لرب العالمين",
      "aya_indic": "٦",
      "jozz": 30,
      "page": 588
    },
    {
      "sura": 83,
      "aya": 7,
      "text_uthmani": "كَلَّآ إِنَّ كِتَٰبَ اَ۬لْفُجّ۪ارِ لَفِے سِجِّينٖۖ",
      "text_normalized": "كلا ان كتاب الفجار لفے سجين",
      "aya_indic": "٧",
      "jozz": 30,
      "page": 588
    },
    {
      "sura": 83,
      "aya": 8,
      "text_uthmani": "وَمَآ أَدْر۪يٰكَ مَا سِجِّينٞ",
      "text_normalized": "وما ادرياك ما سجين",
      "aya_indic": "٨",
      "jozz": 30,
      "page": 588
    },
    {
      "sura": 83,
      "aya": 9,
      "text_uthmani": "كِتَٰبٞ مَّرْقُومٞۖ",
      "text_normalized": "كتاب مرقوم",
      "aya_indic": "٩",
      "jozz": 30,
      "page": 588
    },
    {
      "sura": 83,
      "aya": 10,
      "text_uthmani": "وَيْلٞ يَوْمَئِذٖ لِّلْمُكَذِّبِينَ",
      "text_normalized": "ويل يوميذ للمكذبين",
      "aya_indic": "١٠",
      "jozz": 30,
      "page": 588
    },
    {
      "sura": 83,
      "aya": 11,
      "text_uthmani": "اَ۬لذِينَ يُكَذِّبُونَ بِيَوْمِ اِ۬لدِّينِۖ",
      "text_normalized": "الذين يكذبون بيوم الدين",
      "aya_indic": "١١",
      "jozz": 30,
      "page": 588
    },
    {
      "sura": 83,
      "aya": 12,
      "text_uthmani": "وَمَا يُكَذِّبُ بِهِۦٓ إِلَّا كُلُّ مُعْتَدٍ اَثِيمٍ",
      "text_normalized": "وما يكذب به الا كل معتد اثيم",
      "aya_indic": "١٢",
      "jozz": 30,
      "page": 588
    },
    {
      "sura": 83,
      "aya": 13,
      "text_uthmani": "اِذَا تُتْل۪ىٰ عَلَيْهِ ءَايَٰتُنَا قَالَ أَسَٰطِيرُ اُ۬لَاوَّلِينَۖ",
      "text_normalized": "اذا تتليا عليه ءاياتنا قال اساطير الاولين",
      "aya_indic": "١٣",
      "jozz": 30,
      "page": 588
    },
    {
      "sura": 83,
      "aya": 14,
      "text_uthmani": "۞ كَلَّا بَل رَّانَ عَلَىٰ قُلُوبِهِم مَّا كَانُواْ يَكْسِبُونَۖ",
      "text_normalized": "كلا بل ران عليا قلوبهم ما كانوا يكسبون",
      "aya_indic": "١٤",
      "jozz": 30,
      "page": 588
    },
    {
      "sura": 83,
      "aya": 15,
      "text_uthmani": "كَلَّآ إِنَّهُمْ عَن رَّبِّهِمْ يَوْمَئِذٖ لَّمَحْجُوبُونَۖ",
      "text_normalized": "كلا انهم عن ربهم يوميذ لمحجوبون",
      "aya_indic": "١٥",
      "jozz": 30,
      "page": 588
    },
    {
      "sura": 83,
      "aya": 16,
      "text_uthmani": "ثُمَّ إِنَّهُمْ لَصَالُواْ اُ۬لْجَحِيمِۖ",
      "text_normalized": "ثم انهم لصالوا الجحيم",
      "aya_indic": "١٦",
      "jozz": 30,
      "page": 588
    },
    {
      "sura": 83,
      "aya": 17,
      "text_uthmani": "ثُمَّ يُقَالُ هَٰذَا اَ۬لذِے كُنتُم بِهِۦ تُكَذِّبُونَۖ",
      "text_normalized": "ثم يقال هذا الذے كنتم به تكذبون",
      "aya_indic": "١٧",
      "jozz": 30,
      "page": 588
    },
    {
      "sura": 83,
      "aya": 18,
      "text_uthmani": "كَلَّآ إِنَّ كِتَٰبَ اَ۬لَابْر۪ارِ لَفِے عِلِّيِّينَۖ",
      "text_normalized": "كلا ان كتاب الابرار لفے عليين",
      "aya_indic": "١٨",
      "jozz": 30,
      "page": 588
    },
    {
      "sura": 83,
      "aya": 19,
      "text_uthmani": "وَمَآ أَدْر۪يٰكَ مَا عِلِّيُّونَ",
      "text_normalized": "وما ادرياك ما عليون",
      "aya_indic": "١٩",
      "jozz": 30,
      "page": 588
    },
    {
      "sura": 83,
      "aya": 20,
      "text_uthmani": "كِتَٰبٞ مَّرْقُومٞ",
      "text_normalized": "كتاب مرقوم",
      "aya_indic": "٢٠",
      "jozz": 30,
      "page": 588
    },
    {
      "sura": 83,
      "aya": 21,
      "text_uthmani": "يَشْهَدُهُ اُ۬لْمُقَرَّبُونَۖ",
      "text_normalized": "يشهده المقربون",
      "aya_indic": "٢١",
      "jozz": 30,
      "page": 588
    },
    {
      "sura": 83,
      "aya": 22,
      "text_uthmani": "إِنَّ اَ۬لَابْرَارَ لَفِے نَعِيمٍ",
      "text_normalized": "ان الابرار لفے نعيم",
      "aya_indic": "٢٢",
      "jozz": 30,
      "page": 588
    },
    {
      "sura": 83,
      "aya": 23,
      "text_uthmani": "عَلَى اَ۬لَارَآئِكِ يَنظُرُونَ",
      "text_normalized": "علي الارايك ينظرون",
      "aya_indic": "٢٣",
      "jozz": 30,
      "page": 588
    },
    {
      "sura": 83,
      "aya": 24,
      "text_uthmani": "تَعْرِفُ فِے وُجُوهِهِمْ نَضْرَةَ اَ۬لنَّعِيمِ",
      "text_normalized": "تعرف فے وجوههم نضره النعيم",
      "aya_indic": "٢٤",
      "jozz": 30,
      "page": 588
    },
    {
      "sura": 83,
      "aya": 25,
      "text_uthmani": "يُسْقَوْنَ مِن رَّحِيقٖ مَّخْتُومٍ",
      "text_normalized": "يسقون من رحيق مختوم",
      "aya_indic": "٢٥",
      "jozz": 30,
      "page": 588
    },
    {
      "sura": 83,
      "aya": 26,
      "text_uthmani": "خِتَٰمُهُۥ مِسْكٞۖ وَفِے ذَٰلِكَ فَلْيَتَنَافَسِ اِ۬لْمُتَنَٰفِسُونَۖ",
      "text_normalized": "ختامه مسك وفے ذلك فليتنافس المتنافسون",
      "aya_indic": "٢٦",
      "jozz": 30,
      "page": 588
    },
    {
      "sura": 83,
      "aya": 27,
      "text_uthmani": "وَمِزَاجُهُۥ مِن تَسْنِيمٍ",
      "text_normalized": "ومزاجه من تسنيم",
      "aya_indic": "٢٧",
      "jozz": 30,
      "page": 588
    },
    {
      "sura": 83,
      "aya": 28,
      "text_uthmani": "عَيْناٗ يَشْرَبُ بِهَا اَ۬لْمُقَرَّبُونَۖ",
      "text_normalized": "عينا يشرب بها المقربون",
      "aya_indic": "٢٨",
      "jozz": 30,
      "page": 588
    },
    {
      "sura": 83,
      "aya": 29,
      "text_uthmani": "إِنَّ اَ۬لذِينَ أَجْرَمُواْ كَانُواْ مِنَ اَ۬لذِينَ ءَامَنُواْ يَضْحَكُونَ",
      "text_normalized": "ان الذين اجرموا كانوا من الذين ءامنوا يضحكون",
      "aya_indic": "٢٩",
      "jozz": 30,
      "page": 588
    },
    {
      "sura": 83,
      "aya": 30,
      "text_uthmani": "وَإِذَا مَرُّواْ بِهِمْ يَتَغَامَزُونَ",
      "text_normalized": "واذا مروا بهم يتغامزون",
      "aya_indic": "٣٠",
      "jozz": 30,
      "page": 588
    },
    {
      "sura": 83,
      "aya": 31,
      "text_uthmani": "وَإِذَا اَ۪نقَلَبُوٓاْ إِلَىٰٓ أَهْلِهِمُ اُ۪نقَلَبُواْ فَٰكِهِينَ",
      "text_normalized": "واذا انقلبوا اليا اهلهم انقلبوا فاكهين",
      "aya_indic": "٣١",
      "jozz": 30,
      "page": 588
    },
    {
      "sura": 83,
      "aya": 32,
      "text_uthmani": "وَإِذَا رَأَوْهُمْ قَالُوٓاْ إِنَّ هَٰٓؤُلَآءِ لَضَآلُّونَ",
      "text_normalized": "واذا راوهم قالوا ان هاولاء لضالون",
      "aya_indic": "٣٢",
      "jozz": 30,
      "page": 588
    },
    {
      "sura": 83,
      "aya": 33,
      "text_uthmani": "وَمَآ أُرْسِلُواْ عَلَيْهِمْ حَٰفِظِينَۖ",
      "text_normalized": "وما ارسلوا عليهم حافظين",
      "aya_indic": "٣٣",
      "jozz": 30,
      "page": 588
    },
    {
      "sura": 83,
      "aya": 34,
      "text_uthmani": "فَالْيَوْمَ اَ۬لذِينَ ءَامَنُواْ مِنَ اَ۬لْكُفّ۪ارِ يَضْحَكُونَ",
      "text_normalized": "فاليوم الذين ءامنوا من الكفار يضحكون",
      "aya_indic": "٣٤",
      "jozz": 30,
      "page": 589
    },
    {
      "sura": 83,
      "aya": 35,
      "text_uthmani": "عَلَى اَ۬لَارَآئِكِۖ يَنظُرُونَ",
      "text_normalized": "علي الارايك ينظرون",
      "aya_indic": "٣٥",
      "jozz": 30,
      "page": 589
    },
    {
      "sura": 83,
      "aya": 36,
      "text_uthmani": "هَلْ ثُوِّبَ اَ۬لْكُفَّارُ مَا كَانُواْ يَفْعَلُونَۖ",
      "text_normalized": "هل ثوب الكفار ما كانوا يفعلون",
      "aya_indic": "٣٦",
      "jozz": 30,
      "page": 589
    }
  ]
}