  "narration": "warsh",
  "narration_ar": "ورش عن نافع",
  "ayahs": [
    {
      "sura": 97,
      "aya": 1,
      "text_uthmani": "اِنَّآ أَنزَلْنَٰهُ فِے لَيْلَةِ اِ۬لْقَدْرِۖ",
      "text_normalized": "انا انزلناه فے ليله القدر",
      "aya_indic": "١",
      "jozz": 30,
      "page": 598
    },
    {
      "sura": 97,
      "aya": 2,
      "text_uthmani": "وَمَآ أَدْر۪يٰكَ مَا لَيْلَةُ اُ۬لْقَدْرِۖ",
      "text_normalized": "وما ادرياك ما ليله القدر",
      "aya_indic": "٢",
      "jozz": 30,
      "page": 598
    },
    {
      "sura": 97,
      "aya": 3,
      "text_uthmani": "لَيْلَةُ اُ۬لْقَدْرِ خَيْرٞ مِّنَ اَلْفِ شَهْرٖۖ",
      "text_normalized": "ليله القدر خير من الف شهر",
      "aya_indic": "٣",
      "jozz": 30,
      "page": 598
    },
    {
      "sura": 97,
      "aya": 4,
      "text_uthmani": "تَنَزَّلُ اُ۬لْمَلَٰٓئِكَةُ وَالرُّوحُ فِيهَا بِإِذْنِ رَبِّهِم مِّن كُلِّ أَمْرٖۖ",
      "text_normalized": "تنزل الملايكه والروح فيها باذن ربهم من كل امر",
      "aya_indic": "٤",
      "jozz": 30,
      "page": 598
    },
    {
      "sura": 97,
      "aya": 5,
      "text_uthmani": "سَلَٰمٌ هِيَ حَتَّىٰ مَطْلَعِ اِ۬لْفَجْرِۖ",
      "text_normalized": "سلام هي حتيا مطلع الفجر",
      "aya_indic": "٥",
      "jozz": 30,
      "page": 598
    }
  ]
}