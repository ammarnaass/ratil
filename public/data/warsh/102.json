{
  "id": 102,
  "name_ar": "التكاثر",
  "name_en": "At-Takathur",
  "type": "مكية",
  "ayahs_hafs": 8,
  "ayahs_warsh": 8,
  "page": 600,
  "narration": "warsh",
  "narration_ar": "ورش عن نافع",
  "ayahs": [
    {
      "sura": 102,
      "aya": 1,
      "text_uthmani": "اَلْه۪يٰكُمُ اُ۬لتَّكَاثُرُ",
      "text_normalized": "الهياكم التكاثر",
      "aya_indic": "١",
      "jozz": 30,
      "page": 600
    },
    {
      "sura": 102,
      "aya": 2,
      "text_uthmani": "حَتَّىٰ زُرْتُمُ اُ۬لْمَقَابِرَۖ",
      "text_normalized": "حتيا زرتم المقابر",
      "aya_indic": "٢",
      "jozz": 30,
      "page": 600
    },
    {
      "sura": 102,
      "aya": 3,
      "text_uthmani": "كَلَّا سَوْفَ تَعْلَمُونَ",
      "text_normalized": "كلا سوف تعلمون",
      "aya_indic": "٣",
      "jozz": 30,
      "page": 600
    },
    {
      "sura": 102,
      "aya": 4,
      "text_uthmani": "ثُمَّ كَلَّا سَوْفَ تَعْلَمُونَۖ",
      "text_normalized": "ثم كلا سوف تعلمون",
      "aya_indic": "٤",
      "jozz": 30,
      "page": 600
    },
    {
      "sura": 102,
      "aya": 5,
      "text_uthmani": "كَلَّا لَوْ تَعْلَمُونَ عِلْمَ اَ۬لْيَقِينِۖ",
      "text_normalized": "كلا لو تعلمون علم اليقين",
      "aya_indic": "٥",
      "jozz": 30,
      "page": 600
    },
    {
      "sura": 102,
      "aya": 6,
      "text_uthmani": "لَتَرَوُنَّ اَ۬لْجَحِيمَ",
      "text_normalized": "لترون الجحيم",
      "aya_indic": "٦",
      "jozz": 30,
      "page": 600
    },
    {
      "sura": 102,
      "aya": 7,
      "text_uthmani": "ثُمَّ لَتَرَوُنَّهَا عَيْنَ اَ۬لْيَقِينِ",
      "text_normalized": "ثم لترونها عين اليقين",
      "aya_indic": "٧",
      "jozz": 30,
      "page": 600
    },
    {
      "sura": 102,
      "aya": 8,
      "text_uthmani": "ثُمَّ لَتُسْـَٔلُنَّ يَوْمَئِذٍ عَنِ اِ۬لنَّعِيمِۖ",
      "text_normalized": "ثم لتسلن يوميذ عن النعيم",
      "aya_indic": "٨",
      "jozz": 30,
      "page": 600
    }
  ]
}