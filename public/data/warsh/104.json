{
  "id": 104,
  "name_ar": "الهمزة",
  "name_en": "Al-Humazah",
  "type": "مكية",
  "ayahs_hafs": 9,
  "ayahs_warsh": 9,
  "page": 601,
  "narration": "warsh",
  "narration_ar": "ورش عن نافع",
  "ayahs": [
    {
      "sura": 104,
      "aya": 1,
      "text_uthmani": "وَيْلٞ لِّكُلِّ هُمَزَةٖ لُّمَزَةٍ",
      "text_normalized": "ويل لكل همزه لمزه",
      "aya_indic": "١",
      "jozz": 30,
      "page": 601
    },
    {
      "sura": 104,
      "aya": 2,
      "text_uthmani": "اِ۬لذِے جَمَعَ مَالاٗ وَعَدَّدَهُۥ",
      "text_normalized": "الذے جمع مالا وعدده",
      "aya_indic": "٢",
      "jozz": 30,
      "page": 601
    },
    {
      "sura": 104,
      "aya": 3,
      "text_uthmani": "يَحْسِبُ أَنَّ مَالَهُۥٓ أَخْلَدَهُۥ",
      "text_normalized": "يحسب ان ماله اخلده",
      "aya_indic": "٣",
      "jozz": 30,
      "page": 601
    },
    {
      "sura": 104,
      "aya": 4,
      "text_uthmani": "كَلَّاۖ لَيُنۢبَذَنَّ فِے اِ۬لْحُطَمَةِۖ",
      "text_normalized": "كلا لينبذن فے الحطمه",
      "aya_indic": "٤",
      "jozz": 30,
      "page": 601
    },
    {
      "sura": 104,
      "aya": 5,
      "text_uthmani": "وَمَآ أَدْر۪يٰكَ مَا اَ۬لْحُطَمَةُۖ",
      "text_normalized": "وما ادرياك ما الحطمه",
      "aya_indic": "٥",
      "jozz": 30,
      "page": 601
    },
    {
      "sura": 104,
      "aya": 6,
      "text_uthmani": "نَارُ اُ۬للَّهِ اِ۬لْمُوقَدَةُ",
      "text_normalized": "نار الله الموقده",
      "aya_indic": "٦",
      "jozz": 30,
      "page": 601
    },
    {
      "sura": 104,
      "aya": 7,
      "text_uthmani": "اُ۬لتِے تَطَّلِعُ عَلَى اَ۬لَافْـِٕدَةِۖ",
      "text_normalized": "التے تطلع علي الافده",
      "aya_indic": "٧",
      "jozz": 30,
      "page": 601
    },
    {
      "sura": 104,
      "aya": 8,
      "text_uthmani": "إِنَّهَا عَلَيْهِم مُّوصَدَةٞ",
      "text_normalized": "انها عليهم موصده",
      "aya_indic": "٨",
      "jozz": 30,
      "page": 601
    },
    {
      "sura": 104,
      "aya": 9,
      "text_uthmani": "فِے عَمَدٖ مُّمَدَّدَةٍۖ",
      "text_normalized": "فے عمد ممدده",
      "aya_indic": "٩",
      "jozz": 30,
      "page": 601
    }
  ]
}