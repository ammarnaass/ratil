{
  "id": 79,
  "name_ar": "النازعات",
  "name_en": "An-Nazi'at",
  "type": "مكية",
  "ayahs_hafs": 46,
  "ayahs_warsh": 45,
  "page": 583,
  "narration": "warsh",
  "narration_ar": "ورش عن نافع",
  "ayahs": [
    {
      "sura": 79,
      "aya": 1,
      "text_uthmani": "وَالنَّٰزِعَٰتِ غَرْقاٗ",
      "text_normalized": "والنازعات غرقا",
      "aya_indic": "١",
      "jozz": 30,
      "page": 583
    },
    {
      "sura": 79,
      "aya": 2,
      "text_uthmani": "وَالنَّٰشِطَٰتِ نَشْطاٗ",
      "text_normalized": "والناشطات نشطا",
      "aya_indic": "٢",
      "jozz": 30,
      "page": 583
    },
    {
      "sura": 79,
      "aya": 3,
      "text_uthmani": "وَالسَّٰبِحَٰتِ سَبْحاٗ",
      "text_normalized": "والسابحات سبحا",
      "aya_indic": "٣",
      "jozz": 30,
      "page": 583
    },
    {
      "sura": 79,
      "aya": 4,
      "text_uthmani": "فَالسَّٰبِقَٰتِ سَبْقاٗ",
      "text_normalized": "فالسابقات سبقا",
      "aya_indic": "٤",
      "jozz": 30,
      "page": 583
    },
    {
      "sura": 79,
      "aya": 5,
      "text_uthmani": "فَالْمُدَبِّرَٰتِ أَمْراٗ",
      "text_normalized": "فالمدبرات امرا",
      "aya_indic": "٥",
      "jozz": 30,
      "page": 583
    },
    {
      "sura": 79,
      "aya": 6,
      "text_uthmani": "يَوْمَ تَرْجُفُ اُ۬لرَّاجِفَةُ",
      "text_normalized": "يوم ترجف الراجفه",
      "aya_indic": "٦",
      "jozz": 30,
      "page": 583
    },
    {
      "sura": 79,
      "aya": 7,
      "text_uthmani": "تَتْبَعُهَا اَ۬لرَّادِفَةُۖ",
      "text_normalized": "تتبعها الرادفه",
      "aya_indic": "٧",
      "jozz": 30,
      "page": 583
    },
    {
      "sura": 79,
      "aya": 8,
      "text_uthmani": "قُلُوبٞ يَوْمَئِذٖ وَاجِفَةٌ",
      "text_normalized": "قلوب يوميذ واجفه",
      "aya_indic": "٨",
      "jozz": 30,
      "page": 583
    },
    {
      "sura": 79,
      "aya": 9,
      "text_uthmani": "اَبْصَٰرُهَا خَٰشِعَةٞۖ",
      "text_normalized": "ابصارها خاشعه",
      "aya_indic": "٩",
      "jozz": 30,
      "page": 583
    },
    {
      "sura": 79,
      "aya": 10,
      "text_uthmani": "يَقُولُونَ أَ۟نَّا لَمَرْدُودُونَ فِے اِ۬لْحَافِرَةِ",
      "text_normalized": "يقولون انا لمردودون فے الحافره",
      "aya_indic": "١٠",
      "jozz": 30,
      "page": 583
    },
    {
      "sura": 79,
      "aya": 11,
      "text_uthmani": "إِذَا كُنَّا عِظَٰماٗ نَّخِرَةٗۖ",
      "text_normalized": "اذا كنا عظاما نخره",
      "aya_indic": "١١",
      "jozz": 30,
      "page": 583
    },
    {
      "sura": 79,
      "aya": 12,
      "text_uthmani": "قَالُواْ تِلْكَ إِذاٗ كَرَّةٌ خَاسِرَةٞ",
      "text_normalized": "قالوا تلك اذا كره خاسره",
      "aya_indic": "١٢",
      "jozz": 30,
      "page": 583
    },
    {
      "sura": 79,
      "aya": 13,
      "text_uthmani": "فَإِنَّمَا هِيَ زَجْرَةٞ وَٰحِدَةٞ",
      "text_normalized": "فانما هي زجره واحده",
      "aya_indic": "١٣",
      "jozz": 30,
      "page": 583
    },
    {
      "sura": 79,
      "aya": 14,
      "text_uthmani": "فَإِذَا هُم بِالسَّاهِرَةِۖ",
      "text_normalized": "فاذا هم بالساهره",
      "aya_indic": "١٤",
      "jozz": 30,
      "page": 583
    },
    {
      "sura": 79,
      "aya": 15,
      "text_uthmani": "هَلَ اَت۪يٰكَ حَدِيثُ مُوس۪ىٰٓ",
      "text_normalized": "هل اتياك حديث موسيا",
      "aya_indic": "١٥",
      "jozz": 30,
      "page": 583
    },
    {
      "sura": 79,
      "aya": 16,
      "text_uthmani": "إِذْ نَاد۪يٰهُ رَبُّهُۥ بِالْوَادِ اِ۬لْمُقَدَّسِ طُوَىۖ",
      "text_normalized": "اذ نادياه ربه بالواد المقدس طوي",
      "aya_indic": "١٦",
      "jozz": 30,
      "page": 583
    },
    {
      "sura": 79,
      "aya": 17,
      "text_uthmani": "اَ۪ذْهَبِ اِلَىٰ فِرْعَوْنَ إِنَّهُۥ طَغ۪ىٰ",
      "text_normalized": "اذهب اليا فرعون انه طغيا",
      "aya_indic": "١٧",
      "jozz": 30,
      "page": 584
    },
    {
      "sura": 79,
      "aya": 18,
      "text_uthmani": "فَقُلْ هَل لَّكَ إِلَىٰٓ أَن تَزَّكّ۪ىٰ",
      "text_normalized": "فقل هل لك اليا ان تزكيا",
      "aya_indic": "١٨",
      "jozz": 30,
      "page": 584
    },
    {
      "sura": 79,
      "aya": 19,
      "text_uthmani": "وَأَهْدِيَكَ إِلَىٰ رَبِّكَ فَتَخْش۪ىٰۖ",
      "text_normalized": "واهديك اليا ربك فتخشيا",
      "aya_indic": "١٩",
      "jozz": 30,
      "page": 584
    },
    {
      "sura": 79,
      "aya": 20,
      "text_uthmani": "فَأَر۪يٰهُ اُ۬لَايَةَ اَ۬لْكُبْر۪ىٰ",
      "text_normalized": "فارياه الايه الكبريا",
      "aya_indic": "٢٠",
      "jozz": 30,
      "page": 584
    },
    {
      "sura": 79,
      "aya": 21,
      "text_uthmani": "فَكَذَّبَ وَعَص۪ىٰ",
      "text_normalized": "فكذب وعصيا",
      "aya_indic": "٢١",
      "jozz": 30,
      "page": 584
    },
    {
      "sura": 79,
      "aya": 22,
      "text_uthmani": "ثُمَّ أَدْبَرَ يَسْع۪ىٰ",
      "text_normalized": "ثم ادبر يسعيا",
      "aya_indic": "٢٢",
      "jozz": 30,
      "page": 584
    },
    {
      "sura": 79,
      "aya": 23,
      "text_uthmani": "فَحَشَرَ فَنَاد۪ىٰ",
      "text_normalized": "فحشر فناديا",
      "aya_indic": "٢٣",
      "jozz": 30,
      "page": 584
    },
    {
      "sura": 79,
      "aya": 24,
      "text_uthmani": "فَقَالَ أَنَا رَبُّكُمُ اُ۬لَاعْل۪ىٰ",
      "text_normalized": "فقال انا ربكم الاعليا",
      "aya_indic": "٢٤",
      "jozz": 30,
      "page": 584
    },
    {
      "sura": 79,
      "aya": 25,
      "text_uthmani": "فَأَخَذَهُ اُ۬للَّهُ نَكَالَ اَ۬لَاخِرَةِ وَالُاول۪ىٰٓۖ",
      "text_normalized": "فاخذه الله نكال الاخره والاوليا",
      "aya_indic": "٢٥",
      "jozz": 30,
      "page": 584
    },
    {
      "sura": 79,
      "aya": 26,
      "text_uthmani": "إِنَّ فِے ذَٰلِكَ لَعِبْرَةٗ لِّمَنْ يَّخْش۪ىٰٓۖ",
      "text_normalized": "ان فے ذلك لعبره لمن يخشيا",
      "aya_indic": "٢٦",
      "jozz": 30,
      "page": 584
    },
    {
      "sura": 79,
      "aya": 27,
      "text_uthmani": "ءَآنتُمُۥٓ أَشَدُّ خَلْقاً اَمِ اِ۬لسَّمَآءُۖ بَنَيٰهَا",
      "text_normalized": "ءانتم اشد خلقا ام السماء بنياها",
      "aya_indic": "٢٧",
      "jozz": 30,
      "page": 584
    },
    {
      "sura": 79,
      "aya": 28,
      "text_uthmani": "رَفَعَ سَمْكَهَا فَسَوَّيٰهَا",
      "text_normalized": "رفع سمكها فسوياها",
      "aya_indic": "٢٨",
      "jozz": 30,
      "page": 584
    },
    {
      "sura": 79,
      "aya": 29,
      "text_uthmani": "وَأَغْطَشَ لَيْلَهَا وَأَخْرَجَ ضُحَيٰهَاۖ",
      "text_normalized": "واغطش ليلها واخرج ضحياها",
      "aya_indic": "٢٩",
      "jozz": 30,
      "page": 584
    },
    {
      "sura": 79,
      "aya": 30,
      "text_uthmani": "وَالَارْضَ بَعْدَ ذَٰلِكَ دَحَيٰهَآ",
      "text_normalized": "والارض بعد ذلك دحياها",
      "aya_indic": "٣٠",
      "jozz": 30,
      "page": 584
    },
    {
      "sura": 79,
      "aya": 31,
      "text_uthmani": "أَخْرَجَ مِنْهَا مَآءَهَا وَمَرْعَيٰهَا",
      "text_normalized": "اخرج منها ماءها ومرعياها",
      "aya_indic": "٣١",
      "jozz": 30,
      "page": 584
    },
    {
      "sura": 79,
      "aya": 32,
      "text_uthmani": "وَالْجِبَالَ أَرْسَيٰهَا",
      "text_normalized": "والجبال ارسياها",
      "aya_indic": "٣٢",
      "jozz": 30,
      "page": 584
    },
    {
      "sura": 79,
      "aya": 33,
      "text_uthmani": "مَتَٰعاٗ لَّكُمْ وَلِأَنْعَٰمِكُمْۖ",
      "text_normalized": "متاعا لكم ولانعامكم",
      "aya_indic": "٣٣",
      "jozz": 30,
      "page": 584
    },
    {
      "sura": 79,
      "aya": 34,
      "text_uthmani": "فَإِذَا جَآءَتِ اِ۬لطَّآمَّةُ اُ۬لْكُبْر۪ىٰ",
      "text_normalized": "فاذا جاءت الطامه الكبريا",
      "aya_indic": "٣٤",
      "jozz": 30,
      "page": 584
    },
    {
      "sura": 79,
      "aya": 35,
      "text_uthmani": "يَوْمَ يَتَذَكَّرُ اُ۬لِانسَٰنُ مَا سَع۪ىٰ",
      "text_normalized": "يوم يتذكر الانسان ما سعيا",
      "aya_indic": "٣٥",
      "jozz": 30,
      "page": 584
    },
    {
      "sura": 79,
      "aya": 36,
      "text_uthmani": "وَبُرِّزَتِ اِ۬لْجَحِيمُ لِمَنْ يَّر۪ىٰۖ",
      "text_normalized": "وبرزت الجحيم لمن يريا",
      "aya_indic": "٣٦",
      "jozz": 30,
      "page": 584
    },
    {
      "sura": 79,
      "aya": 37,
      "text_uthmani": "فَأَمَّا مَن طَغ۪ىٰ وَءَاثَرَ اَ۬لْحَيَوٰةَ اَ۬لدُّنْي۪ا",
      "text_normalized": "فاما من طغيا وءاثر الحياه الدنيا",
      "aya_indic": "٣٧",
      "jozz": 30,
      "page": 584
    },
    {
      "sura": 79,
      "aya": 38,
      "text_uthmani": "فَإِنَّ اَ۬لْجَحِيمَ هِيَ اَ۬لْمَأْو۪ىٰۖ",
      "text_normalized": "فان الجحيم هي الماويا",
      "aya_indic": "٣٨",
      "jozz": 30,
      "page": 584
    },
    {
      "sura": 79,
      "aya": 39,
      "text_uthmani": "وَأَمَّا مَنْ خَافَ مَقَامَ رَبِّهِۦ وَنَهَى اَ۬لنَّفْسَ عَنِ اِ۬لْهَو۪ىٰ",
      "text_normalized": "واما من خاف مقام ربه ونهي النفس عن الهويا",
      "aya_indic": "٣٩",
      "jozz": 30,
      "page": 584
    },
    {
      "sura": 79,
      "aya": 40,
      "text_uthmani": "فَإِنَّ اَ۬لْجَنَّةَ هِيَ اَ۬لْمَأْو۪ىٰۖ",
      "text_normalized": "فان الجنه هي الماويا",
      "aya_indic": "٤٠",
      "jozz": 30,
      "page": 584
    },
    {
      "sura": 79,
      "aya": 41,
      "text_uthmani": "۞ يَسْـَٔلُونَكَ عَنِ اِ۬لسَّاعَةِ أَيَّانَ مُرْسَيٰهَاۖ",
      "text_normalized": "يسلونك عن الساعه ايان مرسياها",
      "aya_indic": "٤١",
      "jozz": 30,
      "page": 584
    },
    {
      "sura": 79,
      "aya": 42,
      "text_uthmani": "فِيمَ أَنتَ مِن ذِكْر۪يٰهَآۖ",
      "text_normalized": "فيم انت من ذكرياها",
      "aya_indic": "٤٢",
      "jozz": 30,
      "page": 584
    },
    {
      "sura": 79,
      "aya": 43,
      "text_uthmani": "إِلَىٰ رَبِّكَ مُنتَهَيٰهَآۖ",
      "text_normalized": "اليا ربك منتهياها",
      "aya_indic": "٤٣",
      "jozz": 30,
      "page": 584
    },
    {
      "sura": 79,
      "aya": 44,
      "text_uthmani": "إِنَّمَآ أَنتَ مُنذِرُ مَنْ يَّخْشَيٰهَاۖ",
      "text_normalized": "انما انت منذر من يخشياها",
      "aya_indic": "٤٤",
      "jozz": 30,
      "page": 584
    },
    {
      "sura": 79,
      "aya": 45,
      "text_uthmani": "كَأَنَّهُمْ يَوْمَ يَرَوْنَهَا لَمْ يَلْبَثُوٓاْ إِلَّا عَشِيَّةً اَوْ ضُحَيٰهَاۖ",
      "text_normalized": "كانهم يوم يرونها لم يلبثوا الا عشيه او ضحياها",
      "aya_indic": "٤٥",
      "jozz": 30,
      "page": 584
    }
  ]
}