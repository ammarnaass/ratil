{
  "id": 91,
  "name_ar": "الشمس",
  "name_en": "Ash-Shams",
  "type": "مكية",
  "ayahs_hafs": 15,
  "ayahs_warsh": 15,
  "page": 595,
  "narration": "warsh",
  "narration_ar": "ورش عن نافع",
  "ayahs": [
    {
      "sura": 91,
      "aya": 1,
      "text_uthmani": "وَالشَّمْسِ وَضُحَيٰهَا",
      "text_normalized": "والشمس وضحياها",
      "aya_indic": "١",
      "jozz": 30,
      "page": 595
    },
    {
      "sura": 91,
      "aya": 2,
      "text_uthmani": "وَالْقَمَرِ إِذَا تَلَيٰهَا",
      "text_normalized": "والقمر اذا تلياها",
      "aya_indic": "٢",
      "jozz": 30,
      "page": 595
    },
    {
      "sura": 91,
      "aya": 3,
      "text_uthmani": "وَالنَّه۪ارِ إِذَا جَلَّيٰهَا",
      "text_normalized": "والنهار اذا جلياها",
      "aya_indic": "٣",
      "jozz": 30,
      "page": 595
    },
    {
      "sura": 91,
      "aya": 4,
      "text_uthmani": "وَاليْلِ إِذَا يَغْشَيٰهَا",
      "text_normalized": "واليل اذا يغشياها",
      "aya_indic": "٤",
      "jozz": 30,
      "page": 595
    },
    {
      "sura": 91,
      "aya": 5,
      "text_uthmani": "وَالسَّمَآءِ وَمَا بَنَيٰهَا",
      "text_normalized": "والسماء وما بنياها",
      "aya_indic": "٥",
      "jozz": 30,
      "page": 595
    },
    {
      "sura": 91,
      "aya": 6,
      "text_uthmani": "وَالَارْضِ وَمَا طَحَيٰهَا",
      "text_normalized": "والارض وما طحياها",
      "aya_indic": "٦",
      "jozz": 30,
      "page": 595
    },
    {
      "sura": 91,
      "aya": 7,
      "text_uthmani": "وَنَفْسٖ وَمَا سَوَّيٰهَا",
      "text_normalized": "ونفس وما سوياها",
      "aya_indic": "٧",
      "jozz": 30,
      "page": 595
    },
    {
      "sura": 91,
      "aya": 8,
      "text_uthmani": "فَأَلْهَمَهَا فُجُورَهَا وَتَقْوَيٰهَا",
      "text_normalized": "فالهمها فجورها وتقوياها",
      "aya_indic": "٨",
      "jozz": 30,
      "page": 595
    },
    {
      "sura": 91,
      "aya": 9,
      "text_uthmani": "قَدَ اَفْلَحَ مَن زَكَّيٰهَا",
      "text_normalized": "قد افلح من زكياها",
      "aya_indic": "٩",
      "jozz": 30,
      "page": 595
    },
    {
      "sura": 91,
      "aya": 10,
      "text_uthmani": "وَقَدْ خَابَ مَن دَسَّيٰهَاۖ",
      "text_normalized": "وقد خاب من دسياها",
      "aya_indic": "١٠",
      "jozz": 30,
      "page": 595
    },
    {
      "sura": 91,
      "aya": 11,
      "text_uthmani": "كَذَّبَتْ ثَمُودُ بِطَغْوَيٰهَآ",
      "text_normalized": "كذبت ثمود بطغوياها",
      "aya_indic": "١١",
      "jozz": 30,
      "page": 595
    },
    {
      "sura": 91,
      "aya": 12,
      "text_uthmani": "إِذِ اِ۪نۢبَعَثَ أَشْقَيٰهَا",
      "text_normalized": "اذ انبعث اشقياها",
      "aya_indic": "١٢",
      "jozz": 30,
      "page": 595
    },
    {
      "sura": 91,
      "aya": 13,
      "text_uthmani": "فَقَالَ لَهُمْ رَسُولُ اُ۬للَّهِ نَاقَةَ اَ۬للَّهِ وَسُقْيَاهَا",
      "text_normalized": "فقال لهم رسول الله ناقه الله وسقياها",
      "aya_indic": "١٣",
      "jozz": 30,
      "page": 595
    },
    {
      "sura": 91,
      "aya": 14,
      "text_uthmani": "فَكَذَّبُوهُ فَعَقَرُوهَا فَدَمْدَمَ عَلَيْهِمْ رَبُّهُم بِذَنۢبِهِمْ فَسَوَّيٰهَاۖ",
      "text_normalized": "فكذبوه فعقروها فدمدم عليهم ربهم بذنبهم فسوياها",
      "aya_indic": "١٤",
      "jozz": 30,
      "page": 595
    },
    {
      "sura": 91,
      "aya": 15,
      "text_uthmani": "فَلَا يَخَافُ عُقْبَٰهَاۖ",
      "text_normalized": "فلا يخاف عقباها",
      "aya_indic": "١٥",
      "jozz": 30,
      "page": 595
    }
  ]
}