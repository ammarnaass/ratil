{
  "id": 111,
  "name_ar": "المسد",
  "name_en": "Al-Masad",
  "type": "مكية",
  "ayahs_hafs": 5,
  "ayahs_warsh": 5,
  "page": 603,
  "narration": "warsh",
  "narration_ar": "ورش عن نافع",
  "ayahs": [
    {
      "sura": 111,
      "aya": 1,
      "text_uthmani": "تَبَّتْ يَدَآ أَبِے لَهَبٖ وَتَبَّۖ",
      "text_normalized": "تبت يدا ابے لهب وتب",
      "aya_indic": "١",
      "jozz": 30,
      "page": 603
    },
    {
      "sura": 111,
      "aya": 2,
      "text_uthmani": "مَآ أَغْن۪ىٰ عَنْهُ مَالُهُۥ وَمَا كَسَبَۖ",
      "text_normalized": "ما اغنيا عنه ماله وما كسب",
      "aya_indic": "٢",
      "jozz": 30,
      "page": 603
    },
    {
      "sura": 111,
      "aya": 3,
      "text_uthmani": "سَيَصْلَىٰ نَاراٗ ذَاتَ لَهَبٖ",
      "text_normalized": "سيصليا نارا ذات لهب",
      "aya_indic": "٣",
      "jozz": 30,
      "page": 603
    },
    {
      "sura": 111,
      "aya": 4,
      "text_uthmani": "وَامْرَأَتُهُۥۖ حَمَّالَةُ اُ۬لْحَطَبِ",
      "text_normalized": "وامراته حماله الحطب",
      "aya_indic": "٤",
      "jozz": 30,
      "page": 603
    },
    {
      "sura": 111,
      "aya": 5,
      "text_uthmani": "فِے جِيدِهَا حَبْلٞ مِّن مَّسَدٖۖ",
      "text_normalized": "فے جيدها حبل من مسد",
      "aya_indic": "٥",
      "jozz": 30,
      "page": 603
    }
  ]
}