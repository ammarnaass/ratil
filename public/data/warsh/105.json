{
  "id": 105,
  "name_ar": "الفيل",
  "name_en": "Al-Fil",
  "type": "مكية",
  "ayahs_hafs": 5,
  "ayahs_warsh": 5,
  "page": 601,
  "narration": "warsh",
  "narration_ar": "ورش عن نافع",
  "ayahs": [
    {
      "sura": 105,
      "aya": 1,
      "text_uthmani": "اَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِأَصْحَٰبِ اِ۬لْفِيلِۖ",
      "text_normalized": "الم تر كيف فعل ربك باصحاب الفيل",
      "aya_indic": "١",
      "jozz": 30,
      "page": 601
    },
    {
      "sura": 105,
      "aya": 2,
      "text_uthmani": "أَلَمْ يَجْعَلْ كَيْدَهُمْ فِے تَضْلِيلٖ",
      "text_normalized": "الم يجعل كيدهم فے تضليل",
      "aya_indic": "٢",
      "jozz": 30,
      "page": 601
    },
    {
      "sura": 105,
      "aya": 3,
      "text_uthmani": "وَأَرْسَلَ عَلَيْهِمْ طَيْراً اَبَابِيلَ",
      "text_normalized": "وارسل عليهم طيرا ابابيل",
      "aya_indic": "٣",
      "jozz": 30,
      "page": 601
    },
    {
      "sura": 105,
      "aya": 4,
      "text_uthmani": "تَرْمِيهِم بِحِجَارَةٖ مِّن سِجِّيلٖ",
      "text_normalized": "ترميهم بحجاره من سجيل",
      "aya_indic": "٤",
      "jozz": 30,
      "page": 601
    },
    {
      "sura": 105,
      "aya": 5,
      "text_uthmani": "فَجَعَلَهُمْ كَعَصْفٖ مَّاكُولٖۖ",
      "text_normalized": "فجعلهم كعصف ماكول",
      "aya_indic": "٥",
      "jozz": 30,
      "page": 601
    }
  ]
}