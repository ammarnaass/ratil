{
  "id": 78,
  "name_ar": "النبأ",
  "name_en": "An-Naba'",
  "type": "مكية",
  "ayahs_hafs": 40,
  "ayahs_warsh": 41,
  "page": 582,
  "narration": "warsh",
  "narration_ar": "ورش عن نافع",
  "ayahs": [
    {
      "sura": 78,
      "aya": 1,
      "text_uthmani": "عَمَّۖ يَتَسَآءَلُونَ",
      "text_normalized": "عم يتساءلون",
      "aya_indic": "١",
      "jozz": 30,
      "page": 582
    },
    {
      "sura": 78,
      "aya": 2,
      "text_uthmani": "عَنِ اِ۬لنَّبَإِ اِ۬لْعَظِيمِ",
      "text_normalized": "عن النبا العظيم",
      "aya_indic": "٢",
      "jozz": 30,
      "page": 582
    },
    {
      "sura": 78,
      "aya": 3,
      "text_uthmani": "اِ۬لذِے هُمْ فِيهِ مُخْتَلِفُونَۖ",
      "text_normalized": "الذے هم فيه مختلفون",
      "aya_indic": "٣",
      "jozz": 30,
      "page": 582
    },
    {
      "sura": 78,
      "aya": 4,
      "text_uthmani": "كَلَّا سَيَعْلَمُونَ",
      "text_normalized": "كلا سيعلمون",
      "aya_indic": "٤",
      "jozz": 30,
      "page": 582
    },
    {
      "sura": 78,
      "aya": 5,
      "text_uthmani": "ثُمَّ كَلَّا سَيَعْلَمُونَۖ",
      "text_normalized": "ثم كلا سيعلمون",
      "aya_indic": "٥",
      "jozz": 30,
      "page": 582
    },
    {
      "sura": 78,
      "aya": 6,
      "text_uthmani": "أَلَمْ نَجْعَلِ اِ۬لَارْضَ مِهَٰداٗ",
      "text_normalized": "الم نجعل الارض مهادا",
      "aya_indic": "٦",
      "jozz": 30,
      "page": 582
    },
    {
      "sura": 78,
      "aya": 7,
      "text_uthmani": "وَالْجِبَالَ أَوْتَاداٗ",
      "text_normalized": "والجبال اوتادا",
      "aya_indic": "٧",
      "jozz": 30,
      "page": 582
    },
    {
      "sura": 78,
      "aya": 8,
      "text_uthmani": "وَخَلَقْنَٰكُمُۥٓ أَزْوَٰجاٗ",
      "text_normalized": "وخلقناكم ازواجا",
      "aya_indic": "٨",
      "jozz": 30,
      "page": 582
    },
    {
      "sura": 78,
      "aya": 9,
      "text_uthmani": "وَجَعَلْنَا نَوْمَكُمْ سُبَاتاٗ",
      "text_normalized": "وجعلنا نومكم سباتا",
      "aya_indic": "٩",
      "jozz": 30,
      "page": 582
    },
    {
      "sura": 78,
      "aya": 10,
      "text_uthmani": "وَجَعَلْنَا اَ۬ليْلَ لِبَاساٗ",
      "text_normalized": "وجعلنا اليل لباسا",
      "aya_indic": "١٠",
      "jozz": 30,
      "page": 582
    },
    {
      "sura": 78,
      "aya": 11,
      "text_uthmani": "وَجَعَلْنَا اَ۬لنَّهَارَ مَعَاشاٗ",
      "text_normalized": "وجعلنا النهار معاشا",
      "aya_indic": "١١",
      "jozz": 30,
      "page": 582
    },
    {
      "sura": 78,
      "aya": 12,
      "text_uthmani": "وَبَنَيْنَا فَوْقَكُمْ سَبْعاٗ شِدَاداٗ",
      "text_normalized": "وبنينا فوقكم سبعا شدادا",
      "aya_indic": "١٢",
      "jozz": 30,
      "page": 582
    },
    {
      "sura": 78,
      "aya": 13,
      "text_uthmani": "وَجَعَلْنَا سِرَاجاٗ وَهَّاجاٗ",
      "text_normalized": "وجعلنا سراجا وهاجا",
      "aya_indic": "١٣",
      "jozz": 30,
      "page": 582
    },
    {
      "sura": 78,
      "aya": 14,
      "text_uthmani": "وَأَنزَلْنَا مِنَ اَ۬لْمُعْصِرَٰتِ مَآءٗ ثَجَّاجاٗ",
      "text_normalized": "وانزلنا من المعصرات ماء ثجاجا",
      "aya_indic": "١٤",
      "jozz": 30,
      "page": 582
    },
    {
      "sura": 78,
      "aya": 15,
      "text_uthmani": "لِّنُخْرِجَ بِهِۦ حَبّاٗ وَنَبَاتاٗ",
      "text_normalized": "لنخرج به حبا ونباتا",
      "aya_indic": "١٥",
      "jozz": 30,
      "page": 582
    },
    {
      "sura": 78,
      "aya": 16,
      "text_uthmani": "وَجَنَّٰتٍ اَلْفَافاًۖ",
      "text_normalized": "وجنات الفافا",
      "aya_indic": "١٦",
      "jozz": 30,
      "page": 582
    },
    {
      "sura": 78,
      "aya": 17,
      "text_uthmani": "اِنَّ يَوْمَ اَ۬لْفَصْلِ كَانَ مِيقَٰتاٗ",
      "text_normalized": "ان يوم الفصل كان ميقاتا",
      "aya_indic": "١٧",
      "jozz": 30,
      "page": 582
    },
    {
      "sura": 78,
      "aya": 18,
      "text_uthmani": "يَوْمَ يُنفَخُ فِے اِ۬لصُّورِ فَتَاتُونَ أَفْوَاجاٗ",
      "text_normalized": "يوم ينفخ فے الصور فتاتون افواجا",
      "aya_indic": "١٨",
      "jozz": 30,
      "page": 582
    },
    {
      "sura": 78,
      "aya": 19,
      "text_uthmani": "وَفُتِّحَتِ اِ۬لسَّمَآءُ فَكَانَتَ اَبْوَٰباٗ",
      "text_normalized": "وفتحت السماء فكانت ابوابا",
      "aya_indic": "١٩",
      "jozz": 30,
      "page": 582
    },
    {
      "sura": 78,
      "aya": 20,
      "text_uthmani": "وَسُيِّرَتِ اِ۬لْجِبَالُ فَكَانَتْ سَرَاباًۖ",
      "text_normalized": "وسيرت الجبال فكانت سرابا",
      "aya_indic": "٢٠",
      "jozz": 30,
      "page": 582
    },
    {
      "sura": 78,
      "aya": 21,
      "text_uthmani": "اِنَّ جَهَنَّمَ كَانَتْ مِرْصَاداٗ",
      "text_normalized": "ان جهنم كانت مرصادا",
      "aya_indic": "٢١",
      "jozz": 30,
      "page": 582
    },
    {
      "sura": 78,
      "aya": 22,
      "text_uthmani": "لِّلطَّٰغِينَ مَـَٔاباٗ",
      "text_normalized": "للطاغين مابا",
      "aya_indic": "٢٢",
      "jozz": 30,
      "page": 582
    },
    {
      "sura": 78,
      "aya": 23,
      "text_uthmani": "لَّٰبِثِينَ فِيهَآ أَحْقَاباٗۖ",
      "text_normalized": "لابثين فيها احقابا",
      "aya_indic": "٢٣",
      "jozz": 30,
      "page": 582
    },
    {
      "sura": 78,
      "aya": 24,
      "text_uthmani": "لَّا يَذُوقُونَ فِيهَا بَرْداٗ وَلَا شَرَاباً",
      "text_normalized": "لا يذوقون فيها بردا ولا شرابا",
      "aya_indic": "٢٤",
      "jozz": 30,
      "page": 582
    },
    {
      "sura": 78,
      "aya": 25,
      "text_uthmani": "اِلَّا حَمِيماٗ وَغَسَاقاٗ",
      "text_normalized": "الا حميما وغساقا",
      "aya_indic": "٢٥",
      "jozz": 30,
      "page": 582
    },
    {
      "sura": 78,
      "aya": 26,
      "text_uthmani": "جَزَآءٗ وِفَاقاًۖ",
      "text_normalized": "جزاء وفاقا",
      "aya_indic": "٢٦",
      "jozz": 30,
      "page": 582
    },
    {
      "sura": 78,
      "aya": 27,
      "text_uthmani": "اِنَّهُمْ كَانُواْ لَا يَرْجُونَ حِسَاباٗ",
      "text_normalized": "انهم كانوا لا يرجون حسابا",
      "aya_indic": "٢٧",
      "jozz": 30,
      "page": 582
    },
    {
      "sura": 78,
      "aya": 28,
      "text_uthmani": "وَكَذَّبُواْ بِـَٔايَٰتِنَا كِذَّاباٗۖ",
      "text_normalized": "وكذبوا باياتنا كذابا",
      "aya_indic": "٢٨",
      "jozz": 30,
      "page": 582
    },
    {
      "sura": 78,
      "aya": 29,
      "text_uthmani": "وَكُلَّ شَےْءٍ اَحْصَيْنَٰهُ كِتَٰباٗۖ",
      "text_normalized": "وكل شےء احصيناه كتابا",
      "aya_indic": "٢٩",
      "jozz": 30,
      "page": 582
    },
    {
      "sura": 78,
      "aya": 30,
      "text_uthmani": "فَذُوقُواْ فَلَن نَّزِيدَكُمُۥٓ إِلَّا عَذَاباًۖ",
      "text_normalized": "فذوقوا فلن نزيدكم الا عذابا",
      "aya_indic": "٣٠",
      "jozz": 30,
      "page": 582
    },
    {
      "sura": 78,
      "aya": 31,
      "text_uthmani": "اِنَّ لِلْمُتَّقِينَ مَفَازاً",
      "text_normalized": "ان للمتقين مفازا",
      "aya_indic": "٣١",
      "jozz": 30,
      "page": 583
    },
    {
      "sura": 78,
      "aya": 32,
      "text_uthmani": "حَدَآئِقَ وَأَعْنَٰباٗ",
      "text_normalized": "حدايق واعنابا",
      "aya_indic": "٣٢",
      "jozz": 30,
      "page": 583
    },
    {
      "sura": 78,
      "aya": 33,
      "text_uthmani": "وَكَوَاعِبَ أَتْرَاباٗ",
      "text_normalized": "وكواعب اترابا",
      "aya_indic": "٣٣",
      "jozz": 30,
      "page": 583
    },
    {
      "sura": 78,
      "aya": 34,
      "text_uthmani": "وَكَأْساٗ دِهَاقاٗ",
      "text_normalized": "وكاسا دهاقا",
      "aya_indic": "٣٤",
      "jozz": 30,
      "page": 583
    },
    {
      "sura": 78,
      "aya": 35,
      "text_uthmani": "لَّا يَسْمَعُونَ فِيهَا لَغْواٗ وَلَا كِذَّاباٗۖ",
      "text_normalized": "لا يسمعون فيها لغوا ولا كذابا",
      "aya_indic": "٣٥",
      "jozz": 30,
      "page": 583
    },
    {
      "sura": 78,
      "aya": 36,
      "text_uthmani": "جَزَآءٗ مِّن رَّبِّكَ عَطَآءً حِسَاباٗۖ",
      "text_normalized": "جزاء من ربك عطاء حسابا",
      "aya_indic": "٣٦",
      "jozz": 30,
      "page": 583
    },
    {
      "sura": 78,
      "aya": 37,
      "text_uthmani": "رَّبُّ اُ۬لسَّمَٰوَٰتِ وَالَارْضِ وَمَا بَيْنَهُمَاۖ اَ۬لرَّحْمَٰنُ لَا يَمْلِكُونَ مِنْهُ خِطَاباٗۖ",
      "text_normalized": "رب السماوات والارض وما بينهما الرحمن لا يملكون منه خطابا",
      "aya_indic": "٣٧",
      "jozz": 30,
      "page": 583
    },
    {
      "sura": 78,
      "aya": 38,
      "text_uthmani": "يَوْمَ يَقُومُ اُ۬لرُّوحُ وَالْمَلَٰٓئِكَةُ صَفّاٗ لَّا يَتَكَلَّمُونَ إِلَّا مَنَ اَذِنَ لَهُ اُ۬لرَّحْمَٰنُ وَقَالَ صَوَاباٗۖ",
      "text_normalized": "يوم يقوم الروح والملايكه صفا لا يتكلمون الا من اذن له الرحمن وقال صوابا",
      "aya_indic": "٣٨",
      "jozz": 30,
      "page": 583
    },
    {
      "sura": 78,
      "aya": 39,
      "text_uthmani": "ذَٰلِكَ اَ۬لْيَوْمُ اُ۬لْحَقُّۖ فَمَن شَآءَ اَ۪تَّخَذَ إِلَىٰ رَبِّهِۦ مَـَٔاباًۖ",
      "text_normalized": "ذلك اليوم الحق فمن شاء اتخذ اليا ربه مابا",
      "aya_indic": "٣٩",
      "jozz": 30,
      "page": 583
    },
    {
      "sura": 78,
      "aya": 40,
      "text_uthmani": "اِنَّآ أَنذَرْنَٰكُمْ عَذَاباٗ قَرِيباٗ يَوْمَ يَنظُرُ اُ۬لْمَرْءُ مَا قَدَّمَتْ يَدَٰهُ وَيَقُولُ اُ۬لْكَافِرُ يَٰلَيْتَنِے كُنتُ تُرَٰباٗۖ",
      "text_normalized": "انا انذرناكم عذابا قريبا يوم ينظر المرء ما قدمت يداه ويقول الكافر ياليتنے كنت ترابا",
      "aya_indic": "٤٠",
      "jozz": 30,
      "page": 583
    }
  ]
}