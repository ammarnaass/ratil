{
  "id": 81,
  "name_ar": "التكوير",
  "name_en": "At-Takwir",
  "type": "مكية",
  "ayahs_hafs": 29,
  "ayahs_warsh": 29,
  "page": 586,
  "narration": "warsh",
  "narration_ar": "ورش عن نافع",
  "ayahs": [
    {
      "sura": 81,
      "aya": 1,
      "text_uthmani": "إِذَا اَ۬لشَّمْسُ كُوِّرَتْ",
      "text_normalized": "اذا الشمس كورت",
      "aya_indic": "١",
      "jozz": 30,
      "page": 586
    },
    {
      "sura": 81,
      "aya": 2,
      "text_uthmani": "وَإِذَا اَ۬لنُّجُومُ اُ۪نكَدَرَتْ",
      "text_normalized": "واذا النجوم انكدرت",
      "aya_indic": "٢",
      "jozz": 30,
      "page": 586
    },
    {
      "sura": 81,
      "aya": 3,
      "text_uthmani": "وَإِذَا اَ۬لْجِبَالُ سُيِّرَتْ",
      "text_normalized": "واذا الجبال سيرت",
      "aya_indic": "٣",
      "jozz": 30,
      "page": 586
    },
    {
      "sura": 81,
      "aya": 4,
      "text_uthmani": "وَإِذَا اَ۬لْعِشَارُ عُطِّلَتْ",
      "text_normalized": "واذا العشار عطلت",
      "aya_indic": "٤",
      "jozz": 30,
      "page": 586
    },
    {
      "sura": 81,
      "aya": 5,
      "text_uthmani": "وَإِذَا اَ۬لْوُحُوشُ حُشِرَتْ",
      "text_normalized": "واذا الوحوش حشرت",
      "aya_indic": "٥",
      "jozz": 30,
      "page": 586
    },
    {
      "sura": 81,
      "aya": 6,
      "text_uthmani": "وَإِذَا اَ۬لْبِحَارُ سُجِّرَتْ",
      "text_normalized": "واذا البحار سجرت",
      "aya_indic": "٦",
      "jozz": 30,
      "page": 586
    },
    {
      "sura": 81,
      "aya": 7,
      "text_uthmani": "وَإِذَا اَ۬لنُّفُوسُ زُوِّجَتْ",
      "text_normalized": "واذا النفوس زوجت",
      "aya_indic": "٧",
      "jozz": 30,
      "page": 586
    },
    {
      "sura": 81,
      "aya": 8,
      "text_uthmani": "وَإِذَا اَ۬لْمَوْءُۥدَةُ سُئِلَتْ",
      "text_normalized": "واذا الموءده سيلت",
      "aya_indic": "٨",
      "jozz": 30,
      "page": 586
    },
    {
      "sura": 81,
      "aya": 9,
      "text_uthmani": "بِأَيِّ ذَنۢبٖ قُتِلَتْ",
      "text_normalized": "باي ذنب قتلت",
      "aya_indic": "٩",
      "jozz": 30,
      "page": 586
    },
    {
      "sura": 81,
      "aya": 10,
      "text_uthmani": "وَإِذَا اَ۬لصُّحُفُ نُشِرَتْ",
      "text_normalized": "واذا الصحف نشرت",
      "aya_indic": "١٠",
      "jozz": 30,
      "page": 586
    },
    {
      "sura": 81,
      "aya": 11,
      "text_uthmani": "وَإِذَا اَ۬لسَّمَآءُ كُشِطَتْ",
      "text_normalized": "واذا السماء كشطت",
      "aya_indic": "١١",
      "jozz": 30,
      "page": 586
    },
    {
      "sura": 81,
      "aya": 12,
      "text_uthmani": "وَإِذَا اَ۬لْجَحِيمُ سُعِّرَتْ",
      "text_normalized": "واذا الجحيم سعرت",
      "aya_indic": "١٢",
      "jozz": 30,
      "page": 586
    },
    {
      "sura": 81,
      "aya": 13,
      "text_uthmani": "وَإِذَا اَ۬لْجَنَّةُ أُزْلِفَتْ",
      "text_normalized": "واذا الجنه ازلفت",
      "aya_indic": "١٣",
      "jozz": 30,
      "page": 586
    },
    {
      "sura": 81,
      "aya": 14,
      "text_uthmani": "عَلِمَتْ نَفْسٞ مَّآ أَحْضَرَتْۖ",
      "text_normalized": "علمت نفس ما احضرت",
      "aya_indic": "١٤",
      "jozz": 30,
      "page": 586
    },
    {
      "sura": 81,
      "aya": 15,
      "text_uthmani": "فَلَآ أُقْسِمُ بِالْخُنَّسِ",
      "text_normalized": "فلا اقسم بالخنس",
      "aya_indic": "١٥",
      "jozz": 30,
      "page": 586
    },
    {
      "sura": 81,
      "aya": 16,
      "text_uthmani": "اِ۬لْجَوَارِ اِ۬لْكُنَّسِ",
      "text_normalized": "الجوار الكنس",
      "aya_indic": "١٦",
      "jozz": 30,
      "page": 586
    },
    {
      "sura": 81,
      "aya": 17,
      "text_uthmani": "وَاليْلِ إِذَا عَسْعَسَ",
      "text_normalized": "واليل اذا عسعس",
      "aya_indic": "١٧",
      "jozz": 30,
      "page": 586
    },
    {
      "sura": 81,
      "aya": 18,
      "text_uthmani": "وَالصُّبْحِ إِذَا تَنَفَّسَ",
      "text_normalized": "والصبح اذا تنفس",
      "aya_indic": "١٨",
      "jozz": 30,
      "page": 586
    },
    {
      "sura": 81,
      "aya": 19,
      "text_uthmani": "إِنَّهُۥ لَقَوْلُ رَسُولٖ كَرِيمٖ",
      "text_normalized": "انه لقول رسول كريم",
      "aya_indic": "١٩",
      "jozz": 30,
      "page": 586
    },
    {
      "sura": 81,
      "aya": 20,
      "text_uthmani": "ذِے قُوَّةٍ عِندَ ذِے اِ۬لْعَرْشِ مَكِينٖ",
      "text_normalized": "ذے قوه عند ذے العرش مكين",
      "aya_indic": "٢٠",
      "jozz": 30,
      "page": 586
    },
    {
      "sura": 81,
      "aya": 21,
      "text_uthmani": "مُّطَاعٖ ثَمَّ أَمِينٖۖ",
      "text_normalized": "مطاع ثم امين",
      "aya_indic": "٢١",
      "jozz": 30,
      "page": 586
    },
    {
      "sura": 81,
      "aya": 22,
      "text_uthmani": "وَمَا صَٰحِبُكُم بِمَجْنُونٖۖ",
      "text_normalized": "وما صاحبكم بمجنون",
      "aya_indic": "٢٢",
      "jozz": 30,
      "page": 586
    },
    {
      "sura": 81,
      "aya": 23,
      "text_uthmani": "وَلَقَدْ ر۪ء۪اهُ بِالُافُقِ اِ۬لْمُبِينِۖ",
      "text_normalized": "ولقد رءاه بالافق المبين",
      "aya_indic": "٢٣",
      "jozz": 30,
      "page": 586
    },
    {
      "sura": 81,
      "aya": 24,
      "text_uthmani": "وَمَا هُوَ عَلَى اَ۬لْغَيْبِ بِضَنِينٖۖ",
      "text_normalized": "وما هو علي الغيب بضنين",
      "aya_indic": "٢٤",
      "jozz": 30,
      "page": 586
    },
    {
      "sura": 81,
      "aya": 25,
      "text_uthmani": "وَمَا هُوَ بِقَوْلِ شَيْطَٰنٖ رَّجِيمٖ",
      "text_normalized": "وما هو بقول شيطان رجيم",
      "aya_indic": "٢٥",
      "jozz": 30,
      "page": 586
    },
    {
      "sura": 81,
      "aya": 26,
      "text_uthmani": "فَأَيْنَ تَذْهَبُونَۖ",
      "text_normalized": "فاين تذهبون",
      "aya_indic": "٢٦",
      "jozz": 30,
      "page": 586
    },
    {
      "sura": 81,
      "aya": 27,
      "text_uthmani": "إِنْ هُوَ إِلَّا ذِكْرٞ لِّلْعَٰلَمِينَ",
      "text_normalized": "ان هو الا ذكر للعالمين",
      "aya_indic": "٢٧",
      "jozz": 30,
      "page": 586
    },
    {
      "sura": 81,
      "aya": 28,
      "text_uthmani": "لِمَن شَآءَ مِنكُمُۥٓ أَنْ يَّسْتَقِيمَۖ",
      "text_normalized": "لمن شاء منكم ان يستقيم",
      "aya_indic": "٢٨",
      "jozz": 30,
      "page": 586
    },
    {
      "sura": 81,
      "aya": 29,
      "text_uthmani": "وَمَا تَشَآءُونَ إِلَّآ أَنْ يَّشَآءَ اَ۬للَّهُ رَبُّ اُ۬لْعَٰلَمِينَۖ",
      "text_normalized": "وما تشاءون الا ان يشاء الله رب العالمين",
      "aya_indic": "٢٩",
      "jozz": 30,
      "page": 586
    }
  ]
}