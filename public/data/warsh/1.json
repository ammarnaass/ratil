{
  "id": 1,
  "name_ar": "الفاتحة",
  "name_en": "Al-Fatihah",
  "type": "مكية",
  "ayahs_hafs": 7,
  "ayahs_warsh": 7,
  "page": 1,
  "narration": "warsh",
  "narration_ar": "ورش عن نافع",
  "ayahs": [
    {
      "sura": 1,
      "aya": 1,
      "text_uthmani": "اِ۬لْحَمْدُ لِلهِ رَبِّ اِ۬لْعَٰلَمِينَ",
      "text_normalized": "الحمد لله رب العالمين",
      "aya_indic": "١",
      "jozz": 1,
      "page": 1
    },
    {
      "sura": 1,
      "aya": 2,
      "text_uthmani": "اَ۬لرَّحْمَٰنِ اِ۬لرَّحِيمِ",
      "text_normalized": "الرحمن الرحيم",
      "aya_indic": "٢",
      "jozz": 1,
      "page": 1
    },
    {
      "sura": 1,
      "aya": 3,
      "text_uthmani": "مَلِكِ يَوْمِ اِ۬لدِّينِۖ",
      "text_normalized": "ملك يوم الدين",
      "aya_indic": "٣",
      "jozz": 1,
      "page": 1
    },
    {
      "sura": 1,
      "aya": 4,
      "text_uthmani": "إِيَّاكَ نَعْبُدُ وَإِيَّاكَ نَسْتَعِينُۖ",
      "text_normalized": "اياك نعبد واياك نستعين",
      "aya_indic": "٤",
      "jozz": 1,
      "page": 1
    },
    {
      "sura": 1,
      "aya": 5,
      "text_uthmani": "اُ۪هْدِنَا اَ۬لصِّرَٰطَ اَ۬لْمُسْتَقِيمَ",
      "text_normalized": "اهدنا الصراط المستقيم",
      "aya_indic": "٥",
      "jozz": 1,
      "page": 1
    },
    {
      "sura": 1,
      "aya": 6,
      "text_uthmani": "صِرَٰطَ اَ۬لذِينَ أَنْعَمْتَ عَلَيْهِمْ",
      "text_normalized": "صراط الذين انعمت عليهم",
      "aya_indic": "٦",
      "jozz": 1,
      "page": 1
    },
    {
      "sura": 1,
      "aya": 7,
      "text_uthmani": "غَيْرِ اِ۬لْمَغْضُوبِ عَلَيْهِمْ وَلَا اَ۬لضَّآلِّينَۖ",
      "text_normalized": "غير المغضوب عليهم ولا الضالين",
      "aya_indic": "٧",
      "jozz": 1,
      "page": 1
    }
  ]
}