{
  "id": 55,
  "name_ar": "الرحمن",
  "name_en": "Ar-Rahman",
  "type": "مدنية",
  "ayahs_hafs": 78,
  "ayahs_warsh": 76,
  "page": 531,
  "narration": "warsh",
  "narration_ar": "ورش عن نافع",
  "ayahs": [
    {
      "sura": 55,
      "aya": 1,
      "text_uthmani": "اِ۬لرَّحْمَٰنُ عَلَّمَ اَ۬لْقُرْءَانَۖ",
      "text_normalized": "الرحمن علم القرءان",
      "aya_indic": "١",
      "jozz": 27,
      "page": 531
    },
    {
      "sura": 55,
      "aya": 2,
      "text_uthmani": "خَلَقَ اَ۬لِانسَٰنَ عَلَّمَهُ اُ۬لْبَيَانَۖ",
      "text_normalized": "خلق الانسان علمه البيان",
      "aya_indic": "٢",
      "jozz": 27,
      "page": 531
    },
    {
      "sura": 55,
      "aya": 3,
      "text_uthmani": "اَ۬لشَّمْسُ وَالْقَمَرُ بِحُسْبَانٖۖ",
      "text_normalized": "الشمس والقمر بحسبان",
      "aya_indic": "٣",
      "jozz": 27,
      "page": 531
    },
    {
      "sura": 55,
      "aya": 4,
      "text_uthmani": "وَالنَّجْمُ وَالشَّجَرُ يَسْجُدَٰنِۖ",
      "text_normalized": "والنجم والشجر يسجدان",
      "aya_indic": "٤",
      "jozz": 27,
      "page": 531
    },
    {
      "sura": 55,
      "aya": 5,
      "text_uthmani": "وَالسَّمَآءَ رَفَعَهَا وَوَضَعَ اَ۬لْمِيزَانَ",
      "text_normalized": "والسماء رفعها ووضع الميزان",
      "aya_indic": "٥",
      "jozz": 27,
      "page": 531
    },
    {
      "sura": 55,
      "aya": 6,
      "text_uthmani": "أَلَّا تَطْغَوْاْ فِے اِ۬لْمِيزَانِ",
      "text_normalized": "الا تطغوا فے الميزان",
      "aya_indic": "٦",
      "jozz": 27,
      "page": 531
    },
    {
      "sura": 55,
      "aya": 7,
      "text_uthmani": "وَأَقِيمُواْ اُ۬لْوَزْنَ بِالْقِسْطِ وَلَا تُخْسِرُواْ اُ۬لْمِيزَانَۖ",
      "text_normalized": "واقيموا الوزن بالقسط ولا تخسروا الميزان",
      "aya_indic": "٧",
      "jozz": 27,
      "page": 531
    },
    {
      "sura": 55,
      "aya": 8,
      "text_uthmani": "وَالَارْضَ وَضَعَهَا لِلَانَامِ",
      "text_normalized": "والارض وضعها للانام",
      "aya_indic": "٨",
      "jozz": 27,
      "page": 531
    },
    {
      "sura": 55,
      "aya": 9,
      "text_uthmani": "فِيهَا فَٰكِهَةٞ وَالنَّخْلُ ذَاتُ اُ۬لَاكْمَامِ",
      "text_normalized": "فيها فاكهه والنخل ذات الاكمام",
      "aya_indic": "٩",
      "jozz": 27,
      "page": 531
    },
    {
      "sura": 55,
      "aya": 10,
      "text_uthmani": "وَالْحَبُّ ذُو اُ۬لْعَصْفِ وَالرَّيْحَانُۖ",
      "text_normalized": "والحب ذو العصف والريحان",
      "aya_indic": "١٠",
      "jozz": 27,
      "page": 531
    },
    {
      "sura": 55,
      "aya": 11,
      "text_uthmani": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ",
      "text_normalized": "فباي ءالاء ربكما تكذبان",
      "aya_indic": "١١",
      "jozz": 27,
      "page": 531
    },
    {
      "sura": 55,
      "aya": 12,
      "text_uthmani": "خَلَقَ اَ۬لِانسَٰنَ مِن صَلْصَٰلٖ كَالْفَخّ۪ارِ",
      "text_normalized": "خلق الانسان من صلصال كالفخار",
      "aya_indic": "١٢",
      "jozz": 27,
      "page": 531
    },
    {
      "sura": 55,
      "aya": 13,
      "text_uthmani": "وَخَلَقَ اَ۬لْجَآنَّ مِن مَّارِجٖ مِّن نّ۪ارٖۖ",
      "text_normalized": "وخلق الجان من مارج من نار",
      "aya_indic": "١٣",
      "jozz": 27,
      "page": 531
    },
    {
      "sura": 55,
      "aya": 14,
      "text_uthmani": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ",
      "text_normalized": "فباي ءالاء ربكما تكذبان",
      "aya_indic": "١٤",
      "jozz": 27,
      "page": 531
    },
    {
      "sura": 55,
      "aya": 15,
      "text_uthmani": "رَبُّ اُ۬لْمَشْرِقَيْنِ وَرَبُّ اُ۬لْمَغْرِبَيْنِۖ",
      "text_normalized": "رب المشرقين ورب المغربين",
      "aya_indic": "١٥",
      "jozz": 27,
      "page": 531
    },
    {
      "sura": 55,
      "aya": 16,
      "text_uthmani": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ",
      "text_normalized": "فباي ءالاء ربكما تكذبان",
      "aya_indic": "١٦",
      "jozz": 27,
      "page": 531
    },
    {
      "sura": 55,
      "aya": 17,
      "text_uthmani": "مَرَجَ اَ۬لْبَحْرَيْنِ يَلْتَقِيَٰنِ",
      "text_normalized": "مرج البحرين يلتقيان",
      "aya_indic": "١٧",
      "jozz": 27,
      "page": 532
    },
    {
      "sura": 55,
      "aya": 18,
      "text_uthmani": "بَيْنَهُمَا بَرْزَخٞ لَّا يَبْغِيَٰنِۖ",
      "text_normalized": "بينهما برزخ لا يبغيان",
      "aya_indic": "١٨",
      "jozz": 27,
      "page": 532
    },
    {
      "sura": 55,
      "aya": 19,
      "text_uthmani": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ",
      "text_normalized": "فباي ءالاء ربكما تكذبان",
      "aya_indic": "١٩",
      "jozz": 27,
      "page": 532
    },
    {
      "sura": 55,
      "aya": 20,
      "text_uthmani": "يُخْرَجُ مِنْهُمَا اَ۬للُّؤْلُؤُاْ وَالْمَرْجَانُۖ",
      "text_normalized": "يخرج منهما اللولوا والمرجان",
      "aya_indic": "٢٠",
      "jozz": 27,
      "page": 532
    },
    {
      "sura": 55,
      "aya": 21,
      "text_uthmani": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ",
      "text_normalized": "فباي ءالاء ربكما تكذبان",
      "aya_indic": "٢١",
      "jozz": 27,
      "page": 532
    },
    {
      "sura": 55,
      "aya": 22,
      "text_uthmani": "وَلَهُ اُ۬لْجَوَارِ اِ۬لْمُنشَأَٰتُ فِے اِ۬لْبَحْرِ كَالَاعْلَٰمِۖ",
      "text_normalized": "وله الجوار المنشاات فے البحر كالاعلام",
      "aya_indic": "٢٢",
      "jozz": 27,
      "page": 532
    },
    {
      "sura": 55,
      "aya": 23,
      "text_uthmani": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ",
      "text_normalized": "فباي ءالاء ربكما تكذبان",
      "aya_indic": "٢٣",
      "jozz": 27,
      "page": 532
    },
    {
      "sura": 55,
      "aya": 24,
      "text_uthmani": "كُلُّ مَنْ عَلَيْهَا فَانٖ",
      "text_normalized": "كل من عليها فان",
      "aya_indic": "٢٤",
      "jozz": 27,
      "page": 532
    },
    {
      "sura": 55,
      "aya": 25,
      "text_uthmani": "وَيَبْق۪ىٰ وَجْهُ رَبِّكَ ذُو اُ۬لْجَلَٰلِ وَالِاكْرَامِۖ",
      "text_normalized": "ويبقيا وجه ربك ذو الجلال والاكرام",
      "aya_indic": "٢٥",
      "jozz": 27,
      "page": 532
    },
    {
      "sura": 55,
      "aya": 26,
      "text_uthmani": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ",
      "text_normalized": "فباي ءالاء ربكما تكذبان",
      "aya_indic": "٢٦",
      "jozz": 27,
      "page": 532
    },
    {
      "sura": 55,
      "aya": 27,
      "text_uthmani": "يَسْـَٔلُهُۥ مَن فِے اِ۬لسَّمَٰوَٰتِ وَالَارْضِ كُلَّ يَوْمٍ هُوَ فِے شَأْنٖۖ",
      "text_normalized": "يسله من فے السماوات والارض كل يوم هو فے شان",
      "aya_indic": "٢٧",
      "jozz": 27,
      "page": 532
    },
    {
      "sura": 55,
      "aya": 28,
      "text_uthmani": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ",
      "text_normalized": "فباي ءالاء ربكما تكذبان",
      "aya_indic": "٢٨",
      "jozz": 27,
      "page": 532
    },
    {
      "sura": 55,
      "aya": 29,
      "text_uthmani": "سَنَفْرُغُ لَكُمُۥٓ أَيُّهَ اَ۬لثَّقَلَٰنِۖ",
      "text_normalized": "سنفرغ لكم ايه الثقلان",
      "aya_indic": "٢٩",
      "jozz": 27,
      "page": 532
    },
    {
      "sura": 55,
      "aya": 30,
      "text_uthmani": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ",
      "text_normalized": "فباي ءالاء ربكما تكذبان",
      "aya_indic": "٣٠",
      "jozz": 27,
      "page": 532
    },
    {
      "sura": 55,
      "aya": 31,
      "text_uthmani": "يَٰمَعْشَرَ اَ۬لْجِنِّ وَالِانسِ إِنِ اِ۪سْتَطَعْتُمُۥٓ أَن تَنفُذُواْ مِنَ اَقْط۪ارِ اِ۬لسَّمَٰوَٰتِ وَالَارْضِ فَانفُذُواْۖ لَا تَنفُذُونَ إِلَّا بِسُلْطَٰنٖۖ",
      "text_normalized": "يامعشر الجن والانس ان استطعتم ان تنفذوا من اقطار السماوات والارض فانفذوا لا تنفذون الا بسلطان",
      "aya_indic": "٣١",
      "jozz": 27,
      "page": 532
    },
    {
      "sura": 55,
      "aya": 32,
      "text_uthmani": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ",
      "text_normalized": "فباي ءالاء ربكما تكذبان",
      "aya_indic": "٣٢",
      "jozz": 27,
      "page": 532
    },
    {
      "sura": 55,
      "aya": 33,
      "text_uthmani": "يُرْسَلُ عَلَيْكُمَا شُوَاظٞ مِّن نّ۪ارٖ",
      "text_normalized": "يرسل عليكما شواظ من نار",
      "aya_indic": "٣٣",
      "jozz": 27,
      "page": 532
    },
    {
      "sura": 55,
      "aya": 34,
      "text_uthmani": "وَنُحَاسٞ فَلَا تَنتَصِرَٰنِۖ",
      "text_normalized": "ونحاس فلا تنتصران",
      "aya_indic": "٣٤",
      "jozz": 27,
      "page": 532
    },
    {
      "sura": 55,
      "aya": 35,
      "text_uthmani": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ",
      "text_normalized": "فباي ءالاء ربكما تكذبان",
      "aya_indic": "٣٥",
      "jozz": 27,
      "page": 532
    },
    {
      "sura": 55,
      "aya": 36,
      "text_uthmani": "فَإِذَا اَ۪نشَقَّتِ اِ۬لسَّمَآءُ فَكَانَتْ وَرْدَةٗ كَالدِّهَانِ",
      "text_normalized": "فاذا انشقت السماء فكانت ورده كالدهان",
      "aya_indic": "٣٦",
      "jozz": 27,
      "page": 532
    },
    {
      "sura": 55,
      "aya": 37,
      "text_uthmani": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "text_normalized": "فباي ءالاء ربكما تكذبان",
      "aya_indic": "٣٧",
      "jozz": 27,
      "page": 532
    },
    {
      "sura": 55,
      "aya": 38,
      "text_uthmani": "فَيَوْمَئِذٖ لَّا يُسْـَٔلُ عَن ذَنۢبِهِۦٓ إِنسٞ وَلَا جَآنّٞۖ",
      "text_normalized": "فيوميذ لا يسل عن ذنبه انس ولا جان",
      "aya_indic": "٣٨",
      "jozz": 27,
      "page": 532
    },
    {
      "sura": 55,
      "aya": 39,
      "text_uthmani": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ",
      "text_normalized": "فباي ءالاء ربكما تكذبان",
      "aya_indic": "٣٩",
      "jozz": 27,
      "page": 532
    },
    {
      "sura": 55,
      "aya": 40,
      "text_uthmani": "۞ يُعْرَفُ اُ۬لْمُجْرِمُونَ بِسِيمٰ۪هُمْ فَيُوخَذُ بِالنَّوَٰصِے وَالَاقْدَامِۖ",
      "text_normalized": "يعرف المجرمون بسيماهم فيوخذ بالنواصے والاقدام",
      "aya_indic": "٤٠",
      "jozz": 27,
      "page": 532
    },
    {
      "sura": 55,
      "aya": 41,
      "text_uthmani": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ",
      "text_normalized": "فباي ءالاء ربكما تكذبان",
      "aya_indic": "٤١",
      "jozz": 27,
      "page": 533
    },
    {
      "sura": 55,
      "aya": 42,
      "text_uthmani": "هَٰذِهِۦ جَهَنَّمُ اُ۬لتِے يُكَذِّبُ بِهَا اَ۬لْمُجْرِمُونَ",
      "text_normalized": "هذه جهنم التے يكذب بها المجرمون",
      "aya_indic": "٤٢",
      "jozz": 27,
      "page": 533
    },
    {
      "sura": 55,
      "aya": 43,
      "text_uthmani": "يَطُوفُونَ بَيْنَهَا وَبَيْنَ حَمِيمٍ اٰنٖۖ",
      "text_normalized": "يطوفون بينها وبين حميم اان",
      "aya_indic": "٤٣",
      "jozz": 27,
      "page": 533
    },
    {
      "sura": 55,
      "aya": 44,
      "text_uthmani": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ",
      "text_normalized": "فباي ءالاء ربكما تكذبان",
      "aya_indic": "٤٤",
      "jozz": 27,
      "page": 533
    },
    {
      "sura": 55,
      "aya": 45,
      "text_uthmani": "وَلِمَنْ خَافَ مَقَامَ رَبِّهِۦ جَنَّتَٰنِ",
      "text_normalized": "ولمن خاف مقام ربه جنتان",
      "aya_indic": "٤٥",
      "jozz": 27,
      "page": 533
    },
    {
      "sura": 55,
      "aya": 46,
      "text_uthmani": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "text_normalized": "فباي ءالاء ربكما تكذبان",
      "aya_indic": "٤٦",
      "jozz": 27,
      "page": 533
    },
    {
      "sura": 55,
      "aya": 47,
      "text_uthmani": "ذَوَاتَآ أَفْنَانٖۖ",
      "text_normalized": "ذواتا افنان",
      "aya_indic": "٤٧",
      "jozz": 27,
      "page": 533
    },
    {
      "sura": 55,
      "aya": 48,
      "text_uthmani": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ",
      "text_normalized": "فباي ءالاء ربكما تكذبان",
      "aya_indic": "٤٨",
      "jozz": 27,
      "page": 533
    },
    {
      "sura": 55,
      "aya": 49,
      "text_uthmani": "فِيهِمَا عَيْنَٰنِ تَجْرِيَٰنِۖ",
      "text_normalized": "فيهما عينان تجريان",
      "aya_indic": "٤٩",
      "jozz": 27,
      "page": 533
    },
    {
      "sura": 55,
      "aya": 50,
      "text_uthmani": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ",
      "text_normalized": "فباي ءالاء ربكما تكذبان",
      "aya_indic": "٥٠",
      "jozz": 27,
      "page": 533
    },
    {
      "sura": 55,
      "aya": 51,
      "text_uthmani": "فِيهِمَا مِن كُلِّ فَٰكِهَةٖ زَوْجَٰنِۖ",
      "text_normalized": "فيهما من كل فاكهه زوجان",
      "aya_indic": "٥١",
      "jozz": 27,
      "page": 533
    },
    {
