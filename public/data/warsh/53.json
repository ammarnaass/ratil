      "aya_indic": "٥٦",
      "jozz": 27,
      "page": 528
    },
    {
      "sura": 53,
      "aya": 57,
      "text_uthmani": "لَيْسَ لَهَا مِن دُونِ اِ۬للَّهِ كَاشِفَةٌۖ",
