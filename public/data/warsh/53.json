{
  "id": 53,
  "name_ar": "النجم",
  "name_en": "An-Najm",
  "type": "مكية",
  "ayahs_hafs": 62,
  "ayahs_warsh": 61,
  "page": 526,
  "narration": "warsh",
  "narration_ar": "ورش عن نافع",
  "ayahs": [
    {
      "sura": 53,
      "aya": 1,
      "text_uthmani": "وَالنَّجْمِ إِذَا هَو۪ىٰ",
      "text_normalized": "والنجم اذا هويا",
      "aya_indic": "١",
      "jozz": 27,
      "page": 526
    },
    {
      "sura": 53,
      "aya": 2,
      "text_uthmani": "مَا ضَلَّ صَٰحِبُكُمْ وَمَا غَو۪ىٰ",
      "text_normalized": "ما ضل صاحبكم وما غويا",
      "aya_indic": "٢",
      "jozz": 27,
      "page": 526
    },
    {
      "sura": 53,
      "aya": 3,
      "text_uthmani": "وَمَا يَنطِقُ عَنِ اِ۬لْهَو۪ىٰٓ",
      "text_normalized": "وما ينطق عن الهويا",
      "aya_indic": "٣",
      "jozz": 27,
      "page": 526
    },
    {
      "sura": 53,
      "aya": 4,
      "text_uthmani": "إِنْ هُوَ إِلَّا وَحْيٞ يُوح۪ىٰۖ",
      "text_normalized": "ان هو الا وحي يوحيا",
      "aya_indic": "٤",
      "jozz": 27,
      "page": 526
    },
    {
      "sura": 53,
      "aya": 5,
      "text_uthmani": "عَلَّمَهُۥ شَدِيدُ اُ۬لْقُو۪ىٰ",
      "text_normalized": "علمه شديد القويا",
      "aya_indic": "٥",
      "jozz": 27,
      "page": 526
    },
    {
      "sura": 53,
      "aya": 6,
      "text_uthmani": "ذُو مِرَّةٖۖ فَاسْتَو۪ىٰ",
      "text_normalized": "ذو مره فاستويا",
      "aya_indic": "٦",
      "jozz": 27,
      "page": 526
    },
    {
      "sura": 53,
      "aya": 7,
      "text_uthmani": "وَهُوَ بِالُافُقِ اِ۬لَاعْل۪ىٰۖ",
      "text_normalized": "وهو بالافق الاعليا",
      "aya_indic": "٧",
      "jozz": 27,
      "page": 526
    },
    {
      "sura": 53,
      "aya": 8,
      "text_uthmani": "ثُمَّ دَنَا فَتَدَلّ۪ىٰ",
      "text_normalized": "ثم دنا فتدليا",
      "aya_indic": "٨",
      "jozz": 27,
      "page": 526
    },
    {
      "sura": 53,
      "aya": 9,
      "text_uthmani": "فَكَانَ قَابَ قَوْسَيْنِ أَوَ اَدْن۪ىٰۖ",
      "text_normalized": "فكان قاب قوسين او ادنيا",
      "aya_indic": "٩",
      "jozz": 27,
      "page": 526
    },
    {
      "sura": 53,
      "aya": 10,
      "text_uthmani": "فَأَوْح۪ىٰٓ إِلَىٰ عَبْدِهِۦ مَآ أَوْح۪ىٰۖ",
      "text_normalized": "فاوحيا اليا عبده ما اوحيا",
      "aya_indic": "١٠",
      "jozz": 27,
      "page": 526
    },
    {
      "sura": 53,
      "aya": 11,
      "text_uthmani": "مَا كَذَبَ اَ۬لْفُؤَادُ مَا ر۪أ۪ىٰٓۖ",
      "text_normalized": "ما كذب الفواد ما رايا",
      "aya_indic": "١١",
      "jozz": 27,
      "page": 526
    },
    {
      "sura": 53,
      "aya": 12,
      "text_uthmani": "أَفَتُمَٰرُونَهُۥ عَلَىٰ مَا يَر۪ىٰۖ",
      "text_normalized": "افتمارونه عليا ما يريا",
      "aya_indic": "١٢",
      "jozz": 27,
      "page": 526
    },
    {
      "sura": 53,
      "aya": 13,
      "text_uthmani": "وَلَقَدْ ر۪ء۪اهُ نَزْلَةً ا۟خْر۪ىٰ",
      "text_normalized": "ولقد رءاه نزله اخريا",
      "aya_indic": "١٣",
      "jozz": 27,
      "page": 526
    },
    {
      "sura": 53,
      "aya": 14,
      "text_uthmani": "عِندَ سِدْرَةِ اِ۬لْمُنتَه۪ىٰ",
      "text_normalized": "عند سدره المنتهيا",
      "aya_indic": "١٤",
      "jozz": 27,
      "page": 526
    },
    {
      "sura": 53,
      "aya": 15,
      "text_uthmani": "عِندَهَا جَنَّةُ اُ۬لْمَأْو۪ىٰٓ",
      "text_normalized": "عندها جنه الماويا",
      "aya_indic": "١٥",
      "jozz": 27,
      "page": 526
    },
    {
      "sura": 53,
      "aya": 16,
      "text_uthmani": "إِذْ يَغْشَى اَ۬لسِّدْرَةَ مَا يَغْش۪ىٰۖ",
      "text_normalized": "اذ يغشي السدره ما يغشيا",
      "aya_indic": "١٦",
      "jozz": 27,
      "page": 526
    },
    {
      "sura": 53,
      "aya": 17,
      "text_uthmani": "مَا زَاغَ اَ۬لْبَصَرُ وَمَا طَغ۪ىٰۖ",
      "text_normalized": "ما زاغ البصر وما طغيا",
      "aya_indic": "١٧",
      "jozz": 27,
      "page": 526
    },
    {
      "sura": 53,
      "aya": 18,
      "text_uthmani": "لَقَدْ ر۪أ۪ىٰ مِنَ اٰيَٰتِ رَبِّهِ اِ۬لْكُبْر۪ىٰٓۖ",
      "text_normalized": "لقد رايا من اايات ربه الكبريا",
      "aya_indic": "١٨",
      "jozz": 27,
      "page": 526
    },
    {
      "sura": 53,
      "aya": 19,
      "text_uthmani": "أَفَرَٰٓيْتُمُ اُ۬للَّٰتَ وَالْعُزّ۪ىٰ",
      "text_normalized": "افرايتم اللات والعزيا",
      "aya_indic": "١٩",
      "jozz": 27,
      "page": 526
    },
    {
      "sura": 53,
      "aya": 20,
      "text_uthmani": "وَمَنَوٰةَ اَ۬لثَّالِثَةَ اَ۬لُاخْر۪ىٰٓ",
      "text_normalized": "ومناه الثالثه الاخريا",
      "aya_indic": "٢٠",
      "jozz": 27,
      "page": 526
    },
    {
      "sura": 53,
      "aya": 21,
      "text_uthmani": "أَلَكُمُ اُ۬لذَّكَرُ وَلَهُ اُ۬لُانث۪ىٰۖ",
      "text_normalized": "الكم الذكر وله الانثيا",
      "aya_indic": "٢١",
      "jozz": 27,
      "page": 526
    },
    {
      "sura": 53,
      "aya": 22,
      "text_uthmani": "تِلْكَ إِذاٗ قِسْمَةٞ ضِيز۪ىٰٓۖ",
      "text_normalized": "تلك اذا قسمه ضيزيا",
      "aya_indic": "٢٢",
      "jozz": 27,
      "page": 526
    },
    {
      "sura": 53,
      "aya": 23,
      "text_uthmani": "إِنْ هِيَ إِلَّآ أَسْمَآءٞ سَمَّيْتُمُوهَآ أَنتُمْ وَءَابَآؤُكُم مَّآ أَنزَلَ اَ۬للَّهُ بِهَا مِن سُلْطَٰنٍۖ اِنْ يَّتَّبِعُونَ إِلَّا اَ۬لظَّنَّ وَمَا تَهْوَى اَ۬لَانفُسُۖ وَلَقَدْ جَآءَهُم مِّن رَّبِّهِمُ اُ۬لْهُد۪ىٰٓۖ",
      "text_normalized": "ان هي الا اسماء سميتموها انتم وءاباوكم ما انزل الله بها من سلطان ان يتبعون الا الظن وما تهوي الانفس ولقد جاءهم من ربهم الهديا",
      "aya_indic": "٢٣",
      "jozz": 27,
      "page": 526
    },
    {
      "sura": 53,
      "aya": 24,
      "text_uthmani": "أَمْ لِلِانسَٰنِ مَا تَمَنّ۪ىٰۖ",
      "text_normalized": "ام للانسان ما تمنيا",
      "aya_indic": "٢٤",
      "jozz": 27,
      "page": 526
    },
    {
      "sura": 53,
      "aya": 25,
      "text_uthmani": "فَلِلهِ اِ۬لَاخِرَةُ وَالُاول۪ىٰۖ",
      "text_normalized": "فلله الاخره والاوليا",
      "aya_indic": "٢٥",
      "jozz": 27,
      "page": 526
    },
    {
      "sura": 53,
      "aya": 26,
      "text_uthmani": "۞ وَكَم مِّن مَّلَكٖ فِے اِ۬لسَّمَٰوَٰتِ لَا تُغْنِے شَفَٰعَتُهُمْ شَئْاً اِلَّا مِنۢ بَعْدِ أَنْ يَّاذَنَ اَ۬للَّهُ لِمَنْ يَّشَآءُ وَيَرْض۪ىٰٓۖ",
      "text_normalized": "وكم من ملك فے السماوات لا تغنے شفاعتهم شيا الا من بعد ان ياذن الله لمن يشاء ويرضيا",
      "aya_indic": "٢٦",
      "jozz": 27,
      "page": 526
    },
    {
      "sura": 53,
      "aya": 27,
      "text_uthmani": "إِنَّ اَ۬لذِينَ لَا يُومِنُونَ بِالَاخِرَةِ لَيُسَمُّونَ اَ۬لْمَلَٰٓئِكَةَ تَسْمِيَةَ اَ۬لُانث۪ىٰۖ",
      "text_normalized": "ان الذين لا يومنون بالاخره ليسمون الملايكه تسميه الانثيا",
      "aya_indic": "٢٧",
      "jozz": 27,
      "page": 527
    },
    {
      "sura": 53,
      "aya": 28,
      "text_uthmani": "وَمَا لَهُم بِهِۦ مِنْ عِلْمٍۖ اِنْ يَّتَّبِعُونَ إِلَّا اَ۬لظَّنَّۖ وَإِنَّ اَ۬لظَّنَّ لَا يُغْنِے مِنَ اَ۬لْحَقِّ شَئْاٗۖ فَأَعْرِضْ عَن مَّن تَوَلّ۪ىٰ عَن ذِكْرِنَا وَلَمْ يُرِدِ اِلَّا اَ۬لْحَيَوٰةَ اَ۬لدُّنْي۪اۖ",
      "text_normalized": "وما لهم به من علم ان يتبعون الا الظن وان الظن لا يغنے من الحق شيا فاعرض عن من توليا عن ذكرنا ولم يرد الا الحياه الدنيا",
      "aya_indic": "٢٨",
      "jozz": 27,
      "page": 527
    },
    {
      "sura": 53,
      "aya": 29,
      "text_uthmani": "ذَٰلِكَ مَبْلَغُهُم مِّنَ اَ۬لْعِلْمِۖ إِنَّ رَبَّكَ هُوَ أَعْلَمُ بِمَن ضَلَّ عَن سَبِيلِهِۦۖ وَهُوَ أَعْلَمُ بِمَنِ اِ۪هْتَد۪ىٰۖ",
      "text_normalized": "ذلك مبلغهم من العلم ان ربك هو اعلم بمن ضل عن سبيله وهو اعلم بمن اهتديا",
      "aya_indic": "٢٩",
      "jozz": 27,
      "page": 527
    },
    {
      "sura": 53,
      "aya": 30,
      "text_uthmani": "وَلِلهِ مَا فِے اِ۬لسَّمَٰوَٰتِ وَمَا فِے اِ۬لَارْضِ لِيَجْزِيَ اَ۬لذِينَ أَسَٰٓـُٔواْ بِمَا عَمِلُواْ وَيَجْزِيَ اَ۬لذِينَ أَحْسَنُواْ بِالْحُسْنَىۖ",
      "text_normalized": "ولله ما فے السماوات وما فے الارض ليجزي الذين اساوا بما عملوا ويجزي الذين احسنوا بالحسني",
      "aya_indic": "٣٠",
      "jozz": 27,
      "page": 527
    },
    {
      "sura": 53,
      "aya": 31,
      "text_uthmani": "اَ۬لذِينَ يَجْتَنِبُونَ كَبَٰٓئِرَ اَ۬لِاثْمِ وَالْفَوَٰحِشَ إِلَّا اَ۬للَّمَمَۖ إِنَّ رَبَّكَ وَٰسِعُ اُ۬لْمَغْفِرَةِۖ هُوَ أَعْلَمُ بِكُمُۥٓ إِذَ اَنشَأَكُم مِّنَ اَ۬لَارْضِ وَإِذَ اَنتُمُۥٓ أَجِنَّةٞ فِے بُطُونِ أُمَّهَٰتِكُمْۖ فَلَا تُزَكُّوٓاْ أَنفُسَكُمْۖ هُوَ أَعْلَمُ بِمَنِ اِ۪تَّق۪ىٰٓۖ",
      "text_normalized": "الذين يجتنبون كباير الاثم والفواحش الا اللمم ان ربك واسع المغفره هو اعلم بكم اذ انشاكم من الارض واذ انتم اجنه فے بطون امهاتكم فلا تزكوا انفسكم هو اعلم بمن اتقيا",
      "aya_indic": "٣١",
      "jozz": 27,
      "page": 527
    },
    {
      "sura": 53,
      "aya": 32,
      "text_uthmani": "أَفَرَٰٓيْتَ اَ۬لذِے تَوَلّ۪ىٰ",
      "text_normalized": "افرايت الذے توليا",
      "aya_indic": "٣٢",
      "jozz": 27,
      "page": 527
    },
    {
      "sura": 53,
      "aya": 33,
      "text_uthmani": "وَأَعْط۪ىٰ قَلِيلاٗ وَأَكْد۪ىٰٓ",
      "text_normalized": "واعطيا قليلا واكديا",
      "aya_indic": "٣٣",
      "jozz": 27,
      "page": 527
    },
    {
      "sura": 53,
      "aya": 34,
      "text_uthmani": "أَعِندَهُۥ عِلْمُ اُ۬لْغَيْبِ فَهُوَ يَر۪ىٰٓۖ",
      "text_normalized": "اعنده علم الغيب فهو يريا",
      "aya_indic": "٣٤",
      "jozz": 27,
      "page": 527
    },
    {
      "sura": 53,
      "aya": 35,
      "text_uthmani": "أَمْ لَمْ يُنَبَّأْ بِمَا فِے صُحُفِ مُوس۪ىٰ",
      "text_normalized": "ام لم ينبا بما فے صحف موسيا",
      "aya_indic": "٣٥",
      "jozz": 27,
      "page": 527
    },
    {
      "sura": 53,
      "aya": 36,
      "text_uthmani": "وَإِبْرَٰهِيمَ اَ۬لذِے وَفّ۪ىٰٓ",
      "text_normalized": "وابراهيم الذے وفيا",
      "aya_indic": "٣٦",
      "jozz": 27,
      "page": 527
    },
    {
      "sura": 53,
      "aya": 37,
      "text_uthmani": "أَلَّا تَزِرُ وَازِرَةٞ وِزْرَ أُخْر۪ىٰۖ",
      "text_normalized": "الا تزر وازره وزر اخريا",
      "aya_indic": "٣٧",
      "jozz": 27,
      "page": 527
    },
    {
      "sura": 53,
      "aya": 38,
      "text_uthmani": "وَأَن لَّيْسَ لِلِانسَٰنِ إِلَّا مَا سَع۪ىٰۖ",
      "text_normalized": "وان ليس للانسان الا ما سعيا",
      "aya_indic": "٣٨",
      "jozz": 27,
      "page": 527
    },
    {
      "sura": 53,
      "aya": 39,
      "text_uthmani": "وَأَنَّ سَعْيَهُۥ سَوْفَ يُر۪ىٰۖ",
      "text_normalized": "وان سعيه سوف يريا",
      "aya_indic": "٣٩",
      "jozz": 27,
      "page": 527
    },
    {
      "sura": 53,
      "aya": 40,
      "text_uthmani": "ثُمَّ يُجْز۪يٰهُ اُ۬لْجَزَآءَ اَ۬لَاوْف۪ىٰۖ",
      "text_normalized": "ثم يجزياه الجزاء الاوفيا",
      "aya_indic": "٤٠",
      "jozz": 27,
      "page": 527
    },
    {
      "sura": 53,
      "aya": 41,
      "text_uthmani": "وَأَنَّ إِلَىٰ رَبِّكَ اَ۬لْمُنتَه۪ىٰۖ",
      "text_normalized": "وان اليا ربك المنتهيا",
      "aya_indic": "٤١",
      "jozz": 27,
      "page": 527
    },
    {
      "sura": 53,
      "aya": 42,
      "text_uthmani": "وَأَنَّهُۥ هُوَ أَضْحَكَ وَأَبْك۪ىٰۖ",
      "text_normalized": "وانه هو اضحك وابكيا",
      "aya_indic": "٤٢",
      "jozz": 27,
      "page": 527
    },
    {
      "sura": 53,
      "aya": 43,
      "text_uthmani": "وَأَنَّهُۥ هُوَ أَمَاتَ وَأَحْي۪اۖ",
      "text_normalized": "وانه هو امات واحيا",
      "aya_indic": "٤٣",
      "jozz": 27,
      "page": 527
    },
    {
      "sura": 53,
      "aya": 44,
      "text_uthmani": "وَأَنَّهُۥ خَلَقَ اَ۬لزَّوْجَيْنِ اِ۬لذَّكَرَ وَالُانث۪ىٰ",
      "text_normalized": "وانه خلق الزوجين الذكر والانثيا",
      "aya_indic": "٤٤",
      "jozz": 27,
      "page": 528
    },
    {
      "sura": 53,
      "aya": 45,
      "text_uthmani": "مِن نُّطْفَةٍ اِذَا تُمْن۪ىٰۖ",
      "text_normalized": "من نطفه اذا تمنيا",
      "aya_indic": "٤٥",
      "jozz": 27,
      "page": 528
    },
    {
      "sura": 53,
      "aya": 46,
      "text_uthmani": "۞ وَأَنَّ عَلَيْهِ اِ۬لنَّشْأَةَ اَ۬لُاخْر۪ىٰۖ",
      "text_normalized": "وان عليه النشاه الاخريا",
      "aya_indic": "٤٦",
      "jozz": 27,
      "page": 528
    },
    {
      "sura": 53,
      "aya": 47,
      "text_uthmani": "وَأَنَّهُۥ هُوَ أَغْن۪ىٰ وَأَقْن۪ىٰۖ",
      "text_normalized": "وانه هو اغنيا واقنيا",
      "aya_indic": "٤٧",
      "jozz": 27,
      "page": 528
    },
    {
      "sura": 53,
      "aya": 48,
      "text_uthmani": "وَأَنَّهُۥ هُوَ رَبُّ اُ۬لشِّعْر۪ىٰۖ",
      "text_normalized": "وانه هو رب الشعريا",
      "aya_indic": "٤٨",
      "jozz": 27,
      "page": 528
    },
    {
      "sura": 53,
      "aya": 49,
