      "aya_indic": "٥٣",
      "jozz": 27,
      "page": 528
    },
    {
      "sura": 53,
      "aya": 54,
      "text_uthmani": "فَبِأَيِّ ءَالَآءِ رَبِّكَ تَتَمَار۪ىٰۖ",
