      "aya_indic": "٥٢",
      "jozz": 27,
      "page": 528
    },
    {
      "sura": 53,
      "aya": 53,
      "text_uthmani": "فَغَشّ۪يٰهَا مَا غَشّ۪ىٰۖ",
