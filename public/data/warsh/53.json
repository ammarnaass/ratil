      "aya_indic": "٥٤",
      "jozz": 27,
      "page": 528
    },
    {
      "sura": 53,
      "aya": 55,
      "text_uthmani": "هَٰذَا نَذِيرٞ مِّنَ اَ۬لنُّذُرِ اِ۬لُاول۪ىٰٓۖ",
      "text_normalized": "هذا نذير من النذر الاوليا",
