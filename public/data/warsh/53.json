      "aya_indic": "٥٠",
      "jozz": 27,
      "page": 528
    },
    {
      "sura": 53,
      "aya": 51,
      "text_uthmani": "وَقَوْمَ نُوحٖ مِّن قَبْلُۖ إِنَّهُمْ كَانُواْ هُمُۥٓ أَظْلَمَ وَأَطْغ۪ىٰۖ",
      "text_normalized": "وقوم نوح من قبل انهم كانوا هم اظلم واطغيا",
