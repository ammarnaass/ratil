{
  "id": 84,
  "name_ar": "الانشقاق",
  "name_en": "Al-Inshiqaq",
  "type": "مكية",
  "ayahs_hafs": 25,
  "ayahs_warsh": 25,
  "page": 589,
  "narration": "warsh",
  "narration_ar": "ورش عن نافع",
  "ayahs": [
    {
      "sura": 84,
      "aya": 1,
      "text_uthmani": "إِذَا اَ۬لسَّمَآءُ اُ۪نشَقَّتْ",
      "text_normalized": "اذا السماء انشقت",
      "aya_indic": "١",
      "jozz": 30,
      "page": 589
    },
    {
      "sura": 84,
      "aya": 2,
      "text_uthmani": "وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ",
      "text_normalized": "واذنت لربها وحقت",
      "aya_indic": "٢",
      "jozz": 30,
      "page": 589
    },
    {
      "sura": 84,
      "aya": 3,
      "text_uthmani": "وَإِذَا اَ۬لَارْضُ مُدَّتْ",
      "text_normalized": "واذا الارض مدت",
      "aya_indic": "٣",
      "jozz": 30,
      "page": 589
    },
    {
      "sura": 84,
      "aya": 4,
      "text_uthmani": "وَأَلْقَتْ مَا فِيهَا وَتَخَلَّتْ",
      "text_normalized": "والقت ما فيها وتخلت",
      "aya_indic": "٤",
      "jozz": 30,
      "page": 589
    },
    {
      "sura": 84,
      "aya": 5,
      "text_uthmani": "وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْۖ",
      "text_normalized": "واذنت لربها وحقت",
      "aya_indic": "٥",
      "jozz": 30,
      "page": 589
    },
    {
      "sura": 84,
      "aya": 6,
      "text_uthmani": "يَٰٓأَيُّهَا اَ۬لِانسَٰنُ إِنَّكَ كَادِحٌ اِلَىٰ رَبِّكَ كَدْحاٗ فَمُلَٰقِيهِۖ",
      "text_normalized": "ياايها الانسان انك كادح اليا ربك كدحا فملاقيه",
      "aya_indic": "٦",
      "jozz": 30,
      "page": 589
    },
    {
      "sura": 84,
      "aya": 7,
      "text_uthmani": "فَأَمَّا مَنُ ا۟وتِيَ كِتَٰبَهُۥ بِيَمِينِهِۦ",
      "text_normalized": "فاما من اوتي كتابه بيمينه",
      "aya_indic": "٧",
      "jozz": 30,
      "page": 589
    },
    {
      "sura": 84,
      "aya": 8,
      "text_uthmani": "فَسَوْفَ يُحَاسَبُ حِسَاباٗ يَسِيراٗ",
      "text_normalized": "فسوف يحاسب حسابا يسيرا",
      "aya_indic": "٨",
      "jozz": 30,
      "page": 589
    },
    {
      "sura": 84,
      "aya": 9,
      "text_uthmani": "وَيَنقَلِبُ إِلَىٰٓ أَهْلِهِۦ مَسْرُوراٗۖ",
      "text_normalized": "وينقلب اليا اهله مسرورا",
      "aya_indic": "٩",
      "jozz": 30,
      "page": 589
    },
    {
      "sura": 84,
      "aya": 10,
      "text_uthmani": "وَأَمَّا مَنُ ا۟وتِيَ كِتَٰبَهُۥ وَرَآءَ ظَهْرِهِۦ",
      "text_normalized": "واما من اوتي كتابه وراء ظهره",
      "aya_indic": "١٠",
      "jozz": 30,
      "page": 589
    },
    {
      "sura": 84,
      "aya": 11,
      "text_uthmani": "فَسَوْفَ يَدْعُواْ ثُبُوراٗ",
      "text_normalized": "فسوف يدعوا ثبورا",
      "aya_indic": "١١",
      "jozz": 30,
      "page": 589
    },
    {
      "sura": 84,
      "aya": 12,
      "text_uthmani": "وَيُصَلَّىٰ سَعِيراًۖ",
      "text_normalized": "ويصليا سعيرا",
      "aya_indic": "١٢",
      "jozz": 30,
      "page": 589
    },
    {
      "sura": 84,
      "aya": 13,
      "text_uthmani": "اِنَّهُۥ كَانَ فِےٓ أَهْلِهِۦ مَسْرُوراًۖ",
      "text_normalized": "انه كان فے اهله مسرورا",
      "aya_indic": "١٣",
      "jozz": 30,
      "page": 589
    },
    {
      "sura": 84,
      "aya": 14,
      "text_uthmani": "اِنَّهُۥ ظَنَّ أَن لَّنْ يَّحُورَ",
      "text_normalized": "انه ظن ان لن يحور",
      "aya_indic": "١٤",
      "jozz": 30,
      "page": 589
    },
    {
      "sura": 84,
      "aya": 15,
      "text_uthmani": "بَل۪ىٰٓۖ إِنَّ رَبَّهُۥ كَانَ بِهِۦ بَصِيراٗۖ",
      "text_normalized": "بليا ان ربه كان به بصيرا",
      "aya_indic": "١٥",
      "jozz": 30,
      "page": 589
    },
    {
      "sura": 84,
      "aya": 16,
      "text_uthmani": "۞ فَلَآ أُقْسِمُ بِالشَّفَقِ",
      "text_normalized": "فلا اقسم بالشفق",
      "aya_indic": "١٦",
      "jozz": 30,
      "page": 589
    },
    {
      "sura": 84,
      "aya": 17,
      "text_uthmani": "وَاليْلِ وَمَا وَسَقَ",
      "text_normalized": "واليل وما وسق",
      "aya_indic": "١٧",
      "jozz": 30,
      "page": 589
    },
    {
      "sura": 84,
      "aya": 18,
      "text_uthmani": "وَالْقَمَرِ إِذَا اَ۪تَّسَقَ",
      "text_normalized": "والقمر اذا اتسق",
      "aya_indic": "١٨",
      "jozz": 30,
      "page": 589
    },
    {
      "sura": 84,
      "aya": 19,
      "text_uthmani": "لَتَرْكَبُنَّ طَبَقاً عَن طَبَقٖۖ",
      "text_normalized": "لتركبن طبقا عن طبق",
      "aya_indic": "١٩",
      "jozz": 30,
      "page": 589
    },
    {
      "sura": 84,
      "aya": 20,
      "text_uthmani": "فَمَا لَهُمْ لَا يُومِنُونَ",
      "text_normalized": "فما لهم لا يومنون",
      "aya_indic": "٢٠",
      "jozz": 30,
      "page": 589
    },
    {
      "sura": 84,
      "aya": 21,
      "text_uthmani": "وَإِذَا قُرِۓَ عَلَيْهِمُ اُ۬لْقُرْءَانُ لَا يَسْجُدُونَۖ",
      "text_normalized": "واذا قرے عليهم القرءان لا يسجدون",
      "aya_indic": "٢١",
      "jozz": 30,
      "page": 589
    },
    {
      "sura": 84,
      "aya": 22,
      "text_uthmani": "بَلِ اِ۬لذِينَ كَفَرُواْ يُكَذِّبُونَ",
      "text_normalized": "بل الذين كفروا يكذبون",
      "aya_indic": "٢٢",
      "jozz": 30,
      "page": 589
    },
    {
      "sura": 84,
      "aya": 23,
      "text_uthmani": "وَاللَّهُ أَعْلَمُ بِمَا يُوعُونَۖ",
      "text_normalized": "والله اعلم بما يوعون",
      "aya_indic": "٢٣",
      "jozz": 30,
      "page": 589
    },
    {
      "sura": 84,
      "aya": 24,
      "text_uthmani": "فَبَشِّرْهُم بِعَذَابٍ اَلِيمٍۖ",
      "text_normalized": "فبشرهم بعذاب اليم",
      "aya_indic": "٢٤",
      "jozz": 30,
      "page": 589
    },
    {
      "sura": 84,
      "aya": 25,
      "text_uthmani": "اِلَّا اَ۬لذِينَ ءَامَنُواْ وَعَمِلُواْ اُ۬لصَّٰلِحَٰتِ لَهُمُۥٓ أَجْرٌ غَيْرُ مَمْنُونٖۖ",
      "text_normalized": "الا الذين ءامنوا وعملوا الصالحات لهم اجر غير ممنون",
      "aya_indic": "٢٥",
      "jozz": 30,
      "page": 590
    }
  ]
}