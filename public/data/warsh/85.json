{
  "id": 85,
  "name_ar": "البروج",
  "name_en": "Al-Buruj",
  "type": "مكية",
  "ayahs_hafs": 22,
  "ayahs_warsh": 22,
  "page": 590,
  "narration": "warsh",
  "narration_ar": "ورش عن نافع",
  "ayahs": [
    {
      "sura": 85,
      "aya": 1,
      "text_uthmani": "وَالسَّمَآءِ ذَاتِ اِ۬لْبُرُوجِ",
      "text_normalized": "والسماء ذات البروج",
      "aya_indic": "١",
      "jozz": 30,
      "page": 590
    },
    {
      "sura": 85,
      "aya": 2,
      "text_uthmani": "وَالْيَوْمِ اِ۬لْمَوْعُودِ",
      "text_normalized": "واليوم الموعود",
      "aya_indic": "٢",
      "jozz": 30,
      "page": 590
    },
    {
      "sura": 85,
      "aya": 3,
      "text_uthmani": "وَشَاهِدٖ وَمَشْهُودٖ",
      "text_normalized": "وشاهد ومشهود",
      "aya_indic": "٣",
      "jozz": 30,
      "page": 590
    },
    {
      "sura": 85,
      "aya": 4,
      "text_uthmani": "قُتِلَ أَصْحَٰبُ اُ۬لُاخْدُودِ",
      "text_normalized": "قتل اصحاب الاخدود",
      "aya_indic": "٤",
      "jozz": 30,
      "page": 590
    },
    {
      "sura": 85,
      "aya": 5,
      "text_uthmani": "اِ۬لنّ۪ارِ ذَاتِ اِ۬لْوَقُودِ",
      "text_normalized": "النار ذات الوقود",
      "aya_indic": "٥",
      "jozz": 30,
      "page": 590
    },
    {
      "sura": 85,
      "aya": 6,
      "text_uthmani": "إِذْ هُمْ عَلَيْهَا قُعُودٞ",
      "text_normalized": "اذ هم عليها قعود",
      "aya_indic": "٦",
      "jozz": 30,
      "page": 590
    },
    {
      "sura": 85,
      "aya": 7,
      "text_uthmani": "وَهُمْ عَلَىٰ مَا يَفْعَلُونَ بِالْمُومِنِينَ شُهُودٞۖ",
      "text_normalized": "وهم عليا ما يفعلون بالمومنين شهود",
      "aya_indic": "٧",
      "jozz": 30,
      "page": 590
    },
    {
      "sura": 85,
      "aya": 8,
      "text_uthmani": "وَمَا نَقَمُواْ مِنْهُمُۥٓ إِلَّآ أَنْ يُّومِنُواْ بِاللَّهِ اِ۬لْعَزِيزِ اِ۬لْحَمِيدِ",
      "text_normalized": "وما نقموا منهم الا ان يومنوا بالله العزيز الحميد",
      "aya_indic": "٨",
      "jozz": 30,
      "page": 590
    },
    {
      "sura": 85,
      "aya": 9,
      "text_uthmani": "اِ۬لذِے لَهُۥ مُلْكُ اُ۬لسَّمَٰوَٰتِ وَالَارْضِۖ وَاللَّهُ عَلَىٰ كُلِّ شَےْءٖ شَهِيدٌۖ",
      "text_normalized": "الذے له ملك السماوات والارض والله عليا كل شےء شهيد",
      "aya_indic": "٩",
      "jozz": 30,
      "page": 590
    },
    {
      "sura": 85,
      "aya": 10,
      "text_uthmani": "اِنَّ اَ۬لذِينَ فَتَنُواْ اُ۬لْمُومِنِينَ وَالْمُومِنَٰتِ ثُمَّ لَمْ يَتُوبُواْ فَلَهُمْ عَذَابُ جَهَنَّمَ وَلَهُمْ عَذَابُ اُ۬لْحَرِيقِۖ",
      "text_normalized": "ان الذين فتنوا المومنين والمومنات ثم لم يتوبوا فلهم عذاب جهنم ولهم عذاب الحريق",
      "aya_indic": "١٠",
      "jozz": 30,
      "page": 590
    },
    {
      "sura": 85,
      "aya": 11,
      "text_uthmani": "إِنَّ اَ۬لذِينَ ءَامَنُواْ وَعَمِلُواْ اُ۬لصَّٰلِحَٰتِ لَهُمْ جَنَّٰتٞ تَجْرِے مِن تَحْتِهَا اَ۬لَانْهَٰرُۖ ذَٰلِكَ اَ۬لْفَوْزُ اُ۬لْكَبِيرُۖ",
      "text_normalized": "ان الذين ءامنوا وعملوا الصالحات لهم جنات تجرے من تحتها الانهار ذلك الفوز الكبير",
      "aya_indic": "١١",
      "jozz": 30,
      "page": 590
    },
    {
      "sura": 85,
      "aya": 12,
      "text_uthmani": "۞ إِنَّ بَطْشَ رَبِّكَ لَشَدِيدٌۖ",
      "text_normalized": "ان بطش ربك لشديد",
      "aya_indic": "١٢",
      "jozz": 30,
      "page": 590
    },
    {
      "sura": 85,
      "aya": 13,
      "text_uthmani": "اِنَّهُۥ هُوَ يُبْدِۓُ وَيُعِيدُۖ",
      "text_normalized": "انه هو يبدے ويعيد",
      "aya_indic": "١٣",
      "jozz": 30,
      "page": 590
    },
    {
      "sura": 85,
      "aya": 14,
      "text_uthmani": "وَهُوَ اَ۬لْغَفُورُ اُ۬لْوَدُودُ",
      "text_normalized": "وهو الغفور الودود",
      "aya_indic": "١٤",
      "jozz": 30,
      "page": 590
    },
    {
      "sura": 85,
      "aya": 15,
      "text_uthmani": "ذُو اُ۬لْعَرْشِۖ اِ۬لْمَجِيدُ",
      "text_normalized": "ذو العرش المجيد",
      "aya_indic": "١٥",
      "jozz": 30,
      "page": 590
    },
    {
      "sura": 85,
      "aya": 16,
      "text_uthmani": "فَعَّالٞ لِّمَا يُرِيدُۖ",
      "text_normalized": "فعال لما يريد",
      "aya_indic": "١٦",
      "jozz": 30,
      "page": 590
    },
    {
      "sura": 85,
      "aya": 17,
      "text_uthmani": "هَلَ اَت۪يٰكَ حَدِيثُ اُ۬لْجُنُودِ",
      "text_normalized": "هل اتياك حديث الجنود",
      "aya_indic": "١٧",
      "jozz": 30,
      "page": 590
    },
    {
      "sura": 85,
      "aya": 18,
      "text_uthmani": "فِرْعَوْنَ وَثَمُودَۖ",
      "text_normalized": "فرعون وثمود",
      "aya_indic": "١٨",
      "jozz": 30,
      "page": 590
    },
    {
      "sura": 85,
      "aya": 19,
      "text_uthmani": "بَلِ اِ۬لذِينَ كَفَرُواْ فِے تَكْذِيبٖ",
      "text_normalized": "بل الذين كفروا فے تكذيب",
      "aya_indic": "١٩",
      "jozz": 30,
      "page": 590
    },
    {
      "sura": 85,
      "aya": 20,
      "text_uthmani": "وَاللَّهُ مِنْ وَّرَآئِهِم مُّحِيطُۢۖ",
      "text_normalized": "والله من ورايهم محيط",
      "aya_indic": "٢٠",
      "jozz": 30,
      "page": 590
    },
    {
      "sura": 85,
      "aya": 21,
      "text_uthmani": "بَلْ هُوَ قُرْءَانٞ مَّجِيدٞ",
      "text_normalized": "بل هو قرءان مجيد",
      "aya_indic": "٢١",
      "jozz": 30,
      "page": 590
    },
    {
      "sura": 85,
      "aya": 22,
      "text_uthmani": "فِے لَوْحٖ مَّحْفُوظٞۖ",
      "text_normalized": "فے لوح محفوظ",
      "aya_indic": "٢٢",
      "jozz": 30,
      "page": 590
    }
  ]
}