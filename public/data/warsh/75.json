{
  "id": 75,
  "name_ar": "القيامة",
  "name_en": "Al-Qiyamah",
  "type": "مكية",
  "ayahs_hafs": 40,
  "ayahs_warsh": 39,
  "page": 577,
  "narration": "warsh",
  "narration_ar": "ورش عن نافع",
  "ayahs": [
    {
      "sura": 75,
      "aya": 1,
      "text_uthmani": "لَآ أُقْسِمُ بِيَوْمِ اِ۬لْقِيَٰمَةِ",
      "text_normalized": "لا اقسم بيوم القيامه",
      "aya_indic": "١",
      "jozz": 29,
      "page": 577
    },
    {
      "sura": 75,
      "aya": 2,
      "text_uthmani": "وَلَآ أُقْسِمُ بِالنَّفْسِ اِ۬للَّوَّامَةِۖ",
      "text_normalized": "ولا اقسم بالنفس اللوامه",
      "aya_indic": "٢",
      "jozz": 29,
      "page": 577
    },
    {
      "sura": 75,
      "aya": 3,
      "text_uthmani": "أَيَحْسِبُ اُ۬لِانسَٰنُ أَلَّن نَّجْمَعَ عِظَامَهُۥ",
      "text_normalized": "ايحسب الانسان الن نجمع عظامه",
      "aya_indic": "٣",
      "jozz": 29,
      "page": 577
    },
    {
      "sura": 75,
      "aya": 4,
      "text_uthmani": "بَل۪ىٰۖ قَٰدِرِينَ عَلَىٰٓ أَن نُّسَوِّيَ بَنَانَهُۥۖ",
      "text_normalized": "بليا قادرين عليا ان نسوي بنانه",
      "aya_indic": "٤",
      "jozz": 29,
      "page": 577
    },
    {
      "sura": 75,
      "aya": 5,
      "text_uthmani": "بَلْ يُرِيدُ اُ۬لِانسَٰنُ لِيَفْجُرَ أَمَامَهُۥۖ",
      "text_normalized": "بل يريد الانسان ليفجر امامه",
      "aya_indic": "٥",
      "jozz": 29,
      "page": 577
    },
    {
      "sura": 75,
      "aya": 6,
      "text_uthmani": "يَسْـَٔلُ أَيَّانَ يَوْمُ اُ۬لْقِيَٰمَةِۖ",
      "text_normalized": "يسل ايان يوم القيامه",
      "aya_indic": "٦",
      "jozz": 29,
      "page": 577
    },
    {
      "sura": 75,
      "aya": 7,
      "text_uthmani": "فَإِذَا بَرَقَ اَ۬لْبَصَرُ",
      "text_normalized": "فاذا برق البصر",
      "aya_indic": "٧",
      "jozz": 29,
      "page": 577
    },
    {
      "sura": 75,
      "aya": 8,
      "text_uthmani": "وَخَسَفَ اَ۬لْقَمَرُ",
      "text_normalized": "وخسف القمر",
      "aya_indic": "٨",
      "jozz": 29,
      "page": 577
    },
    {
      "sura": 75,
      "aya": 9,
      "text_uthmani": "وَجُمِعَ اَ۬لشَّمْسُ وَالْقَمَرُ",
      "text_normalized": "وجمع الشمس والقمر",
      "aya_indic": "٩",
      "jozz": 29,
      "page": 577
    },
    {
      "sura": 75,
      "aya": 10,
      "text_uthmani": "يَقُولُ اُ۬لِانسَٰنُ يَوْمَئِذٍ اَيْنَ اَ۬لْمَفَرُّۖ",
      "text_normalized": "يقول الانسان يوميذ اين المفر",
      "aya_indic": "١٠",
      "jozz": 29,
      "page": 577
    },
    {
      "sura": 75,
      "aya": 11,
      "text_uthmani": "كَلَّا لَا وَزَرَۖ",
      "text_normalized": "كلا لا وزر",
      "aya_indic": "١١",
      "jozz": 29,
      "page": 577
    },
    {
      "sura": 75,
      "aya": 12,
      "text_uthmani": "إِلَىٰ رَبِّكَ يَوْمَئِذٍ اِ۬لْمُسْتَقَرُّۖ",
      "text_normalized": "اليا ربك يوميذ المستقر",
      "aya_indic": "١٢",
      "jozz": 29,
      "page": 577
    },
    {
      "sura": 75,
      "aya": 13,
      "text_uthmani": "يُنَبَّؤُاْ اُ۬لِانسَٰنُ يَوْمَئِذِۢ بِمَا قَدَّمَ وَأَخَّرَۖ",
      "text_normalized": "ينبوا الانسان يوميذ بما قدم واخر",
      "aya_indic": "١٣",
      "jozz": 29,
      "page": 577
    },
    {
      "sura": 75,
      "aya": 14,
      "text_uthmani": "بَلِ اِ۬لِانسَٰنُ عَلَىٰ نَفْسِهِۦ بَصِيرَةٞ",
      "text_normalized": "بل الانسان عليا نفسه بصيره",
      "aya_indic": "١٤",
      "jozz": 29,
      "page": 577
    },
    {
      "sura": 75,
      "aya": 15,
      "text_uthmani": "وَلَوَ اَلْق۪ىٰ مَعَاذِيرَهُۥۖ",
      "text_normalized": "ولو القيا معاذيره",
      "aya_indic": "١٥",
      "jozz": 29,
      "page": 577
    },
    {
      "sura": 75,
      "aya": 16,
      "text_uthmani": "لَا تُحَرِّكْ بِهِۦ لِسَانَكَ لِتَعْجَلَ بِهِۦٓۖ إِنَّ عَلَيْنَا جَمْعَهُۥ وَقُرْءَانَهُۥۖ",
      "text_normalized": "لا تحرك به لسانك لتعجل به ان علينا جمعه وقرءانه",
      "aya_indic": "١٦",
      "jozz": 29,
      "page": 577
    },
    {
      "sura": 75,
      "aya": 17,
      "text_uthmani": "فَإِذَا قَرَأْنَٰهُ فَاتَّبِعْ قُرْءَانَهُۥ",
      "text_normalized": "فاذا قراناه فاتبع قرءانه",
      "aya_indic": "١٧",
      "jozz": 29,
      "page": 577
    },
    {
      "sura": 75,
      "aya": 18,
      "text_uthmani": "ثُمَّ إِنَّ عَلَيْنَا بَيَانَهُۥۖ",
      "text_normalized": "ثم ان علينا بيانه",
      "aya_indic": "١٨",
      "jozz": 29,
      "page": 577
    },
    {
      "sura": 75,
      "aya": 19,
      "text_uthmani": "كَلَّا بَلْ تُحِبُّونَ اَ۬لْعَاجِلَةَ",
      "text_normalized": "كلا بل تحبون العاجله",
      "aya_indic": "١٩",
      "jozz": 29,
      "page": 578
    },
    {
      "sura": 75,
      "aya": 20,
      "text_uthmani": "وَتَذَرُونَ اَ۬لَاخِرَةَۖ",
      "text_normalized": "وتذرون الاخره",
      "aya_indic": "٢٠",
      "jozz": 29,
      "page": 578
    },
    {
      "sura": 75,
      "aya": 21,
      "text_uthmani": "وُجُوهٞ يَوْمَئِذٖ نَّاضِرَةٌ",
      "text_normalized": "وجوه يوميذ ناضره",
      "aya_indic": "٢١",
      "jozz": 29,
      "page": 578
    },
    {
      "sura": 75,
      "aya": 22,
      "text_uthmani": "اِلَىٰ رَبِّهَا نَاظِرَةٞۖ",
      "text_normalized": "اليا ربها ناظره",
      "aya_indic": "٢٢",
      "jozz": 29,
      "page": 578
    },
    {
      "sura": 75,
      "aya": 23,
      "text_uthmani": "وَوُجُوهٞ يَوْمَئِذِۢ بَاسِرَةٞ",
      "text_normalized": "ووجوه يوميذ باسره",
      "aya_indic": "٢٣",
      "jozz": 29,
      "page": 578
    },
    {
      "sura": 75,
      "aya": 24,
      "text_uthmani": "تَظُنُّ أَنْ يُّفْعَلَ بِهَا فَاقِرَةٞۖ",
      "text_normalized": "تظن ان يفعل بها فاقره",
      "aya_indic": "٢٤",
      "jozz": 29,
      "page": 578
    },
    {
      "sura": 75,
      "aya": 25,
      "text_uthmani": "كَلَّآ إِذَا بَلَغَتِ اِ۬لتَّرَاقِيَ",
      "text_normalized": "كلا اذا بلغت التراقي",
      "aya_indic": "٢٥",
      "jozz": 29,
      "page": 578
    },
    {
      "sura": 75,
      "aya": 26,
      "text_uthmani": "وَقِيلَ مَن رَّاقٖ",
      "text_normalized": "وقيل من راق",
      "aya_indic": "٢٦",
      "jozz": 29,
      "page": 578
    },
    {
      "sura": 75,
      "aya": 27,
      "text_uthmani": "وَظَنَّ أَنَّهُ اُ۬لْفِرَاقُ",
      "text_normalized": "وظن انه الفراق",
      "aya_indic": "٢٧",
      "jozz": 29,
      "page": 578
    },
    {
      "sura": 75,
      "aya": 28,
      "text_uthmani": "وَالْتَفَّتِ اِ۬لسَّاقُ بِالسَّاقِ",
      "text_normalized": "والتفت الساق بالساق",
      "aya_indic": "٢٨",
      "jozz": 29,
      "page": 578
    },
    {
      "sura": 75,
      "aya": 29,
      "text_uthmani": "إِلَىٰ رَبِّكَ يَوْمَئِذٍ اِ۬لْمَسَاقُۖ",
      "text_normalized": "اليا ربك يوميذ المساق",
      "aya_indic": "٢٩",
      "jozz": 29,
      "page": 578
    },
    {
      "sura": 75,
      "aya": 30,
      "text_uthmani": "فَلَا صَدَّقَ وَلَا صَلّ۪ىٰۖ",
      "text_normalized": "فلا صدق ولا صليا",
      "aya_indic": "٣٠",
      "jozz": 29,
      "page": 578
    },
    {
      "sura": 75,
      "aya": 31,
      "text_uthmani": "وَلَٰكِن كَذَّبَ وَتَوَلّ۪ىٰۖ",
      "text_normalized": "ولاكن كذب وتوليا",
      "aya_indic": "٣١",
      "jozz": 29,
      "page": 578
    },
    {
      "sura": 75,
      "aya": 32,
      "text_uthmani": "ثُمَّ ذَهَبَ إِلَىٰٓ أَهْلِهِۦ يَتَمَطّ۪ىٰٓۖ",
      "text_normalized": "ثم ذهب اليا اهله يتمطيا",
      "aya_indic": "٣٢",
      "jozz": 29,
      "page": 578
    },
    {
      "sura": 75,
      "aya": 33,
      "text_uthmani": "أَوْل۪ىٰ لَكَ فَأَوْل۪ىٰ",
      "text_normalized": "اوليا لك فاوليا",
      "aya_indic": "٣٣",
      "jozz": 29,
      "page": 578
    },
    {
      "sura": 75,
      "aya": 34,
      "text_uthmani": "ثُمَّ أَوْل۪ىٰ لَكَ فَأَوْل۪ىٰٓۖ",
      "text_normalized": "ثم اوليا لك فاوليا",
      "aya_indic": "٣٤",
      "jozz": 29,
      "page": 578
    },
    {
      "sura": 75,
      "aya": 35,
      "text_uthmani": "أَيَحْسِبُ اُ۬لِانسَٰنُ أَنْ يُّتْرَكَ سُدىًۖ",
      "text_normalized": "ايحسب الانسان ان يترك سدي",
      "aya_indic": "٣٥",
      "jozz": 29,
      "page": 578
    },
    {
      "sura": 75,
      "aya": 36,
      "text_uthmani": "اَلَمْ يَكُ نُطْفَةٗ مِّن مَّنِيّٖ تُمْن۪ىٰ",
      "text_normalized": "الم يك نطفه من مني تمنيا",
      "aya_indic": "٣٦",
      "jozz": 29,
      "page": 578
    },
    {
      "sura": 75,
      "aya": 37,
      "text_uthmani": "ثُمَّ كَانَ عَلَقَةٗ فَخَلَقَ فَسَوّ۪ىٰ",
      "text_normalized": "ثم كان علقه فخلق فسويا",
      "aya_indic": "٣٧",
      "jozz": 29,
      "page": 578
    },
    {
      "sura": 75,
      "aya": 38,
      "text_uthmani": "فَجَعَلَ مِنْهُ اُ۬لزَّوْجَيْنِ اِ۬لذَّكَرَ وَالُانث۪ىٰٓۖ",
      "text_normalized": "فجعل منه الزوجين الذكر والانثيا",
      "aya_indic": "٣٨",
      "jozz": 29,
      "page": 578
    },
    {
      "sura": 75,
      "aya": 39,
      "text_uthmani": "أَلَيْسَ ذَٰلِكَ بِقَٰدِرٍ عَلَىٰٓ أَنْ يُّحْـِۧيَ اَ۬لْمَوْت۪ىٰۖ",
      "text_normalized": "اليس ذلك بقادر عليا ان يحي الموتيا",
      "aya_indic": "٣٩",
      "jozz": 29,
      "page": 578
    }
  ]
}