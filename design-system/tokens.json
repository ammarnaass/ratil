{
  "$name": "Ratil Design Tokens",
  "$version": "1.0.0",
  "description": "Design Tokens for Ratil (رتل) - Audible Quran Web Application",
  "color": {
    "bg": {
      "dark": {
        "$value": "#111318",
        "$type": "color",
        "$description": "خلفية ليلية أساسية عالية التباين ومريحة للعين"
      },
      "light": {
        "$value": "#FAFAFA",
        "$type": "color",
        "$description": "خلفية نهارية نظيفة وهادئة"
      }
    },
    "surface": {
      "dark": {
        "$value": "#1C1F27",
        "$type": "color",
        "$description": "أسطح الكروت والمشغل والـ Bottom Sheet في الوضع الليلي"
      },
      "light": {
        "$value": "#FFFFFF",
        "$type": "color",
        "$description": "أسطح الكروت والمشغل في الوضع النهاري"
      }
    },
    "accent": {
      "base": {
        "$value": "#3ECFB2",
        "$type": "color",
        "$description": "أخضر فيروزي - لون التمييز الأوحد والأساسي للتطبيق"
      },
      "dim": {
        "$value": "#2BA890",
        "$type": "color",
        "$description": "الحالات المضغوطة والأزرار الثانوية النشطة"
      }
    },
    "text": {
      "primary": {
        "dark": {
          "$value": "#F0F0F0",
          "$type": "color"
        },
        "light": {
          "$value": "#111318",
          "$type": "color"
        }
      },
      "muted": {
        "dark": {
          "$value": "#6B7280",
          "$type": "color"
        },
        "light": {
          "$value": "#9CA3AF",
          "$type": "color"
        }
      }
    },
    "quran": {
      "dark": {
        "$value": "#EAEAEA",
        "$type": "color",
        "$description": "لون النص القرآني المعتمد ليلاً (تباين 12:1)"
      },
      "light": {
        "$value": "#1A1A1A",
        "$type": "color",
        "$description": "لون النص القرآني المعتمد نهاراً (تباين 16:1)"
      }
    },
    "highlight": {
      "bg": {
        "$value": "rgba(62, 207, 178, 0.12)",
        "$type": "color",
        "$description": "خلفية تظليل الآية الجارية"
      },
      "border": {
        "$value": "#3ECFB2",
        "$type": "color",
        "$description": "الحد الجانبي البارز للآية الجارية (3px)"
      }
    }
  },
  "typography": {
    "fontFamily": {
      "quran": {
        "$value": "KFGQPC Uthmanic, 'Uthmanic Hafs', Amiri, serif",
        "$type": "fontFamily"
      },
      "ui": {
        "$value": "'IBM Plex Arabic', -apple-system, BlinkMacSystemFont, sans-serif",
        "$type": "fontFamily"
      }
    },
    "fontSize": {
      "quran": {
        "mobile": {
          "sm": { "$value": "20px", "$type": "dimension" },
          "md": { "$value": "22px", "$type": "dimension" },
          "lg": { "$value": "26px", "$type": "dimension" }
        },
        "desktop": {
          "sm": { "$value": "22px", "$type": "dimension" },
          "md": { "$value": "26px", "$type": "dimension" },
          "lg": { "$value": "32px", "$type": "dimension" }
        }
      },
      "ui": {
        "body": { "$value": "16px", "$type": "dimension" },
        "caption": { "$value": "14px", "$type": "dimension" },
        "surahTitle": { "$value": "22px", "$type": "dimension" }
      }
    },
    "lineHeight": {
      "quran": {
        "mobile": { "$value": "2.2", "$type": "number" },
        "desktop": { "$value": "2.3", "$type": "number" }
      },
      "ui": { "$value": "1.5", "$type": "number" }
    }
  },
  "spacing": {
    "player": {
      "collapsed": { "$value": "44px", "$type": "dimension" },
      "expanded": { "$value": "80px", "$type": "dimension" }
    },
    "touchTarget": {
      "min": { "$value": "44px", "$type": "dimension" }
    },
    "container": {
      "mobileGutter": { "$value": "20px", "$type": "dimension" },
      "desktopGutter": { "$value": "15%", "$type": "dimension" }
    }
  },
  "motion": {
    "playerTransition": {
      "$value": "180ms ease-out",
      "$type": "transition"
    },
    "highlightDuration": {
      "$value": "3000ms",
      "$type": "duration"
    }
  }
}
