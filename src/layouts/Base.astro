---
interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  activeNav?: 'home' | 'browse' | 'reciters' | 'bookmarks' | 'offline' | 'sync' | 'login' | 'admin';
}

const {
  title = "رتل — مصحف مسموع",
  description = "مشغّل تلاوات القرآن الكريم مع تتبع الآية وعرض النص القرآني المعتمد بروايتي حفص وورش",
  canonicalUrl = "https://ratil.app",
  activeNav = "home"
} = Astro.props;

import Player from '../components/Player.tsx';
---

<!DOCTYPE html>
<html lang="ar" dir="rtl" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#111318" />

  <!-- Canonical & Open Graph -->
  <link rel="canonical" href={canonicalUrl} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:site_name" content="رتل" />

  <!-- Web Manifest (PWA) -->
  <link rel="manifest" href="/manifest.webmanifest" />

  <!-- Favicons -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />

  <!-- Preload Fonts -->
  <link rel="preload" href="/fonts/hafs.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/warsh.woff2" as="font" type="font/woff2" crossorigin />

  <!-- Google Fonts: IBM Plex Arabic -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

  <!-- Stylesheets -->
  <link rel="stylesheet" href="/src/styles/tokens.css" />
  <link rel="stylesheet" href="/src/styles/app.css" />
</head>
<body class="theme-dark">
  <!-- هالات الإضاءة الروحانية الخلفية -->
  <div class="ambient-glow ambient-glow-top" aria-hidden="true"></div>
  <div class="ambient-glow ambient-glow-bottom" aria-hidden="true"></div>

  <!-- الترويسة الرئيسية -->
  <header class="site-header" id="site-header">
    <div class="header-container site-header-inner">
      <div class="brand-group">
        <a href="/" class="logo-link" aria-label="الرئيسية — رتل">
          <img src="/icons/logo.svg" alt="رَتِّـلْ — مصحف مسموع" class="brand-logo-img" width="160" height="38" />
        </a>
      </div>

      <!-- تبويبات التنقل الرئيسية لسطح المكتب -->
      <nav class="desktop-nav" aria-label="التنقل الرئيسي">
        <a href="/" class={`nav-tab ${activeNav === 'home' ? 'active' : ''}`}>
          الرئيسية
        </a>
        <a href="/surah/1" class={`nav-tab ${activeNav === 'browse' ? 'active' : ''}`}>
          تصفح المصحف
        </a>
        <a href="/reciter/al-minshawy" class={`nav-tab ${activeNav === 'reciters' ? 'active' : ''}`}>
          القرّاء المعتمدون
        </a>
        <a href="/sync" class={`nav-tab ${activeNav === 'sync' ? 'active' : ''}`}>
          المزامنة المشفرة 🔐
        </a>
        <a href="/admin" class={`nav-tab ${activeNav === 'admin' ? 'active' : ''}`}>
          لوحة التحكم ⚙️
        </a>
      </nav>

      <!-- شارة أمان النص القرآني وإجراءات الحساب -->
      <div class="header-actions">
        <a href="/login" class={`nav-tab ${activeNav === 'login' ? 'active' : ''}`} style="font-size: 0.8125rem; display: inline-flex; align-items: center; gap: 0.25rem;">
          <span class="material-symbols-outlined" style="font-size: 1.125rem;">account_circle</span>
          <span>تسجيل الدخول</span>
        </a>
        <div class="verified-badge-pill" title="نص قرآني معتمد ومفحوص رقمياً عبر SHA-256">
          <span class="pulse-dot"></span>
          <span>نص معتمد (حفص)</span>
        </div>
      </div>
    </div>
  </header>

  <!-- المحتوى الرئيسي للصفحة -->
  <main id="main-content" class="site-main">
    <slot />
  </main>

  <!-- مشغّل الصوت الثابت الدائم (React Island) -->
  <Player client:idle />

  <!-- تذييل الصفحة البسيط -->
  <footer class="site-footer">
    <div class="footer-inner">
      <p class="footer-ayah">﴿وَرَتِّلِ الْقُرْآنَ تَرْتِيلًا﴾</p>
      <p class="footer-meta">
        مشروع «رَتِّلْ» — مصحف مسموع ثابت ومستقل. النص معتمد من مشروع تنزيل ومجمع الملك فهد، ومفحوص رقمياً عند كل بناء.
      </p>
      <div class="footer-links">
        <span>بدون إعلانات</span> •
        <span>بدون خوادم وقت التشغيل</span> •
        <span>خصوصية تامة 100%</span>
      </div>
    </div>
  </footer>

  <!-- تسجيل Service Worker للعمل دون اتصال -->
  <script is:inline>
    if ('serviceWorker' in navigator && window.location.protocol.startsWith('http')) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('/sw.js').catch(err => {
          console.debug('ServiceWorker registration skipped:', err);
        });
      });
    }
  </script>
</body>
</html>
