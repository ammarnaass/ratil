---
import Base from '../layouts/Base.astro';
---

<Base title="المزامنة الآمنة والنسخ الاحتياطي — رتل" activeNav="home">
  <div class="sync-page-container">
    
    <!-- بطاقة الترويسة -->
    <header class="sync-page-header">
      <div class="sync-badge-chip">
        <span class="sync-chip-icon">🔐</span>
        <span>تشفير صفري محلي (Zero-Knowledge)</span>
      </div>
      <h1 class="sync-page-title">المزامنة المشفرة وحفظ العلامات</h1>
      <p class="sync-page-subtitle">
        في «رَتِّـلْ»، لا نطلب بريداً إلكترونياً ولا كلمة مرور. خلوتك مع كتاب الله مقدسة؛ علامتك وموضع تلاوتك مشفرة في جهازك، وتتنقل بين أجهزتك بمفتاحك الخاص دون أن يرى خادمنا شيئاً.
      </p>
    </header>

    <!-- البطاقات التفاعلية الثلاث -->
    <div class="sync-cards-stack">
      
      <!-- البطاقة 1: مفتاح الجهاز الحالي -->
      <section class="sync-card">
        <div class="sync-card-header">
          <div class="sync-icon-circle">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 2l-2 2m-1.5 1.5L12 11l4 4 5.5-5.5a2.121 2.121 0 0 0 0-3L20 5m-1.5-1.5L20 2m-8 9l-4 4-2-2-4 4 4 4 4-4-2-2 4-4"></path>
            </svg>
          </div>
          <div>
            <h2 class="sync-card-title">مفتاح مزامنة هذا الجهاز</h2>
            <p class="sync-card-desc">استخدم هذا الرمز لربط حاسوبك أو جهازك اللوحي بمصحفك</p>
          </div>
        </div>

        <div class="sync-key-display-box">
          <code id="current-sync-code" class="sync-code-text">جاري استخراج المفتاح...</code>
          <button id="copy-sync-code-btn" class="sync-action-btn" title="نسخ الكود">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
            </svg>
            <span id="copy-btn-label">نسخ المفتاح</span>
          </button>
        </div>

        <div class="sync-card-footer">
          <button id="regenerate-key-btn" class="sync-text-btn">توليد مفتاح جديد للجهاز</button>
        </div>
      </section>

      <!-- البطاقة 2: ربط جهاز واسترجاع العلامات -->
      <section class="sync-card">
        <div class="sync-card-header">
          <div class="sync-icon-circle">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
              <line x1="8" y1="21" x2="16" y2="21"></line>
              <line x1="12" y1="17" x2="12" y2="21"></line>
            </svg>
          </div>
          <div>
            <h2 class="sync-card-title">ربط جهاز آخر أو استعادة ختمتك</h2>
            <p class="sync-card-desc">أدخل كود المزامنة من جهازك القديم لمزامنة علامتك فوراً</p>
          </div>
        </div>

        <div class="sync-input-row">
          <input 
            type="text" 
            id="import-sync-code-input" 
            class="sync-text-input" 
            placeholder="مثال: RTL7-8K2A-9MP4-XW32" 
            dir="ltr"
            autocomplete="off"
            spellcheck="false"
          />
          <button id="apply-sync-code-btn" class="sync-primary-btn">
            ربط ومزامنة
          </button>
        </div>
        <p id="sync-status-msg" class="sync-status-msg"></p>
      </section>

      <!-- البطاقة 3: النسخ الاحتياطي اليدوي بملف مستقل -->
      <section class="sync-card">
        <div class="sync-card-header">
          <div class="sync-icon-circle">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
          </div>
          <div>
            <h2 class="sync-card-title">النسخة الاحتياطية المستقلة (ملف محلي)</h2>
            <p class="sync-card-desc">احفظ نسخة من علاماتك ومواضعك كملف JSON آمن على هاتفك</p>
          </div>
        </div>

        <div class="sync-buttons-duo">
          <button id="export-backup-btn" class="sync-secondary-btn">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            <span>تصدير نسخة احتياطية (.json)</span>
          </button>

          <label class="sync-file-upload-label">
            <input type="file" id="import-backup-file-input" accept=".json" class="hidden-file-input" />
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="17 8 12 3 7 8"></polyline>
              <line x1="12" y1="3" x2="12" y2="15"></line>
            </svg>
            <span>استيراد ملف نسخة سابقة</span>
          </label>
        </div>
      </section>

    </div>
  </div>

  <script>
    import {
      getOrInitLocalSyncCode,
      setLocalSyncCode,
      generateReadableSyncCode,
      exportBackupFile,
      importBackupFile
    } from '../core/sync-identity.js';

    // 1. عرض المفتاح المحلي الحالي
    const codeEl = document.getElementById('current-sync-code');
    const copyBtn = document.getElementById('copy-sync-code-btn');
    const copyLabel = document.getElementById('copy-btn-label');
    const regenBtn = document.getElementById('regenerate-key-btn');

    let currentCode = getOrInitLocalSyncCode();
    if (codeEl) codeEl.textContent = currentCode;

    if (copyBtn) {
      copyBtn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(currentCode);
          if (copyLabel) copyLabel.textContent = 'تم النسخ!';
          setTimeout(() => {
            if (copyLabel) copyLabel.textContent = 'نسخ المفتاح';
          }, 2000);
        } catch (e) {
          alert('الكود: ' + currentCode);
        }
      });
    }

    if (regenBtn) {
      regenBtn.addEventListener('click', () => {
        if (confirm('هل أنت متأكد من إنشاء مفتاح مزامنة جديد لهذا الجهاز؟')) {
          const fresh = generateReadableSyncCode();
          setLocalSyncCode(fresh);
          currentCode = fresh;
          if (codeEl) codeEl.textContent = fresh;
        }
      });
    }

    // 2. تطبيق كود مزامنة خارجي
    const importInput = document.getElementById('import-sync-code-input') as HTMLInputElement | null;
    const applyBtn = document.getElementById('apply-sync-code-btn');
    const statusMsg = document.getElementById('sync-status-msg');

    if (applyBtn && importInput) {
      applyBtn.addEventListener('click', () => {
        const val = importInput.value.trim().toUpperCase();
        if (val.length < 8) {
          if (statusMsg) {
            statusMsg.textContent = 'يرجى إدخال كود مزامنة صحيح.';
            statusMsg.style.color = '#ffb4ab';
          }
          return;
        }

        setLocalSyncCode(val);
        currentCode = val;
        if (codeEl) codeEl.textContent = val;
        if (statusMsg) {
          statusMsg.textContent = 'تم ربط الجهاز بنجاح بمفتاح المزامنة المشفر.';
          statusMsg.style.color = '#61eccd';
        }
      });
    }

    // 3. تصدير واستيراد ملف النسخ الاحتياطي
    const exportBtn = document.getElementById('export-backup-btn');
    const importFileInput = document.getElementById('import-backup-file-input') as HTMLInputElement | null;

    if (exportBtn) {
      exportBtn.addEventListener('click', () => {
        exportBackupFile();
      });
    }

    if (importFileInput) {
      importFileInput.addEventListener('change', async (e) => {
        const target = e.target as HTMLInputElement;
        const file = target.files?.[0];
        if (!file) return;

        try {
          await importBackupFile(file);
          alert('تمت استعادة النسخة الاحتياطية بنجاح إلى هذا الجهاز.');
          window.location.reload();
        } catch (err: any) {
          alert(err.message || 'فشل استيراد النسخة الاحتياطية.');
        }
      });
    }
  </script>
</Base>

<style>
.sync-page-container {
  max-width: 760px;
  margin: 0 auto;
  padding: 40px 20px 100px;
}

.sync-page-header {
  text-align: center;
  margin-bottom: 36px;
}

.sync-badge-chip {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 6px 14px;
  background: rgba(97, 236, 205, 0.08);
  border: 1px solid rgba(97, 236, 205, 0.2);
  border-radius: 9999px;
  font-size: 13px;
  color: var(--color-primary, #61eccd);
  margin-bottom: 16px;
}

.sync-page-title {
  font-size: 32px;
  font-weight: 700;
  color: var(--color-text-main, #e2e2e9);
  margin: 0 0 12px;
}

.sync-page-subtitle {
  font-size: 15px;
  line-height: 1.7;
  color: var(--color-text-muted, #bbcac4);
  max-width: 600px;
  margin: 0 auto;
}

.sync-cards-stack {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.sync-card {
  background: var(--color-surface, #181B22);
  border: 1px solid var(--color-border, rgba(255, 255, 255, 0.08));
  border-radius: 20px;
  padding: 24px;
}

.sync-card-header {
  display: flex;
  align-items: flex-start;
  gap: 16px;
  margin-bottom: 20px;
}

.sync-icon-circle {
  width: 44px;
  height: 44px;
  border-radius: 12px;
  background: rgba(97, 236, 205, 0.1);
  color: var(--color-primary, #61eccd);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.sync-card-title {
  font-size: 18px;
  font-weight: 600;
  color: var(--color-text-main, #e2e2e9);
  margin: 0 0 4px;
}

.sync-card-desc {
  font-size: 13px;
  color: var(--color-text-muted, #bbcac4);
  margin: 0;
}

.sync-key-display-box {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(0, 0, 0, 0.3);
  border: 1px solid var(--color-border, rgba(255, 255, 255, 0.06));
  border-radius: 12px;
  padding: 12px 18px;
  gap: 12px;
  flex-wrap: wrap;
}

.sync-code-text {
  font-family: monospace;
  font-size: 18px;
  font-weight: 600;
  letter-spacing: 2px;
  color: var(--color-primary, #61eccd);
}

.sync-action-btn, .sync-primary-btn, .sync-secondary-btn, .sync-file-upload-label {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  border-radius: 10px;
  font-size: 14px;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.2s ease;
}

.sync-action-btn {
  background: var(--color-surface, #1e222b);
  border: 1px solid var(--color-border, rgba(255, 255, 255, 0.1));
  color: var(--color-text-main, #e2e2e9);
  padding: 8px 14px;
}

.sync-action-btn:hover {
  background: rgba(255, 255, 255, 0.08);
}

.sync-card-footer {
  margin-top: 14px;
  text-align: left;
}

.sync-text-btn {
  background: none;
  border: none;
  color: var(--color-text-muted, #bbcac4);
  font-size: 12px;
  cursor: pointer;
  padding: 0;
  text-decoration: underline;
}

.sync-text-btn:hover {
  color: var(--color-primary, #61eccd);
}

.sync-input-row {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
}

.sync-text-input {
  flex: 1;
  min-width: 220px;
  background: rgba(0, 0, 0, 0.3);
  border: 1px solid var(--color-border, rgba(255, 255, 255, 0.1));
  border-radius: 10px;
  padding: 10px 14px;
  color: var(--color-text-main, #e2e2e9);
  font-size: 15px;
  font-family: monospace;
  letter-spacing: 1px;
}

.sync-text-input:focus {
  outline: none;
  border-color: var(--color-primary, #61eccd);
}

.sync-primary-btn {
  background: var(--color-primary, #61eccd);
  color: #00382e;
  border: none;
  padding: 10px 20px;
  font-weight: 600;
}

.sync-primary-btn:hover {
  opacity: 0.9;
}

.sync-status-msg {
  font-size: 13px;
  margin: 10px 0 0;
  min-height: 18px;
}

.sync-buttons-duo {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
}

.sync-secondary-btn, .sync-file-upload-label {
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid var(--color-border, rgba(255, 255, 255, 0.1));
  color: var(--color-text-main, #e2e2e9);
  padding: 10px 16px;
}

.sync-secondary-btn:hover, .sync-file-upload-label:hover {
  background: rgba(255, 255, 255, 0.09);
}

.hidden-file-input {
  display: none;
}
</style>
