---
import Base from '../../../layouts/Base.astro';
import reciters from '../../../../data/reciters.json';
import surahs from '../../../../data/surahs.json';
import audioManifest from '../../../../data/audio-manifest.json';

export async function getStaticPaths() {
  return reciters.map((r) => ({
    params: { id: r.id },
    props: { reciter: r }
  }));
}

const { id } = Astro.params;
const { reciter } = Astro.props;

// قراءة السور المتوفرة لهذا القارئ من الـ audio-manifest
const manifestReciter = (audioManifest.reciters as any)[id] || {};
const availableSurahsMap = manifestReciter.surahs || {};
const availableSurahIds = Object.keys(availableSurahsMap).map(Number);

// قائمة السور المسجلة
const recordedSurahs = surahs.filter((s) => availableSurahIds.includes(s.id));
// السور الأخرى المتبقية
const otherSurahs = surahs.filter((s) => !availableSurahIds.includes(s.id));
---

<Base 
  title={`${reciter.name} — رتل | مصحف مسموع`}
  description={`تلاوات ${reciter.name} برواية ${reciter.riwaya === 'hafs' ? 'حفص عن عاصم' : 'ورش عن نافع'} — تسجيلات نقية وأرشيف معتمد.`}
  activeNav="reciters"
>
  <div class="reciter-profile-container">

    <!-- بطاقة تعريف القارئ -->
    <header class="reciter-hero-card">
      <div class="reciter-avatar-large">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"></path>
          <path d="M19 10v2a7 7 0 0 1-14 0v-2"></path>
          <line x1="12" y1="19" x2="12" y2="22"></line>
        </svg>
      </div>

      <div class="reciter-info-block">
        <span class="riwaya-badge">
          رواية {reciter.riwaya === 'hafs' ? 'حفص عن عاصم' : 'ورش عن نافع'}
        </span>
        <h1 class="reciter-title-name">{reciter.name}</h1>
        <p class="reciter-source-meta">
          المصدر: {reciter.source} • الترخيص: {reciter.license}
        </p>
      </div>
    </header>

    <!-- قائمة التلاوات المتوفرة -->
    <section class="recorded-surahs-section">
      <h2 class="section-title">التلاوات المتوفرة والموثقة ({recordedSurahs.length} سورة)</h2>

      <div class="surahs-cards-grid">
        {recordedSurahs.map((s) => (
          <div class="recorded-card">
            <div class="recorded-card-main">
              <span class="surah-num">{String(s.id).padStart(3, '0')}</span>
              <div>
                <h3 class="surah-title">سورة {s.name_ar}</h3>
                <span class="surah-sub">{s.type} • {s.ayahs_hafs} آية</span>
              </div>
            </div>

            <div class="recorded-card-actions">
              <a href={`/reciter/${id}/surah/${s.id}`} class="reciter-listen-link">
                استماع وتتبع الآية
              </a>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- باقي سور المصحف الشريف -->
    {otherSurahs.length > 0 && (
      <section class="all-surahs-section">
        <h2 class="section-title">قراءة نص باقي السور (نص عثماني معتمد)</h2>
        <div class="surahs-cards-grid">
          {otherSurahs.slice(0, 12).map((s) => (
            <a href={`/surah/${s.id}`} class="other-surah-card">
              <span class="surah-num">{String(s.id).padStart(3, '0')}</span>
              <span class="surah-title">سورة {s.name_ar}</span>
            </a>
          ))}
        </div>
      </section>
    )}

  </div>
</Base>

<style>
.reciter-profile-container {
  max-width: 1000px;
  margin: 0 auto;
  padding: 40px 20px 80px;
}

.reciter-hero-card {
  display: flex;
  align-items: center;
  gap: 24px;
  padding: 32px;
  background: var(--color-surface, #181B22);
  border: 1px solid var(--color-border, rgba(255, 255, 255, 0.08));
  border-radius: 24px;
  margin-bottom: 40px;
}

.reciter-avatar-large {
  width: 80px;
  height: 80px;
  border-radius: 50%;
  background: rgba(62, 207, 178, 0.12);
  color: var(--color-primary, #3ECFB2);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.riwaya-badge {
  font-size: 13px;
  font-weight: 600;
  color: var(--color-primary, #3ECFB2);
  background: rgba(62, 207, 178, 0.1);
  padding: 3px 10px;
  border-radius: 8px;
  display: inline-block;
  margin-bottom: 8px;
}

.reciter-title-name {
  font-size: 28px;
  font-weight: 800;
  color: var(--color-text-primary, #F3F4F6);
  margin-bottom: 6px;
}

.reciter-source-meta {
  font-size: 14px;
  color: var(--color-text-secondary, #9EA3B0);
}

.section-title {
  font-size: 20px;
  font-weight: 700;
  color: var(--color-text-primary, #F3F4F6);
  margin-bottom: 20px;
}

.surahs-cards-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 16px;
  margin-bottom: 40px;
}

.recorded-card {
  background: var(--color-surface, #181B22);
  border: 1px solid var(--color-border, rgba(255, 255, 255, 0.08));
  border-radius: 16px;
  padding: 18px;
  display: flex;
  flex-direction: column;
  gap: 14px;
  transition: all 0.2s ease;
}

.recorded-card:hover {
  border-color: var(--color-primary, #3ECFB2);
  transform: translateY(-2px);
}

.recorded-card-main {
  display: flex;
  align-items: center;
  gap: 14px;
}

.surah-num {
  font-size: 13px;
  font-weight: 700;
  color: var(--color-primary, #3ECFB2);
  background: rgba(62, 207, 178, 0.1);
  padding: 4px 8px;
  border-radius: 8px;
}

.surah-title {
  font-size: 17px;
  font-weight: 700;
  color: var(--color-text-primary, #F3F4F6);
}

.surah-sub {
  font-size: 12px;
  color: var(--color-text-secondary, #9EA3B0);
}

.reciter-listen-link {
  display: block;
  text-align: center;
  background: rgba(62, 207, 178, 0.1);
  color: var(--color-primary, #3ECFB2);
  text-decoration: none;
  font-size: 13px;
  font-weight: 600;
  padding: 8px 12px;
  border-radius: 8px;
  transition: all 0.2s ease;
}

.reciter-listen-link:hover {
  background: var(--color-primary, #3ECFB2);
  color: #0E1015;
}

.other-surah-card {
  display: flex;
  align-items: center;
  gap: 12px;
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid rgba(255, 255, 255, 0.06);
  border-radius: 12px;
  padding: 12px 16px;
  text-decoration: none;
  color: inherit;
  transition: all 0.2s ease;
}

.other-surah-card:hover {
  border-color: rgba(255, 255, 255, 0.2);
  color: var(--color-primary, #3ECFB2);
}

@media (max-width: 768px) {
  .reciter-hero-card {
    flex-direction: column;
    text-align: center;
    padding: 24px;
  }
}
</style>
