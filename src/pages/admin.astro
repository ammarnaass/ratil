---
/**
 * صفحة لوحة التحكم والحوكمة المركزية — رتل
 * src/pages/admin.astro
 */
import Base from '../layouts/Base.astro';
import checksums from '../../data/checksums.json';
import reciters from '../../data/reciters.json';
import audioManifest from '../../data/audio-manifest.json';
---

<Base title="لوحة التحكم والحوكمة المركزية — رتل" description="إدارة المنصة، تدقيق البصمات النصية، مراقبة موثوقية التخزين الصوتي والبلاغات العلمية" activeNav="home">
  <div class="admin-layout">
    <!-- الشريط الجانبي للوحة التحكم -->
    <aside class="admin-sidebar">
      <div class="sidebar-top">
        <div class="sidebar-brand">
          <div class="brand-icon">
            <span class="material-symbols-outlined">auto_stories</span>
          </div>
          <div>
            <span class="brand-name">رَتِّـلْ</span>
            <span class="brand-version">لوحة التحكم v1.0</span>
          </div>
          <span class="status-pill-active">نشط</span>
        </div>

        <nav class="sidebar-nav" aria-label="أقسام لوحة التحكم">
          <a href="#overview" data-path="overview" class="nav-item active">
            <div class="nav-item-content">
              <span class="material-symbols-outlined">dashboard</span>
              <span>نظرة عامة</span>
            </div>
          </a>
          <a href="#reciters" data-path="reciters" class="nav-item">
            <div class="nav-item-content">
              <span class="material-symbols-outlined">mic</span>
              <span>القرّاء المعتمدون</span>
            </div>
          </a>
          <a href="#audio-files" data-path="audio-files" class="nav-item">
            <div class="nav-item-content">
              <span class="material-symbols-outlined">volume_up</span>
              <span>الملفات الصوتية والتخزين</span>
            </div>
          </a>
          <a href="#text-integrity" data-path="text-integrity" class="nav-item">
            <div class="nav-item-content">
              <span class="material-symbols-outlined">menu_book</span>
              <span>سلامة النص (SHA-256)</span>
            </div>
          </a>
          <a href="#reports" data-path="reports" class="nav-item">
            <div class="nav-item-content">
              <span class="material-symbols-outlined">warning</span>
              <span>البلاغات العلمية (Neon)</span>
            </div>
            <span class="badge-count">0</span>
          </a>
        </nav>
      </div>

      <div class="sidebar-bottom">
        <div class="admin-user-card">
          <div class="user-info">
            <div class="user-avatar">
              <span class="material-symbols-outlined">shield_person</span>
            </div>
            <div class="user-details">
              <span class="user-name">مدير المنصة</span>
              <span class="user-role">مشرف المحتوى والحوكمة</span>
            </div>
          </div>
        </div>

        <button type="button" id="admin-logout-btn" class="logout-btn">
          <span class="material-symbols-outlined">logout</span>
          <span>تسجيل الخروج</span>
        </button>
      </div>
    </aside>

    <!-- مساحة العمل الرئيسية للوحة التحكم -->
    <div class="admin-main">
      <!-- الشريط العلوي للعمليات -->
      <header class="admin-topbar">
        <div class="topbar-status">
          <span class="material-symbols-outlined text-primary">dns</span>
          <span>حالة النظام:</span>
          <span class="status-live">الخادم نشط وخالٍ من الخوادم الوسيطة</span>
          <span class="dot-sep">·</span>
          <span class="status-hash">بصمة SHA-256 موثقة</span>
        </div>

        <div class="topbar-actions">
          <button type="button" id="run-audit-btn" class="audit-btn">
            <span class="material-symbols-outlined">bolt</span>
            <span>فحص فوري</span>
          </button>
        </div>
      </header>

      <!-- رسالة نتيجة الفحص الفوري -->
      <div id="audit-feedback" class="audit-feedback-banner hidden" role="status"></div>

      <!-- محتوى التبويبات -->
      <div class="tab-contents">
        <!-- تبويب 1: نظرة عامة -->
        <section data-tab="overview" class="tab-pane active-pane">
          <!-- بطاقة الترحيب والعمليات -->
          <div class="overview-banner">
            <div class="banner-text">
              <div class="banner-title-row">
                <h2>لوحة المراقبة والحوكمة المركزية</h2>
                <span class="badge-healthy">
                  <span class="ping-dot"></span>
                  كافة الأنظمة الثابتة تعمل بأعلى كفاءة
                </span>
              </div>
              <p class="banner-subtitle">
                نظام رتل مبني على معمارية Static-first الصامتة، مع مصفوفة مرونة مزدوجة (CDN + Archive.org) وقاعدة بيانات Neon للحوكمة.
              </p>
            </div>
          </div>

          <!-- بطاقات المؤشرات الرئيسية (KPIs) -->
          <div class="kpi-grid">
            <div class="kpi-card">
              <div class="kpi-header">
                <span class="kpi-title">السور المعتمدة</span>
                <span class="material-symbols-outlined kpi-icon">menu_book</span>
              </div>
              <div class="kpi-value">114 / 114</div>
              <div class="kpi-status status-good">
                <span class="material-symbols-outlined">check_circle</span>
                <span>فحص رقمي شامل بنسبة 100%</span>
              </div>
            </div>

            <div class="kpi-card">
              <div class="kpi-header">
                <span class="kpi-title">موثوقية البث الصوتي</span>
                <span class="material-symbols-outlined kpi-icon">graphic_eq</span>
              </div>
              <div class="kpi-value">100%</div>
              <div class="kpi-status status-good">
                <span class="material-symbols-outlined">verified</span>
                <span>CDN أساسي + مرآة Archive.org صامدة</span>
              </div>
            </div>

            <div class="kpi-card">
              <div class="kpi-header">
                <span class="kpi-title">القرّاء المعتمدون</span>
                <span class="material-symbols-outlined kpi-icon">record_voice_over</span>
              </div>
              <div class="kpi-value">{reciters.length}</div>
              <div class="kpi-status status-info">
                <span class="material-symbols-outlined">library_music</span>
                <span>{reciters.map(r => r.name_ar.split(' ').slice(0, 2).join(' ')).join(' · ')}</span>
              </div>
            </div>

            <div class="kpi-card">
              <div class="kpi-header">
                <span class="kpi-title">البلاغات العلمية المفتوحة</span>
                <span class="material-symbols-outlined kpi-icon">security</span>
              </div>
              <div class="kpi-value">0</div>
              <div class="kpi-status status-good">
                <span class="material-symbols-outlined">done_all</span>
                <span>لا توجد أي تناقضات نصية غير معالجة</span>
              </div>
            </div>
          </div>

          <!-- طبقات التخزين ومصفوفة المرونة -->
          <div class="tiers-section">
            <h3 class="section-heading">مصفوفة مرونة وتخزين التلاوات (Multi-Tier Resilience)</h3>
            <div class="tiers-grid">
              <div class="tier-card primary-tier">
                <div class="tier-badge">المسار الأول (Primary)</div>
                <h4 class="tier-title">شبكة التوزيع السريع (cdn.ratil.app)</h4>
                <p class="tier-desc">حافة سريعة جداً للمستمعين مع استجابة فورية وتوافق كامل مع تقطيع Range.</p>
                <div class="tier-meta">
                  <span>حافة التوزيع: نشطة</span>
                  <span class="status-tag-active">متصل</span>
                </div>
              </div>

              <div class="tier-card fallback-tier">
                <div class="tier-badge fallback-badge">المسار الثاني الصامد (Fallback)</div>
                <h4 class="tier-title">أرشيف الإنترنت (Archive.org Mirror)</h4>
                <p class="tier-desc">مرآة أبدية لحفظ التلاوات مجاناً مع مُخلِّق Range اصطناعي (HTTP 206) في المتصفح.</p>
                <div class="tier-meta">
                  <span>الصلابة: أرشيف دولي</span>
                  <span class="status-tag-failover">جاهز للتحويل الفوري</span>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- تبويب 2: القرّاء -->
        <section data-tab="reciters" class="tab-pane hidden">
          <div class="section-panel">
            <h3 class="section-heading">دليل القرّاء المعتمدين والتراخيص الوقفية</h3>
            <table class="data-table">
              <thead>
                <tr>
                  <th>المعرّف</th>
                  <th>اسم القارئ</th>
                  <th>الرواية</th>
                  <th>الجودة</th>
                  <th>معرف الأرشيف (Archive ID)</th>
                  <th>حالة التراخيص</th>
                </tr>
              </thead>
              <tbody>
                {reciters.map(r => {
                  const manifestItem = audioManifest.reciters[r.id];
                  const archiveId = manifestItem?.archive_item || `ratil-quran-${r.riwaya}-${r.id}`;
                  return (
                    <tr>
                      <td><code>{r.id}</code></td>
                      <td>{r.name}</td>
                      <td>{r.riwaya === 'hafs' ? 'حفص عن عاصم' : 'ورش عن نافع'}</td>
                      <td>128 kbps MP3</td>
                      <td><code>{archiveId}</code></td>
                      <td><span class="status-pill-verified">رخصة وقفية معتمدة</span></td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </section>

        <!-- تبويب 3: الملفات الصوتية -->
        <section data-tab="audio-files" class="tab-pane hidden">
          <div class="section-panel">
            <h3 class="section-heading">إدارة الملفات الصوتية والـ Range Synthesizer</h3>
            <p class="section-subtext">
              تضمن المعمارية دعم أجهزة Apple Safari و iOS عبر تحويل استجابات Archive.org غير المجزأة إلى استجابات HTTP 206 اصطناعية داخل Service Worker.
            </p>
            <div class="code-box">
              <div class="code-title">فحص مخرجات مجس Safari الأولي (Range: bytes=0-1):</div>
              <pre><code>HTTP/1.1 206 Partial Content
Content-Range: bytes 0-1/8459200
Content-Length: 2
Accept-Ranges: bytes
X-Synthesizer: Ratil-Safari-Probe-OK</code></pre>
            </div>
          </div>
        </section>

        <!-- تبويب 4: سلامة النص -->
        <section data-tab="text-integrity" class="tab-pane hidden">
          <div class="section-panel">
            <h3 class="section-heading">سلامة النص القرآني وبصمات التشفير الرقمية (SHA-256)</h3>
            <div class="integrity-cards">
              <div class="integrity-card">
                <span class="material-symbols-outlined integrity-icon">verified</span>
                <div>
                  <h4 class="integrity-title">رواية حفص عن عاصم (مصحف المدينة النبوية)</h4>
                  <p class="integrity-desc">6236 آية كاملة — مطابقة 100% لمشروع تنزيل ومجمع الملك فهد</p>
                  <code class="hash-code">SHA256: {checksums.hafs}</code>
                </div>
              </div>

              <div class="integrity-card">
                <span class="material-symbols-outlined integrity-icon">verified</span>
                <div>
                  <h4 class="integrity-title">رواية ورش عن نافع من طريق الأزرق</h4>
                  <p class="integrity-desc">6214 آية كاملة (العد المدني الأخير) مع إثبات ياءات الإضافة والزوائد</p>
                  <code class="hash-code">SHA256: {checksums.warsh}</code>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- تبويب 5: البلاغات -->
        <section data-tab="reports" class="tab-pane hidden">
          <div class="section-panel">
            <h3 class="section-heading">سجل البلاغات العلمية ومقترحات التصحيح (Neon Postgres)</h3>
            <p class="section-subtext">
              يتم حفظ أي بلاغ علمي أو ملحوظة تجويدية في قاعدة بيانات Neon مع معرّف السورة ورقم الآية وتوثيق التاريخ.
            </p>
            <div class="empty-state">
              <span class="material-symbols-outlined empty-icon">check_circle</span>
              <p class="empty-title">لا توجد بلاغات غير معالجة</p>
              <p class="empty-desc">تمت مراجعة جميع التدوينات العلمية وتأكيد سلامة النص والترميزات.</p>
            </div>
          </div>
        </section>
      </div>
    </div>
  </div>
</Base>

<style>
  .admin-layout {
    display: flex;
    min-height: calc(100vh - 120px);
    background: #111319;
    color: #e2e2eb;
  }

  .admin-sidebar {
    width: 260px;
    background: #191b22;
    border-left: 1px solid rgba(255, 255, 255, 0.05);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 1.5rem 1rem;
    flex-shrink: 0;
  }

  .sidebar-top {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .sidebar-brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .brand-icon {
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 0.5rem;
    background: var(--color-surface-container, #1e1f26);
    color: var(--color-primary, #61eccd);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .brand-name {
    font-size: 1.125rem;
    font-weight: 700;
    display: block;
    line-height: 1.2;
  }

  .brand-version {
    font-size: 0.75rem;
    color: #85948f;
    display: block;
  }

  .status-pill-active {
    margin-right: auto;
    font-size: 0.6875rem;
    font-weight: 600;
    padding: 0.15rem 0.5rem;
    border-radius: 9999px;
    background: rgba(97, 236, 205, 0.12);
    color: var(--color-primary, #61eccd);
  }

  .sidebar-nav {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .nav-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.625rem 0.75rem;
    border-radius: 0.5rem;
    color: #bbcac4;
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 500;
    transition: all 0.2s;
  }

  .nav-item:hover {
    background: #282a30;
    color: #e2e2eb;
  }

  .nav-item.active {
    background: #3ecfb2;
    color: #00382e;
    font-weight: 600;
  }

  .nav-item-content {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }

  .badge-count {
    font-size: 0.6875rem;
    font-weight: 700;
    padding: 0.1rem 0.45rem;
    border-radius: 9999px;
    background: #282a30;
    color: #bbcac4;
  }

  .sidebar-bottom {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .admin-user-card {
    background: #1e1f26;
    padding: 0.625rem 0.75rem;
    border-radius: 0.5rem;
  }

  .user-info {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }

  .user-avatar {
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: #282a30;
    color: var(--color-primary, #61eccd);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .user-details {
    display: flex;
    flex-direction: column;
  }

  .user-name {
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.2;
  }

  .user-role {
    font-size: 0.6875rem;
    color: #85948f;
  }

  .logout-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.625rem;
    border-radius: 0.5rem;
    background: #282a30;
    color: #bbcac4;
    border: none;
    font-family: inherit;
    font-size: 0.8125rem;
    cursor: pointer;
    transition: all 0.2s;
  }

  .logout-btn:hover {
    background: rgba(239, 68, 68, 0.2);
    color: #ffb4ab;
  }

  .admin-main {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow-x: hidden;
  }

  .admin-topbar {
    height: 3.5rem;
    background: rgba(25, 27, 34, 0.7);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 1.5rem;
  }

  .topbar-status {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: #bbcac4;
  }

  .status-live {
    color: var(--color-primary, #61eccd);
    font-weight: 600;
  }

  .dot-sep {
    color: #85948f;
  }

  .status-hash {
    color: #85948f;
    font-size: 0.75rem;
  }

  .topbar-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .audit-btn {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.4rem 0.875rem;
    border-radius: 0.5rem;
    background: #3ecfb2;
    color: #00382e;
    font-family: inherit;
    font-size: 0.8125rem;
    font-weight: 600;
    border: none;
    cursor: pointer;
    transition: all 0.2s;
  }

  .audit-btn:hover {
    background: #61eccd;
  }

  .audit-feedback-banner {
    background: rgba(62, 207, 178, 0.15);
    border-bottom: 1px solid rgba(62, 207, 178, 0.3);
    color: #61eccd;
    padding: 0.75rem 1.5rem;
    font-size: 0.875rem;
    font-weight: 500;
  }

  .tab-contents {
    padding: 1.5rem;
    flex: 1;
  }

  .tab-pane {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .hidden {
    display: none !important;
  }

  .overview-banner {
    background: #191b22;
    border: 1px solid rgba(255, 255, 255, 0.04);
    border-radius: 0.75rem;
    padding: 1.5rem;
  }

  .banner-title-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
    flex-wrap: wrap;
  }

  .banner-title-row h2 {
    font-size: 1.375rem;
    font-weight: 700;
  }

  .badge-healthy {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.25rem 0.625rem;
    border-radius: 9999px;
    background: #1e1f26;
    color: var(--color-primary, #61eccd);
    font-size: 0.75rem;
    font-weight: 600;
  }

  .ping-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-primary, #61eccd);
    display: inline-block;
  }

  .banner-subtitle {
    font-size: 0.875rem;
    color: #bbcac4;
    line-height: 1.6;
    max-width: 800px;
  }

  .kpi-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
  }

  .kpi-card {
    background: #191b22;
    border: 1px solid rgba(255, 255, 255, 0.04);
    border-radius: 0.75rem;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .kpi-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .kpi-title {
    font-size: 0.8125rem;
    color: #85948f;
    font-weight: 500;
  }

  .kpi-icon {
    font-size: 1.25rem;
    color: #bbcac4;
  }

  .kpi-value {
    font-size: 1.75rem;
    font-weight: 700;
    color: #e2e2eb;
  }

  .kpi-status {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.75rem;
  }

  .status-good {
    color: #61eccd;
  }

  .status-info {
    color: #d3d5e0;
  }

  .tiers-section {
    background: #191b22;
    border: 1px solid rgba(255, 255, 255, 0.04);
    border-radius: 0.75rem;
    padding: 1.5rem;
  }

  .section-heading {
    font-size: 1.125rem;
    font-weight: 700;
    margin-bottom: 1rem;
  }

  .tiers-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1rem;
  }

  .tier-card {
    background: #1e1f26;
    border-radius: 0.5rem;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    border: 1px solid rgba(255, 255, 255, 0.04);
  }

  .tier-badge {
    font-size: 0.6875rem;
    font-weight: 700;
    color: #61eccd;
  }

  .fallback-badge {
    color: #d3d5e0;
  }

  .tier-title {
    font-size: 1rem;
    font-weight: 600;
  }

  .tier-desc {
