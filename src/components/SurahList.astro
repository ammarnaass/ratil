---
import surahs from '../../data/surahs.json';

interface Props {
  limit?: number;
  featuredOnly?: boolean;
}

const { limit, featuredOnly = false } = Astro.props;

let displaySurahs = surahs;
if (featuredOnly) {
  // السور الأكثر قراءة واستماعاً (الفاتحة، الكهف، يس، الرحمن، الملك، الإخلاص، الفلق، الناس)
  const featuredIds = [1, 18, 36, 55, 67, 112, 113, 114];
  displaySurahs = surahs.filter(s => featuredIds.includes(s.id));
} else if (limit) {
  displaySurahs = surahs.slice(0, limit);
}
---

<div class="surahs-grid-container" id="surahs-list">
  {displaySurahs.map((surah) => {
    const formattedNum = String(surah.id).padStart(3, '0');
    return (
      <a 
        href={`/surah/${surah.id}`}
        class="surah-card"
        data-surah-id={surah.id}
        id={`surah-card-${surah.id}`}
        aria-label={`سورة ${surah.name_ar}، عدد آياتها ${surah.ayahs_hafs}`}
      >
        <div class="surah-card-header">
          <span class="surah-badge">{formattedNum}</span>
          <span class="surah-type-badge">{surah.type}</span>
        </div>

        <div class="surah-card-body">
          <h3 class="surah-name-arabic">{surah.name_ar}</h3>
          <span class="surah-name-english">{surah.name_en}</span>
        </div>

        <div class="surah-card-footer">
          <span class="ayahs-count">{surah.ayahs_hafs} آية</span>
          <span class="listen-action" title="استمع للسورة">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="5 3 19 12 5 21 5 3"></polygon>
            </svg>
          </span>
        </div>
      </a>
    );
  })}
</div>

<style>
.surahs-grid-container {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  gap: 16px;
  width: 100%;
}

.surah-card {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 18px;
  background: var(--color-surface, #181B22);
  border: 1px solid var(--color-border, rgba(255, 255, 255, 0.08));
  border-radius: var(--radius-lg, 16px);
  text-decoration: none;
  color: inherit;
  transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), 
              border-color 0.2s ease, 
              box-shadow 0.2s ease,
              background-color 0.2s ease;
  position: relative;
  overflow: hidden;
}

.surah-card:hover {
  transform: translateY(-2px);
  border-color: var(--color-primary, #3ECFB2);
  background: var(--color-surface-hover, #1F232C);
  box-shadow: 0 10px 24px -10px var(--color-primary-glow, rgba(62, 207, 178, 0.2));
}

.surah-card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
}

.surah-badge {
  font-family: var(--font-ui);
  font-size: 13px;
  font-weight: 600;
  color: var(--color-primary, #3ECFB2);
  background: rgba(62, 207, 178, 0.1);
  padding: 2px 8px;
  border-radius: 8px;
  letter-spacing: 0.5px;
}

.surah-type-badge {
  font-size: 11px;
  color: var(--color-text-secondary, #9EA3B0);
  background: rgba(255, 255, 255, 0.04);
  padding: 2px 6px;
  border-radius: 6px;
}

.surah-card-body {
  margin-bottom: 14px;
}

.surah-name-arabic {
  font-family: var(--font-ui);
  font-size: 20px;
  font-weight: 700;
  color: var(--color-text-primary, #F3F4F6);
  margin-bottom: 4px;
  transition: color 0.2s ease;
}

.surah-card:hover .surah-name-arabic {
  color: var(--color-primary, #3ECFB2);
}

.surah-name-english {
  font-size: 13px;
  color: var(--color-text-secondary, #9EA3B0);
  font-weight: 400;
  direction: ltr;
  display: inline-block;
}

.surah-card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-top: 1px solid rgba(255, 255, 255, 0.05);
  padding-top: 10px;
}

.ayahs-count {
  font-size: 12px;
  color: var(--color-text-secondary, #9EA3B0);
}

.listen-action {
  width: 32px;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(62, 207, 178, 0.1);
  color: var(--color-primary, #3ECFB2);
  transition: all 0.2s ease;
}

.surah-card:hover .listen-action {
  background: var(--color-primary, #3ECFB2);
  color: #0E1015;
  transform: scale(1.05);
}
</style>
