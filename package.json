{
  "name": "ratil",
  "version": "1.0.0",
  "description": "رتل - مشغّل تلاوات القرآن الكريم مع تتبع الآية وعرض النص القرآني المعتمد",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/verify-text.mjs && node scripts/build-data.mjs && node scripts/build-search.mjs && node scripts/init-db.mjs && next build",
    "start": "next start",
    "verify": "node scripts/verify-text.mjs",
    "build:data": "node scripts/build-data.mjs",
    "build:search": "node scripts/build-search.mjs",
    "db:init": "node --env-file=.env.local scripts/init-db.mjs",
    "db:seed": "node --env-file=.env.local scripts/init-db.mjs",
    "lint": "next lint"
  },
  "keywords": [
    "quran",
    "ratil",
    "hafs",
    "warsh",
    "uthmani",
    "audio-player",
    "nextjs",
    "neon",
    "archive-org"
  ],
  "author": "Ratil Project",
  "license": "CC-BY-NC-4.0",
  "dependencies": {
    "@neondatabase/serverless": "^0.9.5",
    "autoprefixer": "^10.4.20",
    "browserslist": "^4.29.5",
    "lucide-react": "^0.453.0",
    "minisearch": "^6.3.0",
    "next": "^14.2.15",
    "postcss": "^8.4.47",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.14"
  },
  "devDependencies": {
    "@types/node": "^20.16.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "typescript": "^5.6.3"
  }
}
