# .env.example
# قم بنسخ هذا الملف إلى .env.local وضع بياناتك الخاصة

# Neon PostgreSQL Serverless
DATABASE_URL=postgresql://user:password@ep-ratil-sample.us-east-2.aws.neon.tech/ratil?sslmode=require

# حماية لوحة التحكم والحوكمة العلمية (يجب أن يكون طويلاً وقوياً)
ADMIN_SECRET=ratil-secret-admin-governance-key-change-in-production

# Vercel Deploy Hook (اختياري — لإعادة البناء من لوحة التحكم)
VERCEL_DEPLOY_HOOK=https://api.vercel.com/v1/integrations/deploy/xxx
